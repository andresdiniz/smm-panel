{
    "name": "andresdiniz/smm-panel",
    "description": "SMM Panel — PHP 8.5.12+ + Symfony 8",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.5.12",
        "ext-ctype": "*",
        "ext-dom": "*",
        "ext-iconv": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "doctrine/doctrine-bundle": "^3.0",
        "doctrine/doctrine-migrations-bundle": "^3.4",
        "doctrine/orm": "^3.4",
        "dragonmantank/cron-expression": "^3.6",
        "easycorp/easyadmin-bundle": "^4.0",
        "knplabs/knp-paginator-bundle": "^7.0 || ^6.8",
        "minishlink/web-push": "9.0",
        "symfony/apache-pack": "^1.0",
        "symfony/asset": "^8.0",
        "symfony/asset-mapper": "^8.0",
        "symfony/console": "^8.0",
        "symfony/doctrine-messenger": "^8.0",
        "symfony/dotenv": "^8.0",
        "symfony/flex": "^2.4",
        "symfony/form": "^8.0",
        "symfony/framework-bundle": "^8.0",
        "symfony/html-sanitizer": "^8.0",
        "symfony/http-client": "^8.0",
        "symfony/mailer": "^8.0",
        "symfony/messenger": "^8.0",
        "symfony/mime": "^8.0",
        "symfony/monolog-bundle": "^4.0",
        "symfony/password-hasher": "^8.0",
        "symfony/rate-limiter": "^8.0",
        "symfony/runtime": "^8.0",
        "symfony/scheduler": "^8.0",
        "symfony/security-bundle": "^8.0",
        "symfony/twig-bridge": "^8.0",
        "symfony/twig-bundle": "^8.0",
        "symfony/uid": "^8.0",
        "symfony/ux-twig-component": "^2.20",
        "symfony/validator": "^8.0",
        "symfony/yaml": "^8.0",
        "twig/extra-bundle": "^3.10",
        "twig/twig": "^3.10"
    },
    "require-dev": {
        "doctrine/doctrine-fixtures-bundle": "^4.0",
        "phpunit/phpunit": "^12.0",
        "symfony/browser-kit": "^8.0",
        "symfony/css-selector": "^8.0",
        "symfony/maker-bundle": "^1.60",
        "symfony/phpunit-bridge": "^8.0"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-install-cmd": ["@auto-scripts"],
        "post-update-cmd": ["@auto-scripts"],
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "importmap:install": "symfony-cmd"
        }
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "8.*"
        }
    }
}
