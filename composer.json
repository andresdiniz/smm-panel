{
    "name": "andresdiniz/smm-panel",
    "description": "SMM Panel — PHP 8.2+ + Symfony 7",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "doctrine/doctrine-bundle": "^2.11",
        "doctrine/doctrine-migrations-bundle": "^3.3",
        "doctrine/orm": "^3.1",
        "dragonmantank/cron-expression": "^3.6",
        "easycorp/easyadmin-bundle": "^4.10",
        "knplabs/knp-paginator-bundle": "^6.3",
        "symfony/apache-pack": "*",
        "symfony/asset": "7.*",
        "symfony/asset-mapper": "7.*",
        "symfony/console": "7.*",
        "symfony/doctrine-messenger": "7.*",
        "symfony/dotenv": "7.*",
        "symfony/flex": "^2",
        "symfony/form": "7.*",
        "symfony/framework-bundle": "7.*",
        "symfony/http-client": "7.*",
        "symfony/mailer": "7.*",
        "symfony/messenger": "7.*",
        "symfony/mime": "7.*",
        "symfony/monolog-bundle": "^3.10",
        "symfony/password-hasher": "7.*",
        "symfony/runtime": "7.*",
        "symfony/scheduler": "7.*",
        "symfony/security-bundle": "7.*",
        "symfony/twig-bridge": "7.*",
        "symfony/twig-bundle": "7.*",
        "symfony/uid": "7.*",
        "symfony/ux-twig-component": "^2.18",
        "symfony/validator": "7.*",
        "symfony/yaml": "7.*",
        "twig/extra-bundle": "^3.10",
        "twig/twig": "^3.10"
    },
    "require-dev": {
        "doctrine/doctrine-fixtures-bundle": "^3.6",
        "phpunit/phpunit": "^11",
        "symfony/browser-kit": "7.*",
        "symfony/css-selector": "7.*",
        "symfony/maker-bundle": "^1.57",
        "symfony/phpunit-bridge": "7.*"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-install-cmd": ["@auto-scripts"],
        "post-update-cmd": ["@auto-scripts"],
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "importmap:install": "symfony-cmd"
        }
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "7.*"
        }
    }
}
