# Copie este arquivo para .env.local e preencha os valores reais.
# NÃO versione .env.local com credenciais reais.

###> Asaas ###
ASSAS_API_KEY=aact_YourKeyHere
ASSAS_BASE_URL=https://sandbox.asaas.com/api/v3
ASSAS_WEBHOOK_TOKEN=seu_token_secreto_asaas
###< Asaas ###

###> Mercado Pago ###
MP_ACCESS_TOKEN=APP_USR-YourTokenHere
MP_BASE_URL=https://api.mercadopago.com
MP_WEBHOOK_SECRET=seu_webhook_secret_mp
###< Mercado Pago ###

###> PagBank ###
PAGBANK_TOKEN=YourPagBankBearerToken
PAGBANK_BASE_URL=https://sandbox.api.pagseguro.com
PAGBANK_WEBHOOK_TOKEN=seu_token_secreto_pagbank
###< PagBank ###

###> Providers SMM ###
