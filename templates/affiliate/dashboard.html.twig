{% extends 'base.html.twig' %}

{% block title %}Programa de Afiliados{% endblock %}

{% block body %}
<main class="site-main affiliate-page">

  <header class="cp-page-heading">
    <div>
      <p class="cp-eyebrow">Indique e ganhe</p>
      <h1>Programa de afiliados</h1>
      <p>Acompanhe suas indicações e comissões em um só lugar.</p>
    </div>
  </header>

  <div class="affiliate-kpis">
    <article class="affiliate-kpi">
      <span class="affiliate-kpi__icon"><i data-lucide="wallet" width="18" height="18"></i></span>
      <div class="affiliate-kpi__label">Total recebido</div>
      <div class="affiliate-kpi__value">R$ {{ paid|number_format(2,',','.') }}</div>
    </article>
    <article class="affiliate-kpi">
      <span class="affiliate-kpi__icon affiliate-kpi__icon--gold"><i data-lucide="clock-3" width="18" height="18"></i></span>
      <div class="affiliate-kpi__label">Aguardando pagamento</div>
      <div class="affiliate-kpi__value">R$ {{ pending|number_format(2,',','.') }}</div>
    </article>
    <article class="affiliate-kpi">
      <span class="affiliate-kpi__icon affiliate-kpi__icon--blue"><i data-lucide="users" width="18" height="18"></i></span>
      <div class="affiliate-kpi__label">Indicados cadastrados</div>
      <div class="affiliate-kpi__value">{{ referredCount }}</div>
    </article>
    <article class="affiliate-kpi">
      <span class="affiliate-kpi__icon affiliate-kpi__icon--green"><i data-lucide="percent" width="18" height="18"></i></span>
      <div class="affiliate-kpi__label">Sua comissão</div>
      <div class="affiliate-kpi__value">{{ (rate * 100)|number_format(1) }}%</div>
    </article>
  </div>

  <section class="affiliate-card">
    <div class="affiliate-card__heading">
      <span class="affiliate-kpi__icon"><i data-lucide="link" width="18" height="18"></i></span>
      <div>
        <h2>Seu link de indicação</h2>
        <p>Compartilhe seu link para receber {{ (rate * 100)|number_format(1) }}% de comissão nos pedidos elegíveis.</p>
      </div>
    </div>
    <div class="affiliate-link-row">
      <input type="text" readonly id="affLink" aria-label="Seu link de indicação"
             value="{{ url('affiliate_click', {code: user.affiliateCode}) }}">
      <button type="button" class="btn btn-primary"
              data-copy-target="affLink" data-copy-feedback="affLinkFeedback"
              data-copy-success="Link copiado!" data-copy-error="Não foi possível copiar. Selecione o link para copiar.">
        <i data-lucide="copy" width="15" height="15" aria-hidden="true"></i> Copiar link
      </button>
    </div>
    <p class="affiliate-copy-feedback" id="affLinkFeedback" role="status" aria-live="polite"></p>
  </section>

  <section class="affiliate-card">
    <div class="affiliate-card__heading affiliate-card__heading--table">
      <span class="affiliate-kpi__icon affiliate-kpi__icon--blue"><i data-lucide="receipt-text" width="18" height="18"></i></span>
      <div>
        <h2>Histórico de comissões</h2>
        <p>Veja os pedidos que geraram comissão para você.</p>
      </div>
    </div>
    {% if commissions is empty %}
      <div class="cp-empty affiliate-empty">
        <span class="cp-empty__icon"><i data-lucide="inbox" width="26" height="26"></i></span>
        <h3>Nenhuma comissão ainda</h3>
        <p>Compartilhe seu link de indicação para começar.</p>
      </div>
    {% else %}
        <div class="cp-table-wrap">
          <table class="cp-table affiliate-table">
            <thead>
              <tr>
                <th>Data</th>
                <th>Cliente</th>
                <th>Pedido</th>
                <th>Taxa</th>
                <th>Valor</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              {% for c in commissions %}
              <tr>
                <td>{{ c.createdAt|date('d/m/Y') }}</td>
                <td>{{ c.customer.name }}</td>
                <td>#{{ c.order.id }}</td>
                <td>{{ (c.rate * 100)|number_format(1) }}%</td>
                <td class="affiliate-amount">R$ {{ c.amount|number_format(2,',','.') }}</td>
                <td>
                  {% if c.status == 'paid' %}
                    <span class="cp-status" data-status="closed">Pago</span>
                  {% elseif c.status == 'pending' %}
                    <span class="cp-status" data-status="waiting_user">Pendente</span>
                  {% else %}
                    <span class="cp-status" data-status="cancelled">Cancelado</span>
                  {% endif %}
                </td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
    {% endif %}
  </section>

</main>

{% endblock %}
