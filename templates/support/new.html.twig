{% extends 'base.html.twig' %}
{% block page_title %}Novo Ticket{% endblock %}

{% block content %}
<section class="cp-form-page">
  <header class="cp-form-heading">
    <a href="{{ path('support_index') }}" class="cp-back-link">
      <i data-lucide="arrow-left" width="14" height="14" aria-hidden="true"></i> Voltar
    </a>
    <p class="cp-eyebrow">Suporte</p>
    <h1>Abrir novo ticket</h1>
    <p>Descreva sua dúvida ou problema com o máximo de detalhes possível.</p>
  </header>

  <div class="cp-form-card">
    <form method="POST" action="{{ path('support_new') }}" class="cp-form">
      <div class="cp-field">
        <label for="subject">Assunto <span>*</span></label>
        <input type="text" id="subject" name="subject" required maxlength="180"
               placeholder="Ex.: Pedido #32 travado em processamento">
      </div>

      <div class="cp-field">
        <label for="body">Mensagem <span>*</span></label>
        <textarea id="body" name="body" required rows="6" maxlength="4000"
                  placeholder="Descreva o problema e inclua o número do pedido, se necessário."></textarea>
      </div>

      <div class="cp-form-actions">
        <a href="{{ path('support_index') }}" class="btn btn-secondary">Cancelar</a>
        <button type="submit" class="btn btn-primary">
          <i data-lucide="send" width="14" height="14" aria-hidden="true"></i>
          Enviar ticket
        </button>
      </div>
    </form>
  </div>
</section>
{% endblock %}
