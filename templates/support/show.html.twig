{% extends 'base.html.twig' %}
{% block page_title %}Ticket #{{ ticket.id }}{% endblock %}

{% block content %}
<section class="cp-ticket-page">

  <header class="cp-ticket-heading">
    <a href="{{ path('support_index') }}" class="cp-back-link">
      <i data-lucide="arrow-left" width="14" height="14" aria-hidden="true"></i> Meus tickets
    </a>
    <div class="cp-ticket-heading__row">
      <div>
        <p class="cp-eyebrow">Ticket #{{ ticket.id }}</p>
        <h1>{{ ticket.subject }}</h1>
        <span class="cp-ticket-date">Aberto em {{ ticket.createdAt|date('d/m/Y \\à\\s H:i') }}</span>
      </div>
      <span class="cp-status" data-status="{{ ticket.status.value }}">{{ ticket.status.label() }}</span>
    </div>
  </header>

  <div class="cp-message-list">
    {% for msg in ticket.messages %}
    <article class="cp-message{% if msg.isFromUser() %} cp-message--user{% else %} cp-message--support{% endif %}">
      <div class="cp-message__meta">
        {% if msg.isFromUser() %}Você{% else %}<i data-lucide="headphones" width="13" height="13" aria-hidden="true"></i> Suporte{% endif %}
        <span>{{ msg.createdAt|date('d/m/y H:i') }}</span>
      </div>
      <div class="cp-message__bubble">
          {{ msg.body|e|nl2br }}
      </div>
    </article>
    {% endfor %}
  </div>

  {% if ticket.isOpen() %}
  <div class="cp-form-card cp-reply-card">
    <form method="POST" class="cp-form">
      <label for="body">Responder</label>
      <textarea id="body" name="body" rows="4" required maxlength="4000"
                placeholder="Digite sua mensagem..."></textarea>
      <div class="cp-form-actions">
        <button type="submit" class="btn btn-primary">
          <i data-lucide="send" width="14" height="14" aria-hidden="true"></i>
          Enviar mensagem
        </button>
      </div>
    </form>
  </div>
  {% else %}
  <div class="cp-closed">
    <i data-lucide="lock" width="20" height="20" aria-hidden="true"></i>
    Este ticket está fechado. <a href="{{ path('support_new') }}">Abrir novo ticket</a> se precisar de mais ajuda.
  </div>
  {% endif %}

</section>
{% endblock %}
