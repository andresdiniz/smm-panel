{% extends 'base.html.twig' %}
{% block page_title %}Suporte{% endblock %}

{% block content %}
<section class="cp-page">
<header class="cp-page-heading">
  <div>
    <p class="cp-eyebrow">Central de ajuda</p>
    <h1>Meus tickets</h1>
    <p>Acompanhe seus atendimentos ou conte com nossa equipe quando precisar.</p>
  </div>
  <a href="{{ path('support_new') }}" class="btn btn-primary">
    <i data-lucide="plus" width="15" height="15" aria-hidden="true"></i>
    Abrir ticket
  </a>
</header>

{% if tickets|length == 0 %}
<div class="cp-empty">
  <span class="cp-empty__icon"><i data-lucide="inbox" width="26" height="26" aria-hidden="true"></i></span>
  <h2>Nenhum ticket ainda</h2>
  <p>Ficou com dúvida ou encontrou um problema? Abra um chamado e nossa equipe responde em breve.</p>
  <a href="{{ path('support_new') }}" class="btn btn-primary">Abrir ticket</a>
</div>
{% else %}
<div class="cp-table-card">
  <div class="cp-table-wrap">
  <table class="cp-table">
    <thead>
      <tr>
        <th>#</th>
        <th>Assunto</th>
        <th>Status</th>
        <th>Mensagens</th>
        <th>Atualizado</th>
        <th><span class="visually-hidden">Ações</span></th>
      </tr>
    </thead>
    <tbody>
    {% for ticket in tickets %}
      {%- set unread = ticket.countUnreadByUser() -%}
      {%- set subject = ticket.subject|length > 60 ? ticket.subject|slice(0,60) ~ '…' : ticket.subject -%}
      <tr>
        <td class="cp-ticket-id">#{{ ticket.id }}</td>
        <td class="cp-ticket-subject">
          {{ subject }}
          {% if unread > 0 %}
          <span class="cp-unread" aria-label="{{ unread }} mensagens não lidas">{{ unread }}</span>
          {% endif %}
        </td>
        <td>
          <span class="cp-status" data-status="{{ ticket.status.value }}">{{ ticket.status.label() }}</span>
        </td>
        <td class="cp-ticket-count">{{ ticket.messages|length }}</td>
        <td class="cp-ticket-date">
          {{ (ticket.updatedAt ?? ticket.createdAt)|date('d/m/y H:i') }}
        </td>
        <td class="cp-ticket-action">
          <a href="{{ path('support_show', {id: ticket.id}) }}" class="cp-view-link">Abrir <span aria-hidden="true">→</span></a>
        </td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
</div>
{% endif %}
</section>
{% endblock %}
