{% extends 'base.html.twig' %}

{% block title %}Criar conta — PulseSMM{% endblock %}
{% block description %}Crie sua conta na PulseSMM e comece a gerenciar pedidos, saldo e automações com uma UI moderna.{% endblock %}

{% block body %}
<section class="auth-page">
    <div class="container auth-page__grid">
        <div class="auth-copy" data-reveal>
            <span class="pill">Cadastro rápido</span>
            <h1>Comece sua operação com um painel premium</h1>
            <p>
                Conta, carteira, serviços, pedidos e acompanhamento financeiro em uma estrutura pronta para escalar.
            </p>

            <div class="auth-highlights">
                <div class="glass-card">
                    <span>Ativação simples</span>
                    <strong>Cadastro em poucos passos</strong>
                </div>
                <div class="glass-card">
                    <span>Experiência mobile-first</span>
                    <strong>Perfeito no celular</strong>
                </div>
            </div>
        </div>

        <div class="auth-card glass" data-reveal>
            <div class="auth-card__head">
                <h2>Criar conta</h2>
                <p>Preencha os dados abaixo para começar.</p>
            </div>

            {{ form_start(registrationForm, {'attr': {'class': 'auth-form'}}) }}
                <div class="field">
                    <span>Nome</span>
                    {{ form_widget(registrationForm.name, {'attr': {'class': 'control', 'placeholder': 'Seu nome'}}) }}
                    {{ form_errors(registrationForm.name) }}
                </div>

                <div class="field">
                    <span>E-mail</span>
                    {{ form_widget(registrationForm.email, {'attr': {'class': 'control', 'placeholder': 'voce@email.com'}}) }}
                    {{ form_errors(registrationForm.email) }}
                </div>

                <div class="field">
                    <span>Senha</span>
                    {{ form_widget(registrationForm.plainPassword, {'attr': {'class': 'control', 'placeholder': 'Crie uma senha forte'}}) }}
                    {{ form_errors(registrationForm.plainPassword) }}
                </div>

                <div class="checkbox-row checkbox-row--stack">
                    {{ form_widget(registrationForm.agreeTerms) }}
                    <span>Concordo com os termos da plataforma</span>
                </div>
                {{ form_errors(registrationForm.agreeTerms) }}

                <button type="submit" class="btn btn--primary btn--lg btn--block">Criar minha conta</button>
            {{ form_end(registrationForm) }}

            <div class="auth-card__footer">
                <span>Já possui conta?</span>
                <a href="{{ path('app_login') }}">Fazer login</a>
            </div>
        </div>
    </div>
</section>
{% endblock %}
