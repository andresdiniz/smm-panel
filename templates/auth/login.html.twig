{% extends 'base.html.twig' %}

{% block title %}Entrar — PulseSMM{% endblock %}
{% block description %}Acesse sua conta PulseSMM com uma interface rápida, elegante e otimizada para mobile.{% endblock %}

{% block body %}
<section class="auth-page">
    <div class="container auth-page__grid">
        <div class="auth-copy" data-reveal>
            <span class="pill">Login seguro</span>
            <h1>Acesse seu painel em segundos</h1>
            <p>
                Controle pedidos, acompanhe saldo, recarregue a carteira e veja suas métricas em uma experiência fluida.
            </p>

            <div class="auth-highlights">
                <div class="glass-card">
                    <span>Checkout otimizado</span>
                    <strong>Pix e cartão</strong>
                </div>
                <div class="glass-card">
                    <span>Status em tempo real</span>
                    <strong>Pedidos sempre visíveis</strong>
                </div>
            </div>
        </div>

        <div class="auth-card glass" data-reveal>
            <div class="auth-card__head">
                <h2>Entrar</h2>
                <p>Use seu e-mail e senha para continuar.</p>
            </div>

            {% if error %}
                <div class="alert alert--error">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
            {% endif %}

            <form method="post" class="auth-form">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <label class="field">
                    <span>E-mail</span>
                    <input type="email" name="_username" value="{{ last_username }}" class="control" autocomplete="email" required autofocus>
                </label>

                <label class="field">
                    <span>Senha</span>
                    <input type="password" name="_password" class="control" autocomplete="current-password" required>
                </label>

                <label class="checkbox-row">
                    <input type="checkbox" name="_remember_me">
                    <span>Lembrar meu acesso</span>
                </label>

                <button type="submit" class="btn btn--primary btn--lg btn--block">Entrar agora</button>
            </form>

            <div class="auth-card__footer">
                <span>Não tem conta?</span>
                <a href="{{ path('app_register') }}">Criar conta</a>
            </div>
        </div>
    </div>
</section>
{% endblock %}
