{% extends 'base.html.twig' %}

{% block title %}Criar conta — PulseSMM{% endblock %}

{% block auth_body %}
<!DOCTYPE html>
<html lang="pt-BR" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Criar conta — PulseSMM</title>

  <link rel="preconnect" href="https://api.fontshare.com">
  <link href="https://api.fontshare.com/v2/css?f[]=satoshi@300,400,500,600,700,800,900&display=swap" rel="stylesheet">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@1&display=swap" rel="stylesheet">

  <style>
    /* ═══════════════════════════════════════════════
       DESIGN TOKENS — mesmos do login, consistência
    ═══════════════════════════════════════════════ */
    :root, [data-theme="light"] {
      --bg:              #f2f0ec;
      --surface:         #fafaf8;
      --surface-2:       #ffffff;
      --surface-offset:  #ece9e4;
      --surface-dynamic: #e4e1db;
      --border:          oklch(0.2 0.005 80 / 0.09);
      --border-focus:    oklch(0.2 0.005 80 / 0.18);
      --divider:         oklch(0.2 0.005 80 / 0.07);
      --text:            #1c1a17;
      --text-muted:      #6e6c66;
      --text-faint:      #b0ada6;
      --text-inverse:    #faf9f7;
      --primary:         #016870;
      --primary-h:       #014e54;
      --primary-a:       #013638;
      --primary-lo:      oklch(0.48 0.08 192 / 0.10);
      --primary-glow:    oklch(0.48 0.08 192 / 0.28);
      --accent:          #e09c00;
      --accent-lo:       oklch(0.72 0.15 80 / 0.12);
      --danger:          #b8312a;
      --danger-lo:       oklch(0.45 0.18 25 / 0.10);
      --danger-border:   oklch(0.45 0.18 25 / 0.22);
      --success:         #3a7a1e;
      --success-lo:      oklch(0.50 0.14 145 / 0.10);
      --success-border:  oklch(0.50 0.14 145 / 0.22);
      --r-xs:4px; --r-sm:8px; --r-md:12px; --r-lg:16px; --r-xl:20px; --r-2xl:24px; --r-full:9999px;
      --s1:.25rem; --s2:.5rem; --s3:.75rem; --s4:1rem;
      --s5:1.25rem; --s6:1.5rem; --s8:2rem; --s10:2.5rem; --s12:3rem;
      --font-body:    'Satoshi', system-ui, sans-serif;
      --font-display: 'Instrument Serif', Georgia, serif;
      --t-xs:   clamp(0.75rem,  0.7rem  + 0.25vw, 0.875rem);
      --t-sm:   clamp(0.875rem, 0.82rem + 0.25vw, 1rem);
      --t-base: clamp(1rem,     0.95rem + 0.25vw, 1.125rem);
      --t-lg:   clamp(1.125rem, 1rem    + 0.6vw,  1.375rem);
      --t-xl:   clamp(1.5rem,   1.2rem  + 1.2vw,  2rem);
      --t-2xl:  clamp(2rem,     1.5rem  + 2vw,    2.75rem);
      --ease: cubic-bezier(0.16, 1, 0.3, 1);
      --dur: 180ms; --dur-slow: 320ms;
      --shadow-xs: 0 1px 2px oklch(0.2 0.01 80 / 0.05);
      --shadow-sm: 0 2px 6px oklch(0.2 0.01 80 / 0.07), 0 1px 2px oklch(0.2 0.01 80 / 0.04);
      --shadow-md: 0 6px 20px oklch(0.2 0.01 80 / 0.09), 0 2px 6px oklch(0.2 0.01 80 / 0.05);
      --shadow-primary: 0 4px 16px oklch(0.48 0.08 192 / 0.32);
      --shadow-primary-h: 0 8px 24px oklch(0.48 0.08 192 / 0.42);
      color-scheme: light;
    }

    [data-theme="dark"] {
      --bg:              #111010;
      --surface:         #181716;
      --surface-2:       #1e1d1c;
      --surface-offset:  #161514;
      --surface-dynamic: #252422;
      --border:          oklch(1 0 0 / 0.07);
      --border-focus:    oklch(1 0 0 / 0.14);
      --divider:         oklch(1 0 0 / 0.06);
      --text:            #d6d4cf;
      --text-muted:      #7a7874;
      --text-faint:      #4e4c49;
      --text-inverse:    #1a1917;
      --primary:         #4ca3aa;
      --primary-h:       #3a8f96;
      --primary-a:       #2e747a;
      --primary-lo:      oklch(0.66 0.07 192 / 0.12);
      --primary-glow:    oklch(0.66 0.07 192 / 0.24);
      --accent:          #f5b82e;
      --accent-lo:       oklch(0.82 0.15 80 / 0.14);
      --danger:          #e0604f;
      --danger-lo:       oklch(0.60 0.18 25 / 0.12);
      --danger-border:   oklch(0.60 0.18 25 / 0.24);
      --success:         #6aaa42;
      --success-lo:      oklch(0.66 0.14 145 / 0.12);
      --success-border:  oklch(0.66 0.14 145 / 0.24);
      --shadow-xs: 0 1px 2px oklch(0 0 0 / 0.20);
      --shadow-sm: 0 2px 6px oklch(0 0 0 / 0.22), 0 1px 2px oklch(0 0 0 / 0.14);
      --shadow-md: 0 6px 20px oklch(0 0 0 / 0.32), 0 2px 6px oklch(0 0 0 / 0.18);
      --shadow-primary: 0 4px 16px oklch(0.66 0.07 192 / 0.28);
      --shadow-primary-h: 0 8px 24px oklch(0.66 0.07 192 / 0.38);
      color-scheme: dark;
    }

    @media (prefers-color-scheme: dark) {
      :root:not([data-theme]) {
        --bg:#111010;--surface:#181716;--surface-2:#1e1d1c;--surface-offset:#161514;
        --surface-dynamic:#252422;
        --border:oklch(1 0 0/0.07);--border-focus:oklch(1 0 0/0.14);--divider:oklch(1 0 0/0.06);
        --text:#d6d4cf;--text-muted:#7a7874;--text-faint:#4e4c49;--text-inverse:#1a1917;
        --primary:#4ca3aa;--primary-h:#3a8f96;--primary-a:#2e747a;
        --primary-lo:oklch(0.66 0.07 192/0.12);--primary-glow:oklch(0.66 0.07 192/0.24);
        --accent:#f5b82e;--accent-lo:oklch(0.82 0.15 80/0.14);
        --danger:#e0604f;--danger-lo:oklch(0.60 0.18 25/0.12);--danger-border:oklch(0.60 0.18 25/0.24);
        --success:#6aaa42;--success-lo:oklch(0.66 0.14 145/0.12);--success-border:oklch(0.66 0.14 145/0.24);
        --shadow-sm:0 2px 6px oklch(0 0 0/0.22),0 1px 2px oklch(0 0 0/0.14);
        --shadow-md:0 6px 20px oklch(0 0 0/0.32),0 2px 6px oklch(0 0 0/0.18);
        --shadow-primary:0 4px 16px oklch(0.66 0.07 192/0.28);
        --shadow-primary-h:0 8px 24px oklch(0.66 0.07 192/0.38);
        color-scheme:dark;
      }
    }

    /* ════ RESET + BASE ════ */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html {
      font-family: var(--font-body);
      font-size: 16px;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      text-rendering: optimizeLegibility;
      scroll-behavior: smooth;
      background: var(--bg);
      color: var(--text);
    }
    body {
      min-height: 100dvh;
      background: var(--bg);
      color: var(--text);
      transition: background var(--dur-slow) var(--ease), color var(--dur-slow) var(--ease);
    }
    img { display: block; max-width: 100%; }
    button { cursor: pointer; border: none; background: none; font: inherit; color: inherit; }
    a { color: var(--primary); text-decoration: none; transition: opacity var(--dur) var(--ease); }
    a:hover { opacity: .8; }
    :focus-visible { outline: 2px solid var(--primary); outline-offset: 3px; border-radius: var(--r-xs); }
    ::selection { background: var(--primary-lo); color: var(--text); }
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { animation-duration: 0.01ms !important; transition-duration: 0.01ms !important; }
    }

    /* ════ LAYOUT SHELL ════ */
    .auth-shell {
      display: flex;
      flex-direction: column;
      min-height: 100dvh;
    }
    @media (min-width: 900px) {
      .auth-shell { display: grid; grid-template-columns: 1fr 1fr; min-height: 100dvh; }
    }
    @media (min-width: 1200px) {
      .auth-shell { grid-template-columns: 1.15fr 1fr; }
    }

    /* ════ MOBILE TOPBAR ════ */
    .mobile-topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: var(--s3) var(--s5);
      background: var(--surface);
      border-bottom: 1px solid var(--border);
      position: sticky;
      top: 0;
      z-index: 20;
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
    }
    @media (min-width: 900px) { .mobile-topbar { display: none; } }

    .topbar-brand { display: flex; align-items: center; gap: var(--s2); text-decoration: none; }
    .topbar-brand__icon {
      width: 32px; height: 32px; border-radius: var(--r-sm);
      background: var(--primary); display: flex; align-items: center; justify-content: center;
      flex-shrink: 0;
    }
    .topbar-brand__name { font-size: 1rem; font-weight: 800; color: var(--text); letter-spacing: -.02em; }
    .topbar-brand__name em { color: var(--primary); font-style: normal; }

    .theme-btn-sm {
      width: 38px; height: 38px; border-radius: var(--r-full);
      background: var(--surface-2); border: 1px solid var(--border);
      display: flex; align-items: center; justify-content: center;
      color: var(--text-muted); box-shadow: var(--shadow-xs);
      transition: color var(--dur) var(--ease), transform var(--dur) var(--ease), background var(--dur) var(--ease);
    }
    .theme-btn-sm:hover { color: var(--text); transform: rotate(18deg); background: var(--surface-offset); }
    .theme-btn-sm:active { transform: rotate(18deg) scale(.93); }

    /* ════ LEFT PANEL — hero visual ════ */
    .hero-panel {
      display: none;
      position: relative;
      background: var(--primary);
      overflow: hidden;
      color: #fff;
      padding: var(--s10) var(--s12);
      flex-direction: column;
      justify-content: space-between;
      gap: var(--s10);
    }
    @media (min-width: 900px) { .hero-panel { display: flex; } }

    /* Grid texture */
    .hero-panel::before {
      content: '';
      position: absolute; inset: 0;
      background-image:
        linear-gradient(rgba(255,255,255,.045) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255,255,255,.045) 1px, transparent 1px);
      background-size: 40px 40px;
      pointer-events: none; z-index: 0;
    }
    /* Radial overlay */
    .hero-panel::after {
      content: '';
      position: absolute; inset: 0;
      background:
        radial-gradient(ellipse 70% 50% at 20% 20%, rgba(255,255,255,.14) 0%, transparent 60%),
        radial-gradient(ellipse 50% 60% at 80% 85%, rgba(0,0,0,.16) 0%, transparent 55%);
      pointer-events: none; z-index: 0;
    }
    .hero-orb {
      position: absolute; width: 520px; height: 520px; border-radius: 50%;
      background: radial-gradient(circle, rgba(255,255,255,.10) 0%, transparent 70%);
      top: -140px; right: -130px;
      animation: orb-drift 11s ease-in-out infinite; pointer-events: none; z-index: 0;
    }
    .hero-orb-2 {
      position: absolute; width: 320px; height: 320px; border-radius: 50%;
      background: radial-gradient(circle, rgba(255,255,255,.07) 0%, transparent 70%);
      bottom: 60px; left: -90px;
      animation: orb-drift 15s ease-in-out infinite reverse; pointer-events: none; z-index: 0;
    }
    @keyframes orb-drift {
      0%,100%{transform:translate(0,0) scale(1)} 33%{transform:translate(-20px,16px) scale(1.06)} 66%{transform:translate(10px,-18px) scale(.96)}
    }

    .hero-content {
      position: relative; z-index: 1;
      display: flex; flex-direction: column; gap: var(--s8); flex: 1;
    }

    /* Brand in hero */
    .hero-brand { display: flex; align-items: center; gap: var(--s3); }
    .hero-brand__icon {
      width: 44px; height: 44px; border-radius: var(--r-md);
      background: rgba(255,255,255,.16); border: 1px solid rgba(255,255,255,.24);
      backdrop-filter: blur(8px); display: flex; align-items: center; justify-content: center;
      flex-shrink: 0; box-shadow: 0 2px 8px rgba(0,0,0,.12);
    }
    .hero-brand__name { font-size: var(--t-lg); font-weight: 800; letter-spacing: -.025em; color: #fff; }
    .hero-brand__name em { font-style: normal; opacity: .72; }

    /* Badge */
    .hero-badge {
      display: inline-flex; align-items: center; gap: var(--s2);
      background: rgba(255,255,255,.12); backdrop-filter: blur(10px);
      border: 1px solid rgba(255,255,255,.18); border-radius: var(--r-full);
      padding: 5px var(--s4); font-size: var(--t-xs); font-weight: 600;
      letter-spacing: .05em; text-transform: uppercase; color: rgba(255,255,255,.9);
      width: fit-content;
    }
    .hero-badge__dot {
      width: 6px; height: 6px; border-radius: 50%;
      background: var(--accent); box-shadow: 0 0 8px var(--accent);
      animation: pulse-dot 2.4s ease-in-out infinite; flex-shrink: 0;
    }
    @keyframes pulse-dot { 0%,100%{transform:scale(1);opacity:1} 50%{transform:scale(1.35);opacity:.65} }

    /* Headline */
    .hero-headline {
      font-family: var(--font-display);
      font-size: var(--t-2xl); font-weight: 400; font-style: italic;
      line-height: 1.1; letter-spacing: -.02em; color: #fff; margin-bottom: var(--s3);
    }
    .hero-headline strong {
      font-style: normal; font-weight: 800; color: var(--accent);
      font-family: var(--font-body); font-size: .78em;
      display: block; letter-spacing: -.03em;
    }
    .hero-desc {
      font-size: var(--t-sm); line-height: 1.78; color: rgba(255,255,255,.68); max-width: 40ch;
    }

    /* Steps */
    .hero-steps { display: flex; flex-direction: column; gap: var(--s3); }
    .hero-step {
      display: flex; align-items: flex-start; gap: var(--s4);
      font-size: var(--t-sm); color: rgba(255,255,255,.85);
    }
    .hero-step__num {
      width: 28px; height: 28px; border-radius: 50%; flex-shrink: 0;
      background: rgba(255,255,255,.14); border: 1.5px solid rgba(255,255,255,.24);
      display: flex; align-items: center; justify-content: center;
      font-size: .68rem; font-weight: 800; color: #fff; margin-top: 1px;
    }
    .hero-step__num.active {
      background: var(--accent); border-color: transparent;
      color: #1a1200; box-shadow: 0 2px 10px rgba(224,156,0,.45);
    }
    .hero-step__text strong { display: block; font-weight: 700; margin-bottom: 1px; }
    .hero-step__text span { color: rgba(255,255,255,.60); font-size: .79rem; }

    /* Benefits grid */
    .hero-benefits {
      display: grid; grid-template-columns: 1fr 1fr; gap: var(--s3);
      position: relative; z-index: 1;
    }
    .benefit-card {
      background: rgba(255,255,255,.10); backdrop-filter: blur(14px);
      border: 1px solid rgba(255,255,255,.16); border-radius: var(--r-md);
      padding: var(--s4);
      transition: background var(--dur) var(--ease), transform var(--dur) var(--ease);
    }
    .benefit-card:hover { background: rgba(255,255,255,.16); transform: translateY(-2px); }
    .benefit-card__icon {
      width: 30px; height: 30px; border-radius: var(--r-sm);
      background: rgba(255,255,255,.14); display: flex; align-items: center; justify-content: center;
      margin-bottom: var(--s2); color: rgba(255,255,255,.9);
    }
    .benefit-card__title { font-size: .84rem; font-weight: 700; color: #fff; margin-bottom: 3px; }
    .benefit-card__sub { font-size: .72rem; color: rgba(255,255,255,.56); line-height: 1.5; }

    /* Quote */
    .hero-quote {
      background: rgba(255,255,255,.08); backdrop-filter: blur(10px);
      border: 1px solid rgba(255,255,255,.12); border-radius: var(--r-xl);
      padding: var(--s5) var(--s6); position: relative; z-index: 1;
    }
    .hero-quote__stars { color: var(--accent); font-size: .7rem; letter-spacing: 2px; margin-bottom: var(--s2); }
    .hero-quote__text {
      font-size: var(--t-sm); line-height: 1.65; color: rgba(255,255,255,.80);
      font-style: italic; margin-bottom: var(--s3);
    }
    .hero-quote__author {
      display: flex; align-items: center; gap: var(--s2);
      font-size: .74rem; color: rgba(255,255,255,.58);
    }
    .hero-quote__avatar {
      width: 28px; height: 28px; border-radius: 50%;
      background: rgba(255,255,255,.18); display: flex; align-items: center; justify-content: center;
      font-size: .62rem; font-weight: 700; color: #fff; flex-shrink: 0;
    }

    /* ════ RIGHT PANEL — form ════ */
    .form-panel {
      flex: 1; display: flex; flex-direction: column;
      align-items: center; justify-content: flex-start;
      padding: var(--s8) var(--s4) var(--s12);
      background: var(--bg);
      transition: background var(--dur-slow) var(--ease);
      position: relative;
    }
    @media (min-width: 640px) { .form-panel { padding: var(--s10) var(--s6) var(--s12); } }
    @media (min-width: 900px) { .form-panel { justify-content: center; padding: var(--s12) var(--s8); } }

    /* Desktop theme toggle */
    .theme-btn {
      display: none;
      position: absolute; top: var(--s5); right: var(--s5);
      width: 40px; height: 40px; border-radius: var(--r-full);
      background: var(--surface-2); border: 1px solid var(--border);
      align-items: center; justify-content: center;
      color: var(--text-muted); box-shadow: var(--shadow-xs);
      transition: color var(--dur) var(--ease), transform var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
    }
    @media (min-width: 900px) { .theme-btn { display: flex; } }
    .theme-btn:hover { color: var(--text); transform: rotate(18deg); box-shadow: var(--shadow-md); }
    .theme-btn:active { transform: rotate(18deg) scale(.93); }

    .form-wrap { width: 100%; max-width: 460px; }

    /* Form header */
    .form-header { margin-bottom: var(--s5); }
    .form-eyebrow {
      display: inline-flex; align-items: center; gap: var(--s2);
      background: var(--primary-lo); border: 1px solid oklch(0.48 0.08 192 / 0.15);
      border-radius: var(--r-full); padding: 5px var(--s3);
      font-size: var(--t-xs); font-weight: 600; color: var(--primary);
      letter-spacing: .04em; text-transform: uppercase; margin-bottom: var(--s4);
    }
    [data-theme="dark"] .form-eyebrow { border-color: oklch(0.66 0.07 192 / 0.18); }
    .form-heading {
      font-size: var(--t-xl); font-weight: 800; letter-spacing: -.03em;
      color: var(--text); line-height: 1.15; margin-bottom: var(--s2);
    }
    .form-sub { font-size: var(--t-sm); color: var(--text-muted); line-height: 1.65; }

    /* Step indicator */
    .step-indicator {
      display: flex; align-items: center; gap: var(--s2);
      margin-bottom: var(--s6); padding: var(--s3) var(--s4);
      background: var(--surface); border: 1px solid var(--border);
      border-radius: var(--r-lg);
    }
    .step-item {
      display: flex; align-items: center; gap: var(--s2);
      font-size: var(--t-xs); color: var(--text-faint); font-weight: 600;
      letter-spacing: .03em;
    }
    .step-item.is-active { color: var(--primary); }
    .step-item.is-done { color: var(--success); }
    .step-dot {
      width: 22px; height: 22px; border-radius: 50%;
      border: 1.5px solid var(--border-focus);
      display: flex; align-items: center; justify-content: center;
      font-size: .62rem; font-weight: 800; flex-shrink: 0;
      background: var(--surface-offset);
      transition: all var(--dur) var(--ease);
    }
    .step-item.is-active .step-dot {
      background: var(--primary-lo); border-color: var(--primary); color: var(--primary);
    }
    .step-item.is-done .step-dot {
      background: var(--success-lo); border-color: var(--success); color: var(--success);
    }
    .step-connector {
      flex: 1; height: 1.5px; background: var(--divider); border-radius: 99px; min-width: var(--s4);
    }

    /* Alerts */
    .alert {
      display: flex; align-items: flex-start; gap: var(--s3);
      padding: var(--s3) var(--s4); border-radius: var(--r-md);
      font-size: var(--t-sm); margin-bottom: var(--s5);
      animation: slide-down .28s var(--ease);
    }
    .alert--error { background: var(--danger-lo); border: 1px solid var(--danger-border); color: var(--danger); }
    .alert--success { background: var(--success-lo); border: 1px solid var(--success-border); color: var(--success); }
    .alert__icon { flex-shrink: 0; margin-top: 2px; }
    @keyframes slide-down { from{opacity:0;transform:translateY(-8px)} to{opacity:1;transform:none} }

    /* Fields */
    .fields { display: flex; flex-direction: column; gap: var(--s4); margin-bottom: var(--s4); }
    .fields-row { display: grid; grid-template-columns: 1fr; gap: var(--s4); }
    @media (min-width: 480px) { .fields-row { grid-template-columns: 1fr 1fr; } }

    .field { display: flex; flex-direction: column; gap: var(--s2); }
    .field-label-row { display: flex; align-items: center; justify-content: space-between; gap: var(--s2); }
    .field-label {
      font-size: .78rem; font-weight: 600;
      color: var(--text-muted); letter-spacing: .04em; text-transform: uppercase;
    }
    .field-hint { font-size: .72rem; color: var(--text-faint); }
    .input-wrap { position: relative; display: flex; align-items: center; }
    .input-icon {
      position: absolute; left: var(--s4); color: var(--text-faint);
      pointer-events: none; transition: color var(--dur) var(--ease); display: flex;
    }
    .input-wrap:focus-within .input-icon { color: var(--primary); }

    .control {
      width: 100%;
      padding: var(--s4) var(--s4) var(--s4) calc(var(--s4) + 16px + var(--s3));
      background: var(--surface-2); border: 1.5px solid var(--border);
      border-radius: var(--r-md); font-family: var(--font-body);
      font-size: var(--t-base); color: var(--text);
      transition: border-color var(--dur) var(--ease), box-shadow var(--dur) var(--ease), background var(--dur) var(--ease);
      -webkit-appearance: none; appearance: none;
    }
    .control.no-icon { padding-left: var(--s4); }
    .control::placeholder { color: var(--text-faint); }
    .control:hover:not(:focus) { border-color: var(--border-focus); background: var(--surface); }
    .control:focus {
      outline: none; border-color: var(--primary);
      box-shadow: 0 0 0 3px var(--primary-lo);
    }
    .control.is-error { border-color: var(--danger); box-shadow: 0 0 0 3px var(--danger-lo); }
    .control.is-valid { border-color: var(--success); }
    @media (max-width: 640px) { .control { font-size: 16px; } }

    /* Password eye toggle */
    .pwd-toggle {
      position: absolute; right: var(--s3);
      width: 32px; height: 32px; border-radius: var(--r-sm);
      display: flex; align-items: center; justify-content: center;
      color: var(--text-faint);
      transition: color var(--dur) var(--ease), background var(--dur) var(--ease);
    }
    .pwd-toggle:hover { color: var(--text-muted); background: var(--surface-offset); }

    /* Password strength meter */
    .strength-wrap { margin-top: var(--s2); }
    .strength-track {
      height: 4px; background: var(--surface-offset); border-radius: 99px; overflow: hidden;
    }
    .strength-fill {
      height: 100%; border-radius: 99px; width: 0%;
      transition: width .4s var(--ease), background .3s var(--ease);
    }
    .strength-fill.s1 { background: var(--danger); }
    .strength-fill.s2 { background: var(--accent); }
    .strength-fill.s3 { background: oklch(0.62 0.14 145); }
    .strength-fill.s4 { background: var(--success); }
    .strength-meta {
      display: flex; align-items: center; justify-content: space-between;
      margin-top: var(--s2); gap: var(--s2);
    }
    .strength-rules {
      display: flex; gap: var(--s2); flex-wrap: wrap;
    }
    .strength-rule {
      display: flex; align-items: center; gap: 4px;
      font-size: .68rem; color: var(--text-faint); font-weight: 500;
      transition: color var(--dur) var(--ease);
    }
    .strength-rule svg { flex-shrink: 0; }
    .strength-rule.met { color: var(--success); }
    .strength-label {
      font-size: .7rem; font-weight: 600; white-space: nowrap;
      transition: color var(--dur) var(--ease);
    }
    .strength-label.s1 { color: var(--danger); }
    .strength-label.s2 { color: var(--accent); }
    .strength-label.s3 { color: oklch(0.55 0.12 145); }
    .strength-label.s4 { color: var(--success); }
    [data-theme="dark"] .strength-label.s3 { color: oklch(0.72 0.14 145); }

    /* Field errors */
    .field-error {
      font-size: .78rem; color: var(--danger);
      display: flex; align-items: center; gap: var(--s1); margin-top: 1px;
      animation: slide-down .22s var(--ease);
    }
    .field-error svg { flex-shrink: 0; }

    /* Terms card */
    .terms-card {
      background: var(--surface); border: 1.5px solid var(--border);
      border-radius: var(--r-md); overflow: hidden;
      transition: border-color var(--dur) var(--ease);
    }
    .terms-card:has(.terms-checkbox:checked) {
      border-color: oklch(0.48 0.08 192 / 0.30);
      background: var(--primary-lo);
    }
    [data-theme="dark"] .terms-card:has(.terms-checkbox:checked) {
      border-color: oklch(0.66 0.07 192 / 0.30);
    }
    .terms-inner {
      display: flex; align-items: flex-start; gap: var(--s3);
      padding: var(--s3) var(--s4); cursor: pointer;
    }
    .terms-checkbox {
      appearance: none; -webkit-appearance: none;
      width: 18px; height: 18px; border-radius: 5px;
      border: 1.5px solid var(--border-focus); background: var(--surface-2);
      cursor: pointer; flex-shrink: 0; margin-top: 1px;
      transition: background var(--dur) var(--ease), border-color var(--dur) var(--ease), transform var(--dur) var(--ease);
      position: relative;
    }
    .terms-checkbox:checked { background: var(--primary); border-color: var(--primary); }
    .terms-checkbox:checked::after {
      content: ''; position: absolute; left: 3px; top: 1.5px;
      width: 9px; height: 5px; border: 2px solid #fff;
      border-top: none; border-right: none; transform: rotate(-45deg);
    }
    .terms-checkbox:active { transform: scale(.9); }
    .terms-checkbox:focus-visible { outline: 2px solid var(--primary); outline-offset: 2px; }
    .terms-text { font-size: var(--t-sm); color: var(--text-muted); line-height: 1.55; }
    .terms-text a { font-weight: 600; }

    /* Submit */
    .btn-submit {
      width: 100%; padding: var(--s4) var(--s6);
      background: var(--primary); color: #fff;
      border-radius: var(--r-md); font-family: var(--font-body);
      font-size: var(--t-base); font-weight: 700; letter-spacing: -.01em;
      border: none; cursor: pointer; min-height: 52px;
      box-shadow: var(--shadow-primary);
      transition: background var(--dur) var(--ease), box-shadow var(--dur) var(--ease), transform var(--dur) var(--ease);
      display: flex; align-items: center; justify-content: center; gap: var(--s2);
      position: relative; overflow: hidden;
    }
    .btn-submit::before {
      content: ''; position: absolute; inset: 0;
      background: linear-gradient(105deg, transparent 35%, rgba(255,255,255,.16) 50%, transparent 65%);
      transform: translateX(-100%);
      transition: transform .55s var(--ease);
    }
    .btn-submit:hover {
      background: var(--primary-h); box-shadow: var(--shadow-primary-h);
      transform: translateY(-1px);
    }
    .btn-submit:hover::before { transform: translateX(100%); }
    .btn-submit:active { transform: translateY(0) scale(.99); }
    .btn-submit .btn-arrow { transition: transform var(--dur) var(--ease); }
    .btn-submit:hover .btn-arrow { transform: translateX(5px); }
    .btn-submit:disabled { opacity: .6; pointer-events: none; }

    /* Spinner */
    .btn-spinner {
      width: 18px; height: 18px; border: 2.5px solid rgba(255,255,255,.35);
      border-top-color: #fff; border-radius: 50%;
      animation: spin .6s linear infinite; display: none;
    }
    .btn-submit.loading .btn-spinner { display: block; }
    .btn-submit.loading .btn-text,
    .btn-submit.loading .btn-icon,
    .btn-submit.loading .btn-arrow { display: none; }
    @keyframes spin { to { transform: rotate(360deg); } }

    /* Divider */
    .divider {
      display: flex; align-items: center; gap: var(--s3);
      margin: var(--s5) 0; color: var(--text-faint);
      font-size: var(--t-xs); letter-spacing: .06em; text-transform: uppercase;
    }
    .divider::before, .divider::after {
      content: ''; flex: 1; height: 1px; background: var(--divider);
    }

    /* Footer links */
    .login-row { text-align: center; font-size: var(--t-sm); color: var(--text-muted); }
    .login-row a { color: var(--primary); font-weight: 600; }

    /* Trust row */
    .trust-row {
      display: flex; align-items: center; justify-content: center;
      gap: var(--s5); margin-top: var(--s5); flex-wrap: wrap;
    }
    .trust-item {
      display: flex; align-items: center; gap: 5px;
      font-size: .7rem; color: var(--text-faint); font-weight: 500;
    }

    /* Entry animations */
    @keyframes fade-up {
      from { opacity: 0; transform: translateY(12px); }
      to   { opacity: 1; transform: none; }
    }
    .form-wrap > * { animation: fade-up var(--dur-slow) var(--ease) both; }
    .form-wrap > *:nth-child(1){animation-delay:0ms}
    .form-wrap > *:nth-child(2){animation-delay:50ms}
    .form-wrap > *:nth-child(3){animation-delay:100ms}
    .form-wrap > *:nth-child(4){animation-delay:150ms}
    .form-wrap > *:nth-child(5){animation-delay:200ms}
    .form-wrap > *:nth-child(6){animation-delay:250ms}
    .form-wrap > *:nth-child(7){animation-delay:300ms}
    .form-wrap > *:nth-child(8){animation-delay:350ms}
    .form-wrap > *:nth-child(9){animation-delay:400ms}

    .hero-content > * { animation: fade-up var(--dur-slow) var(--ease) both; }
    .hero-content > *:nth-child(1){animation-delay:80ms}
    .hero-content > *:nth-child(2){animation-delay:160ms}
    .hero-content > *:nth-child(3){animation-delay:240ms}
    .hero-content > *:nth-child(4){animation-delay:320ms}
    .hero-benefits { animation: fade-up var(--dur-slow) var(--ease) 400ms both; }
    .hero-quote    { animation: fade-up var(--dur-slow) var(--ease) 480ms both; }
  </style>
</head>
<body>

