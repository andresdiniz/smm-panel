      <div class="hero-steps">
        <div class="hero-step">
          <div class="hero-step__num active">1</div>
          <div class="hero-step__text">
            <strong>Crie sua conta</strong>
            <span>Preencha os dados básicos agora</span>
          </div>
        </div>
        <div class="hero-step">
          <div class="hero-step__num">2</div>
          <div class="hero-step__text">
            <strong>Adicione créditos</strong>
            <span>Pix, cartão, boleto e mais opções</span>
          </div>
        </div>
        <div class="hero-step">
          <div class="hero-step__num">3</div>
          <div class="hero-step__text">
            <strong>Faça seu primeiro pedido</strong>
            <span>Entrega automática, começa em minutos</span>
          </div>
        </div>
      </div>

    </div>

    <div class="hero-benefits">
      <div class="benefit-card">
        <div class="benefit-card__icon">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        </div>
        <div class="benefit-card__title">100% Seguro</div>
        <div class="benefit-card__sub">Dados criptografados e pagamentos protegidos</div>
      </div>
      <div class="benefit-card">
        <div class="benefit-card__icon">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        </div>
        <div class="benefit-card__title">Entrega Rápida</div>
        <div class="benefit-card__sub">Início em minutos após confirmação</div>
      </div>
      <div class="benefit-card">
        <div class="benefit-card__icon">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
        </div>
        <div class="benefit-card__title">Suporte 24/7</div>
        <div class="benefit-card__sub">Time pronto para te ajudar a qualquer hora</div>
      </div>
      <div class="benefit-card">
        <div class="benefit-card__icon">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
        </div>
        <div class="benefit-card__title">Garantia</div>
        <div class="benefit-card__sub">Reembolso garantido em 30 dias sem perguntas</div>
      </div>
    </div>

    <div class="hero-quote">
      <div class="hero-quote__stars">★★★★★</div>
      <p class="hero-quote__text">"É o melhor painel que já usei. Os resultados chegam bem mais rápido que o esperado e o suporte é incrível."</p>
      <div class="hero-quote__author">
        <div class="hero-quote__avatar">CF</div>
        <span>Carla F. — Influenciadora digital</span>
      </div>
    </div>

  </aside>

  {# ═════ RIGHT FORM PANEL ═════ #}
  <main class="form-panel">

    <button class="theme-btn" id="themeToggle" aria-label="Alternar tema claro/escuro">
      <svg id="themeIcon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="5"/>
        <line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/>
        <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
        <line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/>
        <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
      </svg>
    </button>

    <div class="form-wrap">

      {# Header #}
      <header class="form-header">
        <div class="form-eyebrow">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
          </svg>
          Cadastro gratuito
        </div>
        <h1 class="form-heading">Criar sua conta</h1>
        <p class="form-sub">Preencha os dados abaixo. Leva menos de 2 minutos.</p>
      </header>

      {# Step indicator #}
      <div class="step-indicator" aria-label="Progresso do cadastro: etapa 1 de 2">
        <div class="step-item is-active" aria-current="step">
          <div class="step-dot">1</div>
          <span>Seus dados</span>
        </div>
        <div class="step-connector"></div>
        <div class="step-item">
          <div class="step-dot">2</div>
          <span>Confirmar</span>
        </div>
      </div>

      {# Flash messages #}
      {% for msg in app.flashes('success') %}
        <div class="alert alert--success" role="alert">
          <svg class="alert__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
            <polyline points="22 4 12 14.01 9 11.01"/>
          </svg>
          <span>{{ msg }}</span>
        </div>
      {% endfor %}

      {% for msg in app.flashes('error') %}
        <div class="alert alert--error" role="alert">
          <svg class="alert__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10"/>
            <line x1="12" y1="8" x2="12" y2="12"/>
            <line x1="12" y1="16" x2="12.01" y2="16"/>
          </svg>
          <span>{{ msg }}</span>
        </div>
      {% endfor %}

      {# Form #}
      {{ form_start(registrationForm, {attr: {class: 'reg-form', novalidate: 'novalidate', id: 'regForm'}}) }}

        <div class="fields">

          {# Nome completo #}
          <div class="field">
            <div class="field-label-row">
              <label class="field-label" for="{{ registrationForm.name.vars.id }}">Nome completo</label>
            </div>
            <div class="input-wrap">
              <span class="input-icon" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                  <circle cx="12" cy="7" r="4"/>
                </svg>
              </span>
              {{ form_widget(registrationForm.name, {attr: {class: 'control', placeholder: 'Seu nome completo', autocomplete: 'name', id: 'fieldName'}}) }}
            </div>
            {% if registrationForm.name.vars.errors|length > 0 %}
              <div class="field-error" role="alert">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                {{ form_errors(registrationForm.name) }}
              </div>
            {% endif %}
          </div>

          {# E-mail #}
          <div class="field">
            <div class="field-label-row">
              <label class="field-label" for="{{ registrationForm.email.vars.id }}">E-mail</label>
            </div>
            <div class="input-wrap">
              <span class="input-icon" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                  <polyline points="22,6 12,13 2,6"/>
                </svg>
              </span>
              {{ form_widget(registrationForm.email, {attr: {class: 'control', placeholder: 'seu@email.com.br', autocomplete: 'email', id: 'fieldEmail'}}) }}
            </div>
            {% if registrationForm.email.vars.errors|length > 0 %}
              <div class="field-error" role="alert">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                {{ form_errors(registrationForm.email) }}
              </div>
            {% endif %}
          </div>

          {# Senha #}
          <div class="field">
            <div class="field-label-row">
              <label class="field-label" for="{{ registrationForm.plainPassword.first.vars.id }}">Senha</label>
              <span class="field-hint">Mínimo 8 caracteres</span>
            </div>
            <div class="input-wrap">
              <span class="input-icon" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                  <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                </svg>
              </span>
              {{ form_widget(registrationForm.plainPassword.first, {attr: {class: 'control', placeholder: '••••••••', autocomplete: 'new-password', id: 'pwd1', style: 'padding-right:3rem'}}) }}
              <button type="button" class="pwd-toggle" id="pwdToggle1" aria-label="Mostrar senha">
                <svg id="eyeIcon1" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>
                </svg>
              </button>
            </div>
            {# Strength meter — barra contínua + regras visuais #}
            <div class="strength-wrap" id="strengthWrap" aria-live="polite">
              <div class="strength-track">
                <div class="strength-fill" id="strengthFill"></div>
              </div>
              <div class="strength-meta">
                <div class="strength-rules">
                  <span class="strength-rule" id="rule-len">
                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/></svg>
                    8+ chars
                  </span>
                  <span class="strength-rule" id="rule-upper">
                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/></svg>
                    Maiúsc.
                  </span>
                  <span class="strength-rule" id="rule-num">
                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/></svg>
                    Número
                  </span>
                  <span class="strength-rule" id="rule-sym">
                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/></svg>
                    Símbolo
                  </span>
                </div>
                <span class="strength-label" id="strengthLabel"></span>
              </div>
            </div>
            {% if registrationForm.plainPassword.first.vars.errors|length > 0 %}
              <div class="field-error" role="alert">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                {{ form_errors(registrationForm.plainPassword.first) }}
              </div>
            {% endif %}
          </div>

          {# Confirmar senha #}
          <div class="field">
            <div class="field-label-row">
              <label class="field-label" for="{{ registrationForm.plainPassword.second.vars.id }}">Confirmar senha</label>
            </div>
            <div class="input-wrap">
              <span class="input-icon" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="9 11 12 14 22 4"/>
                  <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>
                </svg>
              </span>
              {{ form_widget(registrationForm.plainPassword.second, {attr: {class: 'control', placeholder: 'Repita a senha', autocomplete: 'new-password', id: 'pwd2', style: 'padding-right:3rem'}}) }}
              <button type="button" class="pwd-toggle" id="pwdToggle2" aria-label="Mostrar confirmação de senha">
                <svg id="eyeIcon2" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>
                </svg>
              </button>
            </div>
            <div id="matchHint" style="font-size:.72rem;margin-top:3px;display:none;"></div>
            {% if registrationForm.plainPassword.second.vars.errors|length > 0 %}
              <div class="field-error" role="alert">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                {{ form_errors(registrationForm.plainPassword.second) }}
              </div>
            {% endif %}
          </div>

          {# Termos #}
          <div class="terms-card">
            <label class="terms-inner">
              {{ form_widget(registrationForm.agreeTerms, {attr: {class: 'terms-checkbox', id: 'agreeTerms'}}) }}
              <span class="terms-text">
                Li e aceito os
                <a href="/termos" target="_blank" rel="noopener">Termos de uso</a>
                e a
                <a href="/privacidade" target="_blank" rel="noopener">Política de privacidade</a>
                do PulseSMM
              </span>
            </label>
            {% if registrationForm.agreeTerms.vars.errors|length > 0 %}
              <div class="field-error" role="alert" style="padding: 0 var(--s4) var(--s3);">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                {{ form_errors(registrationForm.agreeTerms) }}
              </div>
            {% endif %}
          </div>

        </div>

        <button type="submit" class="btn-submit" id="submitBtn">
          <div class="btn-spinner"></div>
          <svg class="btn-icon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
            <circle cx="9" cy="7" r="4"/>
            <line x1="19" y1="8" x2="19" y2="14"/>
            <line x1="22" y1="11" x2="16" y2="11"/>
          </svg>
          <span class="btn-text">Criar minha conta</span>
          <svg class="btn-arrow" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"/>
            <polyline points="12 5 19 12 12 19"/>
          </svg>
        </button>

      {{ form_end(registrationForm) }}

      <div class="divider" aria-hidden="true">ou</div>

      <p class="login-row">
        Já tem uma conta?
        <a href="{{ path('app_login') }}">Entrar agora →</a>
      </p>

      <div class="trust-row" aria-label="Garantias de segurança">
        <div class="trust-item">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          Dados seguros
        </div>
        <div class="trust-item">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          Sem spam
        </div>
        <div class="trust-item">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
          Grátis pra sempre
        </div>
      </div>

    </div>
  </main>

</div>

<script>
(function () {
  'use strict';

  /* ── Theme toggle ── */
  var html = document.documentElement;
  var stored = (function(){ try{ return sessionStorage.getItem('pulse-theme'); }catch(e){ return null; } })();
  var sys = matchMedia('(prefers-color-scheme:dark)').matches ? 'dark' : 'light';
  var current = stored || sys;
  html.setAttribute('data-theme', current);

  var MOON = '<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>';
  var SUN  = '<circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>';

  function applyIcons(t) {
    ['themeIcon','themeIconMobile'].forEach(function(id){
      var el = document.getElementById(id);
      if (el) el.innerHTML = t === 'dark' ? MOON : SUN;
    });
  }
  function setTheme(t) {
    html.setAttribute('data-theme', t);
    applyIcons(t);
    try { sessionStorage.setItem('pulse-theme', t); } catch(e){}
  }
  setTheme(current);

  ['themeToggle','themeToggleMobile'].forEach(function(id){
    var btn = document.getElementById(id);
    if (btn) btn.addEventListener('click', function(){
      setTheme(html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark');
    });
  });

  /* ── Password toggles ── */
  var EYE_OPEN = '<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>';
  var EYE_OFF  = '<path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/>';

  function makePwdToggle(btnId, inputId, iconId) {
    var btn = document.getElementById(btnId);
    var inp = document.getElementById(inputId);
    var ico = document.getElementById(iconId);
    if (!btn || !inp || !ico) return;
    btn.addEventListener('click', function(){
      var showing = inp.type === 'text';
      inp.type = showing ? 'password' : 'text';
      ico.innerHTML = showing ? EYE_OPEN : EYE_OFF;
      btn.setAttribute('aria-label', showing ? 'Mostrar senha' : 'Ocultar senha');
    });
  }
  makePwdToggle('pwdToggle1', 'pwd1', 'eyeIcon1');
  makePwdToggle('pwdToggle2', 'pwd2', 'eyeIcon2');

  /* ── Password strength — barra contínua + regras visuais ── */
  var pwdInput  = document.getElementById('pwd1');
  var fill      = document.getElementById('strengthFill');
  var lbl       = document.getElementById('strengthLabel');
  var ruleLen   = document.getElementById('rule-len');
  var ruleUpper = document.getElementById('rule-upper');
  var ruleNum   = document.getElementById('rule-num');
  var ruleSym   = document.getElementById('rule-sym');

  var CHECK_SVG  = '<svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>';
  var CIRCLE_SVG = '<svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/></svg>';

  function setRule(el, met, text) {
    if (!el) return;
    el.className = 'strength-rule' + (met ? ' met' : '');
    el.innerHTML = (met ? CHECK_SVG : CIRCLE_SVG) + ' ' + text;
  }

  var LEVELS = ['','Fraca','Razoável','Boa','Forte'];
  var WIDTHS  = ['0%','25%','50%','75%','100%'];

  if (pwdInput && fill) {
    pwdInput.addEventListener('input', function(){
      var v = this.value;
      var len   = v.length >= 8;
      var upper = /[A-Z]/.test(v);
      var num   = /[0-9]/.test(v);
      var sym   = /[^A-Za-z0-9]/.test(v);
      var score = (v.length > 0 ? 1 : 0) + (len?1:0) + (upper?1:0) + (num&&sym?1:0);
      score = Math.min(score, 4);

      fill.className = 'strength-fill' + (score > 0 ? ' s' + score : '');
      fill.style.width = WIDTHS[score];

      if (lbl) {
        lbl.textContent = score > 0 ? LEVELS[score] : '';
        lbl.className = 'strength-label' + (score > 0 ? ' s' + score : '');
      }

      setRule(ruleLen,   len,   '8+ chars');
      setRule(ruleUpper, upper, 'Maiúsc.');
      setRule(ruleNum,   num,   'Número');
      setRule(ruleSym,   sym,   'Símbolo');
    });
  }

  /* ── Confirm password match hint ── */
  var pwd2     = document.getElementById('pwd2');
  var matchHint = document.getElementById('matchHint');

  if (pwd2 && matchHint && pwdInput) {
    function checkMatch() {
      if (!pwd2.value) { matchHint.style.display = 'none'; return; }
      var ok = pwd2.value === pwdInput.value;
      matchHint.style.display = 'flex';
      matchHint.style.alignItems = 'center';
      matchHint.style.gap = '4px';
      matchHint.style.color = ok ? 'var(--success)' : 'var(--danger)';
      matchHint.innerHTML = ok
        ? CHECK_SVG + ' Senhas conferem'
        : CIRCLE_SVG + ' Senhas não conferem';
    }
    pwd2.addEventListener('input', checkMatch);
    if (pwdInput) pwdInput.addEventListener('input', checkMatch);
  }

  /* ── Submit loading state ── */
  var form      = document.getElementById('regForm');
  var submitBtn = document.getElementById('submitBtn');
  if (form && submitBtn) {
    form.addEventListener('submit', function(){
      submitBtn.classList.add('loading');
      submitBtn.disabled = true;
    });
  }

})();
</script>

</body>
</html>
{% endblock %}
