{% extends 'base.html.twig' %}

{% block title %}Criar conta — PulseSMM{% endblock %}

{% block auth_body %}
<!DOCTYPE html>
<html lang="pt-BR" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Criar conta — PulseSMM</title>

  <link rel="preconnect" href="https://api.fontshare.com">
  <link href="https://api.fontshare.com/v2/css?f[]=satoshi@300,400,500,600,700,800,900&display=swap" rel="stylesheet">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@1&display=swap" rel="stylesheet">

  <style>
    /* ═══════════════════════════════════════════════════════════════
       DESIGN TOKENS (mesmo sistema do login)
    ═══════════════════════════════════════════════════════════════ */
    :root, [data-theme="light"] {
      --bg:              #f2f0ec;
      --surface:         #fafaf8;
      --surface-2:       #ffffff;
      --surface-offset:  #ece9e4;
      --border:          oklch(0.2 0.005 80 / 0.09);
      --border-focus:    oklch(0.2 0.005 80 / 0.18);
      --divider:         oklch(0.2 0.005 80 / 0.07);
      --text:            #1c1a17;
      --text-muted:      #6e6c66;
      --text-faint:      #b0ada6;
      --text-inverse:    #faf9f7;
      --primary:         #016870;
      --primary-h:       #014e54;
      --primary-a:       #013638;
      --primary-lo:      oklch(0.48 0.08 192 / 0.10);
      --primary-glow:    oklch(0.48 0.08 192 / 0.28);
      --accent:          #e09c00;
      --accent-lo:       oklch(0.72 0.15 80 / 0.12);
      --danger:          #b8312a;
      --danger-lo:       oklch(0.45 0.18 25 / 0.10);
      --danger-border:   oklch(0.45 0.18 25 / 0.22);
      --success:         #3a7a1e;
      --success-lo:      oklch(0.50 0.14 145 / 0.10);
      --success-border:  oklch(0.50 0.14 145 / 0.22);
      --r-xs:4px; --r-sm:8px; --r-md:12px; --r-lg:16px; --r-xl:20px; --r-full:9999px;
      --s1:.25rem; --s2:.5rem; --s3:.75rem; --s4:1rem;
      --s5:1.25rem; --s6:1.5rem; --s8:2rem; --s10:2.5rem; --s12:3rem;
      --font-body:    'Satoshi', system-ui, sans-serif;
      --font-display: 'Instrument Serif', Georgia, serif;
      --t-xs:   clamp(0.75rem,  0.7rem  + 0.25vw, 0.875rem);
      --t-sm:   clamp(0.875rem, 0.82rem + 0.25vw, 1rem);
      --t-base: clamp(1rem,     0.95rem + 0.25vw, 1.125rem);
      --t-lg:   clamp(1.125rem, 1rem    + 0.6vw,  1.375rem);
      --t-xl:   clamp(1.5rem,   1.2rem  + 1.2vw,  2rem);
      --t-2xl:  clamp(2rem,     1.5rem  + 2vw,    2.75rem);
      --ease: cubic-bezier(0.16, 1, 0.3, 1);
      --dur: 180ms; --dur-slow: 320ms;
      --shadow-xs: 0 1px 2px oklch(0.2 0.01 80 / 0.05);
      --shadow-sm: 0 2px 6px oklch(0.2 0.01 80 / 0.07), 0 1px 2px oklch(0.2 0.01 80 / 0.04);
      --shadow-md: 0 6px 20px oklch(0.2 0.01 80 / 0.09), 0 2px 6px oklch(0.2 0.01 80 / 0.05);
      --shadow-primary: 0 4px 16px oklch(0.48 0.08 192 / 0.32);
      --shadow-primary-h: 0 8px 24px oklch(0.48 0.08 192 / 0.42);
      color-scheme: light;
    }

    [data-theme="dark"] {
      --bg:              #111010;
      --surface:         #181716;
      --surface-2:       #1e1d1c;
      --surface-offset:  #161514;
      --border:          oklch(1 0 0 / 0.07);
      --border-focus:    oklch(1 0 0 / 0.14);
      --divider:         oklch(1 0 0 / 0.06);
      --text:            #d6d4cf;
      --text-muted:      #7a7874;
      --text-faint:      #4e4c49;
      --text-inverse:    #1a1917;
      --primary:         #4ca3aa;
      --primary-h:       #3a8f96;
      --primary-a:       #2e747a;
      --primary-lo:      oklch(0.66 0.07 192 / 0.12);
      --primary-glow:    oklch(0.66 0.07 192 / 0.24);
      --accent:          #f5b82e;
      --accent-lo:       oklch(0.82 0.15 80 / 0.14);
      --danger:          #e0604f;
      --danger-lo:       oklch(0.60 0.18 25 / 0.12);
      --danger-border:   oklch(0.60 0.18 25 / 0.24);
      --success:         #6aaa42;
      --success-lo:      oklch(0.66 0.14 145 / 0.12);
      --success-border:  oklch(0.66 0.14 145 / 0.24);
      --shadow-xs: 0 1px 2px oklch(0 0 0 / 0.20);
      --shadow-sm: 0 2px 6px oklch(0 0 0 / 0.22), 0 1px 2px oklch(0 0 0 / 0.14);
      --shadow-md: 0 6px 20px oklch(0 0 0 / 0.32), 0 2px 6px oklch(0 0 0 / 0.18);
      --shadow-primary: 0 4px 16px oklch(0.66 0.07 192 / 0.28);
      --shadow-primary-h: 0 8px 24px oklch(0.66 0.07 192 / 0.38);
      color-scheme: dark;
    }

    @media (prefers-color-scheme: dark) {
      :root:not([data-theme]) {
        --bg:#111010;--surface:#181716;--surface-2:#1e1d1c;--surface-offset:#161514;
        --border:oklch(1 0 0/0.07);--border-focus:oklch(1 0 0/0.14);--divider:oklch(1 0 0/0.06);
        --text:#d6d4cf;--text-muted:#7a7874;--text-faint:#4e4c49;--text-inverse:#1a1917;
        --primary:#4ca3aa;--primary-h:#3a8f96;--primary-a:#2e747a;
        --primary-lo:oklch(0.66 0.07 192/0.12);--primary-glow:oklch(0.66 0.07 192/0.24);
        --accent:#f5b82e;--accent-lo:oklch(0.82 0.15 80/0.14);
        --danger:#e0604f;--danger-lo:oklch(0.60 0.18 25/0.12);--danger-border:oklch(0.60 0.18 25/0.24);
        --success:#6aaa42;--success-lo:oklch(0.66 0.14 145/0.12);--success-border:oklch(0.66 0.14 145/0.24);
        --shadow-sm:0 2px 6px oklch(0 0 0/0.22),0 1px 2px oklch(0 0 0/0.14);
        --shadow-md:0 6px 20px oklch(0 0 0/0.32),0 2px 6px oklch(0 0 0/0.18);
        --shadow-primary:0 4px 16px oklch(0.66 0.07 192/0.28);
        --shadow-primary-h:0 8px 24px oklch(0.66 0.07 192/0.38);
        color-scheme:dark;
      }
    }

    /* ════════ RESET + BASE ════════ */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html {
      font-family: var(--font-body);
      font-size: 16px;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      text-rendering: optimizeLegibility;
      background: var(--bg);
      color: var(--text);
    }
    body {
      min-height: 100dvh;
      background: var(--bg);
      color: var(--text);
      transition: background var(--dur-slow) var(--ease), color var(--dur-slow) var(--ease);
    }
    img { display: block; max-width: 100%; }
    button { cursor: pointer; border: none; background: none; font: inherit; color: inherit; }
    a { color: var(--primary); text-decoration: none; transition: opacity var(--dur) var(--ease); }
    a:hover { opacity: .8; }
    :focus-visible { outline: 2px solid var(--primary); outline-offset: 3px; border-radius: var(--r-xs); }
    ::selection { background: var(--primary-lo); color: var(--text); }
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { animation-duration: 0.01ms !important; transition-duration: 0.01ms !important; }
    }

    /* ════════ LAYOUT SHELL ════════ */
    .auth-shell {
      display: flex;
      flex-direction: column;
      min-height: 100dvh;
    }
    @media (min-width: 900px) {
      .auth-shell { display: grid; grid-template-columns: 1fr 1fr; }
    }
    @media (min-width: 1200px) {
      .auth-shell { grid-template-columns: 1.15fr 1fr; }
    }

    /* ════════ MOBILE TOPBAR ════════ */
    .mobile-topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: var(--s4) var(--s5);
      background: var(--surface);
      border-bottom: 1px solid var(--border);
      position: sticky;
      top: 0;
      z-index: 10;
    }
    @media (min-width: 900px) { .mobile-topbar { display: none; } }
    .topbar-brand {
      display: flex; align-items: center; gap: var(--s2); text-decoration: none;
    }
    .topbar-brand__icon {
      width: 32px; height: 32px; border-radius: var(--r-sm);
      background: var(--primary); display: flex; align-items: center; justify-content: center;
      flex-shrink: 0;
    }
    .topbar-brand__name {
      font-size: 1rem; font-weight: 800; color: var(--text); letter-spacing: -.02em;
    }
    .topbar-brand__name em { color: var(--primary); font-style: normal; }
    .theme-btn-sm {
      width: 38px; height: 38px; border-radius: var(--r-full);
      background: var(--surface-2); border: 1px solid var(--border);
      display: flex; align-items: center; justify-content: center;
      color: var(--text-muted); box-shadow: var(--shadow-xs);
      transition: color var(--dur) var(--ease), transform var(--dur) var(--ease);
    }
    .theme-btn-sm:hover { color: var(--text); transform: rotate(15deg); }

    /* ════════ LEFT PANEL — hero ════════ */
    .hero-panel {
      display: none;
      position: relative;
      background: var(--primary);
      overflow: hidden;
      color: #fff;
      padding: var(--s10) var(--s12);
      flex-direction: column;
      justify-content: space-between;
      gap: var(--s10);
    }
    @media (min-width: 900px) { .hero-panel { display: flex; } }

    .hero-panel::before {
      content: '';
      position: absolute; inset: 0;
      background-image:
        linear-gradient(rgba(255,255,255,.04) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255,255,255,.04) 1px, transparent 1px);
      background-size: 44px 44px;
      pointer-events: none; z-index: 0;
    }
    .hero-panel::after {
      content: '';
      position: absolute; inset: 0;
      background:
        radial-gradient(ellipse 70% 50% at 15% 25%, rgba(255,255,255,.13) 0%, transparent 60%),
        radial-gradient(ellipse 50% 70% at 85% 80%, rgba(0,0,0,.18) 0%, transparent 55%);
      pointer-events: none; z-index: 0;
    }
    .hero-orb {
      position: absolute; width: 480px; height: 480px; border-radius: 50%;
      background: radial-gradient(circle, rgba(255,255,255,.10) 0%, transparent 70%);
      top: -120px; right: -120px;
      animation: orb-drift 10s ease-in-out infinite; pointer-events: none; z-index: 0;
    }
    .hero-orb-2 {
      position: absolute; width: 300px; height: 300px; border-radius: 50%;
      background: radial-gradient(circle, rgba(255,255,255,.07) 0%, transparent 70%);
      bottom: 80px; left: -80px;
      animation: orb-drift 14s ease-in-out infinite reverse; pointer-events: none; z-index: 0;
    }
    @keyframes orb-drift {
      0%,100%{transform:translate(0,0) scale(1)} 33%{transform:translate(-24px,18px) scale(1.06)} 66%{transform:translate(12px,-20px) scale(.96)}
    }
    .hero-content {
      position: relative; z-index: 1;
      display: flex; flex-direction: column; gap: var(--s10); flex: 1;
    }
    .hero-brand { display: flex; align-items: center; gap: var(--s3); }
    .hero-brand__icon {
      width: 46px; height: 46px; border-radius: var(--r-md);
      background: rgba(255,255,255,.16); border: 1px solid rgba(255,255,255,.24);
      backdrop-filter: blur(8px); display: flex; align-items: center; justify-content: center;
      flex-shrink: 0; box-shadow: 0 2px 8px rgba(0,0,0,.12);
    }
    .hero-brand__name { font-size: var(--t-lg); font-weight: 800; letter-spacing: -.025em; color: #fff; }
    .hero-brand__name em { font-style: normal; opacity: .72; }
    .hero-status {
      display: inline-flex; align-items: center; gap: var(--s2);
      background: rgba(255,255,255,.12); backdrop-filter: blur(10px);
      border: 1px solid rgba(255,255,255,.18); border-radius: var(--r-full);
      padding: var(--s1) var(--s4); font-size: var(--t-xs); font-weight: 600;
      letter-spacing: .05em; text-transform: uppercase; color: rgba(255,255,255,.9); width: fit-content;
    }
    .hero-status__dot {
      width: 6px; height: 6px; border-radius: 50%;
      background: var(--accent); box-shadow: 0 0 8px var(--accent);
      animation: pulse-dot 2.4s ease-in-out infinite;
    }
    @keyframes pulse-dot { 0%,100%{transform:scale(1);opacity:1} 50%{transform:scale(1.3);opacity:.7} }
    .hero-headline {
      font-family: var(--font-display);
      font-size: var(--t-2xl); font-weight: 400; font-style: italic;
      line-height: 1.12; letter-spacing: -.02em; color: #fff;
    }
    .hero-headline strong {
      font-style: normal; font-weight: 800; color: var(--accent);
      font-family: var(--font-body); font-size: .75em;
      display: block; letter-spacing: -.03em;
    }
    .hero-desc {
      font-size: var(--t-sm); line-height: 1.75; color: rgba(255,255,255,.7); max-width: 42ch;
    }

    /* Steps timeline */
    .hero-steps { display: flex; flex-direction: column; gap: var(--s4); }
    .hero-step {
      display: flex; align-items: flex-start; gap: var(--s4);
      font-size: var(--t-sm); color: rgba(255,255,255,.85);
    }
    .hero-step__num {
      width: 28px; height: 28px; border-radius: 50%; flex-shrink: 0;
      background: rgba(255,255,255,.15); border: 1.5px solid rgba(255,255,255,.25);
      display: flex; align-items: center; justify-content: center;
      font-size: .7rem; font-weight: 800; color: #fff;
      margin-top: 1px;
    }
    .hero-step__text strong { display: block; font-weight: 700; margin-bottom: 1px; }
    .hero-step__text span { color: rgba(255,255,255,.62); font-size: .8rem; }

    /* Benefit cards */
    .hero-benefits {
      display: grid; grid-template-columns: 1fr 1fr; gap: var(--s3);
      position: relative; z-index: 1;
    }
    .benefit-card {
      background: rgba(255,255,255,.10); backdrop-filter: blur(14px);
      border: 1px solid rgba(255,255,255,.16); border-radius: var(--r-md);
      padding: var(--s4);
      transition: background var(--dur) var(--ease);
    }
    .benefit-card:hover { background: rgba(255,255,255,.15); }
    .benefit-card__icon {
      width: 32px; height: 32px; border-radius: var(--r-sm);
      background: rgba(255,255,255,.14); display: flex; align-items: center; justify-content: center;
      margin-bottom: var(--s3); color: rgba(255,255,255,.9);
    }
    .benefit-card__title { font-size: .85rem; font-weight: 700; color: #fff; margin-bottom: var(--s1); }
    .benefit-card__sub { font-size: .72rem; color: rgba(255,255,255,.58); line-height: 1.5; }

    /* Bottom quote */
    .hero-quote {
      background: rgba(255,255,255,.08); backdrop-filter: blur(10px);
      border: 1px solid rgba(255,255,255,.12); border-radius: var(--r-lg);
      padding: var(--s5) var(--s6); position: relative; z-index: 1;
    }
    .hero-quote__text {
      font-size: var(--t-sm); line-height: 1.65; color: rgba(255,255,255,.82);
      font-style: italic; margin-bottom: var(--s3);
    }
    .hero-quote__author {
      display: flex; align-items: center; gap: var(--s2);
      font-size: .75rem; color: rgba(255,255,255,.6);
    }
    .hero-quote__avatar {
      width: 28px; height: 28px; border-radius: 50%;
      background: rgba(255,255,255,.2); display: flex; align-items: center; justify-content: center;
      font-size: .65rem; font-weight: 700; color: #fff; flex-shrink: 0;
    }
    .hero-quote__stars { color: var(--accent); font-size: .7rem; letter-spacing: 1px; margin-bottom: var(--s2); }

    /* ════════ RIGHT PANEL — form ════════ */
    .form-panel {
      flex: 1; display: flex; flex-direction: column;
      align-items: center; justify-content: flex-start;
      padding: var(--s8) var(--s4) var(--s12);
      background: var(--bg);
      transition: background var(--dur-slow) var(--ease);
    }
    @media (min-width: 640px) { .form-panel { padding: var(--s10) var(--s8) var(--s12); } }
    @media (min-width: 900px) { .form-panel { justify-content: center; } }

    .theme-btn {
      display: none;
      position: absolute; top: var(--s5); right: var(--s5);
      width: 40px; height: 40px; border-radius: var(--r-full);
      background: var(--surface-2); border: 1px solid var(--border);
      align-items: center; justify-content: center;
      color: var(--text-muted); box-shadow: var(--shadow-xs);
      transition: color var(--dur) var(--ease), transform var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
    }
    @media (min-width: 900px) { .theme-btn { display: flex; } }
    .theme-btn:hover { color: var(--text); transform: rotate(15deg); box-shadow: var(--shadow-md); }

    .form-wrap { width: 100%; max-width: 440px; }

    /* Header */
    .form-header { margin-bottom: var(--s6); }
    .form-eyebrow {
      display: inline-flex; align-items: center; gap: var(--s2);
      background: var(--primary-lo); border: 1px solid oklch(0.48 0.08 192 / 0.15);
      border-radius: var(--r-full); padding: var(--s1) var(--s3);
      font-size: var(--t-xs); font-weight: 600; color: var(--primary);
      letter-spacing: .04em; text-transform: uppercase; margin-bottom: var(--s4);
    }
    [data-theme="dark"] .form-eyebrow { border-color: oklch(0.66 0.07 192 / 0.18); }
    .form-heading {
      font-size: var(--t-xl); font-weight: 800; letter-spacing: -.03em;
      color: var(--text); line-height: 1.15; margin-bottom: var(--s2);
    }
    .form-sub { font-size: var(--t-sm); color: var(--text-muted); line-height: 1.65; }

    /* Progress indicator */
    .progress-bar {
      display: flex; align-items: center; gap: var(--s2);
      margin-bottom: var(--s6);
    }
    .progress-step {
      display: flex; align-items: center; gap: var(--s2);
      font-size: var(--t-xs); color: var(--text-faint);
    }
    .progress-step.active { color: var(--primary); }
    .progress-step.done { color: var(--success); }
    .progress-step__dot {
      width: 24px; height: 24px; border-radius: 50%;
      background: var(--surface-offset); border: 1.5px solid var(--border);
      display: flex; align-items: center; justify-content: center;
      font-size: .65rem; font-weight: 700; flex-shrink: 0;
      transition: background var(--dur) var(--ease), border-color var(--dur) var(--ease);
    }
    .progress-step.active .progress-step__dot {
      background: var(--primary-lo); border-color: var(--primary); color: var(--primary);
    }
    .progress-step.done .progress-step__dot {
      background: var(--success-lo); border-color: var(--success); color: var(--success);
    }
    .progress-line {
      flex: 1; height: 1.5px; background: var(--divider); border-radius: 99px;
    }

    /* Alerts */
    .alert {
      display: flex; align-items: flex-start; gap: var(--s3);
      padding: var(--s3) var(--s4); border-radius: var(--r-md);
      font-size: var(--t-sm); margin-bottom: var(--s5);
      animation: slide-down .28s var(--ease);
    }
    .alert--error { background: var(--danger-lo); border: 1px solid var(--danger-border); color: var(--danger); }
    .alert--success { background: var(--success-lo); border: 1px solid var(--success-border); color: var(--success); }
    .alert__icon { flex-shrink: 0; margin-top: 1px; }
    @keyframes slide-down { from{opacity:0;transform:translateY(-8px)} to{opacity:1;transform:none} }

    /* Fields */
    .fields { display: flex; flex-direction: column; gap: var(--s4); margin-bottom: var(--s4); }
    .fields-row {
      display: grid; grid-template-columns: 1fr; gap: var(--s4);
    }
    @media (min-width: 480px) { .fields-row { grid-template-columns: 1fr 1fr; } }

    .field { display: flex; flex-direction: column; gap: var(--s2); }
    .field-label-row {
      display: flex; align-items: center; justify-content: space-between; gap: var(--s2);
    }
    .field-label {
      font-size: .8rem; font-weight: 600;
      color: var(--text-muted); letter-spacing: .04em; text-transform: uppercase;
    }
    .field-hint { font-size: .72rem; color: var(--text-faint); }
    .input-wrap { position: relative; display: flex; align-items: center; }
    .input-icon {
      position: absolute; left: var(--s4); color: var(--text-faint);
      pointer-events: none; transition: color var(--dur) var(--ease); display: flex;
    }
    .control {
      width: 100%;
      padding: var(--s4) var(--s4) var(--s4) calc(var(--s4) + 16px + var(--s3));
      background: var(--surface-2); border: 1.5px solid var(--border);
      border-radius: var(--r-md); font-family: var(--font-body);
      font-size: var(--t-base); color: var(--text);
      transition: border-color var(--dur) var(--ease), box-shadow var(--dur) var(--ease), background var(--dur) var(--ease);
      -webkit-appearance: none; appearance: none;
    }
    .control.no-icon { padding-left: var(--s4); }
    .control::placeholder { color: var(--text-faint); }
    .control:hover:not(:focus) { border-color: var(--border-focus); }
    .control:focus {
      outline: none; border-color: var(--primary);
      box-shadow: 0 0 0 3px var(--primary-lo);
    }
    .control.error { border-color: var(--danger); box-shadow: 0 0 0 3px var(--danger-lo); }
    .input-wrap:focus-within .input-icon { color: var(--primary); }
    @media (max-width: 640px) { .control { font-size: 16px; } }

    /* Password strength */
    .pwd-toggle {
      position: absolute; right: var(--s3);
      width: 32px; height: 32px; border-radius: var(--r-sm);
      display: flex; align-items: center; justify-content: center;
      color: var(--text-faint);
      transition: color var(--dur) var(--ease), background var(--dur) var(--ease);
    }
    .pwd-toggle:hover { color: var(--text-muted); background: var(--surface-offset); }

    .strength-bar { display: flex; gap: 3px; margin-top: var(--s2); }
    .strength-seg {
      flex: 1; height: 3px; border-radius: 99px;
      background: var(--surface-offset);
      transition: background var(--dur) var(--ease);
    }
    .strength-seg.weak    { background: var(--danger); }
    .strength-seg.fair    { background: var(--accent); }
    .strength-seg.good    { background: oklch(0.62 0.14 145); }
    .strength-seg.strong  { background: var(--success); }
    .strength-label {
      font-size: .7rem; font-weight: 500; margin-top: 3px;
      transition: color var(--dur) var(--ease);
    }
    .strength-label.weak    { color: var(--danger); }
    .strength-label.fair    { color: var(--accent); }
    .strength-label.good    { color: oklch(0.55 0.12 145); }
    .strength-label.strong  { color: var(--success); }
    [data-theme="dark"] .strength-label.good { color: oklch(0.70 0.14 145); }

    /* Field errors */
    .field-error {
      font-size: .78rem; color: var(--danger);
      display: flex; align-items: center; gap: var(--s1); margin-top: 1px;
    }
    .field-error svg { flex-shrink: 0; }

    /* Terms checkbox */
    .terms-field {
      display: flex; align-items: flex-start; gap: var(--s3);
      padding: var(--s4); background: var(--surface-2);
      border: 1.5px solid var(--border); border-radius: var(--r-md);
      cursor: pointer;
      transition: border-color var(--dur) var(--ease), background var(--dur) var(--ease);
    }
    .terms-field:has(input:checked) {
      border-color: oklch(0.48 0.08 192 / 0.30);
      background: var(--primary-lo);
    }
    [data-theme="dark"] .terms-field:has(input:checked) { border-color: oklch(0.66 0.07 192 / 0.30); }
    .terms-checkbox {
      appearance: none; -webkit-appearance: none;
      width: 18px; height: 18px; border-radius: 5px;
      border: 1.5px solid var(--border-focus); background: var(--surface-2);
      cursor: pointer; flex-shrink: 0; margin-top: 1px;
      transition: background var(--dur) var(--ease), border-color var(--dur) var(--ease);
      position: relative;
    }
    .terms-checkbox:checked { background: var(--primary); border-color: var(--primary); }
    .terms-checkbox:checked::after {
      content: ''; position: absolute; left: 3px; top: 1px;
      width: 10px; height: 6px; border: 2px solid #fff;
      border-top: none; border-right: none; transform: rotate(-45deg);
    }
    .terms-checkbox:focus-visible { outline: 2px solid var(--primary); outline-offset: 2px; }
    .terms-text { font-size: var(--t-sm); color: var(--text-muted); line-height: 1.55; }
    .terms-text a { font-weight: 600; }

    /* Submit button */
    .btn-submit {
      width: 100%; padding: var(--s4) var(--s6);
      background: var(--primary); color: #fff;
      border-radius: var(--r-md); font-family: var(--font-body);
      font-size: var(--t-base); font-weight: 700; letter-spacing: -.01em;
      border: none; cursor: pointer; min-height: 52px;
      box-shadow: var(--shadow-primary);
      transition: background var(--dur) var(--ease), box-shadow var(--dur) var(--ease), transform var(--dur) var(--ease);
      display: flex; align-items: center; justify-content: center; gap: var(--s2);
      position: relative; overflow: hidden;
    }
    .btn-submit::before {
      content: ''; position: absolute; inset: 0;
      background: linear-gradient(105deg, transparent 40%, rgba(255,255,255,.14) 50%, transparent 60%);
      transform: translateX(-100%);
      transition: transform .6s var(--ease);
    }
    .btn-submit:hover {
      background: var(--primary-h); box-shadow: var(--shadow-primary-h);
      transform: translateY(-1px);
    }
    .btn-submit:hover::before { transform: translateX(100%); }
    .btn-submit:active { transform: translateY(0) scale(.99); }
    .btn-submit .btn-arrow { transition: transform var(--dur) var(--ease); }
    .btn-submit:hover .btn-arrow { transform: translateX(4px); }

    /* Divider */
    .divider {
      display: flex; align-items: center; gap: var(--s3);
      margin: var(--s6) 0; color: var(--text-faint);
      font-size: var(--t-xs); letter-spacing: .06em; text-transform: uppercase;
    }
    .divider::before, .divider::after {
      content: ''; flex: 1; height: 1px; background: var(--divider);
    }

    /* Login link */
    .login-row { text-align: center; font-size: var(--t-sm); color: var(--text-muted); }
    .login-row a { color: var(--primary); font-weight: 600; }

    /* Mini trust */
    .trust-row {
      display: flex; align-items: center; justify-content: center;
      gap: var(--s5); margin-top: var(--s6); flex-wrap: wrap;
    }
    .trust-item {
      display: flex; align-items: center; gap: var(--s1);
      font-size: .7rem; color: var(--text-faint); font-weight: 500;
    }

    /* Entry animations */
    @keyframes fade-up {
      from { opacity: 0; transform: translateY(14px); }
      to   { opacity: 1; transform: none; }
    }
    .form-wrap > * { animation: fade-up var(--dur-slow) var(--ease) both; }
    .form-wrap > *:nth-child(1){animation-delay:0ms}
    .form-wrap > *:nth-child(2){animation-delay:40ms}
    .form-wrap > *:nth-child(3){animation-delay:80ms}
    .form-wrap > *:nth-child(4){animation-delay:120ms}
    .form-wrap > *:nth-child(5){animation-delay:160ms}
    .form-wrap > *:nth-child(6){animation-delay:200ms}
    .form-wrap > *:nth-child(7){animation-delay:240ms}
    .form-wrap > *:nth-child(8){animation-delay:280ms}

    .hero-content > * { animation: fade-up var(--dur-slow) var(--ease) both; }
    .hero-content > *:nth-child(1){animation-delay:100ms}
    .hero-content > *:nth-child(2){animation-delay:180ms}
    .hero-content > *:nth-child(3){animation-delay:260ms}
    .hero-content > *:nth-child(4){animation-delay:340ms}
    .hero-benefits{animation:fade-up var(--dur-slow) var(--ease) 420ms both}
    .hero-quote{animation:fade-up var(--dur-slow) var(--ease) 500ms both}
  </style>
</head>
<body>

<!-- Mobile topbar -->
<header class="mobile-topbar">
  <a href="/" class="topbar-brand">
    <div class="topbar-brand__icon">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
      </svg>
    </div>
    <span class="topbar-brand__name"><em>Pulse</em>SMM</span>
  </a>
  <button class="theme-btn-sm" id="themeToggleMobile" aria-label="Alternar tema">
    <svg id="themeIconMobile" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="5"/>
      <line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/>
      <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
      <line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/>
      <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
    </svg>
  </button>
</header>

<div class="auth-shell">

  {# ═════ LEFT HERO PANEL ═════ #}
  <aside class="hero-panel" aria-hidden="true">
    <div class="hero-orb"></div>
    <div class="hero-orb-2"></div>

    <div class="hero-content">

      <div class="hero-brand">
        <div class="hero-brand__icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
          </svg>
        </div>
        <span class="hero-brand__name"><em>Pulse</em>SMM</span>
      </div>

      <div>
        <div class="hero-status">
          <span class="hero-status__dot"></span>
          Cadastro grátis e imediato
        </div>
      </div>

      <div>
        <h1 class="hero-headline">
          Comece hoje e<br>cresça mais rápido
          <strong>Resultados reais.</strong>
        </h1>
        <p class="hero-desc">
          Crie sua conta em menos de 2 minutos e tenha acesso a centenas de serviços para todas as redes sociais.
        </p>
      </div>

      <div class="hero-steps">
        <div class="hero-step">
          <div class="hero-step__num">1</div>
          <div class="hero-step__text">
            <strong>Crie sua conta</strong>
            <span>Preencha os dados básicos em segundos</span>
          </div>
        </div>
        <div class="hero-step">
          <div class="hero-step__num">2</div>
          <div class="hero-step__text">
            <strong>Adicione créditos</strong>
            <span>Pix, cartão, boleto e mais opções</span>
          </div>
        </div>
        <div class="hero-step">
          <div class="hero-step__num">3</div>
          <div class="hero-step__text">
            <strong>Faça seu primeiro pedido</strong>
            <span>Entrega automática, começa em minutos</span>
          </div>
        </div>
      </div>

    </div>

    <div class="hero-benefits">
      <div class="benefit-card">
        <div class="benefit-card__icon">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          </svg>
        </div>
        <div class="benefit-card__title">100% Seguro</div>
        <div class="benefit-card__sub">Dados criptografados e pagamentos protegidos</div>
      </div>
      <div class="benefit-card">
        <div class="benefit-card__icon">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10"/>
            <polyline points="12 6 12 12 16 14"/>
          </svg>
        </div>
        <div class="benefit-card__title">Entrega Rápida</div>
        <div class="benefit-card__sub">Início em minutos após confirmação</div>
      </div>
      <div class="benefit-card">
        <div class="benefit-card__icon">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07"/>
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.62 3.32a2 2 0 0 1 2-2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.86A16 16 0 0 0 16 16.95l.95-.95a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
          </svg>
        </div>
        <div class="benefit-card__title">Suporte 24/7</div>
        <div class="benefit-card__sub">Time pronto para te ajudar a qualquer hora</div>
      </div>
      <div class="benefit-card">
        <div class="benefit-card__icon">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
        </div>
        <div class="benefit-card__title">Garantia</div>
        <div class="benefit-card__sub">Reembolso garantido em 30 dias sem perguntas</div>
      </div>
    </div>

    <div class="hero-quote">
      <div class="hero-quote__stars">★★★★★</div>
      <p class="hero-quote__text">"É o melhor painel que já usei. Os resultados chegam bem mais rápido que o esperado e o suporte é incrível."</p>
      <div class="hero-quote__author">
        <div class="hero-quote__avatar">CF</div>
        <span>Carla F. — Influenciadora digital</span>
      </div>
    </div>

  </aside>

  {# ═════ RIGHT FORM PANEL ═════ #}
  <main class="form-panel">

    <button class="theme-btn" id="themeToggle" aria-label="Alternar tema claro/escuro">
      <svg id="themeIcon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="5"/>
        <line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/>
        <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
        <line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/>
        <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
      </svg>
    </button>

    <div class="form-wrap">

      {# Header #}
      <header class="form-header">
        <div class="form-eyebrow">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
          </svg>
          Cadastro gratuito
        </div>
        <h1 class="form-heading">Criar sua conta</h1>
        <p class="form-sub">Preencha os dados abaixo. Leva menos de 2 minutos.</p>
      </header>

      {# Progress indicator #}
      <div class="progress-bar" aria-label="Etapa 1 de 2">
        <div class="progress-step active">
          <div class="progress-step__dot">1</div>
          <span>Dados</span>
        </div>
        <div class="progress-line"></div>
        <div class="progress-step">
          <div class="progress-step__dot">2</div>
          <span>Confirmar</span>
        </div>
      </div>

      {# Flash messages #}
      {% for msg in app.flashes('success') %}
        <div class="alert alert--success" role="alert">
          <svg class="alert__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
            <polyline points="22 4 12 14.01 9 11.01"/>
          </svg>
          <span>{{ msg }}</span>
        </div>
      {% endfor %}

      {% for msg in app.flashes('error') %}
        <div class="alert alert--error" role="alert">
          <svg class="alert__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10"/>
            <line x1="12" y1="8" x2="12" y2="12"/>
            <line x1="12" y1="16" x2="12.01" y2="16"/>
          </svg>
          <span>{{ msg }}</span>
        </div>
      {% endfor %}

      {# Registration form #}
      {{ form_start(registrationForm, {attr: {class: 'reg-form', novalidate: 'novalidate', id: 'regForm'}}) }}

        <div class="fields">

          {# Name #}
          <div class="field">
            <div class="field-label-row">
              <label class="field-label" for="{{ registrationForm.name.vars.id }}">Nome completo</label>
            </div>
            <div class="input-wrap">
              <span class="input-icon">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                  <circle cx="12" cy="7" r="4"/>
                </svg>
              </span>
              {{ form_widget(registrationForm.name, {attr: {class: 'control', placeholder: 'Seu nome completo', autocomplete: 'name'}}) }}
            </div>
            {% if registrationForm.name.vars.errors|length > 0 %}
              <div class="field-error" role="alert">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                {{ form_errors(registrationForm.name) }}
              </div>
            {% endif %}
          </div>

          {# Email #}
          <div class="field">
            <div class="field-label-row">
              <label class="field-label" for="{{ registrationForm.email.vars.id }}">E-mail</label>
            </div>
            <div class="input-wrap">
              <span class="input-icon">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                  <polyline points="22,6 12,13 2,6"/>
                </svg>
              </span>
              {{ form_widget(registrationForm.email, {attr: {class: 'control', placeholder: 'seu@email.com.br', autocomplete: 'email'}}) }}
            </div>
            {% if registrationForm.email.vars.errors|length > 0 %}
              <div class="field-error" role="alert">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                {{ form_errors(registrationForm.email) }}
              </div>
            {% endif %}
          </div>

          {# Password #}
          <div class="field">
            <div class="field-label-row">
              <label class="field-label" for="{{ registrationForm.plainPassword.first.vars.id }}">Senha</label>
              <span class="field-hint">Mínimo 8 caracteres</span>
            </div>
            <div class="input-wrap">
              <span class="input-icon">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                  <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                </svg>
              </span>
              {{ form_widget(registrationForm.plainPassword.first, {attr: {class: 'control', placeholder: '••••••••', autocomplete: 'new-password', id: 'pwd1', style: 'padding-right:3rem'}}) }}
              <button type="button" class="pwd-toggle" id="pwdToggle1" aria-label="Mostrar senha">
                <svg id="eyeIcon1" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                  <circle cx="12" cy="12" r="3"/>
                </svg>
              </button>
            </div>
            <div class="strength-bar" id="strengthBar" aria-hidden="true">
              <div class="strength-seg" id="seg1"></div>
              <div class="strength-seg" id="seg2"></div>
              <div class="strength-seg" id="seg3"></div>
              <div class="strength-seg" id="seg4"></div>
            </div>
            <div class="strength-label" id="strengthLabel" aria-live="polite"></div>
            {% if registrationForm.plainPassword.first.vars.errors|length > 0 %}
              <div class="field-error" role="alert">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                {{ form_errors(registrationForm.plainPassword.first) }}
              </div>
            {% endif %}
          </div>

          {# Confirm password #}
          <div class="field">
            <div class="field-label-row">
              <label class="field-label" for="{{ registrationForm.plainPassword.second.vars.id }}">Confirmar senha</label>
            </div>
            <div class="input-wrap">
              <span class="input-icon">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="9 11 12 14 22 4"/>
                  <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>
                </svg>
              </span>
              {{ form_widget(registrationForm.plainPassword.second, {attr: {class: 'control', placeholder: 'Repita a senha', autocomplete: 'new-password', id: 'pwd2', style: 'padding-right:3rem'}}) }}
              <button type="button" class="pwd-toggle" id="pwdToggle2" aria-label="Mostrar confirmação de senha">
                <svg id="eyeIcon2" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                  <circle cx="12" cy="12" r="3"/>
                </svg>
              </button>
            </div>
            {% if registrationForm.plainPassword.second.vars.errors|length > 0 %}
              <div class="field-error" role="alert">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                {{ form_errors(registrationForm.plainPassword.second) }}
              </div>
            {% endif %}
          </div>

          {# Terms #}
          <label class="terms-field">
            {{ form_widget(registrationForm.agreeTerms, {attr: {class: 'terms-checkbox', id: 'agreeTerms'}}) }}
            <span class="terms-text">
              Li e aceito os
              <a href="/termos" target="_blank" rel="noopener">termos de uso</a>
              e a
              <a href="/privacidade" target="_blank" rel="noopener">política de privacidade</a>
              do PulseSMM
            </span>
          </label>
          {% if registrationForm.agreeTerms.vars.errors|length > 0 %}
            <div class="field-error" role="alert">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
              {{ form_errors(registrationForm.agreeTerms) }}
            </div>
          {% endif %}

        </div>

        <button type="submit" class="btn-submit">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
            <circle cx="9" cy="7" r="4"/>
            <line x1="19" y1="8" x2="19" y2="14"/>
            <line x1="22" y1="11" x2="16" y2="11"/>
          </svg>
          Criar minha conta
          <svg class="btn-arrow" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"/>
            <polyline points="12 5 19 12 12 19"/>
          </svg>
        </button>

      {{ form_end(registrationForm) }}

      <div class="divider" aria-hidden="true">ou</div>

      <p class="login-row">
        Já tem uma conta?
        <a href="{{ path('app_login') }}">Entrar agora →</a>
      </p>

      <div class="trust-row">
        <div class="trust-item">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          </svg>
          Dados seguros
        </div>
        <div class="trust-item">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="11" width="18" height="11" rx="2"/>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
          </svg>
          Sem spam
        </div>
        <div class="trust-item">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
          Grátis pra sempre
        </div>
      </div>

    </div>
  </main>

</div>

<script>
(function () {
  'use strict';

  /* ── Theme ── */
  var html    = document.documentElement;
  var stored  = (function(){ try{ return sessionStorage.getItem('pulse-theme'); }catch(e){ return null; } })();
  var sys     = matchMedia('(prefers-color-scheme:dark)').matches ? 'dark' : 'light';
  var current = stored || sys;
  html.setAttribute('data-theme', current);

  var MOON = '<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>';
  var SUN  = '<circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>';

  function applyIcons(t) {
    ['themeIcon','themeIconMobile'].forEach(function(id){
      var el = document.getElementById(id);
      if (el) el.innerHTML = t === 'dark' ? MOON : SUN;
    });
  }

  function setTheme(t) {
    html.setAttribute('data-theme', t);
    applyIcons(t);
    try { sessionStorage.setItem('pulse-theme', t); } catch(e){}
  }

  setTheme(current);

  ['themeToggle','themeToggleMobile'].forEach(function(id){
    var btn = document.getElementById(id);
    if (btn) btn.addEventListener('click', function(){
      setTheme(html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark');
    });
  });

  /* ── Password toggles ── */
  var EYE_OPEN = '<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>';
  var EYE_OFF  = '<path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/>';

  function makePwdToggle(btnId, inputId, iconId) {
    var btn   = document.getElementById(btnId);
    var input = document.getElementById(inputId);
    var icon  = document.getElementById(iconId);
    if (!btn || !input || !icon) return;
    btn.addEventListener('click', function(){
      var showing = input.type === 'text';
      input.type = showing ? 'password' : 'text';
      icon.innerHTML = showing ? EYE_OPEN : EYE_OFF;
      btn.setAttribute('aria-label', showing ? 'Mostrar senha' : 'Ocultar senha');
    });
  }

  makePwdToggle('pwdToggle1', 'pwd1', 'eyeIcon1');
  makePwdToggle('pwdToggle2', 'pwd2', 'eyeIcon2');

  /* ── Password strength meter ── */
  var pwdInput    = document.getElementById('pwd1');
  var segs        = [document.getElementById('seg1'), document.getElementById('seg2'), document.getElementById('seg3'), document.getElementById('seg4')];
  var strengthLbl = document.getElementById('strengthLabel');

  var levels = [
    { label: '', cls: '' },
    { label: 'Fraca',  cls: 'weak' },
    { label: 'Razoável', cls: 'fair' },
    { label: 'Boa',    cls: 'good' },
    { label: 'Forte',  cls: 'strong' }
  ];

  function getStrength(pwd) {
    if (!pwd || pwd.length < 1) return 0;
    var score = 0;
    if (pwd.length >= 8)  score++;
    if (/[A-Z]/.test(pwd)) score++;
    if (/[0-9]/.test(pwd)) score++;
    if (/[^A-Za-z0-9]/.test(pwd)) score++;
    return score;
  }

  if (pwdInput) {
    pwdInput.addEventListener('input', function(){
      var s = getStrength(this.value);
      segs.forEach(function(seg, i){
        seg.className = 'strength-seg' + (i < s ? ' ' + levels[s].cls : '');
      });
      if (strengthLbl) {
        strengthLbl.textContent = s > 0 ? levels[s].label : '';
        strengthLbl.className = 'strength-label' + (s > 0 ? ' ' + levels[s].cls : '');
      }
    });
  }

})();
</script>

</body>
</html>
{% endblock %}
