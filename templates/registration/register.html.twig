</header>

<div class="auth-shell">

  {# ═════ LEFT HERO PANEL ═════ #}
  <aside class="hero-panel" aria-hidden="true">
    <div class="hero-orb"></div>
    <div class="hero-orb-2"></div>

    <div class="hero-content">

      <div class="hero-brand">
        <div class="hero-brand__icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
          </svg>
        </div>
        <span class="hero-brand__name"><em>Pulse</em>SMM</span>
      </div>

      <div>
        <div class="hero-badge">
          <span class="hero-badge__dot"></span>
          Cadastro gratuito e imediato
        </div>
      </div>

      <div>
        <h1 class="hero-headline">
          Comece agora e<br>cresça mais rápido
          <strong>Resultados reais.</strong>
        </h1>
        <p class="hero-desc">
          Crie sua conta em menos de 2 minutos e tenha acesso a centenas de serviços para todas as redes sociais.
        </p>
