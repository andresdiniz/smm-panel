<!DOCTYPE html>
<html lang="pt-BR" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="PulseSMM — Painel de serviços de redes sociais">
  <title>{% block title %}PulseSMM{% endblock %}</title>
  <link rel="icon" href="/favicon.ico">

  {# CSS externo — sistema de design completo #}
  <link rel="stylesheet" href="{{ asset('css/app.css') }}">

  {# Lucide Icons #}
  <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js" defer></script>

  {% block stylesheets %}{% endblock %}
</head>
<body>

{% block body %}

{%- set route = app.request.attributes.get('_route') -%}
{%- set isAuth = route in ['app_login', 'app_register'] -%}

{% if isAuth or not app.user %}
{# ── PÁGINAS DE AUTH ─────────────────────────────────── #}
{% block auth_body %}{% endblock %}

{% else %}
{# ── APP SHELL (usuário logado) ──────────────────────── #}
<div class="app-shell" id="appShell">

  {# Overlay mobile #}
  <div class="sidebar-overlay" id="sidebarOverlay"></div>

  {# ── SIDEBAR ────────────────────────────────────────── #}
  <aside class="sidebar" id="sidebar">

    <a href="{{ path('app_dashboard') }}" class="sidebar__brand">
      <div class="sidebar__logo" aria-hidden="true">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
        </svg>
      </div>
      <span class="sidebar__brand-name"><em>Pulse</em>SMM</span>
    </a>

    <nav class="sidebar__nav" aria-label="Navegação principal">

      <div class="sidebar__section">Painel</div>

      <a href="{{ path('app_dashboard') }}"
         class="sidebar__link {% if route == 'app_dashboard' %}is-active{% endif %}">
        <i data-lucide="layout-dashboard" width="18" height="18" aria-hidden="true"></i>
        <span class="sidebar__link-label">Dashboard</span>
      </a>

      <a href="{{ path('app_order_new') }}"
         class="sidebar__link {% if route starts with 'app_order' %}is-active{% endif %}">
        <i data-lucide="plus-circle" width="18" height="18" aria-hidden="true"></i>
        <span class="sidebar__link-label">Novo pedido</span>
      </a>

      <div class="sidebar__section">Financeiro</div>

      <a href="{{ path('app_wallet_index') }}"
         class="sidebar__link {% if route starts with 'app_wallet' %}is-active{% endif %}">
        <i data-lucide="wallet" width="18" height="18" aria-hidden="true"></i>
        <span class="sidebar__link-label">Carteira</span>
        {% if app.user.wallet is defined and app.user.wallet %}
        <span class="sidebar__badge">
          R$ {{ (app.user.wallet.balanceCents / 100)|number_format(2, ',', '.') }}
        </span>
        {% endif %}
      </a>

      <a href="#"
         class="sidebar__link {% if route starts with 'app_transaction' %}is-active{% endif %}">
        <i data-lucide="receipt-text" width="18" height="18" aria-hidden="true"></i>
        <span class="sidebar__link-label">Histórico</span>
      </a>

      <div class="sidebar__section">Conta</div>

      <a href="#"
         class="sidebar__link {% if route starts with 'app_profile' %}is-active{% endif %}">
        <i data-lucide="user" width="18" height="18" aria-hidden="true"></i>
        <span class="sidebar__link-label">Perfil</span>
      </a>

      <a href="#"
         class="sidebar__link {% if route starts with 'app_settings' %}is-active{% endif %}">
        <i data-lucide="settings" width="18" height="18" aria-hidden="true"></i>
        <span class="sidebar__link-label">Configurações</span>
      </a>

      {% if is_granted('ROLE_ADMIN') %}
      <div class="sidebar__section">Admin</div>
      <a href="{{ path('admin_index') }}" class="sidebar__link">
        <i data-lucide="shield" width="18" height="18" aria-hidden="true"></i>
        <span class="sidebar__link-label">Painel admin</span>
      </a>
      {% endif %}

    </nav>

    <div class="sidebar__footer">
      <div class="sidebar__avatar" aria-hidden="true">
        {{ app.user.name|first|upper }}
      </div>
      <div class="sidebar__user">
        <strong>{{ app.user.name }}</strong>
        <span>{{ app.user.email }}</span>
      </div>
      <a href="{{ path('app_logout') }}" class="sidebar__logout" title="Sair" aria-label="Sair">
        <i data-lucide="log-out" width="16" height="16"></i>
      </a>
    </div>

  </aside>

  {# ── TOPBAR ──────────────────────────────────────────── #}
  <header class="topbar" role="banner">
    <button class="topbar__toggle" id="sidebarToggle"
            aria-label="Alternar menu lateral" aria-expanded="false" aria-controls="sidebar">
      <i data-lucide="menu" width="20" height="20"></i>
    </button>

    <span class="topbar__title">{% block page_title %}PulseSMM{% endblock %}</span>

    <div class="topbar__actions">
      {% if app.user.wallet is defined and app.user.wallet %}
      <a href="{{ path('app_wallet_deposit') }}" class="topbar__wallet" aria-label="Saldo da carteira">
        <i data-lucide="wallet" width="14" height="14"></i>
        R$ {{ (app.user.wallet.balanceCents / 100)|number_format(2, ',', '.') }}
      </a>
      {% endif %}

      <button class="topbar__btn" id="themeToggle"
              aria-label="Alternar tema claro/escuro" data-theme-toggle>
        <i data-lucide="sun" width="18" height="18" id="themeIcon"></i>
      </button>
    </div>
  </header>

  {# ── MAIN ────────────────────────────────────────────── #}
  <main class="main-content" id="main">

    {# Flash messages #}
    {% set flashes = app.flashes(['success','error','warning','info']) %}
    {% if flashes|length > 0 %}
    <div class="flash-bag" role="status" aria-live="polite">
      {% for type, msgs in flashes %}
        {% for msg in msgs %}
        <div class="flash flash--{{ type }}">
          <i data-lucide="{% if type == 'success' %}check-circle{% elseif type == 'error' %}x-circle{% elseif type == 'warning' %}alert-triangle{% else %}info{% endif %}" width="16" height="16"></i>
          <span>{{ msg }}</span>
          <button class="flash__close" onclick="this.closest('.flash').remove()" aria-label="Fechar">&times;</button>
        </div>
        {% endfor %}
      {% endfor %}
    </div>
    {% endif %}

    <div class="page-body">
      {% block content %}{% endblock %}
    </div>
  </main>

</div>{# /app-shell #}
{% endif %}

{% endblock %}{# /body #}

{# ── SCRIPTS ─────────────────────────────────────────── #}
<script>
(function(){
  // ── Theme toggle
  const html    = document.documentElement;
  const stored  = sessionStorage.getItem('pulse-theme');
  const sysDark = matchMedia('(prefers-color-scheme:dark)').matches;
  const theme   = stored || (sysDark ? 'dark' : 'light');
  html.setAttribute('data-theme', theme);

  function updateIcon(t){
    const icon = document.getElementById('themeIcon');
    if(!icon) return;
    icon.setAttribute('data-lucide', t === 'dark' ? 'moon' : 'sun');
    if(window.lucide) lucide.createIcons();
  }

  document.addEventListener('DOMContentLoaded', function(){
    lucide.createIcons();
    updateIcon(html.getAttribute('data-theme'));

    // Theme toggle
    const btn = document.getElementById('themeToggle');
    if(btn) btn.addEventListener('click', function(){
      const cur  = html.getAttribute('data-theme');
      const next = cur === 'dark' ? 'light' : 'dark';
      html.setAttribute('data-theme', next);
      sessionStorage.setItem('pulse-theme', next);
      updateIcon(next);
    });

    // Sidebar collapse (desktop)
    const shell   = document.getElementById('appShell');
    const toggle  = document.getElementById('sidebarToggle');
    const overlay = document.getElementById('sidebarOverlay');
    if(!shell || !toggle) return;

    function isMobile(){ return window.innerWidth <= 768; }

    toggle.addEventListener('click', function(){
      if(isMobile()){
        shell.classList.toggle('mobile-open');
        toggle.setAttribute('aria-expanded', shell.classList.contains('mobile-open'));
      } else {
        shell.classList.toggle('is-collapsed');
      }
    });

    if(overlay) overlay.addEventListener('click', function(){
      shell.classList.remove('mobile-open');
      toggle.setAttribute('aria-expanded', 'false');
    });

    // Reveal animation (Intersection Observer)
    const reveals = document.querySelectorAll('[data-reveal]');
    if('IntersectionObserver' in window && reveals.length){
      const io = new IntersectionObserver(function(entries){
        entries.forEach(function(e){
          if(e.isIntersecting){
            e.target.classList.add('is-visible');
            io.unobserve(e.target);
          }
        });
      }, { threshold: 0.08 });
      reveals.forEach(function(el){ io.observe(el); });
    } else {
      reveals.forEach(function(el){ el.classList.add('is-visible'); });
    }
  });
})();
</script>

{% block javascripts %}{% endblock %}
</body>
</html>
