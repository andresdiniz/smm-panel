<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="{% block description %}PulseSMM — Painel de serviços de redes sociais{% endblock %}">
  <title>{% block title %}PulseSMM{% endblock %}</title>
  <link rel="icon" href="/favicon.ico">

  {# ── Prevent flash of wrong theme ── #}
  <script>
    (function(){
      var s; try{ s = sessionStorage.getItem('pulse-theme'); }catch(e){}
      var sys = matchMedia('(prefers-color-scheme:dark)').matches ? 'dark' : 'light';
      document.documentElement.setAttribute('data-theme', s || sys);
    })();
  </script>

  <link rel="preconnect" href="https://api.fontshare.com">
  <link href="https://api.fontshare.com/v2/css?f[]=satoshi@300,400,500,600,700,800,900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="{{ asset('css/app.css') }}">
  <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js" defer></script>
  {% block stylesheets %}{% endblock %}
</head>
<body>

{% block body %}

{%- set route = app.request.attributes.get('_route') -%}
{%- set isAuth = route in ['app_login', 'app_register'] -%}

{% if isAuth or not app.user %}
  {% block auth_body %}{% endblock %}

{% else %}
<a href="#main" class="skip-link">Ir ao conteúdo</a>

<div class="app-shell" id="appShell">

  <div class="sidebar-overlay" id="sidebarOverlay"></div>

  {# ═══════════════════ SIDEBAR ═══════════════════ #}
  <aside class="sidebar" id="sidebar" aria-label="Menu lateral">

    <a href="{{ path('app_dashboard') }}" class="sidebar__brand">
      <div class="sidebar__logo" aria-hidden="true">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
        </svg>
      </div>
      <span class="sidebar__brand-name"><em>Pulse</em>SMM</span>
    </a>

    <nav class="sidebar__nav" aria-label="Navegação principal">

      <div class="sidebar__section">Painel</div>

      <a href="{{ path('app_dashboard') }}"
         class="sidebar__link {% if route == 'app_dashboard' %}is-active{% endif %}">
        <i data-lucide="layout-dashboard" width="17" height="17" aria-hidden="true"></i>
        <span class="sidebar__link-label">Dashboard</span>
      </a>

      <a href="{{ path('app_order_new') }}"
         class="sidebar__link {% if route starts with 'app_order' %}is-active{% endif %}">
        <i data-lucide="shopping-cart" width="17" height="17" aria-hidden="true"></i>
        <span class="sidebar__link-label">Novo pedido</span>
      </a>

      <div class="sidebar__section">Financeiro</div>

      <a href="{{ path('app_wallet_index') }}"
         class="sidebar__link {% if route == 'app_wallet_index' %}is-active{% endif %}">
        <i data-lucide="wallet" width="17" height="17" aria-hidden="true"></i>
        <span class="sidebar__link-label">Carteira</span>
        {% if app.user.wallet is defined and app.user.wallet %}
        <span class="sidebar__badge">
          R$ {{ (app.user.wallet.balanceCents / 100)|number_format(2, ',', '.') }}
        </span>
        {% endif %}
      </a>

      <a href="{{ path('app_wallet_deposit') }}"
         class="sidebar__link {% if route == 'app_wallet_deposit' or route == 'app_wallet_pix_pending' %}is-active{% endif %}">
        <i data-lucide="plus-circle" width="17" height="17" aria-hidden="true"></i>
        <span class="sidebar__link-label">Depositar</span>
      </a>

      <div class="sidebar__section">Conta</div>

      <a href="{{ path('app_profile') }}"
         class="sidebar__link {% if route starts with 'app_profile' %}is-active{% endif %}">
        <i data-lucide="user" width="17" height="17" aria-hidden="true"></i>
        <span class="sidebar__link-label">Perfil</span>
      </a>

      <a href="{{ path('app_settings') }}"
         class="sidebar__link {% if route starts with 'app_settings' %}is-active{% endif %}">
        <i data-lucide="settings" width="17" height="17" aria-hidden="true"></i>
        <span class="sidebar__link-label">Configurações</span>
      </a>

      {% if is_granted('ROLE_ADMIN') %}
      <div class="sidebar__section">Admin</div>
      <a href="{{ path('admin') }}" class="sidebar__link">
        <i data-lucide="shield" width="17" height="17" aria-hidden="true"></i>
        <span class="sidebar__link-label">Painel admin</span>
      </a>
      {% endif %}

    </nav>

    <div class="sidebar__footer">
      <div class="sidebar__avatar" aria-hidden="true">{{ app.user.name|first|upper }}</div>
      <div class="sidebar__user">
        <strong>{{ app.user.name }}</strong>
        <span>{{ app.user.email }}</span>
      </div>
      <a href="{{ path('app_logout') }}" class="sidebar__logout" title="Sair" aria-label="Sair">
        <i data-lucide="log-out" width="15" height="15"></i>
      </a>
    </div>

  </aside>

  {# ═══════════════════ TOPBAR ═══════════════════ #}
  <header class="topbar" role="banner">
    <button class="topbar__toggle" id="sidebarToggle"
            aria-label="Alternar menu lateral" aria-expanded="false" aria-controls="sidebar">
      <i data-lucide="menu" width="20" height="20" aria-hidden="true"></i>
    </button>

    <a href="{{ path('app_dashboard') }}" class="topbar__brand" aria-label="PulseSMM home">
      <div class="topbar__brand-logo" aria-hidden="true">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
        </svg>
      </div>
      <span><em>Pulse</em>SMM</span>
    </a>

    <span class="topbar__title">{% block page_title %}PulseSMM{% endblock %}</span>

    <div class="topbar__actions">
      {% if app.user.wallet is defined and app.user.wallet %}
      <a href="{{ path('app_wallet_index') }}" class="topbar__wallet" aria-label="Saldo da carteira">
        <i data-lucide="wallet" width="13" height="13" aria-hidden="true"></i>
        R$ {{ (app.user.wallet.balanceCents / 100)|number_format(2, ',', '.') }}
      </a>
      {% endif %}

      <button class="topbar__btn" id="themeToggle"
              aria-label="Alternar tema claro/escuro">
        <i data-lucide="sun" width="17" height="17" id="themeIconLucide" aria-hidden="true"></i>
      </button>
    </div>
  </header>

  {# ═══════════════════ MAIN ═══════════════════ #}
  <main class="main-content" id="main">

    {% set flashes = app.flashes(['success','error','warning','info']) %}
    {% if flashes|length > 0 %}
    <div class="flash-bag" role="status" aria-live="polite">
      {% for type, msgs in flashes %}
        {% for msg in msgs %}
        <div class="flash flash--{{ type }}">
          <i data-lucide="{% if type == 'success' %}check-circle{% elseif type == 'error' %}x-circle{% elseif type == 'warning' %}alert-triangle{% else %}info{% endif %}" width="16" height="16" aria-hidden="true"></i>
          <span>{{ msg }}</span>
          <button class="flash__close" onclick="this.closest('.flash').remove()" aria-label="Fechar">&times;</button>
        </div>
        {% endfor %}
      {% endfor %}
    </div>
    {% endif %}

    <div class="page-body">
      {% block content %}{% endblock %}
    </div>
  </main>

  {# ═══════════════════ BOTTOM NAV ═══════════════════ #}
  <nav class="bottom-nav" aria-label="Navegação rápida">
    <a href="{{ path('app_dashboard') }}"
       class="bottom-nav__item {% if route == 'app_dashboard' %}is-active{% endif %}"
       aria-label="Dashboard">
      <i data-lucide="layout-dashboard" width="20" height="20" aria-hidden="true"></i>
      <span>Painel</span>
    </a>
    <a href="{{ path('app_order_new') }}"
       class="bottom-nav__item {% if route starts with 'app_order' %}is-active{% endif %}"
       aria-label="Novo pedido">
      <i data-lucide="shopping-cart" width="20" height="20" aria-hidden="true"></i>
      <span>Pedido</span>
    </a>
    <a href="{{ path('app_wallet_index') }}"
       class="bottom-nav__item {% if route starts with 'app_wallet' %}is-active{% endif %}"
       aria-label="Carteira">
      <i data-lucide="wallet" width="20" height="20" aria-hidden="true"></i>
      <span>Carteira</span>
    </a>
    <a href="{{ path('app_profile') }}"
       class="bottom-nav__item {% if route starts with 'app_profile' or route starts with 'app_settings' %}is-active{% endif %}"
       aria-label="Conta">
      <i data-lucide="user" width="20" height="20" aria-hidden="true"></i>
      <span>Conta</span>
    </a>
  </nav>

</div>
{% endif %}

{% endblock %}

<script>
(function(){
  'use strict';
  var html = document.documentElement;

  function applyThemeIcon(t) {
    var icon = document.getElementById('themeIconLucide');
    if (!icon) return;
    icon.setAttribute('data-lucide', t === 'dark' ? 'moon' : 'sun');
    if (window.lucide) lucide.createIcons();
  }

  document.addEventListener('DOMContentLoaded', function(){
    lucide.createIcons();
    var t = html.getAttribute('data-theme') || 'light';
    applyThemeIcon(t);

    document.getElementById('themeToggle') && document.getElementById('themeToggle').addEventListener('click', function(){
      var next = html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
      html.setAttribute('data-theme', next);
      try { sessionStorage.setItem('pulse-theme', next); } catch(e){}
      applyThemeIcon(next);
    });

    var shell   = document.getElementById('appShell');
    var toggle  = document.getElementById('sidebarToggle');
    var overlay = document.getElementById('sidebarOverlay');
    if (!shell || !toggle) return;

    function isMobile(){ return window.innerWidth <= 768; }

    toggle.addEventListener('click', function(){
      if (isMobile()) {
        var open = shell.classList.toggle('mobile-open');
        toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
        document.body.style.overflow = open ? 'hidden' : '';
      } else {
        shell.classList.toggle('is-collapsed');
      }
    });

    function closeDrawer(){
      shell.classList.remove('mobile-open');
      toggle.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    }

    overlay && overlay.addEventListener('click', closeDrawer);

    document.addEventListener('keydown', function(e){
      if (e.key === 'Escape' && shell.classList.contains('mobile-open')) closeDrawer();
    });

    var reveals = document.querySelectorAll('[data-reveal]');
    if ('IntersectionObserver' in window && reveals.length) {
      var io = new IntersectionObserver(function(entries){
        entries.forEach(function(e){
          if (e.isIntersecting){ e.target.classList.add('is-visible'); io.unobserve(e.target); }
        });
      }, { threshold: 0.06 });
      reveals.forEach(function(el){ io.observe(el); });
    } else {
      reveals.forEach(function(el){ el.classList.add('is-visible'); });
    }
  });
})();
</script>

{% block javascripts %}{% endblock %}
{% block importmap %}{{ importmap('app') }}{% endblock %}
</body>
</html>
