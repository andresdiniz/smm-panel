<!DOCTYPE html>
<html lang="pt-BR" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}PulseSMM{% endblock %}</title>
    <meta name="description" content="{% block description %}Painel SMM com UX moderna, mobile-first e pagamentos rápidos.{% endblock %}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('css/app.css') }}">
    {% block stylesheets %}{% endblock %}
</head>
<body class="site-shell">
<a href="#content" class="skip-link">Pular para conteúdo</a>

<header class="topbar glass">
    <div class="container topbar__inner">
        <a href="{{ path('app_home') }}" class="brand">
            <span class="brand__logo">
                <svg width="34" height="34" viewBox="0 0 40 40" fill="none" aria-hidden="true">
                    <rect width="40" height="40" rx="12" fill="url(#g1)"/>
                    <path d="M9 26L16 13L23 21L29 14L32 26" stroke="white" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"/>
                    <defs>
                        <linearGradient id="g1" x1="0" y1="0" x2="40" y2="40">
                            <stop stop-color="#6D5DF6"/>
                            <stop offset="1" stop-color="#00C2A8"/>
                        </linearGradient>
                    </defs>
                </svg>
            </span>
            <span class="brand__text">PulseSMM</span>
        </a>

        <nav class="topbar__nav" id="mainNav" role="navigation" aria-label="Menu principal">
            <a href="{{ path('app_catalog') }}">Serviços</a>
            <a href="{{ path('app_pricing') }}">Preços</a>
            <a href="{{ path('app_faq') }}">FAQ</a>
            <a href="{{ path('app_contact') }}">Contato</a>
        </nav>

        <div class="topbar__actions">
            <button type="button" class="icon-btn" data-theme-toggle aria-label="Alternar tema">
                <span class="theme-dot"></span>
            </button>

            {% if app.user %}
                <a href="{{ path('app_dashboard') }}" class="btn btn--ghost">Dashboard</a>
            {% else %}
                <a href="{{ path('app_login') }}" class="btn btn--ghost">Entrar</a>
                <a href="{{ path('app_register') }}" class="btn btn--primary">Criar conta</a>
            {% endif %}

            <button type="button" class="menu-btn" id="menuToggle" aria-label="Abrir menu" aria-expanded="false" aria-controls="mainNav">
                <span></span><span></span><span></span>
            </button>
        </div>
    </div>
</header>

{% for flash_type, messages in app.flashes(['success','error','warning','info']) %}
    {% for message in messages %}
        <div class="flash flash--{{ flash_type }}" data-flash role="alert">
            <span>{{ message }}</span>
            <button type="button" aria-label="Fechar" onclick="this.parentElement.remove()">×</button>
        </div>
    {% endfor %}
{% endfor %}

<main id="content">
    {% block body %}{% endblock %}
</main>

<footer class="site-footer">
    <div class="container footer-grid">
        <div>
            <h3>PulseSMM</h3>
            <p>Painel SMM com foco em performance, automação e experiência fluida em qualquer dispositivo.</p>
        </div>
        <div>
            <h4>Plataforma</h4>
            <a href="{{ path('app_catalog') }}">Catálogo</a>
            <a href="{{ path('app_pricing') }}">Preços</a>
            <a href="{{ path('app_dashboard') }}">Área do cliente</a>
        </div>
        <div>
            <h4>Legal</h4>
            <a href="{{ path('app_terms') }}">Termos</a>
            <a href="{{ path('app_privacy') }}">Privacidade</a>
        </div>
    </div>
</footer>

<script>
(() => {
    const root = document.documentElement;
    const toggle = document.querySelector('[data-theme-toggle]');
    let theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    root.setAttribute('data-theme', theme);

    toggle?.addEventListener('click', () => {
        theme = theme === 'dark' ? 'light' : 'dark';
        root.setAttribute('data-theme', theme);
        toggle.setAttribute('aria-label', theme === 'dark' ? 'Ativar modo claro' : 'Ativar modo escuro');
    });

    const menuBtn = document.getElementById('menuToggle');
    const nav = document.getElementById('mainNav');
    menuBtn?.addEventListener('click', () => {
        const open = nav.classList.toggle('is-open');
        menuBtn.setAttribute('aria-expanded', open);
    });

    const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry, i) => {
            if (entry.isIntersecting) {
                setTimeout(() => entry.target.classList.add('in-view'), i * 80);
            }
        });
    }, { threshold: 0.10 });
    document.querySelectorAll('[data-reveal]').forEach(el => observer.observe(el));

    document.querySelectorAll('[data-counter]').forEach(el => {
        const observer2 = new IntersectionObserver((entries) => {
            if (entries[0].isIntersecting) {
                const target = parseInt(el.dataset.counter, 10);
                let current = 0;
                const step = Math.max(1, Math.ceil(target / 72));
                const tick = () => {
                    current = Math.min(current + step, target);
                    el.textContent = current.toLocaleString('pt-BR');
                    if (current < target) requestAnimationFrame(tick);
                };
                tick();
                observer2.disconnect();
            }
        }, { threshold: 0.5 });
        observer2.observe(el);
    });

    setTimeout(() => {
        document.querySelectorAll('[data-flash]').forEach(el => el.classList.add('is-visible'));
    }, 120);
})();
</script>

{% block javascripts %}{% endblock %}
</body>
</html>
