<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}{{ title|default('PulseSMM') }}{% endblock %}</title>
    <meta name="description" content="{% block description %}{{ description|default('Plataforma profissional de SMM Panel com automação, integração e foco em performance.') }}{% endblock %}">
    {% set currentRoute = app.request.attributes.get('_route')|default('') %}
    {% set noIndexRoutes = ['app_login', 'app_logout', 'app_register', 'app_forgot_password', 'app_reset_password'] %}
    {% set privatePage = app.user or currentRoute starts with 'admin_' or currentRoute starts with 'app_dashboard' or currentRoute starts with 'app_wallet_' or currentRoute starts with 'app_order_' or currentRoute starts with 'app_profile' or currentRoute starts with 'app_transaction_' or currentRoute starts with 'support_' or currentRoute starts with 'affiliate_' or currentRoute == 'app_marketing_unsubscribe' or currentRoute in noIndexRoutes %}
    {% set canonicalPath = currentRoute == 'app_privacy' ? '/politica-de-privacidade' : app.request.pathInfo %}
    <meta name="robots" content="{{ privatePage ? 'noindex,nofollow' : 'index,follow' }}">
    <meta name="theme-color" content="#087f86">
    <meta name="color-scheme" content="light dark">
    {% if not privatePage %}
        <link rel="canonical" href="{{ site_url }}{{ canonicalPath }}">
    {% endif %}
    <meta property="og:site_name" content="PulseSMM">
    <meta property="og:type" content="website">
    <meta property="og:title" content="{{ block('title')|striptags|trim }}">
    <meta property="og:description" content="{{ block('description')|striptags|trim }}">
    {% if google_site_verification %}
        <meta name="google-site-verification" content="{{ google_site_verification|e('html_attr') }}">
    {% endif %}
    {% if bing_site_verification %}
        <meta name="msvalidate.01" content="{{ bing_site_verification|e('html_attr') }}">
    {% endif %}
    <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/app-shell.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/customer-panel.css') }}">
    <link rel="manifest" href="/manifest.webmanifest">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    {% block stylesheets %}{% endblock %}
</head>
<body{% if app.user %} class="customer-panel"{% endif %}>
    <header class="site-header">
        <a class="site-brand" href="{{ path('home') }}" aria-label="PulseSMM — início">
            <span class="site-brand__mark" aria-hidden="true">P</span>
            <span>Pulse<span class="site-brand__accent">SMM</span></span>
        </a>
        <nav class="site-nav" aria-label="Navegação principal">
            <a href="{{ path('home') }}" {% if app.request.attributes.get('_route') == 'home' %}aria-current="page"{% endif %}>Início</a>
            <a href="{{ path('app_catalog') }}" {% if app.request.attributes.get('_route') == 'app_catalog' %}aria-current="page"{% endif %}>Serviços</a>
            <a href="{{ path('app_how_it_works') }}" {% if app.request.attributes.get('_route') == 'app_how_it_works' %}aria-current="page"{% endif %}>Como funciona</a>
            <a href="{{ path('blog_index') }}" {% if app.request.attributes.get('_route') starts with 'blog_' %}aria-current="page"{% endif %}>Blog</a>
            {% if app.user %}
                <a href="{{ path('app_order_new') }}" {% if app.request.attributes.get('_route') starts with 'app_order_' %}aria-current="page"{% endif %}>Novo pedido</a>
                <a href="{{ path('app_wallet_index') }}" {% if app.request.attributes.get('_route') starts with 'app_wallet_' %}aria-current="page"{% endif %}>Carteira</a>
                <a href="{{ path('support_index') }}" {% if app.request.attributes.get('_route') starts with 'support_' %}aria-current="page"{% endif %}>Suporte</a>
            {% endif %}
        </nav>
        <div class="site-account">
            {% if app.user %}
                <span class="site-account__identity">{{ app.user.userIdentifier }}</span>
                <a class="btn btn-primary" href="{{ path('app_dashboard') }}">Meu painel</a>
                <a class="site-login-link" href="{{ path('app_logout') }}">Sair</a>
            {% else %}
                <a class="site-login-link" href="{{ path('app_login') }}">Entrar</a>
                <a class="btn btn-primary" href="{{ path('app_register') }}">Criar conta</a>
            {% endif %}
        </div>
    </header>
    {% block body %}
        <main class="site-main" id="main-content">
            {% block auth_body %}{% endblock %}
            {% block content %}{% endblock %}
        </main>
    {% endblock %}
    <footer class="site-footer">
        <span>&copy; {{ "now"|date("Y") }} PulseSMM</span>
        <nav aria-label="Links institucionais">
            <a href="{{ path('app_terms') }}">Termos</a>
            <a href="{{ path('app_privacy') }}">Privacidade</a>
            {% if google_tag_manager_id starts with 'GTM-' or clarity_project_id is not empty %}
                <button class="cookie-preferences-link" type="button" data-cookie-preferences>Preferências de cookies</button>
            {% endif %}
            {% if app.user %}
                <a href="{{ path('support_index') }}">Suporte</a>
            {% endif %}
        </nav>
    </footer>
    {% block javascripts %}{% endblock %}
    {{ importmap('app') }}
    <script>
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', function() {
                navigator.serviceWorker.register('/sw.js').catch(function(error) {
                    console.error('Não foi possível registrar o service worker.', error);
                });
            });
        }
    </script>
    {% include 'partials/browser_push.html.twig' %}
    {% include 'partials/analytics_consent.html.twig' %}
    {% if currentRoute == 'home' %}
        <script type="application/ld+json">
            {"@context":"https://schema.org","@type":"WebSite","name":"PulseSMM","url":"{{ site_url }}/","inLanguage":"pt-BR"}
        </script>
    {% endif %}
</body>
</html>
