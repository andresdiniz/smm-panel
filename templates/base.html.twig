<!DOCTYPE html>
<html lang="pt-BR" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="PulseSMM — Painel de serviços de redes sociais">
  <title>{% block title %}PulseSMM{% endblock %}</title>

  <link rel="icon" href="/favicon.ico">

  {# Google Fonts — Inter #}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300..800&display=swap" rel="stylesheet">

  {# Lucide Icons #}
  <script src="https://unpkg.com/lucide@latest" defer></script>

  <style>
  /* ── TOKENS ──────────────────────────────────────────── */
  :root,[data-theme="light"]{
    --font:'Inter',system-ui,sans-serif;
    --text-xs:clamp(.75rem,.7rem + .25vw,.875rem);
    --text-sm:clamp(.875rem,.8rem + .35vw,1rem);
    --text-base:clamp(1rem,.95rem + .25vw,1.125rem);
    --text-lg:clamp(1.125rem,1rem + .75vw,1.5rem);
    --text-xl:clamp(1.5rem,1.2rem + 1.25vw,2.25rem);
    --sp1:.25rem;--sp2:.5rem;--sp3:.75rem;--sp4:1rem;
    --sp6:1.5rem;--sp8:2rem;--sp10:2.5rem;--sp12:3rem;
    --r-sm:.375rem;--r-md:.5rem;--r-lg:.75rem;--r-xl:1rem;--r-full:9999px;
    --sh-sm:0 1px 2px oklch(.2 .01 80/.06);
    --sh-md:0 4px 12px oklch(.2 .01 80/.08);
    --sh-lg:0 12px 32px oklch(.2 .01 80/.12);
    --transition:180ms cubic-bezier(.16,1,.3,1);
    /* Surfaces */
    --bg:#f7f6f2;--surface:#f9f8f5;--surface-2:#fbfbf9;
    --surface-off:#f3f0ec;--surface-dyn:#e6e4df;
    --divider:#dcd9d5;--border:#d4d1ca;
    /* Text */
    --text:#28251d;--muted:#7a7974;--faint:#bab9b4;--text-inv:#f9f8f4;
    /* Accents */
    --primary:#01696f;--primary-h:#0c4e54;--primary-hi:#cedcd8;
    --success:#437a22;--success-h:#2e5c10;
    --error:#a12c7b;--error-h:#7d1e5e;--error-hi:#e0ced7;
    --warning:#964219;
    --gold:#d19900;
    /* Sidebar */
    --sidebar-w:240px;
    --sidebar-w-collapsed:60px;
  }
  [data-theme="dark"]{
    --bg:#171614;--surface:#1c1b19;--surface-2:#201f1d;
    --surface-off:#1d1c1a;--surface-dyn:#2d2c2a;
    --divider:#262523;--border:#393836;
    --text:#cdccca;--muted:#797876;--faint:#5a5957;--text-inv:#2b2a28;
    --primary:#4f98a3;--primary-h:#227f8b;--primary-hi:#313b3b;
    --success:#6daa45;--success-h:#4d8f25;
    --error:#d163a7;--error-h:#b9478f;--error-hi:#4c3d46;
    --warning:#bb653b;
    --gold:#e8af34;
    --sh-sm:0 1px 2px oklch(0 0 0/.2);
    --sh-md:0 4px 12px oklch(0 0 0/.3);
    --sh-lg:0 12px 32px oklch(0 0 0/.4);
  }

  /* ── RESET ───────────────────────────────────────────── */
  *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
  html{-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility;scroll-behavior:smooth;scroll-padding-top:var(--sp8)}
  body{min-height:100dvh;font-family:var(--font);font-size:var(--text-base);color:var(--text);background:var(--bg);line-height:1.6}
  img,picture,video,svg{display:block;max-width:100%;height:auto}
  input,button,textarea,select{font:inherit;color:inherit}
  h1,h2,h3,h4,h5,h6{text-wrap:balance;line-height:1.15}
  p,li{text-wrap:pretty;max-width:72ch}
  button{cursor:pointer;background:none;border:none}
  table{border-collapse:collapse;width:100%}
  ::selection{background:oklch(from var(--primary) l c h/.25);color:var(--text)}
  :focus-visible{outline:2px solid var(--primary);outline-offset:3px;border-radius:var(--r-sm)}
  a,button,[role="button"]{transition:color var(--transition),background var(--transition),box-shadow var(--transition),border-color var(--transition)}
  @media(prefers-reduced-motion:reduce){*,*::before,*::after{animation-duration:.01ms!important;transition-duration:.01ms!important}}

  /* ── LAYOUT SHELL ────────────────────────────────────── */
  .app-shell{display:grid;grid-template-columns:var(--sidebar-w) 1fr;grid-template-rows:auto 1fr;min-height:100dvh;transition:grid-template-columns var(--transition)}
  .app-shell.collapsed{--sidebar-w:var(--sidebar-w-collapsed)}

  /* ── SIDEBAR ─────────────────────────────────────────── */
  .sidebar{
    grid-row:1/-1;
    width:var(--sidebar-w);
    background:var(--surface);
    border-right:1px solid var(--border);
    display:flex;flex-direction:column;
    position:sticky;top:0;height:100dvh;
    overflow:hidden;
    transition:width var(--transition);
    z-index:100;
  }
  .sidebar__brand{
    display:flex;align-items:center;gap:var(--sp3);
    padding:var(--sp4) var(--sp4);
    border-bottom:1px solid var(--border);
    min-height:60px;
    text-decoration:none;
    color:var(--text);
  }
  .sidebar__brand svg{flex-shrink:0}
  .sidebar__brand-name{
    font-weight:800;font-size:1.05rem;letter-spacing:-.03em;
    white-space:nowrap;overflow:hidden;
    transition:opacity var(--transition),width var(--transition);
  }
  .sidebar__brand-name strong{color:var(--primary)}
  .collapsed .sidebar__brand-name{opacity:0;width:0}

  .sidebar__nav{flex:1;overflow-y:auto;padding:var(--sp3) 0}
  .sidebar__nav a,.sidebar__nav button{
    display:flex;align-items:center;gap:var(--sp3);
    padding:var(--sp2) var(--sp4);
    border-radius:var(--r-md);
    margin:1px var(--sp2);
    color:var(--muted);font-size:var(--text-sm);font-weight:500;
    text-decoration:none;white-space:nowrap;overflow:hidden;
    width:calc(100% - var(--sp4));
  }
  .sidebar__nav a:hover,.sidebar__nav a.active{
    background:var(--primary-hi);color:var(--primary-h);
  }
  .sidebar__nav a.active{font-weight:700}
  .sidebar__nav .nav-label{white-space:nowrap;overflow:hidden;transition:opacity var(--transition)}
  .collapsed .sidebar__nav .nav-label{opacity:0;width:0;pointer-events:none}
  .sidebar__section{
    padding:var(--sp4) var(--sp4) var(--sp1);
    font-size:var(--text-xs);font-weight:700;
    text-transform:uppercase;letter-spacing:.08em;
    color:var(--faint);white-space:nowrap;overflow:hidden;
    transition:opacity var(--transition);
  }
  .collapsed .sidebar__section{opacity:0}

  .sidebar__footer{
    padding:var(--sp4);
    border-top:1px solid var(--border);
    display:flex;align-items:center;gap:var(--sp3);
    font-size:var(--text-xs);color:var(--muted);
  }
  .sidebar__avatar{
    width:32px;height:32px;border-radius:var(--r-full);
    background:var(--primary);color:var(--text-inv);
    display:flex;align-items:center;justify-content:center;
    font-weight:700;font-size:.75rem;flex-shrink:0;
  }
  .sidebar__user-info{overflow:hidden;transition:opacity var(--transition)}
  .sidebar__user-info strong{display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:140px}
  .sidebar__user-info span{display:block;font-size:.7rem;color:var(--faint)}
  .collapsed .sidebar__user-info{opacity:0;width:0}

  /* ── TOPBAR ──────────────────────────────────────────── */
  .topbar{
    grid-column:2;position:sticky;top:0;z-index:90;
    display:flex;align-items:center;gap:var(--sp4);
    padding:0 var(--sp6);height:60px;
    background:color-mix(in oklab,var(--surface) 80%,transparent);
    backdrop-filter:blur(12px);
    border-bottom:1px solid var(--border);
  }
  .topbar__toggle{
    color:var(--muted);padding:var(--sp2);border-radius:var(--r-md);
  }
  .topbar__toggle:hover{background:var(--surface-off);color:var(--text)}
  .topbar__title{
    flex:1;font-weight:600;font-size:var(--text-sm);color:var(--muted);
    white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
  }
  .topbar__actions{display:flex;align-items:center;gap:var(--sp2)}
  .topbar__btn{
    display:flex;align-items:center;justify-content:center;
    width:36px;height:36px;border-radius:var(--r-md);
    color:var(--muted);transition:background var(--transition),color var(--transition);
  }
  .topbar__btn:hover{background:var(--surface-off);color:var(--text)}
  .topbar__wallet{
    display:flex;align-items:center;gap:var(--sp2);
    background:var(--surface-off);border-radius:var(--r-full);
    padding:var(--sp1) var(--sp3);font-size:var(--text-xs);
    font-weight:700;color:var(--primary);
  }

  /* ── MAIN CONTENT ────────────────────────────────────── */
  .main-content{grid-column:2;padding:var(--sp8) var(--sp6);overflow-x:hidden}
  .container{max-width:1100px;margin:0 auto}

  /* ── COMPONENTS ─────────────────────────────────────── */
  .panel-card{
    background:var(--surface);border:1px solid var(--border);
    border-radius:var(--r-xl);padding:var(--sp6);
    box-shadow:var(--sh-sm);
  }
  .panel-card__head{
    display:flex;align-items:center;gap:var(--sp3);
    margin-bottom:var(--sp6);flex-wrap:wrap;
  }
  .panel-card__head h1,.panel-card__head h2{flex:1;font-size:var(--text-lg);font-weight:800}

  .glass-card{
    background:var(--surface-off);
    border:1px solid oklch(from var(--text) l c h/.08);
    border-radius:var(--r-lg);padding:var(--sp4) var(--sp5);
    display:flex;justify-content:space-between;align-items:center;
    gap:var(--sp3);
  }
  .glass-card span{font-size:var(--text-xs);color:var(--muted);text-transform:uppercase;letter-spacing:.05em}
  .glass-card strong{font-size:var(--text-lg);font-weight:800;color:var(--text)}

  .order-details{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(220px,100%),1fr));gap:var(--sp3);margin-bottom:var(--sp6)}

  /* Buttons */
  .btn{display:inline-flex;align-items:center;justify-content:center;gap:var(--sp2);
    padding:var(--sp2) var(--sp5);border-radius:var(--r-full);
    font-weight:700;font-size:var(--text-sm);text-decoration:none;
    border:2px solid transparent;transition:all var(--transition);white-space:nowrap;
  }
  .btn--primary{background:var(--primary);color:var(--text-inv);border-color:var(--primary)}
  .btn--primary:hover{background:var(--primary-h);border-color:var(--primary-h)}
  .btn--ghost{background:transparent;color:var(--text);border-color:var(--border)}
  .btn--ghost:hover{background:var(--surface-off)}
  .btn--danger{background:var(--error);color:var(--text-inv);border-color:var(--error)}
  .btn--lg{padding:var(--sp3) var(--sp8);font-size:var(--text-base)}
  .btn--block{width:100%}

  /* Badges */
  .badge{display:inline-flex;align-items:center;padding:2px var(--sp2);border-radius:var(--r-full);font-size:var(--text-xs);font-weight:700}
  .badge--processing{background:#e8f4fd;color:#006494}
  .badge--completed{background:#d4dfcc;color:var(--success-h)}
  .badge--cancelled{background:var(--error-hi);color:var(--error-h)}
  .badge--pending{background:var(--surface-dyn);color:var(--muted)}
  .pill{display:inline-flex;align-items:center;padding:var(--sp1) var(--sp3);border-radius:var(--r-full);font-size:var(--text-xs);font-weight:600;background:var(--surface-off);color:var(--muted)}
  .pill--soft{background:var(--primary-hi);color:var(--primary-h)}

  /* Forms */
  .quick-form{display:flex;flex-direction:column;gap:var(--sp4)}
  .field{display:flex;flex-direction:column;gap:var(--sp1)}
  .field span,.field label{font-size:var(--text-sm);font-weight:600;color:var(--muted)}
  .control{
    background:var(--surface);border:1.5px solid var(--border);
    border-radius:var(--r-md);padding:var(--sp3) var(--sp4);
    font-size:var(--text-base);color:var(--text);
    transition:border-color var(--transition),box-shadow var(--transition);
    width:100%;
  }
  .control:focus{border-color:var(--primary);outline:none;box-shadow:0 0 0 3px oklch(from var(--primary) l c h/.15)}
  .control::placeholder{color:var(--faint)}
  .field--inline{flex-direction:row;align-items:flex-start;gap:var(--sp3);font-size:var(--text-sm)}
  .field--inline input[type=checkbox]{width:18px;height:18px;flex-shrink:0;margin-top:2px;accent-color:var(--primary)}
  .form-error,.invalid-feedback,.form-error-icon{color:var(--error);font-size:var(--text-xs);margin-top:2px}
  .form-error ul{list-style:none;padding:0;margin:0}

  /* Alerts */
  .alert{padding:var(--sp3) var(--sp4);border-radius:var(--r-md);font-size:var(--text-sm);margin-bottom:var(--sp4)}
  .alert--success{background:var(--primary-hi);color:var(--primary-h);border:1px solid var(--primary)}
  .alert--error{background:var(--error-hi);color:var(--error-h);border:1px solid var(--error)}

  /* Auth pages */
  .auth-page{
    min-height:100dvh;display:flex;align-items:center;justify-content:center;
    background:var(--bg);padding:var(--sp6) var(--sp4);
  }
  .auth-card{
    background:var(--surface);border:1px solid var(--border);
    border-radius:var(--r-xl);padding:var(--sp8) var(--sp8);
    width:100%;max-width:480px;box-shadow:var(--sh-lg);
  }
  .auth-card__brand{display:flex;align-items:center;gap:var(--sp3);margin-bottom:var(--sp8);text-decoration:none}
  .auth-card__brand span{font-weight:800;font-size:1.2rem;color:var(--text)}
  .auth-card__title{font-size:var(--text-xl);font-weight:900;margin-bottom:var(--sp2)}
  .auth-card__sub{color:var(--muted);font-size:var(--text-sm);margin-bottom:var(--sp6)}
  .auth-card__footer{text-align:center;font-size:var(--text-sm);color:var(--muted);margin-top:var(--sp6)}
  .auth-card__footer a{color:var(--primary);font-weight:600;text-decoration:none}
  .auth-card__footer a:hover{text-decoration:underline}

  /* Wallet page */
  .wallet-page{padding:var(--sp8) var(--sp4)}

  /* Reveal animation */
  [data-reveal]{opacity:0;transform:translateY(16px);transition:opacity .4s ease,transform .4s ease}
  [data-reveal].revealed{opacity:1;transform:none}

  /* ── RESPONSIVE ──────────────────────────────────────── */
  @media(max-width:768px){
    .app-shell{grid-template-columns:0 1fr}
    .app-shell.mobile-open{grid-template-columns:var(--sidebar-w) 1fr}
    .sidebar{
      position:fixed;left:0;top:0;height:100dvh;
      transform:translateX(-100%);
      transition:transform var(--transition);
    }
    .mobile-open .sidebar{transform:translateX(0)}
    .topbar{grid-column:1/-1}
    .main-content{grid-column:1/-1;padding:var(--sp4) var(--sp4)}
    .sidebar-overlay{
      display:none;position:fixed;inset:0;background:oklch(.1 0 0/.4);z-index:99;
    }
    .mobile-open .sidebar-overlay{display:block}
  }
  </style>

  {% block stylesheets %}{% endblock %}
</head>
<body>

{% set isAuthPage = app.request.attributes.get('_route') in ['app_login','app_register'] %}

{% if not isAuthPage and app.user %}
{# ── APP SHELL (usuário logado) ─────────────────────────────── #}
<div class="app-shell" id="appShell">

  {# Overlay mobile #}
  <div class="sidebar-overlay" id="sidebarOverlay"></div>

  {# ── SIDEBAR ─────────────────────────────────────────────── #}
  <aside class="sidebar" id="sidebar">
    <a href="{{ path('app_dashboard') }}" class="sidebar__brand">
      <svg width="28" height="28" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <rect width="36" height="36" rx="10" fill="var(--primary)"/>
        <path d="M8 24 L14 12 L18 20 L22 16 L28 24" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
        <circle cx="28" cy="14" r="3" fill="white" opacity=".8"/>
      </svg>
      <span class="sidebar__brand-name"><strong>Pulse</strong>SMM</span>
    </a>

    <nav class="sidebar__nav" aria-label="Menu principal">
      <div class="sidebar__section">Painel</div>
      <a href="{{ path('app_dashboard') }}" class="{% if app.request.attributes.get('_route') == 'app_dashboard' %}active{% endif %}">
        <i data-lucide="layout-dashboard" width="18" height="18"></i>
        <span class="nav-label">Dashboard</span>
      </a>
      <a href="{{ path('app_order_new') }}" class="{% if app.request.attributes.get('_route') starts with 'app_order' %}active{% endif %}">
        <i data-lucide="plus-circle" width="18" height="18"></i>
        <span class="nav-label">Novo pedido</span>
      </a>

      <div class="sidebar__section">Conta</div>
      <a href="{{ path('app_wallet') }}">
        <i data-lucide="wallet" width="18" height="18"></i>
        <span class="nav-label">Carteira</span>
      </a>
      <a href="#">
        <i data-lucide="receipt-text" width="18" height="18"></i>
        <span class="nav-label">Histórico</span>
      </a>
      <a href="#">
        <i data-lucide="settings" width="18" height="18"></i>
        <span class="nav-label">Configurações</span>
      </a>

      {% if is_granted('ROLE_ADMIN') %}
      <div class="sidebar__section">Admin</div>
      <a href="{{ path('admin_index') }}">
        <i data-lucide="shield" width="18" height="18"></i>
        <span class="nav-label">Painel admin</span>
      </a>
      {% endif %}
    </nav>

    <div class="sidebar__footer">
      <div class="sidebar__avatar">{{ app.user.name|first|upper }}</div>
      <div class="sidebar__user-info">
        <strong>{{ app.user.name }}</strong>
        <span>{{ app.user.email }}</span>
      </div>
    </div>
  </aside>

  {# ── TOPBAR ───────────────────────────────────────────────── #}
  <header class="topbar">
    <button class="topbar__toggle" id="sidebarToggle" aria-label="Menu">
      <i data-lucide="menu" width="20" height="20"></i>
    </button>

    <span class="topbar__title">{% block page_title %}{% endblock %}</span>

    <div class="topbar__actions">
      {# Saldo #}
      <div class="topbar__wallet">
        <i data-lucide="wallet" width="14" height="14"></i>
        R$ {{ (app.user.wallet.balanceCents / 100)|number_format(2, ',', '.') }}
      </div>

      {# Dark mode toggle #}
      <button class="topbar__btn" data-theme-toggle aria-label="Alternar tema">
        <i data-lucide="moon" width="18" height="18"></i>
      </button>

      {# Notificações placeholder #}
      <button class="topbar__btn" aria-label="Notificações">
        <i data-lucide="bell" width="18" height="18"></i>
      </button>

      <a href="{{ path('app_logout') }}" class="topbar__btn" aria-label="Sair">
        <i data-lucide="log-out" width="18" height="18"></i>
      </a>
    </div>
  </header>

  {# ── MAIN ─────────────────────────────────────────────────── #}
  <main class="main-content">
    {% for msg in app.flashes('success') %}
      <div class="alert alert--success" style="max-width:700px;margin-bottom:var(--sp4)">{{ msg }}</div>
    {% endfor %}
    {% for msg in app.flashes('error') %}
      <div class="alert alert--error" style="max-width:700px;margin-bottom:var(--sp4)">{{ msg }}</div>
    {% endfor %}
    {% block body %}{% endblock %}
  </main>

</div>{# /app-shell #}

{% else %}
{# ── PÁGINAS DE AUTH / PÚBLICO ─────────────────────────────── #}
{% block body %}{% endblock %}
{% endif %}

<script>
(function(){
  /* ── Dark mode ── */
  const r = document.documentElement;
  const stored = null; // sem localStorage no sandbox
  const prefersDark = matchMedia('(prefers-color-scheme:dark)').matches;
  let theme = prefersDark ? 'dark' : 'light';
  r.setAttribute('data-theme', theme);

  document.addEventListener('DOMContentLoaded', () => {
    const toggle = document.querySelector('[data-theme-toggle]');
    if (toggle) {
      updateIcon(toggle, theme);
      toggle.addEventListener('click', () => {
        theme = theme === 'dark' ? 'light' : 'dark';
        r.setAttribute('data-theme', theme);
        updateIcon(toggle, theme);
      });
    }

    /* ── Sidebar collapse (desktop) / open (mobile) ── */
    const shell   = document.getElementById('appShell');
    const btn     = document.getElementById('sidebarToggle');
    const overlay = document.getElementById('sidebarOverlay');
    const isMobile = () => window.innerWidth <= 768;

    if (btn && shell) {
      btn.addEventListener('click', () => {
        if (isMobile()) {
          shell.classList.toggle('mobile-open');
        } else {
          shell.classList.toggle('collapsed');
        }
      });
    }
    if (overlay) {
      overlay.addEventListener('click', () => shell.classList.remove('mobile-open'));
    }

    /* ── Reveal on scroll ── */
    const obs = new IntersectionObserver((entries) => {
      entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('revealed'); obs.unobserve(e.target); } });
    }, { threshold: 0.1 });
    document.querySelectorAll('[data-reveal]').forEach(el => obs.observe(el));

    /* ── Lucide icons ── */
    if (window.lucide) lucide.createIcons();
  });

  function updateIcon(btn, theme) {
    btn.innerHTML = theme === 'dark'
