<script>
function tFaq(btn){
  const fi=btn.closest('.fi'),open=fi.classList.contains('open');
  document.querySelectorAll('.fi.open').forEach(i=>i.classList.remove('open'));
  if(!open)fi.classList.add('open');
}

// Net pills filter (visual only)
document.querySelectorAll('.net-pill').forEach(p=>{
  p.addEventListener('click',()=>{
    document.querySelectorAll('.net-pill').forEach(x=>x.classList.remove('active'));
    p.classList.add('active');
  });
});

// Scroll reveal
const io=new IntersectionObserver(es=>es.forEach(e=>{
  if(e.isIntersecting){e.target.style.opacity='1';e.target.style.transform='translateY(0)'}
}),{threshold:.08});
document.querySelectorAll('.bc,.how-step,.price-col,.tcard').forEach(el=>{
  el.style.opacity='0';el.style.transform='translateY(20px)';
  el.style.transition='opacity .45s ease, transform .45s ease';
  io.observe(el);
});

// Live orders rotation
const orders=[
  {net:'📸',svc:'1.000 Seguidores IG',ago:'há 5 seg',st:'st-ok',lbl:'Entregue'},
  {net:'🎵',svc:'3.000 Views TikTok',ago:'há 18 seg',st:'st-run',lbl:'Em andamento'},
  {net:'▶️',svc:'200 Inscritos YT',ago:'há 41 seg',st:'st-ok',lbl:'Entregue'},
  {net:'📸',svc:'500 Curtidas IG',ago:'há 1 min',st:'st-run',lbl:'Em andamento'},
  {net:'🐦',svc:'100 Seguidores X',ago:'há 2 min',st:'st-pend',lbl:'Processando'},
  {net:'💼',svc:'300 Conexões LI',ago:'há 3 min',st:'st-ok',lbl:'Entregue'},
  {net:'🎬',svc:'2.000 Views Kwai',ago:'há 4 min',st:'st-run',lbl:'Em andamento'},
];
let oi=0;
setInterval(()=>{
  const rows=document.querySelectorAll('.order-row');
  if(!rows.length)return;
  const o=orders[oi%orders.length];
  const r=rows[0];
  r.style.opacity='0';r.style.transform='translateY(-8px)';
  r.style.transition='opacity .3s, transform .3s';
  setTimeout(()=>{
    r.querySelector('.order-net').textContent=o.net;
    r.querySelector('.order-svc').textContent=o.svc;
    r.querySelector('.order-qty').textContent=o.ago;
    const s=r.querySelector('.order-status');
    s.className='order-status '+o.st;
    s.textContent=o.lbl;
    r.style.opacity='1';r.style.transform='translateY(0)';
  },300);
  oi++;
},2800);
</script>
