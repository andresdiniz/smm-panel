{% extends 'base.html.twig' %}

{% block title %}PulseSMM — Crescimento com painel premium{% endblock %}
{% block description %}Painel SMM mobile-first com Pix, cartão, catálogo inteligente, CRM e análise financeira.{% endblock %}

{% block body %}
<section class="hero">
    <div class="container hero__grid">
        <div class="hero__content" data-reveal>
            <span class="pill">✦ Painel SMM mobile-first</span>
            <h1>Venda, gerencie e acompanhe pedidos com uma experiência realmente moderna</h1>
            <p>
                Pix, cartão, catálogo inteligente, pedidos em tempo real, remarketing e CRM em uma interface
                rápida, elegante e pensada primeiro para celular.
            </p>

            <div class="hero__actions">
                <a href="{{ path('app_register') }}" class="btn btn--primary btn--lg">Começar agora</a>
                <a href="{{ path('app_catalog') }}" class="btn btn--ghost btn--lg">Explorar serviços</a>
            </div>

            <div class="hero__stats">
                <div class="mini-stat">
                    <strong data-counter="12840">0</strong>
                    <span>Pedidos entregues</span>
                </div>
                <div class="mini-stat">
                    <strong data-counter="3421">0</strong>
                    <span>Clientes ativos</span>
                </div>
                <div class="mini-stat">
                    <strong data-counter="98">0</strong>
                    <span>% satisfação</span>
                </div>
            </div>
        </div>

        <div class="hero__visual" data-reveal>
            <div class="floating-card floating-card--main">
                <div class="floating-card__top">
                    <span>Receita hoje</span>
                    <strong>R$ 4.820,50</strong>
                </div>
                <div class="chart-bars" aria-hidden="true">
                    <span style="height:34%"></span>
                    <span style="height:56%"></span>
                    <span style="height:49%"></span>
                    <span style="height:78%"></span>
                    <span style="height:67%"></span>
                    <span style="height:92%"></span>
                    <span style="height:74%"></span>
                </div>
            </div>

            <div class="floating-card floating-card--small floating-card--one">
                <span>Pix confirmado</span>
                <strong>+ R$ 150,00</strong>
            </div>

            <div class="floating-card floating-card--small floating-card--two">
                <span>Pedido #4931</span>
                <strong>Em processamento</strong>
            </div>
        </div>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="section-head" data-reveal>
            <span class="pill pill--soft">Vantagens</span>
            <h2>Feito para escalar sem parecer um painel genérico</h2>
        </div>

        <div class="feature-grid">
            <article class="feature-card" data-reveal>
                <div class="feature-card__icon" aria-hidden="true">⚡</div>
                <h3>Checkout rápido</h3>
                <p>Fluxo de compra enxuto com Pix, crédito e débito, pensado para reduzir abandono.</p>
            </article>
            <article class="feature-card" data-reveal>
                <div class="feature-card__icon" aria-hidden="true">📊</div>
                <h3>Dashboard vivo</h3>
                <p>Pedidos, saldo, progresso e indicadores com visual limpo e leitura rápida no celular.</p>
            </article>
            <article class="feature-card" data-reveal>
                <div class="feature-card__icon" aria-hidden="true">🤖</div>
                <h3>Automação real</h3>
                <p>Crons, filas, e-mails e remarketing ligados ao comportamento do cliente.</p>
            </article>
        </div>
    </div>
</section>

<section class="section section--alt">
    <div class="container showcase" data-reveal>
        <div class="showcase__panel">
            <span class="showcase__eyebrow">Visão operacional</span>
            <h2>O usuário entende tudo em poucos toques</h2>
            <p>
                KPIs no topo, pedido rápido, status bem visível e histórico recente.
                A ideia é reduzir atrito e aumentar recompra.
            </p>
            <a href="{{ path('app_register') }}" class="btn btn--primary" style="margin-top:20px">Criar conta grátis</a>
        </div>

        <div class="showcase__stack">
            <div class="glass-card">
                <span>Saldo disponível</span>
                <strong>R$ 1.240,00</strong>
            </div>
            <div class="glass-card">
                <span>Pedidos ativos</span>
                <strong>12</strong>
            </div>
            <div class="glass-card">
                <span>Taxa de conversão</span>
                <strong>6,8%</strong>
            </div>
        </div>
    </div>
</section>
{% endblock %}
