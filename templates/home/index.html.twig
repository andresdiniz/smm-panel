<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AcheiSMM — Seguidores, Curtidas e Engajamento Real</title>
<meta name="description" content="Painel SMM #1 do Brasil. Seguidores, curtidas, views para Instagram, TikTok, YouTube. Entrega automática a partir de R$1,00.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,400&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg:#080810;--s1:#0e0e1a;--s2:#13131f;--s3:#181826;
  --bd:rgba(255,255,255,0.07);--bd2:rgba(255,255,255,0.12);
  --tx:#eeeef5;--mu:#7878a0;--fa:#33334a;
  --p:#7c3aed;--p2:#a855f7;--pg:linear-gradient(135deg,#7c3aed,#a855f7);
  --glow:rgba(124,58,237,0.3);
  --gr:#22c55e;--go:#f59e0b;
  --r:12px;--rs:8px;--rl:20px;
  --nav:60px;
}
html{scroll-behavior:smooth;-webkit-font-smoothing:antialiased}
body{font-family:'Inter',sans-serif;background:var(--bg);color:var(--tx);line-height:1.5;overflow-x:hidden;font-size:15px}
a{color:inherit;text-decoration:none}
button{cursor:pointer;font-family:inherit}

/* ══ NAV ══ */
nav{
  position:fixed;top:0;left:0;right:0;z-index:200;
  height:var(--nav);
  display:flex;align-items:center;justify-content:space-between;
  padding:0 clamp(1rem,4vw,2.5rem);
  background:rgba(8,8,16,0.8);backdrop-filter:blur(20px);
  border-bottom:1px solid var(--bd);
}
.logo{display:flex;align-items:center;gap:9px;font-weight:800;font-size:1.05rem;letter-spacing:-.025em}
.logo-mark{
  width:30px;height:30px;border-radius:8px;
  background:var(--pg);display:flex;align-items:center;justify-content:center;flex-shrink:0;
}
.logo-mark svg{width:16px;height:16px}
.logo-text{background:var(--pg);-webkit-background-clip:text;-webkit-text-fill-color:transparent}
.nav-mid{display:flex;gap:1.75rem}
.nav-mid a{color:var(--mu);font-size:.85rem;font-weight:500;transition:color .18s}
.nav-mid a:hover{color:var(--tx)}
.nav-end{display:flex;gap:.6rem}
.btn{
  display:inline-flex;align-items:center;justify-content:center;gap:5px;
  padding:.45rem 1.1rem;border-radius:9999px;
  font-size:.82rem;font-weight:600;border:none;transition:all .18s;
}
.btn-g{background:transparent;color:var(--mu);border:1px solid var(--bd)}
.btn-g:hover{color:var(--tx);border-color:var(--bd2)}
.btn-p{background:var(--pg);color:#fff;box-shadow:0 0 18px var(--glow)}
.btn-p:hover{transform:translateY(-1px);box-shadow:0 0 28px var(--glow)}
.btn-lg{padding:.72rem 1.75rem;font-size:.95rem}
.btn-xl{padding:.9rem 2.25rem;font-size:1rem;border-radius:9999px}

/* ══ TICKER ══ */
.ticker{
  background:linear-gradient(90deg,rgba(124,58,237,.12),rgba(124,58,237,.06),rgba(124,58,237,.12));
  border-bottom:1px solid rgba(124,58,237,.2);
  overflow:hidden;height:34px;display:flex;align-items:center;
  margin-top:var(--nav);
}
.ticker-inner{
  display:flex;gap:0;white-space:nowrap;
  animation:ticker 30s linear infinite;
}
.ticker-inner:hover{animation-play-state:paused}
@keyframes ticker{0%{transform:translateX(0)}100%{transform:translateX(-50%)}}
.ticker-item{
  display:inline-flex;align-items:center;gap:.4rem;
  padding:0 1.5rem;font-size:.75rem;font-weight:600;color:var(--mu);
}
.ticker-item b{color:var(--tx)}
.ticker-dot{width:4px;height:4px;border-radius:50%;background:var(--p2);flex-shrink:0}

/* ══ HERO ══ */
.hero{
  padding:3rem clamp(1rem,4vw,2.5rem) 0;
  max-width:1200px;margin:0 auto;
}
.hero-top{
  display:grid;grid-template-columns:1fr auto;
  align-items:start;gap:2rem;margin-bottom:1.75rem;
}
.hero-badge{
  display:inline-flex;align-items:center;gap:6px;
  padding:.28rem .8rem;border-radius:9999px;
  background:rgba(124,58,237,.12);border:1px solid rgba(124,58,237,.28);
  font-size:.72rem;font-weight:700;color:#c084fc;
  margin-bottom:.9rem;letter-spacing:.02em;
}
.hero-badge i{width:6px;height:6px;border-radius:50%;background:var(--gr);display:inline-block;animation:blink 2s infinite}
@keyframes blink{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.4;transform:scale(1.5)}}
.hero h1{
  font-size:clamp(2rem,5vw,4rem);font-weight:900;
  line-height:1.0;letter-spacing:-.04em;margin-bottom:.8rem;
}
.hero h1 em{
  font-style:normal;
  background:linear-gradient(135deg,#c084fc 0%,#a855f7 40%,#7c3aed 70%,#6366f1 100%);
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;
}
.hero-sub{font-size:.95rem;color:var(--mu);line-height:1.65;max-width:480px;margin-bottom:1.25rem}
.hero-actions{display:flex;gap:.75rem;flex-wrap:wrap;margin-bottom:1rem}
.hero-trust{display:flex;align-items:center;gap:.65rem;font-size:.78rem;color:var(--mu)}
.avatars{display:flex}
.av{
  width:26px;height:26px;border-radius:50%;border:2px solid var(--bg);
  background:var(--pg);display:flex;align-items:center;justify-content:center;
  font-size:.55rem;font-weight:800;color:#fff;margin-left:-6px;
}
.av:first-child{margin-left:0}
.trust-sep{width:1px;height:14px;background:var(--bd)}
.trust-item{display:flex;align-items:center;gap:.3rem}
.trust-item svg{width:13px;height:13px;color:var(--gr)}

/* ══ BENTO ══ */
.hero-bento{
  display:grid;
  grid-template-columns:repeat(12,1fr);
  grid-template-rows:auto;
  gap:.75rem;
  padding-bottom:3rem;
}
.bc{
  background:var(--s1);border:1px solid var(--bd);
  border-radius:var(--r);overflow:hidden;
  transition:border-color .22s, transform .22s;
}
.bc:hover{border-color:var(--bd2);transform:translateY(-2px)}

/* card 1 — stats wide */
.bc-stats{
  grid-column:span 8;
  display:grid;grid-template-columns:repeat(4,1fr);
  divide-x:1px solid var(--bd);
}
.bc-stat{
  padding:1.25rem 1.25rem;
  border-right:1px solid var(--bd);
  display:flex;flex-direction:column;justify-content:space-between;
}
.bc-stat:last-child{border-right:none}
.bc-stat-num{
  font-size:clamp(1.4rem,2.5vw,2rem);font-weight:900;letter-spacing:-.04em;
  background:var(--pg);-webkit-background-clip:text;-webkit-text-fill-color:transparent;
  line-height:1;
}
.bc-stat-label{font-size:.72rem;color:var(--mu);margin-top:.3rem}
.bc-stat-sub{font-size:.68rem;color:var(--fa);margin-top:.15rem}

/* card 2 — live orders */
.bc-live{
  grid-column:span 4;
  padding:1.25rem;
  display:flex;flex-direction:column;gap:.65rem;
}
.bc-live-header{display:flex;justify-content:space-between;align-items:center}
.bc-live-title{font-size:.78rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--mu)}
.live-badge{
  display:flex;align-items:center;gap:4px;
  font-size:.67rem;font-weight:700;color:var(--gr);
}
.live-dot{width:5px;height:5px;border-radius:50%;background:var(--gr);animation:blink 1.5s infinite}
.order-row{
  display:flex;align-items:center;gap:.6rem;
  padding:.5rem .6rem;border-radius:var(--rs);
  background:var(--s2);
  font-size:.75rem;
}
.order-net{font-size:1rem;flex-shrink:0}
.order-info{flex:1;min-width:0}
.order-svc{font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.order-qty{color:var(--mu);font-size:.68rem}
.order-status{
  font-size:.67rem;font-weight:700;padding:.15rem .45rem;
  border-radius:9999px;white-space:nowrap;
}
.st-ok{background:rgba(34,197,94,.12);color:var(--gr)}
.st-run{background:rgba(124,58,237,.12);color:var(--p2)}
.st-pend{background:rgba(245,158,11,.1);color:var(--go)}

/* card 3 — redes row */
.bc-nets{
  grid-column:span 12;
  padding:.9rem 1.25rem;
  display:flex;align-items:center;gap:0;
  overflow-x:auto;scrollbar-width:none;
}
.bc-nets::-webkit-scrollbar{display:none}
.net-pill{
  display:flex;align-items:center;gap:.4rem;
  padding:.45rem .9rem;border-radius:9999px;
  border:1px solid var(--bd);
  font-size:.78rem;font-weight:600;
  white-space:nowrap;cursor:pointer;
  transition:all .18s;flex-shrink:0;margin-right:.5rem;
}
.net-pill:hover,.net-pill.active{border-color:rgba(124,58,237,.4);background:rgba(124,58,237,.08);color:var(--tx)}
.net-pill span{font-size:1rem}
.net-count{font-size:.67rem;color:var(--mu)}

/* card 4 — how 4 cols */
.bc-how{
  grid-column:span 12;
  display:grid;grid-template-columns:repeat(4,1fr);
  gap:0;
}
.how-step{
  padding:1.5rem 1.5rem;
  border-right:1px solid var(--bd);
  position:relative;
}
.how-step:last-child{border-right:none}
.how-n{
  font-size:2rem;font-weight:900;letter-spacing:-.05em;line-height:1;
  background:linear-gradient(135deg,rgba(168,85,247,.25),rgba(124,58,237,.08));
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;
  margin-bottom:.6rem;
}
.how-t{font-size:.88rem;font-weight:700;margin-bottom:.35rem}
.how-d{font-size:.78rem;color:var(--mu);line-height:1.55}
.how-step::after{
  content:attr(data-n);
  position:absolute;top:.75rem;right:.75rem;
  font-size:.65rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;
  color:var(--fa);
}

/* card 5 — pricing 3 cols */
.bc-pricing{
  grid-column:span 12;
  display:grid;grid-template-columns:repeat(3,1fr);
  gap:0;
}
.price-col{
  padding:1.75rem 1.5rem;
  border-right:1px solid var(--bd);
  display:flex;flex-direction:column;gap:1rem;
  position:relative;
}
.price-col:last-child{border-right:none}
.price-col.pop{
  background:linear-gradient(145deg,rgba(124,58,237,.07),transparent);
}
.pop-tag{
  position:absolute;top:1.25rem;right:1.25rem;
  background:var(--pg);color:#fff;
  font-size:.65rem;font-weight:800;letter-spacing:.06em;text-transform:uppercase;
  padding:.18rem .55rem;border-radius:9999px;
}
.p-icon{font-size:1.4rem}
.p-name{font-size:.7rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--mu)}
.p-price{display:flex;align-items:baseline;gap:3px;line-height:1}
.p-cur{font-size:.85rem;font-weight:700;color:var(--mu)}
.p-amt{font-size:2.2rem;font-weight:900;letter-spacing:-.04em}
.p-per{font-size:.72rem;color:var(--mu);align-self:flex-end;padding-bottom:.15rem}
.p-desc{font-size:.78rem;color:var(--mu);line-height:1.55}
.p-feats{list-style:none;display:flex;flex-direction:column;gap:.4rem}
.p-feats li{font-size:.78rem;display:flex;align-items:center;gap:6px}
.p-feats li::before{content:'✓';color:var(--gr);font-weight:800;flex-shrink:0;font-size:.75rem}
.price-cta{margin-top:auto}

/* card 6 — testimonials + faq row */
.bc-social{grid-column:span 7;padding:1.5rem}
.bc-faq{grid-column:span 5;padding:1.25rem;display:flex;flex-direction:column;gap:.4rem}

.testi-head{margin-bottom:1rem}
.testi-title{font-size:.72rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--mu);margin-bottom:.4rem}
.testi-stars{color:#facc15;font-size:.8rem;letter-spacing:1px}
.testi-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:.6rem}
.tcard{background:var(--s2);border-radius:var(--rs);padding:.9rem}
.tc-txt{font-size:.75rem;color:var(--mu);line-height:1.6;margin-bottom:.65rem}
.tc-auth{display:flex;align-items:center;gap:.45rem}
.tc-av{
  width:26px;height:26px;border-radius:50%;flex-shrink:0;
  background:var(--pg);display:flex;align-items:center;justify-content:center;
  font-size:.55rem;font-weight:800;color:#fff;
}
.tc-name{font-size:.75rem;font-weight:600}
.tc-hand{font-size:.67rem;color:var(--fa)}

.faq-head{font-size:.72rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--mu);margin-bottom:.6rem}
.fi{border-bottom:1px solid var(--bd);overflow:hidden}
.fi:first-of-type{border-top:1px solid var(--bd)}
.fq{
  width:100%;background:transparent;border:none;color:var(--tx);
  padding:.7rem 0;text-align:left;font-size:.8rem;font-weight:600;
  display:flex;justify-content:space-between;align-items:center;gap:.75rem;
  font-family:inherit;
}
.fq-ic{font-size:1rem;color:var(--p2);flex-shrink:0;transition:transform .22s}
.fa-ans{max-height:0;overflow:hidden;transition:max-height .28s ease}
.fa-ans p{font-size:.75rem;color:var(--mu);line-height:1.6;padding-bottom:.7rem}
.fi.open .fq-ic{transform:rotate(45deg)}
.fi.open .fa-ans{max-height:160px}

/* card 7 — CTA banner */
.bc-cta{
  grid-column:span 12;
  padding:2.5rem;
  background:linear-gradient(135deg,rgba(124,58,237,.1),rgba(99,102,241,.06));
  border-color:rgba(124,58,237,.25) !important;
  display:flex;align-items:center;justify-content:space-between;gap:2rem;
  flex-wrap:wrap;
}
.cta-text h2{font-size:clamp(1.3rem,2.5vw,1.8rem);font-weight:900;letter-spacing:-.03em;margin-bottom:.35rem}
.cta-text p{font-size:.85rem;color:var(--mu)}
.cta-btns{display:flex;gap:.75rem;flex-wrap:wrap;flex-shrink:0}

/* ══ FOOTER ══ */
footer{
  border-top:1px solid var(--bd);
  padding:1.5rem clamp(1rem,4vw,2.5rem);
}
.foot{
  max-width:1200px;margin:0 auto;
  display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:1rem;
}
.foot-logo{display:flex;align-items:center;gap:8px;font-weight:800;font-size:.9rem;letter-spacing:-.02em}
.foot-txt{color:var(--p2)}
.foot-links{display:flex;gap:1.25rem}
.foot-links a{font-size:.75rem;color:var(--fa);transition:color .18s}
.foot-links a:hover{color:var(--mu)}
.foot-copy{font-size:.72rem;color:var(--fa)}

/* ══ SCROLL ══ */
::-webkit-scrollbar{width:5px}::-webkit-scrollbar-track{background:var(--bg)}::-webkit-scrollbar-thumb{background:var(--fa);border-radius:3px}

/* ══ MOBILE ══ */
@media(max-width:768px){
  .nav-mid,.nav-end .btn-g{display:none}
  .hero-top{grid-template-columns:1fr}
  .bc-stats{grid-column:span 12;grid-template-columns:repeat(2,1fr)}
  .bc-live{grid-column:span 12}
  .bc-how{grid-template-columns:repeat(2,1fr)}
  .how-step:nth-child(2){border-right:none}
  .how-step:nth-child(1),.how-step:nth-child(2){border-bottom:1px solid var(--bd)}
  .bc-pricing{grid-template-columns:1fr}
  .price-col{border-right:none;border-bottom:1px solid var(--bd)}
  .price-col:last-child{border-bottom:none}
  .bc-social{grid-column:span 12}
  .bc-faq{grid-column:span 12}
  .testi-grid{grid-template-columns:1fr}
}
@media(max-width:480px){
  .bc-stats{grid-template-columns:repeat(2,1fr)}
  .bc-stat:nth-child(even){border-right:none}
  .bc-stat{border-bottom:1px solid var(--bd)}
}
</style>
</head>
