{% extends 'base.html.twig' %}

{% block title %}PulseSMM — serviços para suas redes sociais{% endblock %}
{% block description %}Conheça serviços para redes sociais, consulte preços no catálogo público e gerencie seus pedidos em um só lugar.{% endblock %}

{% block body %}
<main class="home-page">
    <section class="hero">
        <div class="hero-copy">
            <p class="eyebrow">PulseSMM</p>
            <h1>Encontre serviços para impulsionar sua presença nas redes sociais</h1>
            <p>Explore o catálogo, compare os serviços disponíveis e acompanhe seus pedidos em uma área simples e organizada.</p>
            <div class="hero-actions">
                <a class="btn btn-primary" href="{{ path('app_catalog') }}">Explorar serviços</a>
                <a class="btn btn-secondary" href="{{ path('app_how_it_works') }}">Como funciona</a>
            </div>
        </div>
        <div class="hero-card">
            <h2>Comece em poucos passos</h2>
            <ul>
                <li>Consulte serviços e preços sem criar conta.</li>
                <li>Crie sua conta para enviar um pedido.</li>
                <li>Acompanhe o andamento pelo painel.</li>
            </ul>
        </div>
    </section>

    <section class="feature-grid">
        <article>
            <h2>Catálogo transparente</h2>
            <p>Veja preços, quantidades mínimas e máximas antes de fazer seu pedido.</p>
        </article>
        <article>
            <h2>Pedidos organizados</h2>
            <p>Consulte o histórico e o status dos pedidos na sua conta.</p>
        </article>
        <article>
            <h2>Área do cliente</h2>
            <p>Gerencie sua carteira e acompanhe as movimentações em um só lugar.</p>
        </article>
    </section>

    <section class="public-cta">
        <h2>Pronto para começar?</h2>
        <p>Veja o catálogo público ou crie uma conta para acessar os pedidos.</p>
        <div class="hero-actions">
            <a class="btn btn-secondary" href="{{ path('app_catalog') }}">Ver catálogo</a>
            <a class="btn btn-primary" href="{{ path('app_register') }}">Criar conta</a>
        </div>
    </section>
</main>
{% endblock %}
