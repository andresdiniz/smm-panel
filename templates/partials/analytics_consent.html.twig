{% set currentRoute = app.request.attributes.get('_route')|default('') %}
{% set clarityRestrictedPage = app.user or currentRoute starts with 'admin_' or currentRoute starts with 'app_dashboard' or currentRoute starts with 'app_wallet_' or currentRoute starts with 'app_order_' or currentRoute starts with 'app_profile' or currentRoute starts with 'app_transaction_' or currentRoute starts with 'support_' or currentRoute starts with 'affiliate_' or currentRoute in ['app_login', 'app_logout', 'app_register', 'app_forgot_password', 'app_reset_password'] %}
{% if google_tag_manager_id starts with 'GTM-' or (not clarityRestrictedPage and clarity_project_id is not empty) %}
    <style>
        .cookie-preferences-link { padding: 0; border: 0; background: none; color: inherit; font: inherit; text-decoration: underline; cursor: pointer; }
        .cookie-consent { position: fixed; z-index: 1000; right: 16px; bottom: 16px; width: min(440px, calc(100vw - 32px)); padding: 20px; border: 1px solid #d5dfdf; border-radius: 16px; background: #fff; color: #172a2c; box-shadow: 0 16px 48px rgb(15 35 38 / 20%); font: 14px/1.55 system-ui, sans-serif; }
        .cookie-consent[hidden] { display: none; }
        .cookie-consent p { margin: 0 0 14px; }
        .cookie-consent a { color: #075e64; }
        .cookie-consent__actions { display: flex; flex-wrap: wrap; gap: 8px; }
        .cookie-consent__button { min-height: 40px; padding: 8px 13px; border: 1px solid #b8c8c9; border-radius: 9px; background: #fff; color: #17464a; font: inherit; font-weight: 700; cursor: pointer; }
        .cookie-consent__button--accept { border-color: #075e64; background: #075e64; color: #fff; }
        @media (max-width: 520px) { .cookie-consent { right: 10px; bottom: 10px; width: calc(100vw - 20px); } }
    </style>
    <section class="cookie-consent" id="cookie-consent" role="dialog" aria-modal="false" aria-labelledby="cookie-consent-title" hidden>
        <strong id="cookie-consent-title">Sua privacidade importa</strong>
        <p>Usamos Google Tag Manager e Microsoft Clarity para medições opcionais somente após sua autorização. Você pode aceitar ou recusar e alterar a escolha depois. <a href="{{ path('cookies') }}">Política de Cookies</a>.</p>
        <div class="cookie-consent__actions">
            <button class="cookie-consent__button cookie-consent__button--accept" type="button" data-cookie-choice="granted">Aceitar análise</button>
            <button class="cookie-consent__button" type="button" data-cookie-choice="denied">Recusar</button>
        </div>
    </section>
    <script>
        (function () {
            var containerId = {{ google_tag_manager_id|json_encode(constant('JSON_HEX_TAG'))|raw }};
            var clarityId = {{ clarity_project_id|json_encode(constant('JSON_HEX_TAG'))|raw }};
            var hasTagManager = /^GTM-[A-Z0-9]+$/.test(containerId);
            var hasClarity = !{{ clarityRestrictedPage ? 'true' : 'false' }} && /^[A-Za-z0-9]+$/.test(clarityId);
            if (!hasTagManager && !hasClarity) return;

            var banner = document.getElementById('cookie-consent');
            var preferenceButton = document.querySelector('[data-cookie-preferences]');
            var tagManagerLoaded = false;
            var clarityLoaded = false;
            var tagManagerConsentInitialized = false;

            function initializeTagManagerConsent() {
                if (!hasTagManager) return;
                window.dataLayer = window.dataLayer || [];
                window.gtag = window.gtag || function () { window.dataLayer.push(arguments); };
                if (tagManagerConsentInitialized) return;
                tagManagerConsentInitialized = true;
                window.gtag('consent', 'default', {
                    analytics_storage: 'denied',
                    ad_storage: 'denied',
                    ad_user_data: 'denied',
                    ad_personalization: 'denied'
                });
            }

            function updateTagManagerConsent(choice) {
                initializeTagManagerConsent();
                if (!hasTagManager || !window.gtag) return;
                window.gtag('consent', 'update', {
                    analytics_storage: choice === 'granted' ? 'granted' : 'denied',
                    ad_storage: 'denied',
                    ad_user_data: 'denied',
                    ad_personalization: 'denied'
                });
            }

            function loadTagManager() {
                if (!hasTagManager || tagManagerLoaded) return;
                initializeTagManagerConsent();
                tagManagerLoaded = true;
                window.dataLayer.push({'gtm.start': Date.now(), event: 'gtm.js'});

                var script = document.createElement('script');
                script.async = true;
                script.src = 'https://www.googletagmanager.com/gtm.js?id=' + containerId;
                script.onerror = function () {
                    tagManagerLoaded = false;
                    console.error('Não foi possível carregar o Google Tag Manager.');
                };
                document.head.appendChild(script);
            }

            function updateClarityConsent(choice) {
                if (!hasClarity || typeof window.clarity !== 'function') return;
                window.clarity('consentv2', {
                    ad_Storage: 'denied',
                    analytics_Storage: choice === 'granted' ? 'granted' : 'denied'
                });
            }

            function loadClarity() {
                if (!hasClarity) return;
                window.clarity = window.clarity || function () {
                    (window.clarity.q = window.clarity.q || []).push(arguments);
                };
                updateClarityConsent('granted');
                if (clarityLoaded) return;
                clarityLoaded = true;

                var script = document.createElement('script');
                script.async = true;
                script.src = 'https://www.clarity.ms/tag/' + clarityId + '?ref=bwt';
                script.onerror = function () {
                    clarityLoaded = false;
                    console.error('Não foi possível carregar o Microsoft Clarity.');
                };
                document.head.appendChild(script);
            }

            initializeTagManagerConsent();

            function saveChoice(choice) {
                if (choice !== 'granted' && choice !== 'denied') return;
                try {
                    window.localStorage.setItem('pulse_analytics_consent', choice);
                } catch (error) {
                    console.warn('Não foi possível salvar a preferência de cookies neste navegador.', error);
                }
                banner.hidden = true;
                updateTagManagerConsent(choice);
                if (choice === 'granted') {
                    loadTagManager();
                    loadClarity();
                } else {
                    updateClarityConsent('denied');
                }
            }

            document.querySelectorAll('[data-cookie-choice]').forEach(function (button) {
                button.addEventListener('click', function () {
                    saveChoice(button.dataset.cookieChoice);
                });
            });
            if (preferenceButton) {
                preferenceButton.addEventListener('click', function () {
                    banner.hidden = false;
                });
            }

            var choice = null;
            try {
                choice = window.localStorage.getItem('pulse_analytics_consent');
            } catch (error) {
                console.warn('Não foi possível ler a preferência de cookies neste navegador.', error);
            }
            if (choice === 'granted') {
                updateTagManagerConsent('granted');
                loadTagManager();
                loadClarity();
            } else if (choice === 'denied') {
                updateTagManagerConsent('denied');
                updateClarityConsent('denied');
            }
            if (choice !== 'granted' && choice !== 'denied') banner.hidden = false;
        })();
    </script>
{% endif %}
