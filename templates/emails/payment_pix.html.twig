{% extends 'emails/layout.html.twig' %}

{% block title %}Pague via Pix — R$ {{ (payment.amountCents / 100)|number_format(2, ',', '.') }}{% endblock %}

{% block content %}
<h1 style="color:#1a1a2e;font-size:22px;margin-bottom:8px">Pague via Pix</h1>
<p style="color:#555">Olá, <strong>{{ payment.user.name }}</strong>!</p>
<p style="color:#555;margin-bottom:24px">
    Valor: <strong>R$ {{ (payment.amountCents / 100)|number_format(2, ',', '.') }}</strong><br>
    Expira em: {{ payment.pixExpiresAt|date('d/m/Y H:i') }}
</p>

{% if payment.pixQrCodeUrl %}
<div style="text-align:center;margin:24px 0">
    <img src="{{ payment.pixQrCodeUrl }}" alt="QR Code Pix" width="200" height="200"
         style="border:1px solid #e5e7eb;padding:8px;border-radius:8px">
</div>
{% endif %}

<p style="color:#555;font-size:13px;margin-bottom:8px">Ou copie o código abaixo:</p>
<div style="background:#f3f4f6;border-radius:6px;padding:12px 16px;font-family:monospace;font-size:12px;word-break:break-all">
    {{ payment.pixPayload }}
</div>
{% endblock %}
