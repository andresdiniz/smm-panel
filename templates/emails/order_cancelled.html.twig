{% extends 'emails/base.html.twig' %}

{% block subject %}Pedido #{{ order.id }} cancelado — PulseSMM{% endblock %}

{% block body %}
<div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; background: #ffffff;">

    <!-- Header -->
    <div style="background: #c0392b; padding: 32px 24px; text-align: center; border-radius: 8px 8px 0 0;">
        <h1 style="color: #ffffff; margin: 0; font-size: 24px;">&#10060; Pedido Cancelado</h1>
    </div>

    <!-- Body -->
    <div style="padding: 32px 24px;">
        <p style="font-size: 16px; color: #333;">Olá, <strong>{{ user.name }}</strong>!</p>
        <p style="font-size: 15px; color: #555;">Infelizmente seu pedido foi cancelado pelo provedor. O valor cobrado foi <strong>reembolsado automaticamente</strong> para sua carteira.</p>

        <!-- Box do pedido -->
        <div style="background: #fdf2f2; border: 1px solid #f5c6cb; border-radius: 8px; padding: 20px; margin: 24px 0;">
            <h2 style="color: #c0392b; font-size: 18px; margin: 0 0 12px;">Pedido #{{ order.id }}</h2>
            <p style="margin: 0; font-size: 14px; color: #555;">{{ order.service.name }}</p>
            {% if order.service.provider is defined %}
            <p style="margin: 4px 0 0; font-size: 13px; color: #888;">{{ order.service.provider }}</p>
            {% endif %}
        </div>

        <!-- Detalhes -->
        <div style="background: #f8f9fa; border-radius: 8px; padding: 20px; margin-bottom: 24px;">
            <table style="width: 100%; font-size: 14px; color: #444;">
                <tr>
                    <td style="padding: 6px 0;"><strong>Quantidade:</strong></td>
                    <td style="text-align: right;">{{ order.quantity }}</td>
                </tr>
                <tr>
                    <td style="padding: 6px 0;"><strong>Valor reembolsado:</strong></td>
                    <td style="text-align: right;">R$ {{ (order.amountCents / 100)|number_format(2, ',', '.') }}</td>
                </tr>
                <tr>
                    <td style="padding: 6px 0;"><strong>Status:</strong></td>
                    <td style="text-align: right; color: #c0392b;">Cancelado</td>
                </tr>
                <tr>
                    <td style="padding: 6px 0;"><strong>Data:</strong></td>
                    <td style="text-align: right;">{{ order.createdAt|date('d/m/Y H:i') }}</td>
                </tr>
            </table>
        </div>

        <p style="font-size: 14px; color: #666;">O saldo foi creditado na sua carteira e já está disponível para um novo pedido.</p>

        <!-- CTA -->
        <div style="text-align: center; margin-top: 32px;">
            <a href="{{ app.request.schemeAndHttpHost }}/dashboard"
               style="background: #27ae60; color: #fff; padding: 14px 32px; border-radius: 50px;
                      text-decoration: none; font-size: 15px; font-weight: bold; display: inline-block;">
                Ver meu painel
            </a>
        </div>
    </div>

    <!-- Footer -->
    <div style="background: #f1f1f1; padding: 16px 24px; text-align: center; border-radius: 0 0 8px 8px;">
        <p style="font-size: 12px; color: #999; margin: 0;">PulseSMM &mdash; Suporte: contato@pulsesmm.com.br</p>
    </div>

</div>
{% endblock %}
