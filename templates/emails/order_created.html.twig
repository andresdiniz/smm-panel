{% extends 'emails/layout.html.twig' %}

{% block title %}Pedido #{{ order.id }} recebido{% endblock %}

{% block content %}
<h1 style="color:#1a1a2e;font-size:22px;margin-bottom:16px">
    Olá, {{ order.user.name }}!
</h1>
<p style="color:#555;line-height:1.6">
    Recebemos seu pedido <strong>#{{ order.id }}</strong> para o serviço
    <strong>{{ order.service.name }}</strong>.
</p>

<table style="width:100%;border-collapse:collapse;margin:24px 0">
    <tr style="background:#f8f8f8">
        <td style="padding:10px 16px;font-weight:600">Serviço</td>
        <td style="padding:10px 16px">{{ order.service.name }}</td>
    </tr>
    <tr>
        <td style="padding:10px 16px;font-weight:600">Quantidade</td>
        <td style="padding:10px 16px">{{ order.quantity|number_format(0, ',', '.') }}</td>
    </tr>
    <tr style="background:#f8f8f8">
        <td style="padding:10px 16px;font-weight:600">Link alvo</td>
        <td style="padding:10px 16px">{{ order.targetUrl }}</td>
    </tr>
    <tr>
        <td style="padding:10px 16px;font-weight:600">Valor pago</td>
        <td style="padding:10px 16px">R$ {{ (order.priceCents / 100)|number_format(2, ',', '.') }}</td>
    </tr>
    <tr style="background:#f8f8f8">
        <td style="padding:10px 16px;font-weight:600">Status</td>
        <td style="padding:10px 16px">{{ order.status.label() }}</td>
    </tr>
</table>

<p style="color:#555">Acompanhe o progresso acessando o painel:</p>
<a href="{{ url('app_order_show', {id: order.id}) }}"
   style="display:inline-block;background:#4f46e5;color:#fff;padding:12px 24px;border-radius:6px;text-decoration:none;font-weight:600">
    Ver meu pedido
</a>
{% endblock %}
