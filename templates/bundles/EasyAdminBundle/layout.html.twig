{% extends '@!EasyAdmin/layout.html.twig' %}

{#
  Fix SVG gigante: o EasyAdmin injeta um <svg> sprite invisivel no topo do body.
  CSS externo chega tarde demais. Este <style> no <head> garante que o browser
  receba a regra ANTES de renderizar o body.
#}
{% block head_stylesheets %}
  {{ parent() }}
  <style>
    /* Esconde o sprite SVG que o EasyAdmin injeta no body */
    body > svg:first-of-type,
    body > svg[style*="display:none"],
    body > svg[aria-hidden] {
      display: none !important;
      width: 0 !important;
      height: 0 !important;
      position: absolute !important;
      overflow: hidden !important;
    }

    /* Qualquer SVG sem width/height declarado: cap em 20px */
    svg:not([width]):not([style*="width"]) {
      max-width: 20px !important;
      max-height: 20px !important;
      width: 20px !important;
      height: 20px !important;
    }

    /* Excecoes: SVGs com width inline (nossos icones) */
    svg[style*="width:12px"] { width:12px !important; height:12px !important; max-width:12px !important; max-height:12px !important; }
    svg[style*="width:16px"] { width:16px !important; height:16px !important; max-width:16px !important; max-height:16px !important; }
    svg[style*="width:24px"] { width:24px !important; height:24px !important; max-width:24px !important; max-height:24px !important; }
    svg[style*="width:28px"] { width:28px !important; height:28px !important; max-width:28px !important; max-height:28px !important; }
    svg[style*="width:32px"] { width:32px !important; height:32px !important; max-width:32px !important; max-height:32px !important; }

    /* Dropdown do usuario: icones pequenos */
    .dropdown-menu svg,
    [class*="user"] svg,
    [class*="avatar"] svg {
      width: 16px !important;
      height: 16px !important;
      max-width: 16px !important;
      max-height: 16px !important;
    }
  </style>
{% endblock %}
