{% extends 'base.html.twig' %}

{% block navbar %}{% endblock %}

{% block body %}
<div class="app-layout">
    {# SIDEBAR #}
    <aside class="sidebar" id="sidebar">
        <div class="sidebar__header">
            <a href="{{ path('app_home') }}" class="sidebar__logo">
                <svg width="28" height="28" viewBox="0 0 32 32" fill="none">
                    <rect width="32" height="32" rx="8" fill="#4f46e5"/>
                    <path d="M8 22 L14 10 L20 18 L23 14 L28 22" stroke="#fff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
                </svg>
                <span>SMM Panel</span>
            </a>
        </div>

        <nav class="sidebar__nav">
            <a href="{{ path('app_dashboard') }}" class="sidebar__link {% if app.request.attributes.get('_route') == 'app_dashboard' %}is-active{% endif %}">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/></svg>
                Dashboard
            </a>
            <a href="{{ path('app_catalog') }}" class="sidebar__link">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg>
                Catálogo
            </a>
            <a href="{{ path('app_order_index') }}" class="sidebar__link">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 11 12 14 22 4"/><path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"/></svg>
                Meus pedidos
            </a>
            <a href="{{ path('app_wallet_index') }}" class="sidebar__link">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>
                Carteira
                <span class="sidebar__badge">R$ {{ (app.user.wallet.balanceCents / 100)|number_format(2, ',', '.') }}</span>
            </a>
            <a href="{{ path('app_profile') }}" class="sidebar__link">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                Meu perfil
            </a>
            <a href="{{ path('app_support') }}" class="sidebar__link">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 015.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                Suporte
            </a>
        </nav>

        <div class="sidebar__footer">
            <div class="sidebar__user">
                <div class="sidebar__avatar">{{ app.user.name|first|upper }}</div>
                <div>
                    <div class="sidebar__user-name">{{ app.user.name }}</div>
                    <div class="sidebar__user-email">{{ app.user.email }}</div>
                </div>
            </div>
            <a href="{{ path('app_logout') }}" class="sidebar__logout" title="Sair">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
            </a>
        </div>
    </aside>

    {# MAIN #}
    <div class="app-main">
        <header class="app-topbar">
            <button class="sidebar-toggle" id="sidebarToggle" aria-label="Toggle sidebar">
                <span></span><span></span><span></span>
            </button>
            <h1 class="app-topbar__title">{% block page_title %}{% endblock %}</h1>
            <div class="app-topbar__actions">
                <button data-theme-toggle class="btn btn-icon" aria-label="Alternar tema">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2"/></svg>
                </button>
            </div>
        </header>
        <div class="app-content">
            {% for flash_type, messages in app.flashes(['success','error','warning','info']) %}
                {% for message in messages %}
                    <div class="flash flash--{{ flash_type }}">{{ message }}<button onclick="this.parentElement.remove()">&times;</button></div>
                {% endfor %}
            {% endfor %}
            {% block dashboard_body %}{% endblock %}
        </div>
    </div>
</div>
{% endblock %}
