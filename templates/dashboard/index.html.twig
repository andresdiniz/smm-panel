{% extends 'dashboard/layout.html.twig' %}

{% block page_title %}Dashboard{% endblock %}

{% block dashboard_body %}
{# KPIs #}
<div class="kpi-grid">
    <div class="kpi-card">
        <span class="kpi-card__label">Saldo disponível</span>
        <span class="kpi-card__value">R$ {{ (wallet.balanceCents / 100)|number_format(2, ',', '.') }}</span>
        <a href="{{ path('app_wallet_deposit') }}" class="kpi-card__action">+ Adicionar saldo</a>
    </div>
    <div class="kpi-card">
        <span class="kpi-card__label">Pedidos este mês</span>
        <span class="kpi-card__value">{{ stats.ordersThisMonth }}</span>
        <span class="kpi-card__sub">{{ stats.ordersTotal }} no total</span>
    </div>
    <div class="kpi-card">
        <span class="kpi-card__label">Gasto este mês</span>
        <span class="kpi-card__value">R$ {{ (stats.spentThisMonth / 100)|number_format(2, ',', '.') }}</span>
    </div>
    <div class="kpi-card">
        <span class="kpi-card__label">Pedidos em andamento</span>
        <span class="kpi-card__value kpi-card__value--active">{{ stats.ordersActive }}</span>
    </div>
</div>

{# QUICK ORDER #}
<div class="card mt-8">
    <div class="card__header">
        <h2>Novo pedido rápido</h2>
    </div>
    <div class="card__body">
        <form method="post" action="{{ path('app_order_new') }}" class="quick-order-form">
            <input type="hidden" name="_token" value="{{ csrf_token('new_order') }}">
            <div class="form-row">
                <div class="form-group">
                    <label for="service_id">Serviço</label>
                    <select id="service_id" name="service_id" class="form-control" required>
                        <option value="">Selecione…</option>
                        {% for category, services in servicesGrouped %}
                        <optgroup label="{{ category }}">
                            {% for service in services %}
                            <option value="{{ service.id }}"
                                    data-min="{{ service.minQuantity }}"
                                    data-max="{{ service.maxQuantity }}"
                                    data-price="{{ service.pricePerThousandCents }}">
                                {{ service.name }} — R$ {{ (service.pricePerThousandCents / 100)|number_format(2, ',', '.') }}/1k
                            </option>
                            {% endfor %}
                        </optgroup>
                        {% endfor %}
                    </select>
                </div>
                <div class="form-group">
                    <label for="target_url">Link alvo</label>
                    <input type="url" id="target_url" name="target_url" class="form-control"
                           placeholder="https://instagram.com/seuperfil" required>
                </div>
                <div class="form-group form-group--sm">
                    <label for="quantity">Quantidade</label>
                    <input type="number" id="quantity" name="quantity" class="form-control"
                           min="100" max="100000" step="100" value="1000" required>
                </div>
                <div class="form-group form-group--sm">
                    <label>Total estimado</label>
                    <div class="price-preview" id="pricePreview">R$ —</div>
                </div>
            </div>
            <button type="submit" class="btn btn-primary">Fazer pedido</button>
        </form>
    </div>
</div>

{# RECENT ORDERS #}
<div class="card mt-6">
    <div class="card__header">
        <h2>Pedidos recentes</h2>
        <a href="{{ path('app_order_index') }}" class="btn btn-sm btn-ghost">Ver todos</a>
    </div>
    <div class="card__body p-0">
        <table class="table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Serviço</th>
                    <th>Qtd</th>
                    <th>Status</th>
                    <th>Progresso</th>
                    <th>Data</th>
                </tr>
            </thead>
            <tbody>
            {% for order in recentOrders %}
            <tr>
                <td><a href="{{ path('app_order_show', {id: order.id}) }}">{{ order.id }}</a></td>
                <td>{{ order.service.name }}</td>
                <td>{{ order.quantity|number_format(0, ',', '.') }}</td>
                <td><span class="badge badge--{{ order.status.cssClass() }}">{{ order.status.label() }}</span></td>
                <td>
                    <div class="progress">
                        <div class="progress__bar" style="width:{{ order.progressPercent }}%"></div>
                    </div>
                    <small>{{ order.deliveredCount }}/{{ order.quantity }}</small>
                </td>
                <td>{{ order.createdAt|date('d/m/Y H:i') }}</td>
            </tr>
            {% else %}
            <tr><td colspan="6" class="text-center text-muted">Nenhum pedido ainda. <a href="{{ path('app_catalog') }}">Faça seu primeiro!</a></td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
document.addEventListener('DOMContentLoaded', () => {
    const sel = document.getElementById('service_id');
    const qty = document.getElementById('quantity');
    const preview = document.getElementById('pricePreview');
    function updatePrice() {
        const opt = sel.selectedOptions[0];
        if (!opt || !opt.dataset.price) { preview.textContent = 'R$ —'; return; }
        const price = (parseInt(opt.dataset.price) * parseInt(qty.value || 0)) / 100000;
        preview.textContent = 'R$ ' + price.toLocaleString('pt-BR', {minimumFractionDigits: 2, maximumFractionDigits: 2});
        qty.min = opt.dataset.min;
        qty.max = opt.dataset.max;
    }
    sel.addEventListener('change', updatePrice);
    qty.addEventListener('input', updatePrice);
});
</script>
{% endblock %}
