{% extends 'base.html.twig' %}

{% block title %}Dashboard{% endblock %}

{% block body %}
<div class="grid stats">
    <div class="card"><span>Balance</span><strong>R$ {{ app.user.balance }}</strong></div>
    <div class="card"><span>Recent orders</span><strong>{{ orders|length }}</strong></div>
</div>

<div class="card">
    <h2>Recent orders</h2>
    <table>
        <thead><tr><th>ID</th><th>Service</th><th>Quantity</th><th>Charge</th><th>Status</th></tr></thead>
        <tbody>
        {% for order in orders %}
            <tr>
                <td>#{{ order.id }}</td>
                <td>{{ order.service.name }}</td>
                <td>{{ order.quantity }}</td>
                <td>R$ {{ order.charge }}</td>
                <td><span class="badge badge-{{ order.status }}">{{ order.status }}</span></td>
            </tr>
        {% else %}
            <tr><td colspan="5">No orders yet.</td></tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
