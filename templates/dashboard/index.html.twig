{% extends 'base.html.twig' %}

{% block title %}Dashboard — PulseSMM{% endblock %}
{% block page_title %}Dashboard{% endblock %}

{% block stylesheets %}
<style>
/* ================================================================
   DASHBOARD — redesign v2
   - KPI cards respirando com padding generoso e ícone harmonioso
   - Tabela: larguras proporcionais, texto quebra em vez de ellipsis
   - Badges com dot indicator e tipografia alinhada
   - Fundo body ≠ surface dos cards para profundidade visual
================================================================ */

/* ── KPI GRID ─────────────────────────────────────────────── */
.kpi-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--s4);
  margin-bottom: var(--s5);
}
@media (max-width: 960px) { .kpi-grid { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 480px) { .kpi-grid { grid-template-columns: 1fr 1fr; gap: var(--s3); } }

.kpi {
  padding: 20px 22px;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.kpi__header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--s2);
}

.kpi__label {
  font-size: .65rem;
  font-weight: 700;
  letter-spacing: .08em;
  text-transform: uppercase;
  color: var(--text-3);
  line-height: 1.3;
  padding-top: 2px;
}

.kpi__icon {
  width: 32px;
  height: 32px;
  border-radius: var(--r-md);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  color: var(--kpi-accent, var(--primary));
  background: color-mix(in srgb, var(--kpi-accent, var(--primary)) 12%, transparent);
}
.kpi__icon--teal  { --kpi-accent: var(--primary) }
.kpi__icon--blue  { --kpi-accent: #2563eb }
.kpi__icon--green { --kpi-accent: #16a34a }
.kpi__icon--gold  { --kpi-accent: var(--accent) }
[data-theme="dark"] .kpi__icon--blue  { --kpi-accent: #60a5fa }
[data-theme="dark"] .kpi__icon--green { --kpi-accent: #4ade80 }

.kpi__value {
  font-size: clamp(1.35rem, 1rem + .9vw, 1.85rem);
  font-weight: 800;
  letter-spacing: -.04em;
  color: var(--text);
  line-height: 1;
  font-variant-numeric: tabular-nums lining-nums;
}

.kpi__foot {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: .7rem;
  color: var(--text-3);
  flex-wrap: wrap;
}

.kpi__delta {
  display: inline-flex;
  align-items: center;
  gap: 2px;
  font-size: .65rem;
  font-weight: 700;
  padding: 2px 6px;
  border-radius: var(--r-full, 9999px);
}
.kpi__delta--up   { background: color-mix(in srgb,#22c55e 15%,transparent); color: #22c55e; }
.kpi__delta--down { background: color-mix(in srgb,#ef4444 15%,transparent); color: #ef4444; }
.kpi__delta--neutral { background: color-mix(in srgb,currentColor 10%,transparent); color: var(--text-3); }
[data-theme="light"] .kpi__delta--up   { color: #15803d; }
[data-theme="light"] .kpi__delta--down { color: #991b1b; }

.kpi__link {
  font-size: .7rem;
  font-weight: 600;
  color: var(--primary);
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  gap: 4px;
  opacity: .75;
  transition: opacity var(--fast) var(--ease), gap var(--fast) var(--ease);
}
.kpi__link:hover { opacity: 1; gap: 8px; }

/* ── QUICK ACTIONS ────────────────────────────────────────── */
.quick-actions {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--s3);
  margin-bottom: var(--s5);
}
@media (max-width: 600px) { .quick-actions { grid-template-columns: repeat(2, 1fr); } }

/* ── CARD WRAPPER ─────────────────────────────────────────── */
.card--padded {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--r-lg);
  box-shadow: var(--shadow-sm);
  overflow: hidden;
}

.card__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14px 20px;
  border-bottom: 1px solid var(--border);
  gap: var(--s4);
}

.card__head h2 {
  font-size: var(--tb);
  font-weight: 700;
  color: var(--text);
  letter-spacing: -.02em;
  display: flex;
  align-items: center;
  gap: 6px;
}

.card__head-actions {
  display: flex;
  align-items: center;
  gap: var(--s2);
  flex-shrink: 0;
}

/* ── ORDERS TABLE ─────────────────────────────────────────── */
.data-table .col-id     { width: 52px;  min-width: 44px; }
.data-table .col-svc    { width: 36%;   min-width: 180px; }
.data-table .col-url    { width: 22%;   min-width: 120px; }
.data-table .col-qty    { width: 60px;  min-width: 52px;  text-align: right; }
.data-table .col-val    { width: 88px;  min-width: 72px;  text-align: right; }
.data-table .col-status { width: 118px; min-width: 100px; text-align: center; }
.data-table .col-date   { width: 82px;  min-width: 68px;  text-align: right; }
.data-table .col-act    { width: 52px;  min-width: 48px;  text-align: right; }

.svc-name {
  font-weight: 600;
  color: var(--text);
  line-height: 1.35;
  word-break: break-word;
  overflow-wrap: break-word;
  white-space: normal;
  display: block;
}
.svc-cat {
  font-size: var(--tx);
  color: var(--text-3);
  margin-top: 2px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  display: block;
}

.url-cell {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: var(--tx);
  color: var(--primary);
  max-width: 100%;
}
.url-cell:hover { text-decoration: underline; }

.badge {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 3px 8px;
  font-size: .6rem;
  font-weight: 700;
  letter-spacing: .05em;
  border-radius: var(--r-full, 9999px);
  vertical-align: middle;
  white-space: nowrap;
}
.badge::before {
  content: '';
  width: 5px;
  height: 5px;
  border-radius: 50%;
  flex-shrink: 0;
  background: currentColor;
  opacity: .8;
}

.card__foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10px 20px;
  border-top: 1px solid var(--border);
  background: color-mix(in srgb, var(--surface-2, var(--surface)) 60%, transparent);
  gap: var(--s4);
}
.card__foot-info {
  font-size: var(--tx);
  color: var(--text-3);
}
.pagination {
  display: flex;
  align-items: center;
  gap: 2px;
}
.page-btn {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: 4px 10px;
  border-radius: var(--r-md);
  font-size: var(--tx);
  font-weight: 600;
  color: var(--text-2);
  background: transparent;
  border: 1px solid transparent;
  cursor: pointer;
  transition: background var(--fast) var(--ease), border-color var(--fast) var(--ease), color var(--fast) var(--ease);
  text-decoration: none;
}
.page-btn:hover { background: var(--surface-2, var(--border)); color: var(--text); border-color: var(--border); }
</style>
{% endblock %}

{% block content %}

{# ── KPIs ───────────────────────────────────────────────── #}
<div class="kpi-grid" data-reveal>

  <div class="kpi card--padded">
    <div class="kpi__header">
      <span class="kpi__label">Saldo disponível</span>
      <div class="kpi__icon kpi__icon--teal">
        <i data-lucide="wallet" width="15" height="15"></i>
      </div>
    </div>
    <div class="kpi__value">R$&thinsp;{{ (wallet.balanceCents / 100)|number_format(2, ',', '.') }}</div>
    <div class="kpi__foot">
      <a href="{{ path('app_wallet_deposit') }}" class="kpi__link">
        Recarregar <i data-lucide="arrow-right" width="10" height="10"></i>
      </a>
    </div>
  </div>

  <div class="kpi card--padded">
    <div class="kpi__header">
      <span class="kpi__label">Pedidos (30d)</span>
      <div class="kpi__icon kpi__icon--blue">
        <i data-lucide="shopping-cart" width="15" height="15"></i>
      </div>
    </div>
    <div class="kpi__value">{{ ordersCount }}</div>
    <div class="kpi__foot">
      <a href="{{ path('app_order_new') }}" class="kpi__link">
        Novo pedido <i data-lucide="arrow-right" width="10" height="10"></i>
      </a>
    </div>
  </div>

  <div class="kpi card--padded">
    <div class="kpi__header">
      <span class="kpi__label">Concluídos</span>
      <div class="kpi__icon kpi__icon--green">
        <i data-lucide="check-circle" width="15" height="15"></i>
      </div>
    </div>
    <div class="kpi__value">{{ completedCount }}</div>
    <div class="kpi__foot">
      <span class="kpi__delta kpi__delta--up">
        <i data-lucide="trending-up" width="9" height="9"></i> pedidos ok
      </span>
    </div>
  </div>

  <div class="kpi card--padded">
    <div class="kpi__header">
      <span class="kpi__label">Total gasto (30d)</span>
      <div class="kpi__icon kpi__icon--gold">
        <i data-lucide="trending-up" width="15" height="15"></i>
      </div>
    </div>
    <div class="kpi__value">R$&thinsp;{{ (totalSpentCents / 100)|number_format(2, ',', '.') }}</div>
    <div class="kpi__foot">
      <span class="kpi__delta kpi__delta--neutral">últimos 30 dias</span>
    </div>
  </div>

</div>

{# ── AÇÕES RÁPIDAS ──────────────────────────────────────── #}
<div class="quick-actions" data-reveal data-delay="1">

  <a href="{{ path('app_order_new') }}" class="quick-action">
    <i data-lucide="plus-circle" width="20" height="20"></i>
    <span>Novo pedido</span>
  </a>

  <a href="{{ path('app_wallet_deposit') }}" class="quick-action">
    <i data-lucide="banknote" width="20" height="20"></i>
    <span>Recarregar</span>
  </a>

  <a href="{{ path('app_wallet_index') }}" class="quick-action">
    <i data-lucide="receipt-text" width="20" height="20"></i>
    <span>Histórico</span>
  </a>

  <a href="#" class="quick-action">
    <i data-lucide="headset" width="20" height="20"></i>
    <span>Suporte</span>
  </a>

</div>

{# ── PEDIDOS RECENTES ────────────────────────────────── #}
<div class="card--padded" data-reveal data-delay="2">

  <div class="card__head">
    <h2>
      <i data-lucide="file-text" width="15" height="15"></i>
      Pedidos recentes
    </h2>
    <div class="card__head-actions">
      <a href="{{ path('app_order_new') }}" class="btn btn-primary btn-sm">+ Novo</a>
    </div>
  </div>

  {% if recentOrders|length > 0 %}
  <div class="table-wrap" style="border:none;border-radius:0;box-shadow:none">
    <table class="data-table">
      <colgroup>
        <col class="col-id">
        <col class="col-svc">
        <col class="col-url">
        <col class="col-qty">
        <col class="col-val">
        <col class="col-status">
        <col class="col-date">
        <col class="col-act">
      </colgroup>
      <thead>
        <tr>
          <th>#</th>
          <th>Serviço</th>
          <th>URL</th>
          <th style="text-align:right">Qtd</th>
          <th style="text-align:right">Valor</th>
          <th style="text-align:center">Status</th>
          <th style="text-align:right">Data</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {% for order in recentOrders %}
        <tr>
          <td class="cell-muted col-id">{{ order.id }}</td>

          <td class="col-svc">
            <span class="svc-name">{{ order.service.name }}</span>
            <span class="svc-cat">{{ order.service.category }}</span>
          </td>

          <td class="col-url">
            <a href="{{ order.targetUrl }}" target="_blank" rel="noopener noreferrer"
               class="url-cell" title="{{ order.targetUrl }}">
              {{ order.targetUrl }}
            </a>
          </td>

          <td class="cell-mono col-qty" style="text-align:right">
            {{ order.quantity|number_format(0,',','.') }}
          </td>

          <td class="cell-mono col-val" style="text-align:right;white-space:nowrap">
            R$&thinsp;{{ (order.amountCents/100)|number_format(2,',','.') }}
          </td>

          <td class="col-status" style="text-align:center">
            {% set st = order.status|lower %}
            {% set stClass = {
              'completed':  'badge--completed',
              'cancelled':  'badge--cancelled',
              'pending':    'badge--pending',
              'processing': 'badge--processing',
              'partial':    'badge--pending',
              'inprogress': 'badge--processing'
            } %}
            <span class="badge {{ stClass[st] ?? 'badge--processing' }}">
              {{ order.status|replace({'_':' '})|capitalize }}
            </span>
          </td>

          <td class="cell-muted col-date" style="white-space:nowrap;text-align:right">
            {{ order.createdAt|date('d/m/y') }}
          </td>

          <td class="col-act">
            <a href="{{ path('app_order_show', {id: order.id}) }}" class="btn btn-ghost btn-sm">Ver</a>
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>

  <div class="card__foot">
    <span class="card__foot-info">Mostrando {{ recentOrders|length }} pedidos recentes</span>
    <a href="{{ path('app_order_new') }}" class="page-btn">
      Novo pedido <i data-lucide="plus" width="10" height="10"></i>
    </a>
  </div>

  {% else %}
  <div class="empty-state">
    <i data-lucide="inbox" width="40" height="40"></i>
    <h3>Nenhum pedido ainda</h3>
    <p>Crie seu primeiro pedido e acompanhe o resultado aqui.</p>
    <a href="{{ path('app_order_new') }}" class="btn btn-primary" style="margin-top:8px">Criar pedido</a>
  </div>
  {% endif %}

</div>

{% endblock %}
