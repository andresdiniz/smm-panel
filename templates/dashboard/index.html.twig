{% extends 'base.html.twig' %}

{% block title %}Dashboard — PulseSMM{% endblock %}

{% block body %}
<div class="app-shell">
    <aside class="app-sidebar" id="sidebar" aria-label="Menu lateral">
        <div class="app-sidebar__brand">
            <strong>PulseSMM</strong>
            <button class="icon-btn d-mobile" id="closeSidebar" aria-label="Fechar menu">×</button>
        </div>

        <nav class="app-menu">
            <a href="{{ path('app_dashboard') }}" class="is-active" aria-current="page">Dashboard</a>
            <a href="{{ path('app_catalog') }}">Catálogo</a>
            <a href="{{ path('app_order_index') }}">Pedidos</a>
            <a href="{{ path('app_wallet_index') }}">Carteira</a>
            <a href="{{ path('app_profile') }}">Perfil</a>
            <a href="{{ path('app_support') }}">Suporte</a>
        </nav>

        <div class="app-sidebar__footer">
            <a href="{{ path('app_logout') }}" class="btn btn--ghost btn--block">Sair</a>
        </div>
    </aside>

    <div class="app-overlay" id="sidebarOverlay" aria-hidden="true"></div>

    <section class="app-main">
        <header class="app-topbar glass">
            <button class="icon-btn" id="openSidebar" aria-label="Abrir menu lateral">☰</button>
            <div>
                <small class="muted">Bom dia, {{ app.user.name }}</small>
                <h1>Seu painel</h1>
            </div>
            <a href="{{ path('app_wallet_deposit') }}" class="btn btn--primary btn--sm">+ Saldo</a>
        </header>

        <div class="app-content">

            <div class="kpi-grid">
                <article class="kpi-card kpi-card--gradient" data-reveal>
                    <span>Saldo disponível</span>
                    <strong>R$ {{ (wallet.balanceCents / 100)|number_format(2, ',', '.') }}</strong>
                    <small>Pronto para novos pedidos</small>
                </article>
                <article class="kpi-card" data-reveal>
                    <span>Pedidos hoje</span>
                    <strong>{{ stats.ordersToday }}</strong>
                    <small>{{ stats.ordersActive }} em andamento</small>
                </article>
                <article class="kpi-card" data-reveal>
                    <span>Gasto no mês</span>
                    <strong>R$ {{ (stats.spentThisMonth / 100)|number_format(2, ',', '.') }}</strong>
                    <small>Incluindo taxas</small>
                </article>
            </div>

            <section class="panel-card" data-reveal>
                <div class="panel-card__head">
                    <h2>Pedido rápido</h2>
                    <span class="pill pill--soft">Atualização instantânea</span>
                </div>

                <form method="post" action="{{ path('app_order_new') }}" class="quick-form">
                    <input type="hidden" name="_token" value="{{ csrf_token('new_order') }}">

                    <label class="field">
                        <span>Serviço</span>
                        <select name="service_id" class="control" required>
                            <option value="">Selecione um serviço</option>
                            {% for category, services in servicesGrouped %}
                                <optgroup label="{{ category }}">
                                    {% for service in services %}
                                        <option value="{{ service.id }}"
                                                data-price="{{ service.pricePerUnit }}"
                                                data-min="{{ service.minQuantity }}"
                                                data-max="{{ service.maxQuantity }}">
                                            {{ service.name }}
                                        </option>
                                    {% endfor %}
                                </optgroup>
                            {% endfor %}
                        </select>
                    </label>

                    <label class="field">
                        <span>Link alvo</span>
                        <input type="url" name="target_url" class="control"
                               placeholder="https://instagram.com/perfil" required autocomplete="off">
                    </label>

                    <div class="field-row">
                        <label class="field">
                            <span>Quantidade</span>
                            <input type="number" name="quantity" id="qty" class="control"
                                   min="100" step="100" value="1000" required>
                        </label>

                        <div class="field price-box">
                            <span>Total estimado</span>
                            <strong id="pricePreview">R$ 0,00</strong>
                        </div>
                    </div>

                    <button type="submit" class="btn btn--primary btn--lg btn--block">Confirmar pedido</button>
                </form>
            </section>

            <section class="panel-card" data-reveal>
                <div class="panel-card__head">
                    <h2>Pedidos recentes</h2>
                    <a href="{{ path('app_order_index') }}" class="link-more">Ver todos →</a>
                </div>

                <div class="orders-list">
                    {% for order in recentOrders %}
                        <article class="order-item">
                            <div class="order-item__top">
                                <div>
                                    <strong>#{{ order.id }}</strong>
                                    <p>{{ order.service.name }}</p>
                                </div>
                                <span class="badge badge--{{ order.status.cssClass() }}">{{ order.status.label() }}</span>
                            </div>
                            <div class="order-item__meta">
                                <span>{{ order.quantity|number_format(0, ',', '.') }} unidades</span>
                                <span>{{ order.createdAt|date('d/m/Y H:i') }}</span>
                            </div>
                            <div class="progress" role="progressbar"
                                 aria-valuenow="{{ order.progressPercent }}"
                                 aria-valuemin="0" aria-valuemax="100">
                                <div class="progress__bar" style="width:{{ order.progressPercent }}%"></div>
                            </div>
                        </article>
                    {% else %}
                        <div class="empty-box">Nenhum pedido ainda. Que tal fazer o primeiro?</div>
                    {% endfor %}
                </div>
            </section>

        </div>
    </section>
</div>

<script>
(() => {
    const open  = document.getElementById('openSidebar');
    const close = document.getElementById('closeSidebar');
    const sidebar = document.getElementById('sidebar');
    const overlay = document.getElementById('sidebarOverlay');

    const show = () => { sidebar.classList.add('is-open'); overlay.classList.add('is-open'); };
    const hide = () => { sidebar.classList.remove('is-open'); overlay.classList.remove('is-open'); };

    open?.addEventListener('click', show);
    close?.addEventListener('click', hide);
    overlay?.addEventListener('click', hide);

    const sel = document.querySelector('select[name="service_id"]');
    const qty = document.getElementById('qty');
    const preview = document.getElementById('pricePreview');

    function updatePrice() {
        const opt = sel?.options[sel.selectedIndex];
        const price = parseFloat(opt?.dataset.price ?? 0);
        const q = parseInt(qty?.value ?? 0, 10);
        if (price && q) {
            const total = (price * q / 1000).toFixed(2).replace('.', ',');
            preview.textContent = 'R$ ' + total.replace(/\B(?=(\d{3})+(?!\d))/g, '.');
        } else {
            preview.textContent = 'R$ 0,00';
        }
    }

    sel?.addEventListener('change', updatePrice);
    qty?.addEventListener('input', updatePrice);
})();
</script>
{% endblock %}
