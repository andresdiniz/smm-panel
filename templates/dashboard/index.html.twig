{% extends 'base.html.twig' %}

{% block title %}Dashboard — PulseSMM{% endblock %}
{% block page_title %}Dashboard{% endblock %}

{% block stylesheets %}
<style>
/* ================================================================
   DASHBOARD — page-specific styles
================================================================ */

/* KPI grid */
.kpi-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--s4);
  margin-bottom: var(--s5);
}
@media (max-width: 960px) { .kpi-grid { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 480px) { .kpi-grid { grid-template-columns: 1fr; } }

/* KPI accent top-bar */
.kpi { position: relative; overflow: hidden; padding: 20px 22px; }
.kpi::before {
  content: '';
  position: absolute; top: 0; left: 0; right: 0;
  height: 3px;
  border-radius: var(--r-lg) var(--r-lg) 0 0;
  background: var(--kpi-accent, var(--primary));
  opacity: .5;
}

.kpi__header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--s3);
  margin-bottom: var(--s3);
}

.kpi__meta { display: flex; flex-direction: column; gap: 3px; }

.kpi__label {
  font-size: .65rem;
  font-weight: 700;
  letter-spacing: .09em;
  text-transform: uppercase;
  color: var(--text-3);
  line-height: 1;
}

.kpi__icon {
  width: 34px; height: 34px;
  border-radius: var(--r-md);
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
  color: var(--kpi-accent, var(--primary));
  background: color-mix(in srgb, var(--kpi-accent, var(--primary)) 10%, transparent);
}
.kpi__icon--teal  { --kpi-accent: var(--primary) }
.kpi__icon--blue  { --kpi-accent: #2563eb }
.kpi__icon--green { --kpi-accent: #16a34a }
.kpi__icon--gold  { --kpi-accent: var(--accent) }
[data-theme="dark"] .kpi__icon--blue  { --kpi-accent: #60a5fa }
[data-theme="dark"] .kpi__icon--green { --kpi-accent: #4ade80 }

.kpi__value {
  font-size: clamp(1.45rem, 1.1rem + .9vw, 1.95rem);
  font-weight: 800;
  letter-spacing: -.04em;
  color: var(--text);
  line-height: 1;
  font-variant-numeric: tabular-nums;
  margin-bottom: var(--s2);
}

.kpi__link {
  font-size: .72rem;
  font-weight: 600;
  color: var(--primary);
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  gap: 4px;
  opacity: .7;
  transition: opacity var(--fast) var(--ease), gap var(--fast) var(--ease);
}
.kpi__link:hover { opacity: 1; gap: 8px; }

/* Quick actions */
.quick-actions {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--s3);
  margin-bottom: var(--s5);
}
@media (max-width: 600px) { .quick-actions { grid-template-columns: repeat(2, 1fr); } }

/* Recents card */
.card--padded {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--r-lg);
  box-shadow: var(--shadow-sm);
  overflow: hidden;
}

.card__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 20px;
  border-bottom: 1px solid var(--border);
}
.card__head h2 {
  font-size: var(--tb);
  font-weight: 700;
  color: var(--text);
  letter-spacing: -.02em;
}

/* Table: column widths */
.data-table .col-id     { width: 42px;  min-width: 42px; }
.data-table .col-svc    { width: auto;  min-width: 200px; }
.data-table .col-url    { width: 160px; min-width: 120px; }
.data-table .col-qty    { width: 56px;  min-width: 56px;  text-align: right; }
.data-table .col-val    { width: 80px;  min-width: 72px;  text-align: right; }
.data-table .col-status { width: 120px; min-width: 100px; }
.data-table .col-date   { width: 76px;  min-width: 68px; }
.data-table .col-act    { width: 56px;  min-width: 56px;  text-align: right; }

/* Service name: wrap instead of ellipsis */
.svc-name {
  font-weight: 600;
  color: var(--text);
  line-height: 1.35;
  word-break: break-word;
  white-space: normal;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.svc-cat {
  font-size: var(--tx);
  color: var(--text-3);
  margin-top: 2px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* URL cell */
.url-cell {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: var(--tx);
  color: var(--primary);
  max-width: 160px;
}

/* Refined badge overrides */
.badge {
  padding: 3px 9px;
  font-size: .6rem;
  letter-spacing: .06em;
  vertical-align: middle;
}
</style>
{% endblock %}

{% block content %}

{# ── KPIs ───────────────────────────────────────────────── #}
<div class="kpi-grid" data-reveal>

  <div class="kpi">
    <div class="kpi__header">
      <div class="kpi__meta">
        <span class="kpi__label">Saldo disponível</span>
      </div>
      <div class="kpi__icon kpi__icon--teal">
        <i data-lucide="wallet" width="16" height="16"></i>
      </div>
    </div>
    <div class="kpi__value">R$&thinsp;{{ (wallet.balanceCents / 100)|number_format(2, ',', '.') }}</div>
    <a href="{{ path('app_wallet_deposit') }}" class="kpi__link">
      Recarregar <i data-lucide="arrow-right" width="11" height="11"></i>
    </a>
  </div>

  <div class="kpi">
    <div class="kpi__header">
      <div class="kpi__meta">
        <span class="kpi__label">Pedidos (30d)</span>
      </div>
      <div class="kpi__icon kpi__icon--blue">
        <i data-lucide="shopping-cart" width="16" height="16"></i>
      </div>
    </div>
    <div class="kpi__value">{{ ordersCount }}</div>
    <a href="{{ path('app_order_new') }}" class="kpi__link">
      Novo pedido <i data-lucide="arrow-right" width="11" height="11"></i>
    </a>
  </div>

  <div class="kpi">
    <div class="kpi__header">
      <div class="kpi__meta">
        <span class="kpi__label">Concluídos</span>
      </div>
      <div class="kpi__icon kpi__icon--green">
        <i data-lucide="check-circle" width="16" height="16"></i>
      </div>
    </div>
    <div class="kpi__value">{{ completedCount }}</div>
  </div>

  <div class="kpi">
    <div class="kpi__header">
      <div class="kpi__meta">
        <span class="kpi__label">Total gasto (30d)</span>
      </div>
      <div class="kpi__icon kpi__icon--gold">
        <i data-lucide="trending-up" width="16" height="16"></i>
      </div>
    </div>
    <div class="kpi__value">R$&thinsp;{{ (totalSpentCents / 100)|number_format(2, ',', '.') }}</div>
  </div>

</div>

{# ── AÇÕES RÁPIDAS ──────────────────────────────────────── #}
<div class="quick-actions" data-reveal data-delay="1">

  <a href="{{ path('app_order_new') }}" class="quick-action">
    <i data-lucide="plus-circle" width="22" height="22"></i>
    <span>Novo pedido</span>
  </a>

  <a href="{{ path('app_wallet_deposit') }}" class="quick-action">
    <i data-lucide="banknote" width="22" height="22"></i>
    <span>Recarregar</span>
  </a>

  <a href="{{ path('app_wallet_index') }}" class="quick-action">
    <i data-lucide="receipt-text" width="22" height="22"></i>
    <span>Histórico</span>
  </a>

  <a href="#" class="quick-action">
    <i data-lucide="headset" width="22" height="22"></i>
    <span>Suporte</span>
  </a>

</div>

{# ── PEDIDOS RECENTES ────────────────────────────────── #}
<div class="card--padded" data-reveal data-delay="2">

  <div class="card__head">
    <h2>Pedidos recentes</h2>
    <a href="{{ path('app_order_new') }}" class="btn btn-primary btn-sm">+ Novo</a>
  </div>

  {% if recentOrders|length > 0 %}
  <div class="table-wrap" style="border:none;border-radius:0;box-shadow:none">
    <table class="data-table">
      <colgroup>
        <col class="col-id">
        <col class="col-svc">
        <col class="col-url">
        <col class="col-qty">
        <col class="col-val">
        <col class="col-status">
        <col class="col-date">
        <col class="col-act">
      </colgroup>
      <thead>
        <tr>
          <th>#</th>
          <th>Serviço</th>
          <th>URL</th>
          <th style="text-align:right">Qtd</th>
          <th style="text-align:right">Valor</th>
          <th>Status</th>
          <th>Data</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {% for order in recentOrders %}
        <tr>
          <td class="cell-muted col-id">{{ order.id }}</td>

          <td class="col-svc">
            <div class="svc-name">{{ order.service.name }}</div>
            <div class="svc-cat">{{ order.service.category }}</div>
          </td>

          <td class="col-url">
            <a href="{{ order.targetUrl }}" target="_blank" rel="noopener noreferrer"
               class="url-cell" title="{{ order.targetUrl }}">
              {{ order.targetUrl }}
            </a>
          </td>

          <td class="cell-mono col-qty" style="text-align:right">
            {{ order.quantity|number_format(0,',','.') }}
          </td>

          <td class="cell-mono col-val" style="text-align:right;white-space:nowrap">
            R$&thinsp;{{ (order.amountCents/100)|number_format(2,',','.') }}
          </td>

          <td class="col-status">
            {% set st = order.status|lower %}
            {% set stClass = {
              'completed':  'badge--completed',
              'cancelled':  'badge--cancelled',
              'pending':    'badge--pending',
              'processing': 'badge--processing',
              'partial':    'badge--pending',
              'inprogress': 'badge--processing'
            } %}
            <span class="badge {{ stClass[st] ?? 'badge--processing' }}">
              {{ order.status|replace({'_':' '})|capitalize }}
            </span>
          </td>

          <td class="cell-muted col-date" style="white-space:nowrap">
            {{ order.createdAt|date('d/m/y') }}
          </td>

          <td class="col-act">
            <a href="{{ path('app_order_show', {id: order.id}) }}" class="btn btn-ghost btn-sm">Ver</a>
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>

  {% else %}
  <div class="empty-state">
    <i data-lucide="inbox" width="40" height="40"></i>
    <h3>Nenhum pedido ainda</h3>
    <p>Crie seu primeiro pedido e acompanhe o resultado aqui.</p>
    <a href="{{ path('app_order_new') }}" class="btn btn-primary" style="margin-top:8px">Criar pedido</a>
  </div>
  {% endif %}

</div>

{% endblock %}
