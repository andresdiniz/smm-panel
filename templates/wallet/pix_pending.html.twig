{% extends 'base.html.twig' %}

{% block title %}Pagar via Pix — PulseSMM{% endblock %}
{% block page_title %}Pagar via Pix{% endblock %}

{% block stylesheets %}{{ parent() }}
<style>
/* ══════════════════════════════════════════
   PIX PENDING v3 — tema-agnóstico
   ══════════════════════════════════════════ */

/* tokens locais que funcionam em cima de qualquer tema-base */
.pix-wrap {
  --_bg:       var(--surface,   #1a1d27);
  --_bg2:      var(--surface-2, #1f2333);
  --_bg3:      var(--surface-off, #161925);
  --_border:   var(--border,    rgba(255,255,255,.09));
  --_border2:  var(--border-2,  rgba(255,255,255,.05));
  --_text:     var(--text,      #e8eaf0);
  --_text2:    var(--text-2,    #7c8299);
  --_acc:      var(--acc,       #01696f);
  --_acc-soft: var(--acc-soft,  rgba(1,105,111,.15));
  --_acc-brd:  var(--acc-border,rgba(1,105,111,.35));
  --_acc-hov:  var(--acc-hover, #0c4e54);

  max-width: 520px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  gap: 16px;
  padding-bottom: 40px;
}

/* ── Status card ── */
.pix-status {
  display: grid;
  grid-template-columns: 44px 1fr auto;
  align-items: center;
  gap: 16px;
  padding: 16px 24px;
  background: var(--_bg2);
  border: 1px solid var(--_border);
  border-radius: 12px;
  position: relative;
  overflow: hidden;
  box-shadow: 0 2px 12px rgba(0,0,0,.18);
}
.pix-status::before {
  content: '';
  position: absolute;
  top: 0; left: 0;
  width: 3px; height: 100%;
  background: var(--_acc);
  border-radius: 0 2px 2px 0;
}
.pix-status::after {
  content: '';
  position: absolute;
  inset: 0;
  background: radial-gradient(ellipse at 0% 50%, var(--_acc-soft) 0%, transparent 55%);
  pointer-events: none;
}

/* pulse */
.pix-pulse {
  width: 44px; height: 44px;
  border-radius: 50%;
  background: var(--_acc-soft);
  border: 1.5px solid var(--_acc-brd);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  flex-shrink: 0;
  z-index: 1;
}
.pix-pulse::before {
  content: '';
  position: absolute;
  inset: -7px;
  border-radius: 50%;
  border: 1.5px solid var(--_acc-brd);
  animation: pix-ring 2.2s cubic-bezier(.4,0,.6,1) infinite;
  opacity: 0;
}
.pix-pulse__dot {
  width: 13px; height: 13px;
  border-radius: 50%;
  background: var(--_acc);
  animation: pix-dot 2.2s ease-in-out infinite;
}
@keyframes pix-ring {
  0%   { transform: scale(.75); opacity: .7; }
  70%  { transform: scale(1.6);  opacity: 0; }
  100% { transform: scale(.75); opacity: 0; }
}
@keyframes pix-dot {
  0%, 100% { opacity: 1;   transform: scale(1); }
  50%      { opacity: .4;  transform: scale(.8); }
}

.pix-status__info   { z-index: 1; }
.pix-status__eyebrow {
  font-size: 10px;
  font-weight: 700;
  color: var(--_text2);
  text-transform: uppercase;
  letter-spacing: .08em;
  margin-bottom: 3px;
}
.pix-status__label {
  font-size: 13px;
  font-weight: 700;
  color: var(--_acc);
}
.pix-status__amount { text-align: right; z-index: 1; }
.pix-status__alabel {
  font-size: 10px;
  font-weight: 700;
  color: var(--_text2);
  text-transform: uppercase;
  letter-spacing: .08em;
  margin-bottom: 3px;
}
.pix-status__value {
  font-size: 22px;
  font-weight: 900;
  font-variant-numeric: tabular-nums;
  letter-spacing: -0.04em;
  line-height: 1;
  color: var(--_text);
}

/* ── Subtítulo ── */
.pix-subtitle {
  font-size: 13px;
  color: var(--_text2);
  line-height: 1.65;
  text-align: center;
  padding: 0 8px;
}

/* ── Card principal ── */
.pix-card {
  background: var(--_bg2);
  border: 1px solid var(--_border);
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 4px 24px rgba(0,0,0,.18);
}

/* ── QR section ── */
.pix-qr-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16px;
  padding: 32px 24px 24px;
  border-bottom: 1px solid var(--_border);
}
.pix-qr-frame {
  padding: 14px;
  background: #ffffff;
  border-radius: 10px;
  box-shadow:
    0 0 0 1px rgba(0,0,0,.08),
    0 4px 16px rgba(0,0,0,.14),
    0 20px 48px rgba(0,0,0,.10);
  display: inline-flex;
  transition: transform .22s ease, box-shadow .22s ease;
}
.pix-qr-frame:hover {
  transform: translateY(-3px);
  box-shadow:
    0 0 0 1px rgba(0,0,0,.08),
    0 8px 28px rgba(0,0,0,.2),
    0 28px 64px rgba(0,0,0,.14);
}
.pix-qr-frame img { display: block; border-radius: 4px; }
.pix-qr-empty {
  width: 220px; height: 220px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12px;
  color: var(--_text2);
  font-size: 13px;
}
.pix-qr-hint {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: var(--_bg3);
  border: 1px solid var(--_border);
  border-radius: 999px;
  padding: 5px 12px;
  font-size: 11px;
  font-weight: 500;
  color: var(--_text2);
}

/* ── Divisor ── */
.pix-divider {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 14px 24px 0;
}
.pix-divider__line {
  flex: 1;
  height: 1px;
  background: var(--_border);
}
.pix-divider__label {
  font-size: 11px;
  font-weight: 500;
  color: var(--_text2);
  white-space: nowrap;
}

/* ── Copia e Cola ── */
.pix-copy-section { padding: 12px 24px 24px; }
.pix-copy-header {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 10px;
  font-weight: 700;
  color: var(--_text2);
  text-transform: uppercase;
  letter-spacing: .08em;
  margin-bottom: 10px;
}
.pix-copy-field {
  display: flex;
  align-items: stretch;
  border: 1.5px solid var(--_border);
  border-radius: 8px;
  overflow: hidden;
  background: var(--_bg3);
  transition: border-color .18s, box-shadow .18s;
}
.pix-copy-field:focus-within {
  border-color: var(--_acc);
  box-shadow: 0 0 0 3px var(--_acc-soft);
}
.pix-copy-code {
  flex: 1;
  padding: 10px 14px;
  font-family: 'Courier New', monospace;
  font-size: 11px;
  line-height: 1.65;
  color: var(--_text);
  background: transparent;
  border: none;
  resize: none;
  outline: none;
  word-break: break-all;
  min-height: 70px;
}
.pix-copy-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4px;
  padding: 0 20px;
  min-width: 76px;
  background: var(--_acc);
  color: #fff;
  border: none;
  cursor: pointer;
  font-size: 11px;
  font-weight: 700;
  flex-shrink: 0;
  transition: background .18s, transform .1s;
}
.pix-copy-btn:hover  { background: var(--_acc-hov); }
.pix-copy-btn:active { transform: scale(.96); }
.pix-copy-btn.copied { background: #1a6b14; }

/* ── Passos ── */
.pix-steps {
  background: var(--_bg2);
  border: 1px solid var(--_border);
  border-radius: 12px;
  overflow: hidden;
  list-style: none;
  box-shadow: 0 2px 10px rgba(0,0,0,.12);
}
.pix-step {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 12px 20px;
  border-bottom: 1px solid var(--_border2);
  transition: background .15s;
}
.pix-step:last-child { border-bottom: none; }
.pix-step:hover { background: rgba(255,255,255,.03); }
.pix-step__num {
  width: 24px; height: 24px;
  min-width: 24px;
  border-radius: 50%;
  background: var(--_acc-soft);
  border: 1.5px solid var(--_acc-brd);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 11px;
  font-weight: 800;
  color: var(--_acc);
  flex-shrink: 0;
}
.pix-step__text {
  font-size: 13px;
  color: var(--_text2);
  line-height: 1.5;
}
.pix-step__text strong { color: var(--_text); font-weight: 700; }

/* ── Footer ── */
.pix-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 12px 16px;
  background: var(--_bg2);
  border: 1px solid var(--_border);
  border-radius: 10px;
  flex-wrap: wrap;
}
.pix-expiry {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 12px;
  color: var(--_text2);
}
.pix-expiry strong { color: var(--_text); }
.pix-footer a {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 12px;
  font-weight: 600;
  color: var(--_text2);
  text-decoration: none;
  transition: color .18s;
}
.pix-footer a:hover { color: var(--_text); }

/* ── Responsivo ── */
@media (max-width: 520px) {
  .pix-status {
    grid-template-columns: 44px 1fr;
    padding: 14px 16px;
  }
  .pix-status__amount {
    grid-column: 2;
    text-align: left;
    margin-top: -8px;
  }
  .pix-qr-section { padding: 24px 16px 20px; }
  .pix-copy-section { padding: 10px 16px 20px; }
  .pix-step { padding: 11px 16px; }
}
</style>
{% endblock %}

{% block content %}
<div class="pix-wrap">

  {# ── Status ── #}
  <div class="pix-status">
    <div class="pix-pulse">
      <span class="pix-pulse__dot"></span>
    </div>
    <div class="pix-status__info">
      <div class="pix-status__eyebrow">Status do pagamento</div>
      <div class="pix-status__label">Aguardando pagamento</div>
    </div>
    <div class="pix-status__amount">
      <div class="pix-status__alabel">Valor</div>
      <div class="pix-status__value">R$&nbsp;{{ (payment.amountCents / 100)|number_format(2, ',', '.') }}</div>
    </div>
  </div>

  <p class="pix-subtitle">
    Escaneie o QR Code com o app do seu banco ou copie o código abaixo para concluir o pagamento.
  </p>

  {# ── Card QR + Copia e Cola ── #}
  <div class="pix-card">

    <div class="pix-qr-section">
      {% if qrCodeBase64 is defined and qrCodeBase64 %}
        <div class="pix-qr-frame">
          <img src="data:image/png;base64,{{ qrCodeBase64 }}"
               alt="QR Code Pix" width="220" height="220" loading="eager">
        </div>
        <div class="pix-qr-hint">
          <i data-lucide="smartphone" width="13" height="13"></i>
          Abra o banco → Pix → Pagar → Câmera
        </div>
      {% else %}
        <div class="pix-qr-frame">
          <div class="pix-qr-empty">
            <i data-lucide="qr-code" width="52" height="52" style="opacity:.35"></i>
            <span>QR Code indisponível</span>
          </div>
        </div>
      {% endif %}
    </div>

    <div class="pix-divider">
      <span class="pix-divider__line"></span>
      <span class="pix-divider__label">ou use o Pix Copia e Cola</span>
      <span class="pix-divider__line"></span>
    </div>

    <div class="pix-copy-section">
      <div class="pix-copy-header">
        <i data-lucide="copy" width="12" height="12"></i>
        Pix Copia e Cola
      </div>
      <div class="pix-copy-field">
        <textarea class="pix-copy-code" id="pixCode" readonly rows="3" spellcheck="false">{{ payment.pixCode }}</textarea>
        <button type="button" class="pix-copy-btn" id="copyPixBtn" aria-label="Copiar código Pix">
          <i data-lucide="copy" width="17" height="17" id="copyIcon"></i>
          <span id="copyLabel">Copiar</span>
        </button>
      </div>
    </div>

  </div>

  {# ── Passos ── #}
  <ol class="pix-steps">
    <li class="pix-step">
      <span class="pix-step__num">1</span>
      <span class="pix-step__text">Abra o aplicativo do seu banco</span>
    </li>
    <li class="pix-step">
      <span class="pix-step__num">2</span>
      <span class="pix-step__text">Acesse a área Pix e escolha <strong>Pagar</strong></span>
    </li>
    <li class="pix-step">
      <span class="pix-step__num">3</span>
      <span class="pix-step__text">Escaneie o QR Code ou cole o código copiado</span>
    </li>
    <li class="pix-step">
      <span class="pix-step__num">4</span>
      <span class="pix-step__text">Confirme — seu saldo é creditado <strong>em instantes</strong></span>
    </li>
  </ol>

  {# ── Footer ── #}
  <div class="pix-footer">
    <div class="pix-expiry">
      <i data-lucide="clock" width="14" height="14"></i>
      <span>Código válido por <strong>24 horas</strong></span>
    </div>
    <a href="{{ path('app_wallet_index') }}">
      <i data-lucide="arrow-left" width="13" height="13"></i>
      Voltar para carteira
    </a>
  </div>

</div>
{% endblock %}

{% block javascripts %}{{ parent() }}
<script>
const copyBtn  = document.getElementById('copyPixBtn');
const copyIcon = document.getElementById('copyIcon');
const copyLbl  = document.getElementById('copyLabel');
const pixCode  = document.getElementById('pixCode');

copyBtn.addEventListener('click', async () => {
  try {
    await navigator.clipboard.writeText(pixCode.value);
  } catch {
    pixCode.select();
    document.execCommand('copy');
  }
  copyBtn.classList.add('copied');
  copyLbl.textContent = 'Copiado!';
  copyIcon.setAttribute('data-lucide', 'check');
  lucide.createIcons();
  setTimeout(() => {
    copyBtn.classList.remove('copied');
    copyLbl.textContent = 'Copiar';
    copyIcon.setAttribute('data-lucide', 'copy');
    lucide.createIcons();
  }, 2500);
});
</script>
{% endblock %}
