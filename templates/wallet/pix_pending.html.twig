{% extends 'base.html.twig' %}

{% block title %}Pix pendente — PulseSMM{% endblock %}
{% block page_title %}Pagar via Pix{% endblock %}

{% block stylesheets %}{{ parent() }}
<style>
/* ══════════════════════════════════════════
   PIX PENDING — Design Refinado
   ══════════════════════════════════════════ */

.pix-page {
  max-width: 560px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  gap: var(--sp5);
}

/* ── Status header ── */
.pix-status-bar {
  display: flex;
  align-items: center;
  gap: var(--sp4);
  padding: var(--sp4) var(--sp5);
  background: var(--surface-2);
  border: 1px solid var(--border);
  border-radius: var(--r3);
  overflow: hidden;
  position: relative;
}
.pix-status-bar::before {
  content: '';
  position: absolute;
  top: 0; left: 0;
  width: 3px; height: 100%;
  background: var(--acc);
  border-radius: 0 2px 2px 0;
}
.pix-status-bar__pulse {
  width: 40px; height: 40px;
  border-radius: 50%;
  background: var(--acc-soft);
  border: 1.5px solid var(--acc-border);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  position: relative;
}
.pix-status-bar__pulse::before {
  content: '';
  position: absolute;
  inset: -6px;
  border-radius: 50%;
  border: 1.5px solid var(--acc-border);
  animation: pix-ring 2s ease-in-out infinite;
  opacity: 0;
}
.pix-status-bar__dot {
  width: 14px; height: 14px;
  border-radius: 50%;
  background: var(--acc);
  animation: pix-dot 2s ease-in-out infinite;
}
@keyframes pix-ring {
  0%   { transform: scale(.8); opacity: .6; }
  70%  { transform: scale(1.5); opacity: 0; }
  100% { transform: scale(.8); opacity: 0; }
}
@keyframes pix-dot {
  0%, 100% { opacity: 1; transform: scale(1); }
  50%       { opacity: .5; transform: scale(.85); }
}
.pix-status-bar__info { flex: 1; }
.pix-status-bar__label {
  font-size: var(--text-xs);
  color: var(--text-2);
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: .06em;
  margin-bottom: 2px;
}
.pix-status-bar__status {
  font-size: var(--text-sm);
  font-weight: 700;
  color: var(--acc);
}
.pix-status-bar__amount { text-align: right; }
.pix-status-bar__amount-label {
  font-size: var(--text-xs);
  color: var(--text-2);
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: .06em;
  margin-bottom: 2px;
}
.pix-status-bar__value {
  font-size: var(--text-lg);
  font-weight: 900;
  font-variant-numeric: tabular-nums;
  letter-spacing: -0.03em;
  line-height: 1;
}

/* ── Intro ── */
.pix-intro {
  font-size: var(--text-sm);
  color: var(--text-2);
  line-height: 1.65;
  text-align: center;
}

/* ── Corpo ── */
.pix-body {
  background: var(--surface-2);
  border: 1px solid var(--border);
  border-radius: var(--r4);
  overflow: hidden;
}
.pix-body__qr-section {
  padding: var(--sp6);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--sp4);
  border-bottom: 1px solid var(--border);
}
.pix-qr {
  padding: var(--sp4);
  background: #fff;
  border-radius: var(--r3);
  border: 1px solid rgba(0,0,0,.06);
  box-shadow: 0 4px 24px rgba(0,0,0,.07);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: box-shadow var(--base);
}
.pix-qr:hover { box-shadow: 0 8px 32px rgba(0,0,0,.12); }
.pix-qr img { display: block; border-radius: var(--r2); }
.pix-qr--empty {
  width: 220px; height: 220px;
  flex-direction: column;
  gap: var(--sp3);
  color: var(--text-2);
  font-size: var(--text-sm);
  font-weight: 600;
}
.pix-qr__hint {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: var(--text-xs);
  color: var(--text-2);
  font-weight: 500;
  background: var(--surface-off);
  border: 1px solid var(--border);
  border-radius: var(--rp);
  padding: 5px var(--sp3);
}

/* ── Copia e cola ── */
.pix-body__copy-section {
  padding: var(--sp5) var(--sp6);
}
.pix-copy-label {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: var(--text-xs);
  font-weight: 700;
  color: var(--text-2);
  text-transform: uppercase;
  letter-spacing: .06em;
  margin-bottom: var(--sp3);
}
.pix-copy-box {
  display: flex;
  align-items: stretch;
  border: 1.5px solid var(--border);
  border-radius: var(--r2);
  overflow: hidden;
  background: var(--surface-off);
  transition: border-color var(--fast), box-shadow var(--fast);
}
.pix-copy-box:focus-within {
  border-color: var(--acc);
  box-shadow: 0 0 0 3px var(--acc-soft);
}
.pix-copy-code {
  flex: 1;
  padding: var(--sp3) var(--sp4);
  font-family: 'Courier New', monospace;
  font-size: 11px;
  line-height: 1.6;
  color: var(--text);
  background: transparent;
  border: none;
  resize: none;
  outline: none;
  word-break: break-all;
}
.pix-copy-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 3px;
  padding: 0 var(--sp4);
  min-width: 68px;
  background: var(--acc);
  color: #fff;
  border: none;
  cursor: pointer;
  font-size: 11px;
  font-weight: 700;
  transition: background var(--fast);
  flex-shrink: 0;
}
.pix-copy-btn:hover  { background: var(--acc-hover); }
.pix-copy-btn.copied { background: var(--green, #1e5e14); }

/* ── Passos ── */
.pix-steps {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 0;
  background: var(--surface-2);
  border: 1px solid var(--border);
  border-radius: var(--r3);
  overflow: hidden;
}
.pix-steps li {
  display: flex;
  align-items: flex-start;
  gap: var(--sp4);
  padding: var(--sp3) var(--sp5);
  font-size: var(--text-sm);
  color: var(--text-2);
  line-height: 1.5;
  transition: background var(--fast);
  border-bottom: 1px solid var(--border-2);
}
.pix-steps li:last-child { border-bottom: none; }
.pix-steps li:hover { background: var(--surface-off); }
.pix-step-num {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 22px; height: 22px;
  min-width: 22px;
  border-radius: 50%;
  background: var(--acc-soft);
  border: 1.5px solid var(--acc-border);
  color: var(--acc);
  font-size: var(--text-xs);
  font-weight: 800;
  margin-top: 1px;
}

/* ── Footer ── */
.pix-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--sp4);
  padding: var(--sp3) var(--sp5);
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--r3);
  flex-wrap: wrap;
}
.pix-footer__expiry {
  display: flex;
  align-items: center;
  gap: var(--sp2);
  font-size: var(--text-xs);
  color: var(--text-2);
}

/* ── Responsivo ── */
@media (max-width: 560px) {
  .pix-body__qr-section { padding: var(--sp4); }
  .pix-body__copy-section { padding: var(--sp4); }
  .pix-status-bar { flex-wrap: wrap; gap: var(--sp3); }
  .pix-status-bar__amount { margin-left: 0; }
  .pix-footer { gap: var(--sp3); }
}
</style>
{% endblock %}

{% block content %}
<div class="pix-page" data-reveal>

  {# ── Status bar ── #}
  <div class="pix-status-bar">
    <div class="pix-status-bar__pulse">
      <span class="pix-status-bar__dot"></span>
    </div>
    <div class="pix-status-bar__info">
      <div class="pix-status-bar__label">Status do pagamento</div>
      <div class="pix-status-bar__status">Aguardando pagamento</div>
    </div>
    <div class="pix-status-bar__amount">
      <div class="pix-status-bar__amount-label">Valor</div>
      <div class="pix-status-bar__value">R$ {{ (payment.amountCents / 100)|number_format(2, ',', '.') }}</div>
    </div>
  </div>

  <p class="pix-intro">
    Escaneie o QR Code com o app do seu banco ou copie o código abaixo para concluir o pagamento.
  </p>

  {# ── QR Code + Copia e Cola ── #}
  <div class="pix-body">

    <div class="pix-body__qr-section">
      {% if qrCodeBase64 is defined and qrCodeBase64 %}
        <div class="pix-qr">
          <img src="data:image/png;base64,{{ qrCodeBase64 }}"
               alt="QR Code Pix" width="220" height="220" loading="eager">
        </div>
        <div class="pix-qr__hint">
          <i data-lucide="smartphone" width="13" height="13"></i>
          Abra o banco → Pix → Pagar → Câmera
        </div>
      {% else %}
        <div class="pix-qr pix-qr--empty">
          <i data-lucide="qr-code" width="48" height="48"></i>
          <span>QR Code indisponível</span>
          <a href="" class="btn btn--ghost btn--sm">Tentar novamente</a>
        </div>
      {% endif %}
    </div>

    <div class="pix-body__copy-section">
      <div class="pix-copy-label">
        <i data-lucide="copy" width="13" height="13"></i>
        Pix Copia e Cola
      </div>
      <div class="pix-copy-box">
        <textarea class="pix-copy-code" id="pixCode" readonly rows="3" spellcheck="false">{{ payment.pixCode }}</textarea>
        <button type="button" class="pix-copy-btn" id="copyPixBtn" aria-label="Copiar código Pix">
          <i data-lucide="copy" width="16" height="16" id="copyIcon"></i>
          <span id="copyLabel">Copiar</span>
        </button>
      </div>
    </div>

  </div>

  {# ── Instruções ── #}
  <ol class="pix-steps">
    <li>
      <span class="pix-step-num">1</span>
      Abra o aplicativo do seu banco
    </li>
    <li>
      <span class="pix-step-num">2</span>
      Acesse a área Pix e escolha <strong>Pagar</strong>
    </li>
    <li>
      <span class="pix-step-num">3</span>
      Escaneie o QR Code ou cole o código copiado
    </li>
    <li>
      <span class="pix-step-num">4</span>
      Confirme — seu saldo é creditado em instantes
    </li>
  </ol>

  {# ── Footer ── #}
  <div class="pix-footer">
    <div class="pix-footer__expiry">
      <i data-lucide="clock" width="14" height="14"></i>
      <span>Código válido por <strong>24 horas</strong></span>
    </div>
    <a href="{{ path('app_wallet_index') }}" class="btn btn--ghost btn--sm">
      <i data-lucide="arrow-left" width="15" height="15"></i>
      Voltar para carteira
    </a>
  </div>

</div>
{% endblock %}

{% block javascripts %}{{ parent() }}
<script>
const copyBtn  = document.getElementById('copyPixBtn');
const copyIcon = document.getElementById('copyIcon');
const copyLbl  = document.getElementById('copyLabel');
const pixCode  = document.getElementById('pixCode');

copyBtn.addEventListener('click', async () => {
  try {
    await navigator.clipboard.writeText(pixCode.value);
  } catch {
    pixCode.select();
    document.execCommand('copy');
  }
  copyBtn.classList.add('copied');
  copyLbl.textContent = 'Copiado!';
  copyIcon.setAttribute('data-lucide', 'check');
  lucide.createIcons();
  setTimeout(() => {
    copyBtn.classList.remove('copied');
    copyLbl.textContent = 'Copiar';
    copyIcon.setAttribute('data-lucide', 'copy');
    lucide.createIcons();
  }, 2500);
});
</script>
{% endblock %}
