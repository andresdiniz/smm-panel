{% extends 'base.html.twig' %}

{% block title %}Carteira — PulseSMM{% endblock %}
{% block page_title %}Carteira{% endblock %}

{% block stylesheets %}{{ parent() }}
<style>
/* ════════════════════════════════════════════
   WALLET INDEX
   ════════════════════════════════════════════ */

/* ─ Hero ──────────────────────────────────────── */
.wh {
  position: relative;
  overflow: hidden;
  background: linear-gradient(135deg, #01696f 0%, #08444a 55%, #0b3638 100%);
  border-radius: var(--r4);
  padding: 36px 40px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  color: #fff;
  margin-bottom: 20px;
  box-shadow: 0 8px 32px rgba(1,105,111,.28);
}
/* orbs decorativos */
.wh::before {
  content: '';
  position: absolute;
  top: -70px; right: -70px;
  width: 260px; height: 260px;
  border-radius: 50%;
  background: rgba(255,255,255,.07);
  pointer-events: none;
}
.wh::after {
  content: '';
  position: absolute;
  bottom: -90px; left: 38%;
  width: 300px; height: 300px;
  border-radius: 50%;
  background: rgba(255,255,255,.04);
  pointer-events: none;
}

.wh__badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: rgba(255,255,255,.15);
  backdrop-filter: blur(8px);
  border: 1px solid rgba(255,255,255,.2);
  border-radius: 99px;
  padding: 4px 12px;
  font-size: .72rem;
  font-weight: 700;
  letter-spacing: .07em;
  text-transform: uppercase;
  margin-bottom: 12px;
  color: rgba(255,255,255,.92);
  width: fit-content;
}
.wh__label {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: .85rem;
  font-weight: 500;
  opacity: .72;
  margin-bottom: 6px;
}
.wh__amount {
  font-size: clamp(2.1rem, 5.5vw, 3.4rem);
  font-weight: 900;
  letter-spacing: -0.04em;
  line-height: 1;
  font-variant-numeric: tabular-nums;
}
.wh__actions {
  display: flex;
  flex-direction: column;
  gap: 10px;
  flex-shrink: 0;
  position: relative;
  z-index: 1;
}
/* botões dentro do hero */
.wh__btn-solid {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  height: 42px;
  padding: 0 20px;
  background: #fff;
  color: #01696f;
  border: none;
  border-radius: var(--r3);
  font-size: .88rem;
  font-weight: 700;
  text-decoration: none;
  cursor: pointer;
  box-shadow: 0 2px 12px rgba(0,0,0,.18);
  transition: background 140ms ease, box-shadow 140ms ease;
  white-space: nowrap;
}
.wh__btn-solid:hover {
  background: rgba(255,255,255,.88);
  box-shadow: 0 4px 20px rgba(0,0,0,.22);
}
.wh__btn-ghost {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  height: 42px;
  padding: 0 20px;
  background: rgba(255,255,255,.12);
  color: #fff;
  border: 1.5px solid rgba(255,255,255,.3);
  border-radius: var(--r3);
  font-size: .88rem;
  font-weight: 600;
  text-decoration: none;
  cursor: pointer;
  backdrop-filter: blur(8px);
  transition: background 140ms ease;
  white-space: nowrap;
}
.wh__btn-ghost:hover { background: rgba(255,255,255,.2); }

/* ─ KPI grid ────────────────────────────────── */
.wkpis {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14px;
  margin-bottom: 20px;
}
.wkpi {
  background: var(--surface-2);
  border: 1px solid var(--border);
  border-radius: var(--r3);
  padding: 18px 20px 16px;
  display: flex;
  flex-direction: column;
  gap: 8px;
  transition: box-shadow 160ms ease, transform 160ms ease;
}
.wkpi:hover {
  box-shadow: var(--sh-md);
  transform: translateY(-2px);
}
.wkpi__icon {
  width: 36px; height: 36px;
  border-radius: var(--r2);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.wkpi__icon--teal  { background: var(--acc-soft); color: var(--acc); }
.wkpi__icon--blue  { background: color-mix(in oklab,#154f82 12%,transparent); color: var(--blue,#3a7fc1); }
.wkpi__icon--gold  { background: color-mix(in oklab,#9c7400 12%,transparent); color: var(--gold,#b08a00); }
.wkpi__icon--green { background: color-mix(in oklab,#1e5e14 12%,transparent); color: var(--green,#437a22); }
.wkpi__label {
  font-size: .7rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: .07em;
  color: var(--text-2);
}
.wkpi__val {
  font-size: 1.45rem;
  font-weight: 800;
  letter-spacing: -0.02em;
  font-variant-numeric: tabular-nums;
  line-height: 1;
  color: var(--text);
}
.wkpi__val--green { color: var(--green,#437a22); }

/* ─ Tabela extrato ───────────────────────── */
.wtcard {
  background: var(--surface-2);
  border: 1px solid var(--border);
  border-radius: var(--r4);
  overflow: hidden;
}
.wtcard__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14px 24px;
  border-bottom: 1px solid var(--border);
}
.wtcard__head h2 {
  font-size: .9rem;
  font-weight: 700;
  letter-spacing: -0.01em;
}
.wtcard__badge {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 3px 10px;
  border-radius: 99px;
  font-size: .7rem;
  font-weight: 700;
  letter-spacing: .03em;
  background: var(--surface-off);
  color: var(--text-2);
  border: 1px solid var(--border);
}
.wtcard__wrap { overflow-x: auto; }

/* Tabela */
.wt {
  width: 100%;
  border-collapse: collapse;
}
.wt thead tr {
  border-bottom: 1.5px solid var(--border);
}
.wt thead th {
  padding: 10px 16px;
  font-size: .68rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: .08em;
  color: var(--text-2);
  text-align: left;
  white-space: nowrap;
  background: var(--surface);
}
.wt tbody tr {
  border-bottom: 1px solid var(--border);
  transition: background 120ms ease;
}
.wt tbody tr:last-child { border-bottom: none; }
.wt tbody tr:hover { background: var(--surface-off); }

/* linha pendente: fundo dourado sutil */
.wt tbody tr.row--pending {
  background: color-mix(in oklab, var(--gold,#b08a00) 5%, transparent);
}
.wt tbody tr.row--pending:hover {
  background: color-mix(in oklab, var(--gold,#b08a00) 9%, transparent);
}

.wt td {
  padding: 12px 16px;
  font-size: .875rem;
  vertical-align: middle;
}

/* larguras das colunas */
.wt .col-date    { width: 130px; white-space: nowrap; }
.wt .col-gw      { width: 130px; }
.wt .col-method  { width: 100px; }
.wt .col-status  { width: 140px; }
.wt .col-val     { text-align: right; white-space: nowrap; }

.td-date-main  { font-size: .85rem; font-variant-numeric: tabular-nums; color: var(--text); }
.td-date-sub   { font-size: .72rem; color: var(--text-2); opacity: .7; margin-top: 2px; }
.td-gw-pill {
  display: inline-block;
  padding: 2px 8px;
  border-radius: 99px;
  font-size: .72rem;
  font-weight: 600;
  background: var(--surface-off);
  color: var(--text-2);
  border: 1px solid var(--border);
}
.td-method { font-size: .82rem; text-transform: uppercase; letter-spacing: .04em; color: var(--text-2); font-weight: 600; }

/* Badges status */
.bs {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: 4px 10px;
  border-radius: 99px;
  font-size: .72rem;
  font-weight: 700;
  letter-spacing: .03em;
  white-space: nowrap;
  text-decoration: none;
}
.bs--ok    { background: var(--green-bg,rgba(67,122,34,.12)); color: var(--green,#437a22); }
.bs--pend  { background: color-mix(in oklab,var(--gold,#b08a00) 14%,transparent); color: var(--gold,#b08a00); }
.bs--cancel{ background: color-mix(in oklab,var(--red,#a1364a) 12%,transparent); color: var(--red,#a1364a); }

.td-val {
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  font-size: .92rem;
  color: var(--text-2);
}
.td-val--credit { color: var(--green,#437a22); }

/* ─ Empty state ───────────────────────── */
.wempty {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 60px 32px;
  gap: 10px;
}
.wempty svg  { color: var(--text-2); opacity: .5; }
.wempty h3   { font-size: .95rem; font-weight: 700; color: var(--text); }
.wempty p    { font-size: .85rem; color: var(--text-2); max-width: 30ch; }

/* ─ Responsivo ───────────────────────── */
@media (max-width: 900px) {
  .wkpis { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 640px) {
  .wh { flex-direction: column; align-items: flex-start; padding: 24px 20px; }
  .wh__actions { flex-direction: row; width: 100%; }
  .wh__btn-solid, .wh__btn-ghost { flex: 1; justify-content: center; }
  .wkpis { grid-template-columns: repeat(2, 1fr); }
  .wt thead th, .wt td { padding: 8px 10px; }
  .wt .col-gw { display: none; } /* esconde gateway em telas pequenas */
}
</style>
{% endblock %}

{% block content %}

{# ── HERO SALDO ── #}
<div class="wh" data-reveal>
  <div class="wh__info">
    <div class="wh__badge">
      <i data-lucide="wallet" width="12" height="12"></i>
      Carteira PulseSMM
    </div>
    <div class="wh__label">
      <i data-lucide="circle-dollar-sign" width="14" height="14"></i>
      Saldo disponível
    </div>
    <div class="wh__amount">
      R$&thinsp;{{ wallet ? (wallet.balanceCents / 100)|number_format(2, ',', '.') : '0,00' }}
    </div>
  </div>
  <div class="wh__actions">
    <a href="{{ path('app_wallet_deposit') }}" class="wh__btn-solid">
      <i data-lucide="plus" width="16" height="16"></i>
      Adicionar saldo
    </a>
    <a href="{{ path('app_transaction_index') }}" class="wh__btn-ghost">
      <i data-lucide="clock" width="16" height="16"></i>
      Histórico
    </a>
  </div>
</div>

{# ── KPIs ── #}
{% set total_dep = 0 %}
{% for tx in transactions %}
  {% if tx.status == 'approved' %}{% set total_dep = total_dep + tx.amountCents %}{% endif %}
{% endfor %}

<div class="wkpis" data-reveal>
  <div class="wkpi">
    <div class="wkpi__icon wkpi__icon--teal">
      <i data-lucide="trending-up" width="18" height="18"></i>
    </div>
    <div class="wkpi__label">Total depositado</div>
    <div class="wkpi__val">R$&thinsp;{{ (total_dep / 100)|number_format(2, ',', '.') }}</div>
  </div>
  <div class="wkpi">
    <div class="wkpi__icon wkpi__icon--blue">
      <i data-lucide="layers" width="18" height="18"></i>
    </div>
    <div class="wkpi__label">Transações</div>
    <div class="wkpi__val">{{ transactions|length }}</div>
  </div>
  <div class="wkpi">
    <div class="wkpi__icon wkpi__icon--gold">
      <i data-lucide="clock" width="18" height="18"></i>
    </div>
    <div class="wkpi__label">Pendentes</div>
    <div class="wkpi__val">{{ transactions|filter(t => t.status == 'pending')|length }}</div>
  </div>
  <div class="wkpi">
    <div class="wkpi__icon wkpi__icon--green">
      <i data-lucide="check-circle" width="18" height="18"></i>
    </div>
    <div class="wkpi__label">Aprovadas</div>
    <div class="wkpi__val wkpi__val--green">{{ transactions|filter(t => t.status == 'approved')|length }}</div>
  </div>
</div>

{# ── EXTRATO ── #}
<div class="wtcard" data-reveal>
  <div class="wtcard__head">
    <h2>Extrato</h2>
    <span class="wtcard__badge">
      <i data-lucide="receipt" width="12" height="12"></i>
      {{ transactions|length }} registro{{ transactions|length != 1 ? 's' : '' }}
    </span>
  </div>
  <div class="wtcard__wrap">
    <table class="wt">
      <thead>
        <tr>
          <th class="col-date">Data</th>
          <th class="col-gw">Gateway</th>
          <th class="col-method">Método</th>
          <th class="col-status">Status</th>
          <th class="col-val">Valor</th>
        </tr>
      </thead>
      <tbody>
      {% for tx in transactions %}
        <tr class="{{ tx.status == 'pending' ? 'row--pending' : '' }}">

          {# Data #}
          <td class="col-date">
            <div class="td-date-main">{{ tx.createdAt|date('d/m/Y') }}</div>
            <div class="td-date-sub">{{ tx.createdAt|date('H:i') }}</div>
          </td>

          {# Gateway #}
          <td class="col-gw">
            {% if tx.gateway %}
              <span class="td-gw-pill">{{ tx.gateway }}</span>
            {% else %}
              <span style="color:var(--text-2);opacity:.4">—</span>
            {% endif %}
          </td>

          {# Método #}
          <td class="col-method">
            <span class="td-method">{{ tx.method ?? '—' }}</span>
          </td>

          {# Status #}
          <td class="col-status">
            {% if tx.status == 'approved' %}
              <span class="bs bs--ok">
                <i data-lucide="check" width="11" height="11"></i> Aprovado
              </span>
            {% elseif tx.status == 'pending' and tx.method == 'pix' %}
              <a href="{{ path('app_wallet_pix_pending', {id: tx.id}) }}"
                 class="bs bs--pend"
                 title="Ver QR Code Pix">
                <i data-lucide="qr-code" width="11" height="11"></i> Pendente
              </a>
            {% elseif tx.status == 'pending' %}
              <span class="bs bs--pend">
                <i data-lucide="clock" width="11" height="11"></i> Pendente
              </span>
            {% elseif tx.status == 'cancelled' %}
              <span class="bs bs--cancel">
                <i data-lucide="x" width="11" height="11"></i> Cancelado
              </span>
            {% else %}
              <span class="bs bs--pend">{{ tx.status }}</span>
            {% endif %}
          </td>

          {# Valor #}
          <td class="col-val">
            <span class="td-val {{ tx.status == 'approved' ? 'td-val--credit' : '' }}">
              +R$&thinsp;{{ (tx.amountCents / 100)|number_format(2, ',', '.') }}
            </span>
          </td>

        </tr>
      {% else %}
        <tr>
          <td colspan="5">
            <div class="wempty">
              <i data-lucide="credit-card" width="42" height="42"></i>
              <h3>Nenhuma transação ainda</h3>
              <p>Faça seu primeiro depósito para ver o extrato aqui.</p>
              <a href="{{ path('app_wallet_deposit') }}" class="btn btn--ghost btn--sm">Fazer primeiro depósito</a>
            </div>
          </td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
</div>

{% endblock %}
