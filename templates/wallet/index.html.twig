{% extends 'dashboard/layout.html.twig' %}

{% block page_title %}Carteira{% endblock %}

{% block dashboard_body %}
<div class="wallet-page">
    {# BALANCE CARD #}
    <div class="balance-card">
        <span class="balance-card__label">Saldo disponível</span>
        <span class="balance-card__amount">R$ {{ (wallet.balanceCents / 100)|number_format(2, ',', '.') }}</span>
        <a href="{{ path('app_wallet_deposit') }}" class="btn btn-primary">+ Adicionar saldo</a>
    </div>

    {# EXTRATO (Payment entities) #}
    <div class="card mt-6">
        <div class="card__header">
            <h2>Extrato</h2>
            <span class="text-muted">Últimas {{ transactions|length }} transações</span>
        </div>
        <div class="card__body p-0">
            <table class="table">
                <thead>
                    <tr>
                        <th>Data</th>
                        <th>Descrição / Gateway</th>
                        <th>Status</th>
                        <th class="text-right">Valor</th>
                    </tr>
                </thead>
                <tbody>
                {% for tx in transactions %}
                <tr>
                    <td>{{ tx.createdAt|date('d/m/Y H:i') }}</td>
                    <td>{{ tx.gateway ?? '—' }}</td>
                    <td>
                        <span class="badge badge--{{ tx.status == 'approved' ? 'success' : (tx.status == 'pending' ? 'warning' : 'error') }}">
                            {% if tx.status == 'approved' %}Aprovado
                            {% elseif tx.status == 'pending' %}Pendente
                            {% else %}{{ tx.status|capitalize }}
                            {% endif %}
                        </span>
                    </td>
                    <td class="text-right {{ tx.status == 'approved' ? 'text-success' : 'text-muted' }}">
                        +R$ {{ (tx.amountCents / 100)|number_format(2, ',', '.') }}
                    </td>
                </tr>
                {% else %}
                <tr><td colspan="4" class="text-center text-muted py-4">Nenhuma transação ainda.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
