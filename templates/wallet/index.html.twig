{% extends 'base.html.twig' %}

{% block title %}Carteira — PulseSMM{% endblock %}
{% block page_title %}Carteira{% endblock %}

{% block content %}
<div class="wallet-page">

  {# ── HERO SALDO ── #}
  <div class="wallet-hero" data-reveal>
    <div class="wallet-hero__info">
      <span class="wallet-hero__label">Saldo disponível</span>
      <span class="wallet-hero__amount">
        R$ {{ wallet ? (wallet.balanceCents / 100)|number_format(2, ',', '.') : '0,00' }}
      </span>
    </div>
    <a href="{{ path('app_wallet_deposit') }}" class="btn btn--primary">
      <i data-lucide="plus" width="16" height="16"></i>
      Adicionar saldo
    </a>
  </div>

  {# ── STATS ── #}
  <div class="kpi-grid" data-reveal>
    <div class="kpi">
      <div class="kpi__label">Total depositado</div>
      <div class="kpi__value">
        {% set total = 0 %}
        {% for tx in transactions %}{% if tx.status == 'approved' %}{% set total = total + tx.amountCents %}{% endif %}{% endfor %}
        R$ {{ (total / 100)|number_format(2, ',', '.') }}
      </div>
    </div>
    <div class="kpi">
      <div class="kpi__label">Transações</div>
      <div class="kpi__value">{{ transactions|length }}</div>
    </div>
    <div class="kpi">
      <div class="kpi__label">Pendentes</div>
      <div class="kpi__value">{{ transactions|filter(t => t.status == 'pending')|length }}</div>
    </div>
  </div>

  {# ── EXTRATO ── #}
  <div class="card" data-reveal>
    <div class="card__head">
      <h2 class="card__title">Extrato</h2>
      <span class="badge badge--soft">{{ transactions|length }} registro(s)</span>
    </div>
    <div class="table-wrap">
      <table class="data-table">
        <thead>
          <tr>
            <th>Data</th>
            <th>Gateway</th>
            <th>Método</th>
            <th>Status</th>
            <th class="text-right">Valor</th>
          </tr>
        </thead>
        <tbody>
        {% for tx in transactions %}
          <tr>
            <td>
              <span class="text-sm">{{ tx.createdAt|date('d/m/Y') }}</span><br>
              <span class="text-xs text-muted">{{ tx.createdAt|date('H:i') }}</span>
            </td>
            <td>{{ tx.gateway ?? '—' }}</td>
            <td>{{ tx.method ?? '—' }}</td>
            <td>
              <span class="badge badge--{{ tx.status == 'approved' ? 'completed' : (tx.status == 'pending' ? 'pending' : 'cancelled') }}">
                {{ tx.status == 'approved' ? 'Aprovado' : (tx.status == 'pending' ? 'Pendente' : (tx.status == 'cancelled' ? 'Cancelado' : tx.status)) }}
              </span>
            </td>
            <td class="text-right tabular-nums {{ tx.status == 'approved' ? 'text-success' : '' }}">
              +R$ {{ (tx.amountCents / 100)|number_format(2, ',', '.') }}
            </td>
          </tr>
        {% else %}
          <tr>
            <td colspan="5">
              <div class="empty-state">
                <i data-lucide="credit-card" width="32" height="32"></i>
                <p>Nenhuma transação ainda.</p>
                <a href="{{ path('app_wallet_deposit') }}" class="btn btn--ghost btn--sm">Fazer primeiro depósito</a>
              </div>
            </td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
    </div>
  </div>

</div>
{% endblock %}
