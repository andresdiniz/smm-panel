{% extends 'base.html.twig' %}

{% block title %}Adicionar saldo — PulseSMM{% endblock %}
{% block page_title %}Adicionar saldo{% endblock %}

{% block content %}
<div class="dep-layout" data-reveal>

  {# ── INFO LATERAL ── #}
  <div class="dep-info">
    <div class="dep-info__badge">
      <i data-lucide="wallet" width="18" height="18"></i>
      Carteira
    </div>
    <h1 class="dep-info__title">Abasteça sua conta</h1>
    <p class="dep-info__desc">Escolha Pix ou cartão, gere a cobrança e acompanhe o status em tempo real.</p>

    <div class="dep-stats">
      <div class="dep-stat">
        <span class="dep-stat__label">Saldo atual</span>
        <span class="dep-stat__value">R$ {{ (wallet.balanceCents / 100)|number_format(2, ',', '.') }}</span>
      </div>
      <div class="dep-stat">
        <span class="dep-stat__label">Última recarga</span>
        <span class="dep-stat__value">{{ lastDeposit ? lastDeposit.createdAt|date('d/m/Y') : '—' }}</span>
      </div>
    </div>

    <div class="dep-pix-tip">
      <i data-lucide="zap" width="16" height="16"></i>
      <span>Pix é aprovado em menos de 1 minuto.</span>
    </div>

    <div class="dep-security">
      <i data-lucide="shield-check" width="15" height="15"></i>
      <span>Ambiente seguro — dados protegidos por criptografia</span>
    </div>
  </div>

  {# ── FORMULÁRIO ── #}
  <div class="card card--padded dep-form-card">
    <h2 class="dep-form-card__title">Nova recarga</h2>
    <p class="dep-form-card__sub">Mínimo R$ 10,00</p>

    <form method="post" class="form-grid" id="depositForm">
      <input type="hidden" name="_token" value="{{ csrf_token('wallet_deposit') }}">

      {# Valor #}
      <div class="field">
        <label for="dep_amount">Valor</label>
        <div class="dep-amount-wrap">
          <span class="dep-amount-prefix">R$</span>
          <input type="number" id="dep_amount" name="amount" class="control dep-amount-input"
                 min="10" step="0.01" value="50" required>
        </div>
      </div>

      {# Presets #}
      <div class="dep-presets">
        <span class="dep-presets__label">Valores rápidos</span>
        <div class="dep-presets__grid">
          {% for v in [20, 50, 100, 200, 500] %}
          <button type="button" class="dep-preset" data-val="{{ v }}">R$ {{ v }}</button>
          {% endfor %}
        </div>
      </div>

      {# Método #}
      <div class="field">
        <label for="dep_method">Método de pagamento</label>
        <select id="dep_method" name="method" class="control" required>
          <option value="pix">⚡ Pix — aprovação instantânea</option>
          <option value="credit_card">💳 Cartão de crédito</option>
          <option value="debit_card">💳 Cartão de débito</option>
        </select>
      </div>

      {# Divider #}
      <div class="dep-divider">
        <span>Dados pessoais</span>
      </div>

      {# CPF #}
      <div class="field">
        <label for="dep_cpf">
          CPF
          <span class="field__required">*</span>
        </label>
        <div class="input-icon-wrap">
          <i data-lucide="id-card" width="16" height="16" class="input-icon"></i>
          <input type="text" id="dep_cpf" name="cpf" class="control control--icon"
                 placeholder="000.000.000-00" maxlength="14"
                 inputmode="numeric" autocomplete="off" required>
        </div>
        <span class="field__hint">Necessário para emissão da cobrança</span>
      </div>

      {# Telefone #}
      <div class="field">
        <label for="dep_phone">
          Telefone / WhatsApp
          <span class="field__required">*</span>
        </label>
        <div class="input-icon-wrap">
          <i data-lucide="smartphone" width="16" height="16" class="input-icon"></i>
          <input type="text" id="dep_phone" name="phone" class="control control--icon"
                 placeholder="(00) 00000-0000" maxlength="15"
                 inputmode="numeric" autocomplete="tel" required>
        </div>
        <span class="field__hint">Com DDD — usado para notificações de pagamento</span>
      </div>

      <button type="submit" class="btn btn--primary btn--lg btn--block" id="submitBtn">
        <i data-lucide="arrow-right" width="18" height="18"></i>
        Gerar cobrança
      </button>
    </form>
  </div>

</div>

<style>
/* ── Layout ── */
.dep-layout {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--sp10);
  max-width: 900px;
  margin: 0 auto;
  align-items: start;
}

/* ── Info lateral ── */
.dep-info__badge {
  display: inline-flex;
  align-items: center;
  gap: var(--sp2);
  background: var(--primary-hi);
  color: var(--primary-h);
  padding: 5px var(--sp3);
  border-radius: var(--r-full);
  font-size: var(--text-xs);
  font-weight: 700;
  margin-bottom: var(--sp4);
  letter-spacing: 0.04em;
  text-transform: uppercase;
}
.dep-info__title {
  font-size: var(--text-xl);
  font-weight: 900;
  letter-spacing: -0.03em;
  line-height: 1.15;
  margin-bottom: var(--sp3);
}
.dep-info__desc {
  font-size: var(--text-sm);
  color: var(--muted);
  line-height: 1.65;
  max-width: 32ch;
  margin-bottom: var(--sp6);
}
.dep-stats {
  display: flex;
  flex-direction: column;
  gap: var(--sp2);
  margin-bottom: var(--sp4);
}
.dep-stat {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--sp3) var(--sp4);
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--r-lg);
}
.dep-stat__label {
  font-size: var(--text-xs);
  color: var(--muted);
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.06em;
}
.dep-stat__value {
  font-size: var(--text-sm);
  font-weight: 800;
  font-variant-numeric: tabular-nums;
}
.dep-pix-tip {
  display: flex;
  align-items: center;
  gap: var(--sp2);
  font-size: var(--text-xs);
  color: var(--primary-h);
  font-weight: 600;
  background: var(--primary-hi);
  padding: var(--sp2) var(--sp3);
  border-radius: var(--r-md);
  margin-bottom: var(--sp3);
}
.dep-security {
  display: flex;
  align-items: center;
  gap: var(--sp2);
  font-size: var(--text-xs);
  color: var(--muted);
  padding: var(--sp2) var(--sp3);
  border: 1px solid var(--border);
  border-radius: var(--r-md);
  background: var(--surface);
}

/* ── Formulário ── */
.dep-form-card__title {
  font-size: var(--text-lg);
  font-weight: 900;
  letter-spacing: -0.02em;
  margin-bottom: 4px;
}
.dep-form-card__sub {
  font-size: var(--text-xs);
  color: var(--muted);
  margin-bottom: var(--sp5);
}

/* ── Valor ── */
.dep-amount-wrap {
  position: relative;
  display: flex;
  align-items: center;
}
.dep-amount-prefix {
  position: absolute;
  left: var(--sp4);
  font-weight: 700;
  color: var(--muted);
  pointer-events: none;
  font-size: var(--text-base);
}
.dep-amount-input {
  padding-left: 2.6rem !important;
  font-size: var(--text-lg) !important;
  font-weight: 700 !important;
}

/* ── Presets ── */
.dep-presets { display: flex; flex-direction: column; gap: var(--sp2); }
.dep-presets__label {
  font-size: var(--text-xs);
  color: var(--muted);
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}
.dep-presets__grid { display: flex; gap: var(--sp2); flex-wrap: wrap; }
.dep-preset {
  padding: 6px var(--sp4);
  border-radius: var(--r-full);
  border: 1.5px solid var(--border);
  background: var(--surface-off);
  font-size: var(--text-xs);
  font-weight: 700;
  color: var(--muted);
  cursor: pointer;
  transition: background var(--t), border-color var(--t), color var(--t);
}
.dep-preset:hover, .dep-preset.is-active {
  background: var(--primary-hi);
  border-color: var(--primary);
  color: var(--primary-h);
}

/* ── Divider seção ── */
.dep-divider {
  position: relative;
  display: flex;
  align-items: center;
  margin: var(--sp2) 0 var(--sp1);
}
.dep-divider::before, .dep-divider::after {
  content: '';
  flex: 1;
  height: 1px;
  background: var(--border);
}
.dep-divider span {
  padding: 0 var(--sp3);
  font-size: var(--text-xs);
  color: var(--muted);
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.07em;
  white-space: nowrap;
}

/* ── Input com ícone ── */
.input-icon-wrap {
  position: relative;
  display: flex;
  align-items: center;
}
.input-icon {
  position: absolute;
  left: var(--sp4);
  color: var(--muted);
  pointer-events: none;
  flex-shrink: 0;
}
.control--icon { padding-left: 2.5rem !important; }

/* ── Hints e required ── */
.field__required {
  color: var(--danger, #e53e3e);
  margin-left: 2px;
}
.field__hint {
  display: block;
  font-size: var(--text-xs);
  color: var(--muted);
  margin-top: 4px;
  line-height: 1.4;
}

/* ── Responsivo ── */
@media (max-width: 700px) {
  .dep-layout { grid-template-columns: 1fr; gap: var(--sp6); }
}
</style>

{% block javascripts %}{{ parent() }}
<script>
/* ── Presets de valor ── */
document.querySelectorAll('.dep-preset').forEach(btn => {
  btn.addEventListener('click', () => {
    document.getElementById('dep_amount').value = btn.dataset.val;
    document.querySelectorAll('.dep-preset').forEach(b => b.classList.remove('is-active'));
    btn.classList.add('is-active');
  });
});

/* ── Máscara CPF: 000.000.000-00 ── */
const cpfInput = document.getElementById('dep_cpf');
cpfInput.addEventListener('input', function() {
  let v = this.value.replace(/\D/g, '').substring(0, 11);
  if (v.length > 9)      v = v.replace(/(\d{3})(\d{3})(\d{3})(\d+)/, '$1.$2.$3-$4');
  else if (v.length > 6) v = v.replace(/(\d{3})(\d{3})(\d+)/, '$1.$2.$3');
  else if (v.length > 3) v = v.replace(/(\d{3})(\d+)/, '$1.$2');
  this.value = v;
});

/* ── Máscara Telefone: (00) 00000-0000 ── */
const phoneInput = document.getElementById('dep_phone');
phoneInput.addEventListener('input', function() {
  let v = this.value.replace(/\D/g, '').substring(0, 11);
  if (v.length > 10)     v = v.replace(/(\d{2})(\d{5})(\d+)/, '($1) $2-$3');
  else if (v.length > 6) v = v.replace(/(\d{2})(\d{4})(\d+)/, '($1) $2-$3');
  else if (v.length > 2) v = v.replace(/(\d{2})(\d+)/, '($1) $2');
  this.value = v;
});

/* ── Loading no submit ── */
document.getElementById('depositForm').addEventListener('submit', function() {
  const btn = document.getElementById('submitBtn');
  btn.disabled = true;
  btn.innerHTML = '<svg class="spin" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/></svg> Gerando...';
});
</script>
<style>
@keyframes spin { to { transform: rotate(360deg); } }
.spin { animation: spin .8s linear infinite; }
</style>
{% endblock %}
{% endblock %}
