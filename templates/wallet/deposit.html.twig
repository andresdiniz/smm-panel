{% extends 'base.html.twig' %}

{% block title %}Adicionar saldo — PulseSMM{% endblock %}
{% block page_title %}Adicionar saldo{% endblock %}

{% block stylesheets %}{{ parent() }}
<style>
/* ══════════════════════════════════════════
   DEPOSIT — Design Refinado
   ══════════════════════════════════════════ */
.dep-layout {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--sp8);
  max-width: 960px;
  margin: 0 auto;
  align-items: start;
}

/* ── Painel esquerdo (info) ── */
.dep-info {
  position: sticky;
  top: calc(var(--topbar-h, 64px) + var(--sp6));
  display: flex;
  flex-direction: column;
  gap: var(--sp4);
}
.dep-info__eyebrow {
  display: inline-flex;
  align-items: center;
  gap: var(--sp2);
  background: var(--acc-soft);
  color: var(--acc);
  border: 1px solid var(--acc-border);
  border-radius: var(--rp);
  padding: 4px var(--sp3);
  font-size: var(--text-xs);
  font-weight: 700;
  letter-spacing: .06em;
  text-transform: uppercase;
  width: fit-content;
}
.dep-info__title {
  font-size: var(--text-xl);
  font-weight: 900;
  letter-spacing: -0.03em;
  line-height: 1.15;
}
.dep-info__desc {
  font-size: var(--text-sm);
  color: var(--text-2);
  line-height: 1.7;
  max-width: 34ch;
}

/* Stats box */
.dep-stats {
  background: var(--surface-2);
  border: 1px solid var(--border);
  border-radius: var(--r3);
  overflow: hidden;
}
.dep-stat {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--sp3) var(--sp5);
  transition: background var(--fast);
}
.dep-stat + .dep-stat { border-top: 1px solid var(--border-2); }
.dep-stat__label {
  font-size: var(--text-xs);
  color: var(--text-2);
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: .06em;
  display: flex;
  align-items: center;
  gap: var(--sp2);
}
.dep-stat__value {
  font-size: var(--text-sm);
  font-weight: 800;
  font-variant-numeric: tabular-nums;
}

/* Tips */
.dep-tip {
  display: flex;
  align-items: center;
  gap: var(--sp3);
  padding: var(--sp3) var(--sp4);
  border-radius: var(--r2);
  font-size: var(--text-xs);
  font-weight: 600;
  line-height: 1.4;
}
.dep-tip--pix {
  background: var(--acc-soft);
  color: var(--acc);
  border: 1px solid var(--acc-border);
}
.dep-tip--security {
  background: var(--surface);
  color: var(--text-2);
  border: 1px solid var(--border);
}
.dep-tip svg { flex-shrink: 0; }

/* ── Formulário ── */
.dep-form-card {
  background: var(--surface-2);
  border: 1px solid var(--border);
  border-radius: var(--r4);
  overflow: hidden;
}
.dep-form-header {
  padding: var(--sp5) var(--sp6);
  border-bottom: 1px solid var(--border);
  background: var(--surface);
}
.dep-form-header h2 {
  font-size: var(--text-base);
  font-weight: 800;
  letter-spacing: -0.01em;
  margin-bottom: 2px;
}
.dep-form-header p {
  font-size: var(--text-xs);
  color: var(--text-2);
}
.dep-form-body {
  padding: var(--sp6);
  display: flex;
  flex-direction: column;
  gap: var(--sp5);
}

/* Valor com prefixo */
.dep-amount-wrap {
  position: relative;
  display: flex;
  align-items: center;
}
.dep-amount-prefix {
  position: absolute;
  left: var(--sp4);
  font-weight: 700;
  color: var(--text-2);
  pointer-events: none;
  font-size: var(--text-base);
  z-index: 1;
}
.dep-amount-input {
  padding-left: 2.6rem !important;
  font-size: var(--text-lg) !important;
  font-weight: 800 !important;
  letter-spacing: -0.02em;
}

/* Presets */
.dep-presets { display: flex; flex-direction: column; gap: var(--sp2); }
.dep-presets__label {
  font-size: var(--text-xs);
  color: var(--text-2);
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: .06em;
}
.dep-presets__grid { display: flex; gap: var(--sp2); flex-wrap: wrap; }
.dep-preset {
  padding: 7px var(--sp4);
  border-radius: var(--rp);
  border: 1.5px solid var(--border);
  background: var(--surface-off);
  font-size: var(--text-xs);
  font-weight: 700;
  color: var(--text-2);
  cursor: pointer;
  transition: background var(--fast), border-color var(--fast), color var(--fast), box-shadow var(--fast);
}
.dep-preset:hover {
  background: var(--acc-soft);
  border-color: var(--acc-border);
  color: var(--acc);
}
.dep-preset.is-active {
  background: var(--acc);
  border-color: var(--acc);
  color: #fff;
  box-shadow: 0 2px 8px color-mix(in srgb, var(--acc) 30%, transparent);
}

/* Método select com ícone */
.dep-method-select { position: relative; }
.dep-method-select select {
  appearance: none;
  -webkit-appearance: none;
  padding-right: 2.5rem !important;
  cursor: pointer;
}
.dep-method-select__arrow {
  position: absolute;
  right: var(--sp4);
  top: 50%;
  transform: translateY(-50%);
  pointer-events: none;
  color: var(--text-2);
}

/* Divider seção */
.dep-divider {
  display: flex;
  align-items: center;
  gap: var(--sp3);
}
.dep-divider::before, .dep-divider::after {
  content: '';
  flex: 1;
  height: 1px;
  background: var(--border);
}
.dep-divider span {
  font-size: var(--text-xs);
  color: var(--text-2);
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: .07em;
  white-space: nowrap;
}

/* Input com ícone */
.input-icon-wrap {
  position: relative;
  display: flex;
  align-items: center;
}
.input-icon {
  position: absolute;
  left: var(--sp4);
  color: var(--text-2);
  pointer-events: none;
  flex-shrink: 0;
}
.control--icon { padding-left: 2.6rem !important; }

/* Field helpers */
.field__required { color: #e53e3e; margin-left: 2px; }
.field__hint {
  display: block;
  font-size: var(--text-xs);
  color: var(--text-3);
  margin-top: 4px;
  line-height: 1.5;
}

/* Form field layout */
.form-grid { display: flex; flex-direction: column; }
.field { display: flex; flex-direction: column; gap: var(--sp1); }
.field label {
  font-size: var(--text-xs);
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: .06em;
  color: var(--text-2);
}
.control {
  width: 100%;
  padding: var(--sp3) var(--sp4);
  background: var(--surface-off);
  border: 1.5px solid var(--border);
  border-radius: var(--r2);
  font-size: var(--text-sm);
  color: var(--text);
  transition: border-color var(--fast), box-shadow var(--fast), background var(--fast);
  outline: none;
}
.control:focus {
  border-color: var(--acc);
  background: var(--surface-2);
  box-shadow: 0 0 0 3px var(--acc-soft);
}
.control::placeholder { color: var(--text-3); }

/* Submit */
.btn--block { width: 100%; justify-content: center; }
.btn--lg {
  padding: var(--sp4) var(--sp6);
  font-size: var(--text-base);
  border-radius: var(--r2);
}

/* Spin */
@keyframes spin { to { transform: rotate(360deg); } }
.spin { animation: spin .8s linear infinite; }

/* ── Responsivo ── */
@media (max-width: 700px) {
  .dep-layout {
    grid-template-columns: 1fr;
    gap: var(--sp6);
  }
  .dep-info { position: static; }
}
</style>
{% endblock %}

{% block content %}
<div class="dep-layout" data-reveal>

  {# ── INFO LATERAL ── #}
  <div class="dep-info">
    <div class="dep-info__eyebrow">
      <i data-lucide="wallet" width="12" height="12"></i>
      Carteira
    </div>
    <h1 class="dep-info__title">Abasteça sua conta</h1>
    <p class="dep-info__desc">Escolha Pix ou cartão, gere a cobrança e acompanhe o status em tempo real.</p>

    <div class="dep-stats">
      <div class="dep-stat">
        <span class="dep-stat__label">
          <i data-lucide="wallet" width="13" height="13"></i>
          Saldo atual
        </span>
        <span class="dep-stat__value">R$ {{ (wallet.balanceCents / 100)|number_format(2, ',', '.') }}</span>
      </div>
      <div class="dep-stat">
        <span class="dep-stat__label">
          <i data-lucide="calendar" width="13" height="13"></i>
          Última recarga
        </span>
        <span class="dep-stat__value">{{ lastDeposit ? lastDeposit.createdAt|date('d/m/Y') : '—' }}</span>
      </div>
    </div>

    <div class="dep-tip dep-tip--pix">
      <i data-lucide="zap" width="15" height="15"></i>
      <span>Pix aprovado em menos de 1 minuto.</span>
    </div>

    <div class="dep-tip dep-tip--security">
      <i data-lucide="shield-check" width="15" height="15"></i>
      <span>Ambiente seguro — criptografia de ponta a ponta</span>
    </div>
  </div>

  {# ── FORMULÁRIO ── #}
  <div class="dep-form-card">
    <div class="dep-form-header">
      <h2>Nova recarga</h2>
      <p>Valor mínimo R$ 10,00</p>
    </div>

    <form method="post" class="dep-form-body" id="depositForm">
      <input type="hidden" name="_token" value="{{ csrf_token('wallet_deposit') }}">

      {# Valor #}
      <div class="field">
        <label for="dep_amount">Valor</label>
        <div class="dep-amount-wrap">
          <span class="dep-amount-prefix">R$</span>
          <input type="number" id="dep_amount" name="amount"
                 class="control dep-amount-input"
                 min="10" step="0.01" value="50" required>
        </div>
      </div>

      {# Presets #}
      <div class="dep-presets">
        <span class="dep-presets__label">Valores rápidos</span>
        <div class="dep-presets__grid">
          {% for v in [20, 50, 100, 200, 500] %}
          <button type="button" class="dep-preset" data-val="{{ v }}">R$ {{ v }}</button>
          {% endfor %}
        </div>
      </div>

      {# Método #}
      <div class="field">
        <label for="dep_method">Método de pagamento</label>
        <div class="dep-method-select">
          <select id="dep_method" name="method" class="control" required>
            <option value="pix">⚡ Pix — aprovação instantânea</option>
            <option value="credit_card">💳 Cartão de crédito</option>
            <option value="debit_card">💳 Cartão de débito</option>
          </select>
          <span class="dep-method-select__arrow">
            <i data-lucide="chevron-down" width="16" height="16"></i>
          </span>
        </div>
      </div>

      {# Divider #}
      <div class="dep-divider">
        <span>Dados pessoais</span>
      </div>

      {# CPF #}
      <div class="field">
        <label for="dep_cpf">
          CPF <span class="field__required">*</span>
        </label>
        <div class="input-icon-wrap">
          <i data-lucide="id-card" width="16" height="16" class="input-icon"></i>
          <input type="text" id="dep_cpf" name="cpf"
                 class="control control--icon"
                 placeholder="000.000.000-00" maxlength="14"
                 inputmode="numeric" autocomplete="off" required>
        </div>
        <span class="field__hint">Necessário para emissão da cobrança</span>
      </div>

      {# Telefone #}
      <div class="field">
        <label for="dep_phone">
          Telefone / WhatsApp <span class="field__required">*</span>
        </label>
        <div class="input-icon-wrap">
          <i data-lucide="smartphone" width="16" height="16" class="input-icon"></i>
          <input type="text" id="dep_phone" name="phone"
                 class="control control--icon"
                 placeholder="(00) 00000-0000" maxlength="15"
                 inputmode="numeric" autocomplete="tel" required>
        </div>
        <span class="field__hint">Com DDD — para notificações de pagamento</span>
      </div>

      <button type="submit" class="btn btn--primary btn--lg btn--block" id="submitBtn">
        <i data-lucide="arrow-right" width="18" height="18"></i>
        Gerar cobrança
      </button>
    </form>
  </div>

</div>
{% endblock %}

{% block javascripts %}{{ parent() }}
<script>
/* Presets */
document.querySelectorAll('.dep-preset').forEach(btn => {
  btn.addEventListener('click', () => {
    document.getElementById('dep_amount').value = btn.dataset.val;
    document.querySelectorAll('.dep-preset').forEach(b => b.classList.remove('is-active'));
    btn.classList.add('is-active');
  });
});

/* Máscara CPF */
const cpfInput = document.getElementById('dep_cpf');
cpfInput.addEventListener('input', function() {
  let v = this.value.replace(/\D/g, '').substring(0, 11);
  if (v.length > 9)      v = v.replace(/(\d{3})(\d{3})(\d{3})(\d+)/, '$1.$2.$3-$4');
  else if (v.length > 6) v = v.replace(/(\d{3})(\d{3})(\d+)/, '$1.$2.$3');
  else if (v.length > 3) v = v.replace(/(\d{3})(\d+)/, '$1.$2');
  this.value = v;
});

/* Máscara Telefone */
const phoneInput = document.getElementById('dep_phone');
phoneInput.addEventListener('input', function() {
  let v = this.value.replace(/\D/g, '').substring(0, 11);
  if (v.length > 10)     v = v.replace(/(\d{2})(\d{5})(\d+)/, '($1) $2-$3');
  else if (v.length > 6) v = v.replace(/(\d{2})(\d{4})(\d+)/, '($1) $2-$3');
  else if (v.length > 2) v = v.replace(/(\d{2})(\d+)/, '($1) $2');
  this.value = v;
});

/* Loading submit */
document.getElementById('depositForm').addEventListener('submit', function() {
  const btn = document.getElementById('submitBtn');
  btn.disabled = true;
  btn.innerHTML = '<svg class="spin" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/></svg> Gerando...';
});
</script>
{% endblock %}
