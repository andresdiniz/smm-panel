{% extends 'base.html.twig' %}

{% block title %}Adicionar saldo — PulseSMM{% endblock %}
{% block page_title %}Adicionar saldo{% endblock %}

{% block stylesheets %}{{ parent() }}
<style>
/* ══════════════════════════════════════════
   DEPOSIT v2 — tokens locais, tema-agnóstico
   ══════════════════════════════════════════ */
.dep {
  --_bg:        var(--surface,     #181b26);
  --_bg2:       var(--surface-2,   #1f2333);
  --_bg3:       var(--surface-off, #161925);
  --_border:    var(--border,      rgba(255,255,255,.09));
  --_border2:   var(--border-2,    rgba(255,255,255,.05));
  --_text:      var(--text,        #e4e6f0);
  --_text2:     var(--text-2,      #7a7e99);
  --_text3:     var(--text-3,      #4a4e66);
  --_acc:       var(--acc,         #01696f);
  --_acc-soft:  var(--acc-soft,    rgba(1,105,111,.15));
  --_acc-brd:   var(--acc-border,  rgba(1,105,111,.35));
  --_acc-hov:   var(--acc-hover,   #0c4e54);

  display: grid;
  grid-template-columns: 1fr 1.1fr;
  gap: 40px;
  max-width: 900px;
  margin: 0 auto;
  align-items: start;
  padding-bottom: 48px;
}

/* ── Painel esquerdo ── */
.dep__info {
  position: sticky;
  top: calc(var(--topbar-h, 60px) + 24px);
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.dep__eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: var(--_acc-soft);
  color: var(--_acc);
  border: 1px solid var(--_acc-brd);
  border-radius: 999px;
  padding: 4px 12px;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: .07em;
  text-transform: uppercase;
  width: fit-content;
}
.dep__title {
  font-size: 26px;
  font-weight: 900;
  letter-spacing: -0.03em;
  line-height: 1.15;
  color: var(--_text);
}
.dep__desc {
  font-size: 13px;
  color: var(--_text2);
  line-height: 1.7;
  max-width: 32ch;
}

/* Stats box */
.dep__stats {
  background: var(--_bg2);
  border: 1px solid var(--_border);
  border-radius: 10px;
  overflow: hidden;
  box-shadow: 0 2px 10px rgba(0,0,0,.15);
}
.dep__stat {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12px 18px;
}
.dep__stat + .dep__stat { border-top: 1px solid var(--_border2); }
.dep__stat-label {
  display: flex;
  align-items: center;
  gap: 7px;
  font-size: 11px;
  font-weight: 700;
  color: var(--_text2);
  text-transform: uppercase;
  letter-spacing: .06em;
}
.dep__stat-value {
  font-size: 13px;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
  color: var(--_text);
}

/* Tips */
.dep__tip {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 14px;
  border-radius: 8px;
  font-size: 12px;
  font-weight: 600;
  line-height: 1.4;
}
.dep__tip--pix {
  background: var(--_acc-soft);
  color: var(--_acc);
  border: 1px solid var(--_acc-brd);
}
.dep__tip--sec {
  background: var(--_bg2);
  color: var(--_text2);
  border: 1px solid var(--_border);
}

/* ── Card do formário ── */
.dep__card {
  background: var(--_bg2);
  border: 1px solid var(--_border);
  border-radius: 14px;
  overflow: hidden;
  box-shadow: 0 4px 24px rgba(0,0,0,.18);
}
.dep__card-head {
  padding: 18px 24px 16px;
  border-bottom: 1px solid var(--_border);
  background: var(--_bg3);
}
.dep__card-head h2 {
  font-size: 15px;
  font-weight: 800;
  color: var(--_text);
  margin-bottom: 2px;
}
.dep__card-head p {
  font-size: 12px;
  color: var(--_text2);
}
.dep__card-body {
  padding: 24px;
  display: flex;
  flex-direction: column;
  gap: 20px;
}

/* Fields */
.dep__field {
  display: flex;
  flex-direction: column;
  gap: 5px;
}
.dep__label {
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: .07em;
  color: var(--_text2);
}
.dep__label em { color: #e05252; font-style: normal; margin-left: 2px; }
.dep__hint {
  font-size: 11px;
  color: var(--_text3);
  line-height: 1.5;
  margin-top: 2px;
}

/* Input base */
.dep__control {
  width: 100%;
  padding: 10px 14px;
  background: var(--_bg3);
  border: 1.5px solid var(--_border);
  border-radius: 8px;
  font-size: 13px;
  color: var(--_text);
  outline: none;
  transition: border-color .18s, box-shadow .18s, background .18s;
}
.dep__control::placeholder { color: var(--_text3); }
.dep__control:focus {
  border-color: var(--_acc);
  background: var(--_bg2);
  box-shadow: 0 0 0 3px var(--_acc-soft);
}
select.dep__control { appearance: none; -webkit-appearance: none; cursor: pointer; }

/* Valor com prefixo R$ */
.dep__amount-wrap {
  position: relative;
  display: flex;
  align-items: center;
}
.dep__amount-prefix {
  position: absolute;
  left: 14px;
  font-weight: 700;
  color: var(--_text2);
  pointer-events: none;
  font-size: 15px;
  z-index: 1;
}
.dep__amount-input {
  padding-left: 34px !important;
  font-size: 22px !important;
  font-weight: 800 !important;
  letter-spacing: -0.02em;
  height: 52px;
}

/* Presets */
.dep__presets-label {
  font-size: 11px;
  font-weight: 700;
  color: var(--_text2);
  text-transform: uppercase;
  letter-spacing: .07em;
  margin-bottom: 8px;
}
.dep__presets {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}
.dep__preset {
  padding: 7px 16px;
  border-radius: 999px;
  border: 1.5px solid var(--_border);
  background: var(--_bg3);
  font-size: 12px;
  font-weight: 700;
  color: var(--_text2);
  cursor: pointer;
  transition: background .18s, border-color .18s, color .18s, box-shadow .18s;
  line-height: 1;
}
.dep__preset:hover {
  background: var(--_acc-soft);
  border-color: var(--_acc-brd);
  color: var(--_acc);
}
.dep__preset.is-active {
  background: var(--_acc);
  border-color: var(--_acc);
  color: #fff;
  box-shadow: 0 2px 8px rgba(1,105,111,.3);
}

/* Select método com seta */
.dep__method-wrap { position: relative; }
.dep__method-wrap select { padding-right: 40px !important; }
.dep__method-arrow {
  position: absolute;
  right: 14px;
  top: 50%;
  transform: translateY(-50%);
  pointer-events: none;
  color: var(--_text2);
  display: flex;
}

/* Input com ícone à esquerda */
.dep__icon-wrap { position: relative; display: flex; align-items: center; }
.dep__icon {
  position: absolute;
  left: 14px;
  color: var(--_text2);
  pointer-events: none;
  flex-shrink: 0;
  display: flex;
}
.dep__control--icon { padding-left: 40px !important; }

/* Divider */
.dep__divider {
  display: flex;
  align-items: center;
  gap: 10px;
}
.dep__divider::before, .dep__divider::after {
  content: '';
  flex: 1;
  height: 1px;
  background: var(--_border);
}
.dep__divider span {
  font-size: 11px;
  font-weight: 600;
  color: var(--_text2);
  white-space: nowrap;
}

/* Botão submit */
.dep__submit {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 14px 24px;
  background: var(--_acc);
  color: #fff;
  border: none;
  border-radius: 8px;
  font-size: 15px;
  font-weight: 700;
  cursor: pointer;
  transition: background .18s, transform .1s, box-shadow .18s;
  box-shadow: 0 4px 16px rgba(1,105,111,.35);
  margin-top: 4px;
}
.dep__submit:hover   { background: var(--_acc-hov); box-shadow: 0 6px 20px rgba(1,105,111,.45); }
.dep__submit:active  { transform: scale(.98); }
.dep__submit:disabled { opacity: .6; cursor: not-allowed; }
.dep__submit:focus-visible,
.dep__preset:focus-visible,
.dep__control:focus-visible {
  outline: 3px solid var(--_acc-brd);
  outline-offset: 2px;
}
.dep__alert {
  padding: 12px 14px;
  border: 1px solid rgba(224, 82, 82, .35);
  border-radius: 10px;
  color: #ffb8b8;
  background: rgba(224, 82, 82, .1);
  font-size: 13px;
  line-height: 1.5;
}
.dep__alert + .dep__alert { margin-top: 8px; }

@keyframes spin { to { transform: rotate(360deg); } }
.spin { animation: spin .8s linear infinite; }

.pix-modal {
  width: min(94vw, 520px);
  max-width: none;
  max-height: min(90dvh, 760px);
  padding: 0;
  overflow: auto;
  color: var(--text);
  background: transparent;
  border: 0;
}
.pix-modal::backdrop {
  background: rgb(10 25 28 / 72%);
  backdrop-filter: blur(5px);
}
.pix-modal__panel {
  padding: 24px;
  border: 1px solid var(--border);
  border-radius: var(--r-xl, 18px);
  background: var(--surface);
  box-shadow: var(--shadow-md);
}
.pix-modal__header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16px;
  padding-bottom: 16px;
  border-bottom: 1px solid var(--border);
}
.pix-modal__eyebrow {
  margin: 0 0 4px;
  color: var(--primary);
  font-size: .72rem;
  font-weight: 750;
  letter-spacing: .08em;
  text-transform: uppercase;
}
.pix-modal__header h2 {
  margin: 0;
  color: var(--text-bright);
  font-size: 1.35rem;
}
.pix-modal__close {
  display: grid;
  width: 36px;
  height: 36px;
  flex: 0 0 auto;
  place-items: center;
  border: 1px solid var(--border);
  border-radius: 50%;
  color: var(--text-muted);
  font-size: 1.5rem;
  line-height: 1;
  text-decoration: none;
}
.pix-modal__close:hover {
  color: var(--primary);
  background: var(--primary-lo);
}
.pix-modal__status {
  margin: 18px 0;
  padding: 12px 14px;
  border: 1px solid var(--acc-border);
  border-radius: var(--r-sm);
  color: var(--primary);
  background: var(--acc-soft);
  font-size: .9rem;
  font-weight: 700;
}
.pix-modal__details[hidden] {
  display: none;
}
.pix-modal__qr {
  display: grid;
  width: fit-content;
  min-width: 220px;
  min-height: 220px;
  margin: 0 auto 12px;
  padding: 12px;
  place-items: center;
  border: 1px solid #e6ebeb;
  border-radius: 12px;
  background: #fff;
}
.pix-modal__qr img {
  display: block;
  width: 220px;
  height: 220px;
  object-fit: contain;
}
.pix-modal__qr--empty {
  color: #627477;
  font-size: .85rem;
}
.pix-modal__hint {
  margin: 0 0 18px;
  color: var(--text-muted);
  font-size: .85rem;
  line-height: 1.55;
  text-align: center;
}
.pix-modal__label {
  display: block;
  margin-bottom: 7px;
  color: var(--text-muted);
  font-size: .75rem;
  font-weight: 750;
  text-transform: uppercase;
}
.pix-modal__copy {
  display: flex;
  align-items: stretch;
  overflow: hidden;
  border: 1px solid var(--border-2);
  border-radius: var(--r-sm);
  background: var(--surface-2);
}
.pix-modal__copy textarea {
  width: 100%;
  min-width: 0;
  padding: 11px;
  resize: vertical;
  border: 0;
  color: var(--text);
  background: transparent;
  font: .72rem/1.5 ui-monospace, SFMono-Regular, Consolas, monospace;
  overflow-wrap: anywhere;
}
.pix-modal__copy button,
.pix-modal__check {
  padding: 0 14px;
  border: 0;
  color: #fff;
  background: var(--primary);
  font: inherit;
  font-size: .82rem;
  font-weight: 750;
  cursor: pointer;
}
.pix-modal__copy button:hover,
.pix-modal__check:hover {
  background: var(--primary-hover);
}
.pix-modal__copy-feedback {
  min-height: 1.2em;
  margin: 5px 0 0;
  color: var(--text-muted);
  font-size: .76rem;
}
.pix-modal__summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  margin-top: 20px;
  padding: 14px 0;
  border-top: 1px solid var(--border);
  color: var(--text-muted);
  font-size: .88rem;
}
.pix-modal__summary strong {
  color: var(--text-bright);
  font-size: 1.15rem;
}
.pix-modal__check {
  width: 100%;
  min-height: 44px;
  border-radius: var(--r-sm);
}
.pix-modal__refresh {
  width: 100%;
  min-height: 44px;
  margin-bottom: 10px;
  border: 1px solid var(--acc-border);
  border-radius: var(--r-sm);
  color: var(--primary);
  background: var(--acc-soft);
  font: inherit;
  font-size: .85rem;
  font-weight: 750;
  cursor: pointer;
  transition: background .18s, transform .12s, opacity .18s;
}
.pix-modal__cancel-form { margin-top: 10px; }
.pix-modal__cancel {
  width: 100%;
  min-height: 42px;
  border: 1px solid color-mix(in oklab, var(--error) 45%, transparent);
  border-radius: var(--r-sm);
  color: var(--error);
  background: transparent;
  font: inherit;
  font-size: .84rem;
  font-weight: 750;
  cursor: pointer;
}
.pix-modal__cancel:hover { background: color-mix(in oklab, var(--error) 8%, transparent); }
.pix-modal__cancel-hint {
  margin: 7px 0 0;
  color: var(--text-muted);
  font-size: .74rem;
  line-height: 1.5;
}
.pix-modal__refresh:hover { background: var(--primary-lo); }
.pix-modal__refresh:active { transform: translateY(1px); }
.pix-modal__refresh:disabled,
.pix-modal__check:disabled { opacity: .6; cursor: wait; }
.pix-modal__refresh:focus-visible,
.pix-modal__check:focus-visible,
.pix-modal__copy button:focus-visible {
  outline: 3px solid var(--acc-border);
  outline-offset: 2px;
}
.pix-modal__error {
  margin: 10px 0 0;
  color: var(--error);
  font-size: .8rem;
}
.pix-modal__footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-top: 16px;
  color: var(--text-muted);
  font-size: .76rem;
}
.pix-modal__footer a {
  color: var(--primary);
  font-weight: 700;
  white-space: nowrap;
}

/* Responsivo */
@media (max-width: 680px) {
  .dep { grid-template-columns: 1fr; gap: 24px; }
  .dep__info { position: static; }
}
@media (max-width: 480px) {
  .pix-modal__panel { padding: 18px; }
  .pix-modal__copy { flex-direction: column; }
  .pix-modal__copy button { min-height: 42px; }
  .pix-modal__footer { align-items: flex-start; flex-direction: column; }
}
</style>
{% endblock %}

{% block content %}
<div class="dep">

  {# ── INFO ESQUERDA ── #}
  <div class="dep__info">
    {% for message in app.flashes('error') %}
      <div class="dep__alert" role="alert">{{ message }}</div>
    {% endfor %}
    <div class="dep__eyebrow">
      <i data-lucide="wallet" width="11" height="11"></i>
      Carteira
    </div>
    <h1 class="dep__title">Adicione saldo</h1>
    <p class="dep__desc">Escolha Pix ou cartão, gere a cobrança e acompanhe o status em tempo real.</p>

    <div class="dep__stats">
      <div class="dep__stat">
        <span class="dep__stat-label">
          <i data-lucide="wallet" width="13" height="13"></i>
          Saldo atual
        </span>
        <span class="dep__stat-value">R$ {{ (wallet.balanceCents / 100)|number_format(2, ',', '.') }}</span>
      </div>
      <div class="dep__stat">
        <span class="dep__stat-label">
          <i data-lucide="calendar" width="13" height="13"></i>
          Última recarga
        </span>
        <span class="dep__stat-value">{{ lastDeposit ? lastDeposit.createdAt|date('d/m/Y') : '—' }}</span>
      </div>
    </div>

    <div class="dep__tip dep__tip--pix">
      <i data-lucide="zap" width="14" height="14"></i>
      <span>Pix aprovado em menos de 1 minuto</span>
    </div>
    <div class="dep__tip dep__tip--sec">
      <i data-lucide="shield-check" width="14" height="14"></i>
      <span>Ambiente seguro — criptografia de ponta a ponta</span>
    </div>
  </div>

  {# ── FORMULÁRIO DIREITA ── #}
  <div class="dep__card">
    <div class="dep__card-head">
      <h2>Nova recarga</h2>
      <p>Valor mínimo R$ 10,00</p>
    </div>

    <form method="post" class="dep__card-body" id="depositForm">
      <input type="hidden" name="_token" value="{{ csrf_token('wallet_deposit') }}">

      {# Valor #}
      <div class="dep__field">
        <span class="dep__label">Valor</span>
        <div class="dep__amount-wrap">
          <span class="dep__amount-prefix">R$</span>
          <input type="number" id="dep_amount" name="amount"
                 class="dep__control dep__amount-input"
                 min="10" step="0.01" value="50" required>
        </div>
      </div>

      {# Presets #}
      <div>
        <div class="dep__presets-label">Valores rápidos</div>
        <div class="dep__presets">
          {% for v in [20, 50, 100, 200, 500] %}
          <button type="button" class="dep__preset{{ v == 50 ? ' is-active' : '' }}" data-val="{{ v }}">R$ {{ v }}</button>
          {% endfor %}
        </div>
      </div>

      {# Método #}
      <div class="dep__field">
        <span class="dep__label">Método de pagamento</span>
        <div class="dep__method-wrap">
          <select id="dep_method" name="method" class="dep__control" required>
            <option value="pix">⚡ Pix — aprovação instantânea</option>
            <option value="credit_card">💳 Cartão de crédito</option>
            <option value="debit_card">💳 Cartão de débito</option>
          </select>
          <span class="dep__method-arrow">
            <i data-lucide="chevron-down" width="15" height="15"></i>
          </span>
        </div>
      </div>

      {# Divider #}
      <div class="dep__divider"><span>Dados pessoais</span></div>

      {# CPF #}
      <div class="dep__field">
        <span class="dep__label">CPF <em>*</em></span>
        <div class="dep__icon-wrap">
          <span class="dep__icon"><i data-lucide="id-card" width="15" height="15"></i></span>
          <input type="text" id="dep_cpf" name="cpf"
                 class="dep__control dep__control--icon"
                 placeholder="000.000.000-00" maxlength="14"
                 inputmode="numeric" autocomplete="off" required>
        </div>
        <span class="dep__hint">Necessário para emissão da cobrança</span>
      </div>

      {# Telefone #}
      <div class="dep__field">
        <span class="dep__label">Telefone / WhatsApp <em>*</em></span>
        <div class="dep__icon-wrap">
          <span class="dep__icon"><i data-lucide="smartphone" width="15" height="15"></i></span>
          <input type="text" id="dep_phone" name="phone"
                 class="dep__control dep__control--icon"
                 placeholder="(00) 00000-0000" maxlength="15"
                 inputmode="numeric" autocomplete="tel" required>
        </div>
        <span class="dep__hint">Com DDD — para notificações de pagamento</span>
      </div>

      <button type="submit" class="dep__submit" id="submitBtn">
        <i data-lucide="arrow-right" width="18" height="18"></i>
        Gerar cobrança
      </button>
    </form>
  </div>

</div>
{% if pixPayment %}
  {% include 'wallet/_pix_modal.html.twig' with {payment: pixPayment, canRefreshPix: canRefreshPix, canCancelPix: canCancelPix} only %}
{% endif %}
{% endblock %}

{% block javascripts %}{{ parent() }}
<script>
/* Presets */
const amountInput = document.getElementById('dep_amount');
document.querySelectorAll('.dep__preset').forEach(btn => {
  btn.addEventListener('click', () => {
    amountInput.value = btn.dataset.val;
    document.querySelectorAll('.dep__preset').forEach(b => b.classList.remove('is-active'));
    btn.classList.add('is-active');
  });
});

/* Máscara CPF */
const cpfInput = document.getElementById('dep_cpf');
cpfInput.addEventListener('input', function() {
  let v = this.value.replace(/\D/g, '').substring(0, 11);
  if (v.length > 9)      v = v.replace(/(\d{3})(\d{3})(\d{3})(\d+)/, '$1.$2.$3-$4');
  else if (v.length > 6) v = v.replace(/(\d{3})(\d{3})(\d+)/, '$1.$2.$3');
  else if (v.length > 3) v = v.replace(/(\d{3})(\d+)/, '$1.$2');
  this.value = v;
});

/* Máscara Telefone */
const phoneInput = document.getElementById('dep_phone');
phoneInput.addEventListener('input', function() {
  let v = this.value.replace(/\D/g, '').substring(0, 11);
  if (v.length > 10)     v = v.replace(/(\d{2})(\d{5})(\d+)/, '($1) $2-$3');
  else if (v.length > 6) v = v.replace(/(\d{2})(\d{4})(\d+)/, '($1) $2-$3');
  else if (v.length > 2) v = v.replace(/(\d{2})(\d+)/, '($1) $2');
  this.value = v;
});

/* Loading submit */
document.getElementById('depositForm').addEventListener('submit', function() {
  const btn = document.getElementById('submitBtn');
  btn.disabled = true;
  btn.innerHTML = '<svg class="spin" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/></svg> Gerando...';
});

{% if pixPayment %}
const pixModal = document.getElementById('pix-payment-modal');
const pixCancelForm = document.getElementById('pix-cancel-form');
const pixStatus = document.getElementById('pix-payment-status');
const pixStatusError = document.getElementById('pix-status-error');
const pixDetails = document.getElementById('pix-payment-details');
const pixCheckButton = document.getElementById('pix-check-status');
const pixRefreshButton = document.getElementById('pix-refresh-qr');
const pixQrContainer = document.getElementById('pix-qr-container');
const pixCopySection = document.getElementById('pix-copy-section');
const pixStatusLabels = {
  pending: 'Aguardando a confirmação do pagamento.',
  approved: 'Pix confirmado. Seu saldo já foi atualizado.',
  failed: 'O pagamento não foi aprovado.',
  cancelled: 'Este Pix foi cancelado e não está mais disponível.',
  refunded: 'Este pagamento foi estornado.',
};

pixModal.showModal();
pixModal.addEventListener('cancel', event => event.preventDefault());
if (pixCancelForm) {
  pixCancelForm.addEventListener('submit', event => {
    if (!window.confirm('Deseja cancelar esta cobrança Pix pendente?')) {
      event.preventDefault();
    }
  });
}
pixModal.addEventListener('click', event => {
  if (event.target === pixModal) {
    window.location.assign(pixModal.dataset.continueUrl);
  }
});

if (pixRefreshButton) {
  pixRefreshButton.addEventListener('click', async () => {
    pixRefreshButton.disabled = true;
    pixStatusError.hidden = true;
    try {
      const response = await fetch(pixModal.dataset.qrUrl, {
        method: 'POST',
        headers: {
          Accept: 'application/json',
          'X-CSRF-Token': pixModal.dataset.qrCsrfToken,
        },
        credentials: 'same-origin',
        cache: 'no-store',
      });
      let result;
      try {
        result = await response.json();
      } catch {
        throw new Error('O servidor não retornou uma resposta válida. Tente novamente.');
      }
      if (!response.ok) {
        throw new Error(result.message || 'Não foi possível atualizar o QR Code.');
      }

      if (result.qrCodeBase64) {
        const image = document.createElement('img');
        image.src = `data:image/png;base64,${result.qrCodeBase64}`;
        image.alt = 'QR Code Pix para pagamento';
        image.width = 220;
        image.height = 220;
        pixQrContainer.replaceChildren(image);
        pixQrContainer.classList.remove('pix-modal__qr--empty');
        pixQrContainer.setAttribute('role', 'img');
        pixQrContainer.setAttribute('aria-label', 'QR Code Pix disponível para pagamento');
      }

      if (result.pixCode) {
        const pixCodeInput = document.getElementById('pix-payment-code');
        pixCodeInput.value = result.pixCode;
        pixCopySection.hidden = false;
        document.getElementById('pix-copy-button').hidden = false;
      }

      if (!result.qrCodeBase64 && !result.pixCode) {
        throw new Error('O gateway ainda não disponibilizou o QR Code.');
      }

      pixStatus.textContent = result.qrCodeBase64
        ? 'QR Code Pix atualizado. Aguardando a confirmação do pagamento.'
        : 'Código Pix atualizado. Use a opção copia e cola para pagar.';
    } catch (error) {
      pixStatusError.textContent = error instanceof Error
        ? error.message
        : 'Não foi possível atualizar o QR Code. Tente novamente.';
      pixStatusError.hidden = false;
    } finally {
      pixRefreshButton.disabled = false;
    }
  });
}

const pixCopyButton = document.getElementById('pix-copy-button');
if (pixCopyButton) {
  pixCopyButton.addEventListener('click', async () => {
    const pixCodeInput = document.getElementById('pix-payment-code');
    const feedback = document.getElementById('pix-copy-feedback');
    try {
      await navigator.clipboard.writeText(pixCodeInput.value);
      feedback.textContent = 'Código Pix copiado.';
    } catch {
      pixCodeInput.focus();
      pixCodeInput.select();
      feedback.textContent = document.execCommand('copy')
        ? 'Código Pix copiado.'
        : 'Não foi possível copiar. Selecione e copie o código manualmente.';
    }
  });
}

if (pixCheckButton) {
  let polling = false;
  const checkPixStatus = async () => {
    if (polling) return;
    polling = true;
    pixCheckButton.disabled = true;
    pixStatusError.hidden = true;
    try {
      const response = await fetch(pixModal.dataset.statusUrl, {
        headers: {Accept: 'application/json'},
        credentials: 'same-origin',
        cache: 'no-store',
      });
      if (!response.ok) {
        throw new Error('Falha ao consultar o pagamento.');
      }

      const result = await response.json();
      const status = pixStatusLabels[result.status] ? result.status : null;
      if (!status) {
        throw new Error('O gateway retornou um status de pagamento inválido.');
      }
      pixStatus.textContent = pixStatusLabels[status];
      if (status !== 'pending') {
        pixDetails.hidden = true;
        pixCheckButton.hidden = true;
        if (pixRefreshButton) {
          pixRefreshButton.hidden = true;
        }
      }
    } catch (error) {
      pixStatusError.textContent = error instanceof Error
        ? `${error.message} Tente novamente.`
        : 'Não foi possível consultar o pagamento. Tente novamente.';
      pixStatusError.hidden = false;
    } finally {
      polling = false;
      if (!pixCheckButton.hidden) {
        pixCheckButton.disabled = false;
      }
    }
  };

  pixCheckButton.addEventListener('click', checkPixStatus);
  window.setInterval(() => {
    if (!document.hidden && !pixCheckButton.hidden) {
      checkPixStatus();
    }
  }, 8000);
}
{% endif %}
</script>
{% endblock %}
