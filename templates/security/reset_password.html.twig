{% extends 'base.html.twig' %}

{% block title %}Criar nova senha | PulseSMM{% endblock %}
{% block description %}Defina uma nova senha para acessar sua conta PulseSMM.{% endblock %}

{% block body %}
<main class="login-page">
    <section class="login-card">
        <p class="eyebrow">Recuperação de acesso</p>
        <h1>Crie uma nova senha</h1>
        <p>Escolha uma senha com pelo menos 8 caracteres.</p>
        {% if formError is defined %}
            <p class="form-message form-message--error" role="alert">{{ formError }}</p>
        {% endif %}
        <form method="post" action="{{ path('app_reset_password', {selector: selector, token: token}) }}" class="login-form">
            <input type="hidden" name="_token" value="{{ csrf_token('reset_password_' ~ selector) }}">
            <div class="form-field">
                <label for="password">Nova senha</label>
                <input id="password" name="password" type="password" autocomplete="new-password" minlength="8" maxlength="4096" required>
            </div>
            <div class="form-field">
                <label for="password_confirmation">Confirme a nova senha</label>
                <input id="password_confirmation" name="password_confirmation" type="password" autocomplete="new-password" minlength="8" maxlength="4096" required>
            </div>
            <div class="form-actions">
                <button type="submit">Alterar senha</button>
            </div>
        </form>
        <p class="login-note"><a href="{{ path('app_login') }}">Voltar ao login</a></p>
    </section>
</main>
{% endblock %}
