{% extends 'base.html.twig' %}

{% block title %}Entrar — PulseSMM{% endblock %}

{% block body %}
<div class="auth-page">
  <div class="auth-card">

    {# ── Brand ── #}
    <a href="/" class="auth-card__brand">
      <svg width="36" height="36" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <rect width="36" height="36" rx="10" fill="var(--primary)"/>
        <path d="M8 24 L14 12 L18 20 L22 16 L28 24" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
        <circle cx="28" cy="14" r="3" fill="white" opacity=".8"/>
      </svg>
      <span style="font-weight:800;font-size:1.2rem;color:var(--text)">
        <strong style="color:var(--primary)">Pulse</strong>SMM
      </span>
    </a>

    <h1 class="auth-card__title">Bem-vindo de volta</h1>
    <p class="auth-card__sub">Entre na sua conta para continuar</p>

    {# ── Erro de autenticação ── #}
    {% if error %}
      <div class="alert alert--error" role="alert">
        {{ error.messageKey|trans(error.messageData, 'security') }}
      </div>
    {% endif %}

    {# ── Formulário ── #}
    <form method="post" action="{{ path('app_login') }}" class="quick-form" novalidate>
      <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

      <div class="field">
        <label for="inputEmail">E-mail</label>
        <input
          type="email"
          id="inputEmail"
          name="_username"
          value="{{ last_username }}"
          required
          autofocus
          autocomplete="email"
          class="control"
          placeholder="seu@email.com.br"
        >
      </div>

      <div class="field">
        <label for="inputPassword">Senha</label>
        <div style="position:relative">
          <input
            type="password"
            id="inputPassword"
            name="_password"
            required
            autocomplete="current-password"
            class="control"
            placeholder="••••••••"
            style="padding-right:2.75rem"
          >
          <button
            type="button"
            id="togglePwdBtn"
            aria-label="Mostrar ou ocultar senha"
            style="
              position:absolute;right:var(--sp3);top:50%;transform:translateY(-50%);
              display:flex;align-items:center;justify-content:center;
              color:var(--muted);padding:0;background:none;border:none;
              transition:color var(--transition);
            "
          >
            <svg id="eyeIcon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
            </svg>
          </button>
        </div>
      </div>

      <div class="field--inline" style="display:flex;align-items:center;gap:var(--sp2)">
        <input
          type="checkbox"
          name="_remember_me"
          id="rememberMe"
          style="width:16px;height:16px;accent-color:var(--primary);flex-shrink:0"
        >
        <label for="rememberMe" style="font-size:var(--text-sm);color:var(--muted);font-weight:400;cursor:pointer">Lembrar-me por 7 dias</label>
      </div>

      <button type="submit" class="btn btn--primary btn--lg btn--block" style="margin-top:var(--sp2)">
        Entrar
      </button>
    </form>

    <div class="auth-card__footer">
      Não tem conta?
      <a href="{{ path('app_register') }}">Cadastre-se grátis</a>
    </div>

  </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
(function() {
  var btn   = document.getElementById('togglePwdBtn');
  var input = document.getElementById('inputPassword');
  var icon  = document.getElementById('eyeIcon');
  if (!btn || !input) { return; }

  var eyeOpen = '<path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>';
  var eyeOff  = '<path stroke-linecap="round" stroke-linejoin="round" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"/>';

  btn.addEventListener('click', function() {
    var isPassword = input.type === 'password';
    input.type = isPassword ? 'text' : 'password';
    icon.innerHTML = isPassword ? eyeOff : eyeOpen;
    btn.setAttribute('aria-label', isPassword ? 'Ocultar senha' : 'Mostrar senha');
  });

  btn.addEventListener('mouseenter', function() { btn.style.color = 'var(--text)'; });
  btn.addEventListener('mouseleave', function() { btn.style.color = 'var(--muted)'; });
})();
</script>
{% endblock %}
