{% extends 'base.html.twig' %}

{% block title %}Entrar — PulseSMM{% endblock %}

{% block auth_body %}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Entrar — PulseSMM</title>

  <script>
    (function(){
      var s; try{ s = sessionStorage.getItem('pulse-theme'); }catch(e){}
      var sys = matchMedia('(prefers-color-scheme:dark)').matches ? 'dark' : 'light';
      document.documentElement.setAttribute('data-theme', s || sys);
    })();
  </script>

  <link rel="preconnect" href="https://api.fontshare.com">
  <link href="https://api.fontshare.com/v2/css?f[]=satoshi@300,400,500,600,700,800,900&display=swap" rel="stylesheet">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@1&display=swap" rel="stylesheet">

  <style>
    :root, [data-theme="light"] {
      --bg:#f2f0ec;--surface:#fafaf8;--surface-2:#ffffff;--surface-offset:#ece9e4;
      --border:oklch(0.2 0.005 80/0.09);--border-focus:oklch(0.2 0.005 80/0.18);--divider:oklch(0.2 0.005 80/0.07);
      --text:#1c1a17;--text-muted:#6e6c66;--text-faint:#b0ada6;--text-inverse:#faf9f7;
      --primary:#016870;--primary-h:#014e54;--primary-a:#013638;
      --primary-lo:oklch(0.48 0.08 192/0.10);--primary-glow:oklch(0.48 0.08 192/0.28);
      --accent:#e09c00;--accent-lo:oklch(0.72 0.15 80/0.12);
      --danger:#b8312a;--danger-lo:oklch(0.45 0.18 25/0.10);--danger-border:oklch(0.45 0.18 25/0.22);
      --success:#3a7a1e;--success-lo:oklch(0.50 0.14 145/0.10);
      --r-xs:6px;--r-sm:8px;--r-md:12px;--r-lg:16px;--r-xl:20px;--r-2xl:28px;--r-full:9999px;
      --s1:.25rem;--s2:.5rem;--s3:.75rem;--s4:1rem;--s5:1.25rem;--s6:1.5rem;--s8:2rem;--s10:2.5rem;--s12:3rem;--s16:4rem;
      --font-body:'Satoshi',system-ui,sans-serif;--font-display:'Instrument Serif',Georgia,serif;
      --t-xs:clamp(0.75rem,0.7rem + 0.25vw,0.875rem);--t-sm:clamp(0.875rem,0.82rem + 0.25vw,1rem);
      --t-base:clamp(1rem,0.95rem + 0.25vw,1.125rem);--t-lg:clamp(1.125rem,1rem + 0.6vw,1.375rem);
      --t-xl:clamp(1.5rem,1.2rem + 1.2vw,2rem);--t-2xl:clamp(2rem,1.5rem + 2vw,2.75rem);
      --ease:cubic-bezier(0.16,1,0.3,1);--dur-fast:120ms;--dur:180ms;--dur-slow:320ms;
      --shadow-xs:0 1px 2px oklch(0.2 0.01 80/0.05);
      --shadow-sm:0 2px 6px oklch(0.2 0.01 80/0.07),0 1px 2px oklch(0.2 0.01 80/0.04);
      --shadow-md:0 6px 20px oklch(0.2 0.01 80/0.09),0 2px 6px oklch(0.2 0.01 80/0.05);
      --shadow-lg:0 16px 48px oklch(0.2 0.01 80/0.12),0 4px 12px oklch(0.2 0.01 80/0.06);
      --shadow-primary:0 4px 16px oklch(0.48 0.08 192/0.32);
      --shadow-primary-h:0 8px 24px oklch(0.48 0.08 192/0.42);
      color-scheme:light;
    }
    [data-theme="dark"] {
      --bg:#111010;--surface:#181716;--surface-2:#1e1d1c;--surface-offset:#161514;
      --border:oklch(1 0 0/0.07);--border-focus:oklch(1 0 0/0.14);--divider:oklch(1 0 0/0.06);
      --text:#d6d4cf;--text-muted:#7a7874;--text-faint:#4e4c49;--text-inverse:#1a1917;
      --primary:#4ca3aa;--primary-h:#3a8f96;--primary-a:#2e747a;
      --primary-lo:oklch(0.66 0.07 192/0.12);--primary-glow:oklch(0.66 0.07 192/0.24);
      --accent:#f5b82e;--accent-lo:oklch(0.82 0.15 80/0.14);
      --danger:#e0604f;--danger-lo:oklch(0.60 0.18 25/0.12);--danger-border:oklch(0.60 0.18 25/0.24);
      --success:#6aaa42;--success-lo:oklch(0.66 0.14 145/0.12);
      --shadow-sm:0 2px 6px oklch(0 0 0/0.22),0 1px 2px oklch(0 0 0/0.14);
      --shadow-md:0 6px 20px oklch(0 0 0/0.32),0 2px 6px oklch(0 0 0/0.18);
      --shadow-lg:0 16px 48px oklch(0 0 0/0.44),0 4px 12px oklch(0 0 0/0.24);
      --shadow-primary:0 4px 16px oklch(0.66 0.07 192/0.28);
      --shadow-primary-h:0 8px 24px oklch(0.66 0.07 192/0.38);
      color-scheme:dark;
    }
    @media (prefers-color-scheme:dark){
      :root:not([data-theme]){
        --bg:#111010;--surface:#181716;--surface-2:#1e1d1c;--surface-offset:#161514;
        --border:oklch(1 0 0/.07);--border-focus:oklch(1 0 0/.14);--divider:oklch(1 0 0/.06);
        --text:#d6d4cf;--text-muted:#7a7874;--text-faint:#4e4c49;--text-inverse:#1a1917;
        --primary:#4ca3aa;--primary-h:#3a8f96;--primary-a:#2e747a;
        --primary-lo:oklch(0.66 0.07 192/.12);--primary-glow:oklch(0.66 0.07 192/.24);
        --accent:#f5b82e;--accent-lo:oklch(0.82 0.15 80/.14);
        --danger:#e0604f;--danger-lo:oklch(0.60 0.18 25/.12);--danger-border:oklch(0.60 0.18 25/.24);
        --success:#6aaa42;--success-lo:oklch(0.66 0.14 145/.12);
        --shadow-sm:0 2px 6px oklch(0 0 0/.22),0 1px 2px oklch(0 0 0/.14);
        --shadow-md:0 6px 20px oklch(0 0 0/.32),0 2px 6px oklch(0 0 0/.18);
        --shadow-lg:0 16px 48px oklch(0 0 0/.44),0 4px 12px oklch(0 0 0/.24);
        --shadow-primary:0 4px 16px oklch(0.66 0.07 192/.28);
        --shadow-primary-h:0 8px 24px oklch(0.66 0.07 192/.38);
        color-scheme:dark;
      }
    }
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
    html{font-family:var(--font-body);font-size:16px;-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale;text-rendering:optimizeLegibility;background:var(--bg);color:var(--text);height:100%;scroll-behavior:smooth;}
    body{min-height:100dvh;background:var(--bg);color:var(--text);transition:background var(--dur-slow) var(--ease),color var(--dur-slow) var(--ease);}
    img{display:block;max-width:100%;height:auto;}
    button{cursor:pointer;border:none;background:none;font:inherit;color:inherit;}
    a{color:var(--primary);text-decoration:none;transition:color var(--dur) var(--ease),opacity var(--dur) var(--ease);}
    a:hover{opacity:.8;}
    :focus-visible{outline:2px solid var(--primary);outline-offset:3px;border-radius:var(--r-xs);}
    ::selection{background:var(--primary-lo);color:var(--text);}
    @media(prefers-reduced-motion:reduce){*,*::before,*::after{animation-duration:0.01ms!important;transition-duration:0.01ms!important;}}

    .auth-shell{display:flex;flex-direction:column;min-height:100dvh;}
    @media(min-width:900px){.auth-shell{display:grid;grid-template-columns:1fr 1fr;grid-template-rows:1fr;min-height:100dvh;}}
    @media(min-width:1200px){.auth-shell{grid-template-columns:1.15fr 1fr;}}

    .hero-panel{background:var(--primary);overflow:hidden;color:#fff;position:relative;}
    .hero-panel::before{content:'';position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,.04) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.04) 1px,transparent 1px);background-size:44px 44px;pointer-events:none;z-index:0;}
    .hero-panel::after{content:'';position:absolute;inset:0;background:radial-gradient(ellipse 70% 50% at 15% 25%,rgba(255,255,255,.13) 0%,transparent 60%),radial-gradient(ellipse 50% 70% at 85% 80%,rgba(0,0,0,.18) 0%,transparent 55%);pointer-events:none;z-index:0;}

    .hero-mobile-strip{position:relative;z-index:1;display:flex;align-items:center;justify-content:space-between;gap:var(--s4);padding:var(--s4) var(--s5);}
    .hero-strip-brand{display:flex;align-items:center;gap:var(--s2);text-decoration:none;}
    .hero-strip-brand__icon{width:36px;height:36px;border-radius:var(--r-md);background:rgba(255,255,255,.18);border:1px solid rgba(255,255,255,.28);backdrop-filter:blur(8px);display:flex;align-items:center;justify-content:center;flex-shrink:0;}
    .hero-strip-brand__name{font-size:1.05rem;font-weight:800;letter-spacing:-.025em;color:#fff;}
    .hero-strip-brand__name em{font-style:normal;opacity:.72;}
    .hero-strip-right{display:flex;align-items:center;gap:var(--s3);}
    .hero-strip-stat{display:flex;flex-direction:column;align-items:flex-end;gap:1px;}
    .hero-strip-stat__num{font-size:.85rem;font-weight:800;color:#fff;letter-spacing:-.03em;font-variant-numeric:tabular-nums;line-height:1;}
    .hero-strip-stat__label{font-size:.58rem;color:rgba(255,255,255,.55);font-weight:500;letter-spacing:.04em;text-transform:uppercase;}
    .hero-strip-divider{width:1px;height:28px;background:rgba(255,255,255,.18);flex-shrink:0;}
    .hero-strip-theme{width:36px;height:36px;border-radius:var(--r-full);background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.18);display:flex;align-items:center;justify-content:center;color:rgba(255,255,255,.85);transition:background var(--dur) var(--ease),transform var(--dur) var(--ease);flex-shrink:0;}
    .hero-strip-theme:hover{background:rgba(255,255,255,.22);transform:rotate(15deg);}

    .hero-desktop-content{display:none;}
    @media(min-width:900px){
      .hero-mobile-strip{display:none;}
      .hero-panel{display:flex;flex-direction:column;justify-content:space-between;gap:var(--s10);padding:var(--s10) var(--s12);min-height:100dvh;}
      .hero-desktop-content{display:flex;flex-direction:column;gap:var(--s10);flex:1;position:relative;z-index:1;}
      .hero-stats-desktop{display:grid;grid-template-columns:repeat(3,1fr);gap:var(--s3);position:relative;z-index:1;}
      .hero-testimonial-desktop{position:relative;z-index:1;}
    }
    .hero-orb{display:none;}
    @media(min-width:900px){
      .hero-orb{display:block;position:absolute;width:480px;height:480px;border-radius:50%;background:radial-gradient(circle,rgba(255,255,255,.10) 0%,transparent 70%);top:-120px;right:-120px;animation:orb-drift 10s ease-in-out infinite;pointer-events:none;z-index:0;}
      .hero-orb-2{display:block;position:absolute;width:300px;height:300px;border-radius:50%;background:radial-gradient(circle,rgba(255,255,255,.07) 0%,transparent 70%);bottom:80px;left:-80px;animation:orb-drift 14s ease-in-out infinite reverse;pointer-events:none;z-index:0;}
    }
    @keyframes orb-drift{0%,100%{transform:translate(0,0) scale(1);}33%{transform:translate(-24px,18px) scale(1.06);}66%{transform:translate(12px,-20px) scale(0.96);}}
    .hero-brand{display:flex;align-items:center;gap:var(--s3);}
    .hero-brand__icon{width:46px;height:46px;border-radius:var(--r-md);background:rgba(255,255,255,.16);border:1px solid rgba(255,255,255,.24);backdrop-filter:blur(8px);display:flex;align-items:center;justify-content:center;flex-shrink:0;box-shadow:0 2px 8px rgba(0,0,0,.12);}
    .hero-brand__name{font-size:var(--t-lg);font-weight:800;letter-spacing:-.025em;color:#fff;}
    .hero-brand__name em{font-style:normal;opacity:.72;}
    .hero-status{display:inline-flex;align-items:center;gap:var(--s2);background:rgba(255,255,255,.12);backdrop-filter:blur(10px);border:1px solid rgba(255,255,255,.18);border-radius:var(--r-full);padding:var(--s1) var(--s4);font-size:var(--t-xs);font-weight:600;letter-spacing:.05em;text-transform:uppercase;color:rgba(255,255,255,.9);width:fit-content;}
    .hero-status__dot{width:6px;height:6px;border-radius:50%;background:var(--accent);box-shadow:0 0 8px var(--accent),0 0 16px rgba(240,165,0,.4);animation:pulse-dot 2.4s ease-in-out infinite;}
    @keyframes pulse-dot{0%,100%{transform:scale(1);opacity:1;}50%{transform:scale(1.3);opacity:.7;}}
    .hero-headline{font-family:var(--font-display);font-size:var(--t-2xl);font-weight:400;font-style:italic;line-height:1.12;letter-spacing:-.02em;color:#fff;}
    .hero-headline strong{font-style:normal;font-weight:800;color:var(--accent);font-family:var(--font-body);font-size:.75em;display:block;letter-spacing:-.03em;}
    .hero-desc{font-size:var(--t-sm);line-height:1.75;color:rgba(255,255,255,.7);max-width:42ch;}
    .hero-feats{display:flex;flex-direction:column;gap:var(--s3);}
    .hero-feat{display:flex;align-items:center;gap:var(--s3);font-size:var(--t-sm);color:rgba(255,255,255,.82);}
    .hero-feat__icon{width:30px;height:30px;border-radius:var(--r-sm);background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.10);display:flex;align-items:center;justify-content:center;flex-shrink:0;color:rgba(255,255,255,.9);}
    .stat-card{background:rgba(255,255,255,.10);backdrop-filter:blur(14px);border:1px solid rgba(255,255,255,.16);border-radius:var(--r-md);padding:var(--s4);transition:background var(--dur) var(--ease);}
    .stat-card:hover{background:rgba(255,255,255,.15);}
    .stat-card__num{font-size:1.5rem;font-weight:800;letter-spacing:-.04em;color:#fff;line-height:1;font-variant-numeric:tabular-nums;}
    .stat-card__label{font-size:.68rem;color:rgba(255,255,255,.55);margin-top:var(--s1);font-weight:500;letter-spacing:.04em;text-transform:uppercase;}
    .hero-testimonial{background:rgba(255,255,255,.08);backdrop-filter:blur(10px);border:1px solid rgba(255,255,255,.12);border-radius:var(--r-lg);padding:var(--s5) var(--s6);}
    .testimonial-stars{color:var(--accent);font-size:.8rem;letter-spacing:2px;margin-bottom:var(--s2);}
    .testimonial-text{font-size:var(--t-sm);line-height:1.65;color:rgba(255,255,255,.82);font-style:italic;margin-bottom:var(--s3);}
    .testimonial-author{display:flex;align-items:center;gap:var(--s2);font-size:.75rem;color:rgba(255,255,255,.6);}
    .testimonial-author__avatar{width:28px;height:28px;border-radius:50%;background:rgba(255,255,255,.2);display:flex;align-items:center;justify-content:center;font-size:.65rem;font-weight:700;color:#fff;flex-shrink:0;}

    .form-panel{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:var(--s8) var(--s4);background:var(--bg);position:relative;transition:background var(--dur-slow) var(--ease);}
    @media(min-width:640px){.form-panel{padding:var(--s10) var(--s8);}}
    @media(min-width:900px){.form-panel{min-height:100dvh;}}
    .theme-btn{position:absolute;top:var(--s5);right:var(--s5);width:40px;height:40px;border-radius:var(--r-full);background:var(--surface-2);border:1px solid var(--border);display:none;align-items:center;justify-content:center;color:var(--text-muted);box-shadow:var(--shadow-sm);transition:color var(--dur) var(--ease),background var(--dur) var(--ease),box-shadow var(--dur) var(--ease),transform var(--dur) var(--ease);}
    @media(min-width:900px){.theme-btn{display:flex;}}
    .theme-btn:hover{color:var(--text);box-shadow:var(--shadow-md);transform:rotate(15deg);}
    .form-wrap{width:100%;max-width:420px;}
    .form-header{margin-bottom:var(--s8);}
    .form-eyebrow{display:inline-flex;align-items:center;gap:var(--s2);background:var(--primary-lo);border:1px solid oklch(0.48 0.08 192/0.15);border-radius:var(--r-full);padding:var(--s1) var(--s3);font-size:var(--t-xs);font-weight:600;color:var(--primary);letter-spacing:.04em;text-transform:uppercase;margin-bottom:var(--s4);}
    [data-theme="dark"] .form-eyebrow{border-color:oklch(0.66 0.07 192/0.18);}
    .form-heading{font-size:var(--t-xl);font-weight:800;letter-spacing:-.03em;color:var(--text);line-height:1.15;margin-bottom:var(--s2);}
    .form-sub{font-size:var(--t-sm);color:var(--text-muted);line-height:1.65;}
    .social-proof{display:flex;align-items:center;gap:var(--s3);padding:var(--s3) var(--s4);background:var(--surface-2);border:1px solid var(--border);border-radius:var(--r-md);margin-bottom:var(--s6);box-shadow:var(--shadow-xs);}
    .sp-avatars{display:flex;}
    .sp-avatar{width:28px;height:28px;border-radius:50%;border:2px solid var(--bg);background:var(--primary-lo);display:flex;align-items:center;justify-content:center;font-size:.6rem;font-weight:700;color:var(--primary);margin-left:-8px;}
    .sp-avatar:first-child{margin-left:0;}
    .sp-stars{color:var(--accent);font-size:.7rem;letter-spacing:1px;line-height:1;}
    .sp-text{font-size:.75rem;color:var(--text-muted);margin-top:var(--s1);}
    .sp-text strong{color:var(--text);}
    .alert{display:flex;align-items:flex-start;gap:var(--s3);padding:var(--s3) var(--s4);border-radius:var(--r-md);font-size:var(--t-sm);margin-bottom:var(--s5);animation:slide-down .28s var(--ease);}
    .alert--error{background:var(--danger-lo);border:1px solid var(--danger-border);color:var(--danger);}
    .alert__icon{flex-shrink:0;margin-top:1px;}
    @keyframes slide-down{from{opacity:0;transform:translateY(-8px);}to{opacity:1;transform:none;}}
    .fields{display:flex;flex-direction:column;gap:var(--s5);margin-bottom:var(--s5);}
    .field{display:flex;flex-direction:column;gap:var(--s2);}
    .field-label{display:flex;align-items:center;justify-content:space-between;gap:var(--s2);}
    .field-label label{font-size:.8rem;font-weight:600;color:var(--text-muted);letter-spacing:.04em;text-transform:uppercase;}
    .field-link{font-size:.78rem;font-weight:500;color:var(--primary);}
    .field-link:hover{opacity:.8;}
    .input-wrap{position:relative;display:flex;align-items:center;}
    .input-icon{position:absolute;left:var(--s4);color:var(--text-faint);pointer-events:none;transition:color var(--dur) var(--ease);display:flex;}
    .control{width:100%;padding:var(--s4) var(--s4) var(--s4) calc(var(--s4) + 18px + var(--s3));background:var(--surface-2);border:1.5px solid var(--border);border-radius:var(--r-md);font-family:var(--font-body);font-size:16px;color:var(--text);transition:border-color var(--dur) var(--ease),box-shadow var(--dur) var(--ease),background var(--dur) var(--ease);-webkit-appearance:none;appearance:none;}
    .control::placeholder{color:var(--text-faint);}
    .control:hover:not(:focus){border-color:var(--border-focus);}
    .control:focus{outline:none;border-color:var(--primary);box-shadow:0 0 0 3px var(--primary-lo);}
    .input-wrap:focus-within .input-icon{color:var(--primary);}
    .pwd-toggle{position:absolute;right:var(--s3);display:flex;align-items:center;justify-content:center;width:32px;height:32px;border-radius:var(--r-sm);color:var(--text-faint);cursor:pointer;transition:color var(--dur) var(--ease),background var(--dur) var(--ease);}
    .pwd-toggle:hover{color:var(--text-muted);background:var(--surface-offset);}
    .row-remember{display:flex;align-items:center;justify-content:space-between;gap:var(--s3);}
    .check-label{display:flex;align-items:center;gap:var(--s2);font-size:var(--t-xs);color:var(--text-muted);cursor:pointer;user-select:none;}
    .check-label input[type="checkbox"]{appearance:none;-webkit-appearance:none;width:16px;height:16px;border-radius:4px;border:1.5px solid var(--border-focus);background:var(--surface-2);cursor:pointer;position:relative;transition:background var(--dur) var(--ease),border-color var(--dur) var(--ease);flex-shrink:0;}
    .check-label input[type="checkbox"]:checked{background:var(--primary);border-color:var(--primary);}
    .check-label input[type="checkbox"]:checked::after{content:'';position:absolute;left:3px;top:1px;width:8px;height:5px;border:2px solid #fff;border-top:none;border-right:none;transform:rotate(-45deg);}
    .btn-submit{width:100%;padding:var(--s4) var(--s6);background:var(--primary);color:#fff;border-radius:var(--r-md);font-family:var(--font-body);font-size:var(--t-base);font-weight:700;letter-spacing:-.01em;border:none;cursor:pointer;box-shadow:var(--shadow-primary);transition:background var(--dur) var(--ease),box-shadow var(--dur) var(--ease),transform var(--dur) var(--ease);display:flex;align-items:center;justify-content:center;gap:var(--s2);position:relative;overflow:hidden;min-height:52px;}
    .btn-submit::before{content:'';position:absolute;inset:0;background:linear-gradient(105deg,transparent 40%,rgba(255,255,255,.14) 50%,transparent 60%);transform:translateX(-100%);transition:transform .6s var(--ease);}
    .btn-submit:hover{background:var(--primary-h);box-shadow:var(--shadow-primary-h);transform:translateY(-1px);}
    .btn-submit:hover::before{transform:translateX(100%);}
    .btn-submit:active{transform:translateY(0) scale(.99);box-shadow:var(--shadow-primary);}
    .btn-submit .btn-arrow{transition:transform var(--dur) var(--ease);}
    .btn-submit:hover .btn-arrow{transform:translateX(4px);}

    /* Blog button */
    .btn-blog{display:flex;align-items:center;justify-content:center;gap:var(--s2);width:100%;padding:var(--s3) var(--s6);background:var(--surface-2);color:var(--text-muted);border:1.5px solid var(--border);border-radius:var(--r-md);font-family:var(--font-body);font-size:var(--t-sm);font-weight:600;cursor:pointer;text-decoration:none;transition:background var(--dur) var(--ease),border-color var(--dur) var(--ease),color var(--dur) var(--ease),box-shadow var(--dur) var(--ease);box-shadow:var(--shadow-xs);margin-bottom:var(--s4);}
    .btn-blog:hover{background:var(--surface-offset);border-color:var(--border-focus);color:var(--text);box-shadow:var(--shadow-sm);opacity:1;}
    .btn-blog svg{flex-shrink:0;color:var(--primary);}

    .divider{display:flex;align-items:center;gap:var(--s3);margin:var(--s6) 0;color:var(--text-faint);font-size:var(--t-xs);letter-spacing:.06em;text-transform:uppercase;}
    .divider::before,.divider::after{content:'';flex:1;height:1px;background:var(--divider);}
    .register-row{text-align:center;font-size:var(--t-sm);color:var(--text-muted);margin-bottom:var(--s5);}
    .register-row a{color:var(--primary);font-weight:600;}
    .trust-row{display:flex;align-items:center;justify-content:center;gap:var(--s6);margin-top:var(--s6);flex-wrap:wrap;}
    .trust-item{display:flex;align-items:center;gap:var(--s1);font-size:.7rem;color:var(--text-faint);font-weight:500;letter-spacing:.02em;}

    /* Footer links */
    .footer-links{display:flex;align-items:center;justify-content:center;gap:var(--s4);margin-top:var(--s6);flex-wrap:wrap;}
    .footer-links a{font-size:.72rem;color:var(--text-faint);font-weight:500;transition:color var(--dur) var(--ease);}
    .footer-links a:hover{color:var(--text-muted);opacity:1;}
    .footer-links span{color:var(--divider);font-size:.7rem;}

    @keyframes fade-up{from{opacity:0;transform:translateY(16px);}to{opacity:1;transform:none;}}
    .form-wrap > *{animation:fade-up var(--dur-slow) var(--ease) both;}
    .form-wrap > *:nth-child(1){animation-delay:0ms;}
    .form-wrap > *:nth-child(2){animation-delay:40ms;}
    .form-wrap > *:nth-child(3){animation-delay:80ms;}
    .form-wrap > *:nth-child(4){animation-delay:120ms;}
    .form-wrap > *:nth-child(5){animation-delay:160ms;}
    .form-wrap > *:nth-child(6){animation-delay:200ms;}
    .form-wrap > *:nth-child(7){animation-delay:240ms;}
    .form-wrap > *:nth-child(8){animation-delay:280ms;}
    .form-wrap > *:nth-child(9){animation-delay:320ms;}
    .form-wrap > *:nth-child(10){animation-delay:360ms;}
    .hero-desktop-content > *{animation:fade-up var(--dur-slow) var(--ease) both;}
    .hero-desktop-content > *:nth-child(1){animation-delay:100ms;}
    .hero-desktop-content > *:nth-child(2){animation-delay:180ms;}
    .hero-desktop-content > *:nth-child(3){animation-delay:260ms;}
    .hero-desktop-content > *:nth-child(4){animation-delay:340ms;}
    .hero-stats-desktop{animation:fade-up var(--dur-slow) var(--ease) 420ms both;}
    .hero-testimonial-desktop{animation:fade-up var(--dur-slow) var(--ease) 500ms both;}
  </style>
</head>
<body>

<div class="auth-shell">

  {# ══════════ LEFT — HERO PANEL ══════════ #}
  <aside class="hero-panel" aria-label="PulseSMM — Painel de informações">
    <div class="hero-orb" aria-hidden="true"></div>
    <div class="hero-orb-2" aria-hidden="true"></div>

    <div class="hero-mobile-strip">
      <a href="/" class="hero-strip-brand">
        <div class="hero-strip-brand__icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
        </div>
        <span class="hero-strip-brand__name"><em>Pulse</em>SMM</span>
      </a>
      <div class="hero-strip-right">
        <div class="hero-strip-stat">
          <span class="hero-strip-stat__num">1247+</span>
          <span class="hero-strip-stat__label">Pedidos hoje</span>
        </div>
        <div class="hero-strip-divider" aria-hidden="true"></div>
        <div class="hero-strip-stat">
          <span class="hero-strip-stat__num">99.9%</span>
          <span class="hero-strip-stat__label">Uptime</span>
        </div>
        <div class="hero-strip-divider" aria-hidden="true"></div>
        <button class="hero-strip-theme" data-theme-toggle aria-label="Alternar tema claro/escuro">
          <svg data-theme-icon width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
          </svg>
        </button>
      </div>
    </div>

    <div class="hero-desktop-content">
      <div class="hero-brand">
        <div class="hero-brand__icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
        </div>
        <span class="hero-brand__name"><em>Pulse</em>SMM</span>
      </div>
      <div>
        <div class="hero-status">
          <span class="hero-status__dot"></span>
          Plataforma online e operacional
        </div>
      </div>
      <div>
        <h2 class="hero-headline">Crescimento real<br>nas redes sociais<strong>Sem complicação.</strong></h2>
        <p class="hero-desc">Seguidores, curtidas e visualizações entregues de forma rápida, segura e com rastreamento em tempo real.</p>
      </div>
      <div class="hero-feats">
        <div class="hero-feat">
          <div class="hero-feat__icon"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="13 17 18 12 13 7"/><polyline points="6 17 11 12 6 7"/></svg></div>
          Entrega automática em minutos
        </div>
        <div class="hero-feat">
          <div class="hero-feat__icon"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg></div>
          Pagamentos 100% seguros e criptografados
        </div>
        <div class="hero-feat">
          <div class="hero-feat__icon"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg></div>
          Suporte 24h por dia, 7 dias por semana
        </div>
      </div>
    </div>

    <div class="hero-stats-desktop">
      <div class="stat-card"><div class="stat-card__num" id="statOrders">0</div><div class="stat-card__label">Pedidos hoje</div></div>
      <div class="stat-card"><div class="stat-card__num" id="statUsers">0</div><div class="stat-card__label">Clientes ativos</div></div>
      <div class="stat-card"><div class="stat-card__num">99.9%</div><div class="stat-card__label">Uptime</div></div>
    </div>

    <div class="hero-testimonial hero-testimonial-desktop">
      <div class="testimonial-stars">★★★★★</div>
      <p class="testimonial-text">"Consegui 10 mil seguidores em menos de 3 dias. O painel é intuitivo e o suporte respondeu em minutos."</p>
      <div class="testimonial-author">
        <div class="testimonial-author__avatar">MR</div>
        <span>Marcos R. — Criador de conteúdo</span>
      </div>
    </div>
  </aside>

  {# ══════════ RIGHT — FORM PANEL ══════════ #}
  <main class="form-panel">

    <button class="theme-btn" data-theme-toggle aria-label="Alternar tema claro/escuro">
      <svg data-theme-icon width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
      </svg>
    </button>

    <div class="form-wrap">

      <header class="form-header">
        <div class="form-eyebrow">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
          PulseSMM
        </div>
        <h1 class="form-heading">Bem-vindo de volta</h1>
        <p class="form-sub">Entre na sua conta para gerenciar seus serviços e acompanhar seus pedidos.</p>
      </header>

      <div class="social-proof" role="complementary" aria-label="Avaliações de clientes">
        <div class="sp-avatars" aria-hidden="true">
          <div class="sp-avatar">AN</div><div class="sp-avatar">MR</div><div class="sp-avatar">LK</div><div class="sp-avatar">CF</div>
        </div>
        <div>
          <div class="sp-stars" aria-hidden="true">★★★★★</div>
          <div class="sp-text"><strong>+4.800 clientes</strong> confiam no PulseSMM</div>
        </div>
      </div>

      {% if error %}
      <div class="alert alert--error" role="alert">
        <svg class="alert__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        <span>{{ error.messageKey|trans(error.messageData, 'security') }}</span>
      </div>
      {% endif %}

      <form method="post" action="{{ path('app_login') }}" novalidate>
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

        <div class="fields">
          <div class="field">
            <div class="field-label">
              <label for="inputEmail">E-mail</label>
            </div>
            <div class="input-wrap">
              <span class="input-icon">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
              </span>
              <input type="email" id="inputEmail" name="_username" value="{{ last_username }}" required autofocus autocomplete="email" class="control" placeholder="seu@email.com.br" aria-label="Endereço de e-mail">
            </div>
          </div>

          <div class="field">
            <div class="field-label">
              <label for="inputPassword">Senha</label>
              <a href="#" class="field-link">Esqueceu?</a>
            </div>
            <div class="input-wrap">
              <span class="input-icon">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
              </span>
              <input type="password" id="inputPassword" name="_password" required autocomplete="current-password" class="control" placeholder="••••••••" aria-label="Senha" style="padding-right:3rem;">
              <button type="button" class="pwd-toggle" id="pwdToggle" aria-label="Mostrar senha">
                <svg id="eyeIcon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>
                </svg>
              </button>
            </div>
          </div>

          <div class="row-remember">
            <label class="check-label">
              <input type="checkbox" name="_remember_me">
              Lembrar-me neste dispositivo
            </label>
          </div>
        </div>

        <button type="submit" class="btn-submit">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
          Entrar na conta
          <svg class="btn-arrow" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </button>
      </form>

      <div class="divider" aria-hidden="true">ou</div>

      {# ── Blog button ── #}
      <a href="{{ path('blog_index') }}" class="btn-blog">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
        Ver dicas no Blog
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>

      <p class="register-row">
        Ainda não tem conta?
        <a href="{{ path('app_register') }}">Criar conta grátis →</a>
      </p>

      <div class="trust-row" aria-label="Selos de confiança">
        <div class="trust-item">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          SSL seguro
        </div>
        <div class="trust-item">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          Entrega rápida
        </div>
        <div class="trust-item">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
          Garantia 30 dias
        </div>
        <div class="trust-item">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 1.27h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.86A16 16 0 0 0 16 16.95l.95-.95a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          Suporte 24/7
        </div>
      </div>

      <nav class="footer-links" aria-label="Links do rodapé">
        <a href="{{ path('app_terms') }}">Termos de Uso</a>
        <span aria-hidden="true">·</span>
        <a href="{{ path('app_privacy') }}">Privacidade</a>
        <span aria-hidden="true">·</span>
        <a href="{{ path('blog_index') }}">Blog</a>
        <span aria-hidden="true">·</span>
        <a href="{{ path('support_index') }}">Suporte</a>
      </nav>

    </div>
  </main>

</div>

<script>
(function () {
  'use strict';

  var MOON = '<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>';
  var SUN  = '<circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>';
  var EYE_OPEN = '<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>';
  var EYE_OFF  = '<path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/>';

  var html = document.documentElement;

  function updateAllIcons(theme) {
    document.querySelectorAll('[data-theme-icon]').forEach(function(icon) {
      icon.innerHTML = theme === 'dark' ? MOON : SUN;
    });
  }

  function setTheme(t) {
    html.setAttribute('data-theme', t);
    updateAllIcons(t);
    try { sessionStorage.setItem('pulse-theme', t); } catch(e) {}
  }

  var current = html.getAttribute('data-theme') || 'light';
  updateAllIcons(current);

  document.querySelectorAll('[data-theme-toggle]').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var next = html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
      setTheme(next);
    });
  });

  /* ── Password toggle — aguarda DOM pronto ── */
  function initPwdToggle() {
    var pwdBtn   = document.getElementById('pwdToggle');
    var pwdInput = document.getElementById('inputPassword');
    var eyeIcon  = document.getElementById('eyeIcon');

    if (!pwdBtn || !pwdInput || !eyeIcon) return;

    pwdBtn.addEventListener('click', function () {
      var showing = pwdInput.type === 'text';
      pwdInput.type = showing ? 'password' : 'text';
      eyeIcon.innerHTML = showing ? EYE_OPEN : EYE_OFF;
      pwdBtn.setAttribute('aria-label', showing ? 'Mostrar senha' : 'Ocultar senha');
    });
  }

  /* ── Animated counters ── */
  function animCounter(el, target, suffix) {
    if (!el) return;
    var start = 0, duration = 1800, startTime = null;
    function step(ts) {
      if (!startTime) startTime = ts;
      var progress = Math.min((ts - startTime) / duration, 1);
      var eased = 1 - Math.pow(1 - progress, 3);
      el.textContent = Math.floor(eased * target) + (suffix || '');
      if (progress < 1) requestAnimationFrame(step);
    }
    requestAnimationFrame(step);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function() {
      initPwdToggle();
      animCounter(document.getElementById('statOrders'), 1247, '+');
      animCounter(document.getElementById('statUsers'),  4832, '+');
    });
  } else {
    initPwdToggle();
    animCounter(document.getElementById('statOrders'), 1247, '+');
    animCounter(document.getElementById('statUsers'),  4832, '+');
  }

})();
</script>

</body>
</html>
{% endblock %}
