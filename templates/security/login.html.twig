{% extends 'base.html.twig' %}

{% block title %}Entrar — PulseSMM{% endblock %}

{% block auth_body %}
<!DOCTYPE html>
<html lang="pt-BR" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Entrar — PulseSMM</title>
  <link rel="preconnect" href="https://api.fontshare.com">
  <link href="https://api.fontshare.com/v2/css?f[]=satoshi@400,500,600,700,800,900&display=swap" rel="stylesheet">
  <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js" defer></script>
  <style>
    /* ═══════════════════════════════════════════════
       TOKENS
    ═══════════════════════════════════════════════ */
    :root,[data-theme="light"]{
      --bg:         #f4f3ef;
      --surface:    #ffffff;
      --surface-2:  #f9f8f6;
      --border:     rgba(0,0,0,.09);
      --text:       #1a1917;
      --muted:      #78766f;
      --faint:      #b5b3ac;
      --primary:    #016a70;
      --primary-h:  #014f54;
      --primary-lo: rgba(1,106,112,.10);
      --accent:     #f0a500;
      --danger:     #c0392b;
      --danger-lo:  rgba(192,57,43,.10);
      --shadow-sm:  0 1px 3px rgba(0,0,0,.08);
      --shadow-md:  0 6px 24px rgba(0,0,0,.10);
      --shadow-lg:  0 16px 48px rgba(0,0,0,.14);
      --radius:     14px;
      --sp1:.25rem;--sp2:.5rem;--sp3:.75rem;--sp4:1rem;
      --sp5:1.25rem;--sp6:1.5rem;--sp8:2rem;--sp10:2.5rem;
      --transition: 180ms cubic-bezier(.16,1,.3,1);
      --font:'Satoshi',system-ui,sans-serif;
      color-scheme:light;
    }
    [data-theme="dark"]{
      --bg:         #0f0e0d;
      --surface:    #161514;
      --surface-2:  #1c1b19;
      --border:     rgba(255,255,255,.08);
      --text:       #dddbd6;
      --muted:      #7a7871;
      --faint:      #4a4845;
      --primary:    #4fa3aa;
      --primary-h:  #3d8a91;
      --primary-lo: rgba(79,163,170,.12);
      --accent:     #f5b82e;
      --danger:     #e05c4f;
      --danger-lo:  rgba(224,92,79,.12);
      --shadow-sm:  0 1px 3px rgba(0,0,0,.25);
      --shadow-md:  0 6px 24px rgba(0,0,0,.35);
      --shadow-lg:  0 16px 48px rgba(0,0,0,.50);
      color-scheme:dark;
    }

    /* ═══════════════════════════════════════════════
       RESET + BASE
    ═══════════════════════════════════════════════ */
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    html{font-family:var(--font);font-size:16px;-webkit-font-smoothing:antialiased;background:var(--bg);color:var(--text);height:100%}
    body{min-height:100dvh;display:flex;flex-direction:column;background:var(--bg);color:var(--text)}
    a{color:var(--primary);text-decoration:none;transition:opacity var(--transition)}
    a:hover{opacity:.8}
    button{cursor:pointer;border:none;background:none;font:inherit;color:inherit}
    img{display:block;max-width:100%;height:auto}
    :focus-visible{outline:2px solid var(--primary);outline-offset:3px;border-radius:4px}

    /* ═══════════════════════════════════════════════
       LAYOUT SHELL
    ═══════════════════════════════════════════════ */
    .auth-shell{
      display:grid;
      grid-template-columns:1fr 1fr;
      min-height:100dvh;
    }

    /* ═══════════════════════════════════════════════
       LEFT PANEL — hero / landing
    ═══════════════════════════════════════════════ */
    .hero-panel{
      position:relative;
      background: var(--primary);
      background-image:
        radial-gradient(ellipse 80% 60% at 20% 30%, rgba(255,255,255,.10) 0%, transparent 60%),
        radial-gradient(ellipse 60% 80% at 80% 80%, rgba(0,0,0,.15) 0%, transparent 60%);
      display:flex;
      flex-direction:column;
      justify-content:space-between;
      padding:var(--sp8) var(--sp10);
      overflow:hidden;
      color:#fff;
    }

    /* subtle grid pattern */
    .hero-panel::before{
      content:'';
      position:absolute;inset:0;
      background-image:
        linear-gradient(rgba(255,255,255,.04) 1px,transparent 1px),
        linear-gradient(90deg,rgba(255,255,255,.04) 1px,transparent 1px);
      background-size:40px 40px;
      pointer-events:none;
    }

    /* animated pulse orb */
    .hero-panel::after{
      content:'';
      position:absolute;
      width:420px;height:420px;
      border-radius:50%;
      background:radial-gradient(circle,rgba(255,255,255,.12) 0%,transparent 70%);
      top:-80px;right:-80px;
      animation:orb-float 8s ease-in-out infinite;
      pointer-events:none;
    }
    @keyframes orb-float{
      0%,100%{transform:translate(0,0) scale(1)}
      50%{transform:translate(-20px,20px) scale(1.08)}
    }

    .hero-brand{
      display:flex;
      align-items:center;
      gap:var(--sp3);
      position:relative;
      z-index:1;
    }
    .hero-brand__logo{
      width:44px;height:44px;
      background:rgba(255,255,255,.18);
      border-radius:12px;
      display:flex;align-items:center;justify-content:center;
      backdrop-filter:blur(8px);
      border:1px solid rgba(255,255,255,.25);
      flex-shrink:0;
    }
    .hero-brand__name{
      font-size:1.5rem;
      font-weight:800;
      letter-spacing:-.02em;
      color:#fff;
    }
    .hero-brand__name em{font-style:normal;opacity:.75}

    .hero-body{
      position:relative;
      z-index:1;
    }
    .hero-eyebrow{
      display:inline-flex;
      align-items:center;
      gap:var(--sp2);
      background:rgba(255,255,255,.15);
      backdrop-filter:blur(8px);
      border:1px solid rgba(255,255,255,.20);
      border-radius:100px;
      padding:var(--sp1) var(--sp3);
      font-size:.75rem;
      font-weight:600;
      letter-spacing:.04em;
      text-transform:uppercase;
      color:rgba(255,255,255,.9);
      margin-bottom:var(--sp6);
    }
    .hero-eyebrow-dot{
      width:6px;height:6px;
      border-radius:50%;
      background:var(--accent);
      box-shadow:0 0 6px var(--accent);
      animation:blink 2s ease-in-out infinite;
    }
    @keyframes blink{0%,100%{opacity:1}50%{opacity:.4}}

    .hero-headline{
      font-size:clamp(2rem,3.5vw,3rem);
      font-weight:900;
      line-height:1.1;
      letter-spacing:-.03em;
      color:#fff;
      margin-bottom:var(--sp5);
    }
    .hero-headline span{
      color:var(--accent);
    }
    .hero-sub{
      font-size:1rem;
      line-height:1.7;
      color:rgba(255,255,255,.72);
      max-width:44ch;
      margin-bottom:var(--sp10);
    }

    /* feature pills */
    .hero-features{
      display:flex;
      flex-direction:column;
      gap:var(--sp3);
    }
    .hero-feat{
      display:flex;
      align-items:center;
      gap:var(--sp3);
      font-size:.875rem;
      color:rgba(255,255,255,.85);
    }
    .hero-feat__icon{
      width:32px;height:32px;
      border-radius:8px;
      background:rgba(255,255,255,.14);
      display:flex;align-items:center;justify-content:center;
      flex-shrink:0;
    }

    /* floating stats cards */
    .hero-stats{
      display:flex;
      gap:var(--sp4);
      position:relative;
      z-index:1;
      flex-wrap:wrap;
    }
    .stat-card{
      background:rgba(255,255,255,.13);
      backdrop-filter:blur(12px);
      border:1px solid rgba(255,255,255,.20);
      border-radius:12px;
      padding:var(--sp4) var(--sp5);
      flex:1 1 120px;
      min-width:110px;
    }
    .stat-card__num{
      font-size:1.6rem;
      font-weight:800;
      letter-spacing:-.03em;
      color:#fff;
      line-height:1;
    }
    .stat-card__label{
      font-size:.72rem;
      color:rgba(255,255,255,.60);
      margin-top:var(--sp1);
      font-weight:500;
      letter-spacing:.03em;
      text-transform:uppercase;
    }

    /* animated waveform */
    .hero-wave{
      position:absolute;
      bottom:0;left:0;right:0;
      height:80px;
      pointer-events:none;
      z-index:0;
    }
    .hero-wave path{fill:rgba(255,255,255,.05)}

    /* ═══════════════════════════════════════════════
       RIGHT PANEL — form
    ═══════════════════════════════════════════════ */
    .form-panel{
      display:flex;
      align-items:center;
      justify-content:center;
      padding:var(--sp8) var(--sp6);
      background:var(--bg);
      position:relative;
    }

    /* theme toggle */
    .theme-btn{
      position:absolute;
      top:var(--sp6);
      right:var(--sp6);
      width:40px;height:40px;
      border-radius:100px;
      background:var(--surface);
      border:1px solid var(--border);
      display:flex;align-items:center;justify-content:center;
      color:var(--muted);
      box-shadow:var(--shadow-sm);
      transition:color var(--transition),background var(--transition),box-shadow var(--transition);
    }
    .theme-btn:hover{color:var(--text);box-shadow:var(--shadow-md)}

    .form-wrap{
      width:100%;
      max-width:400px;
    }

    /* mobile brand shown only when hero panel hidden */
    .mobile-brand{
      display:none;
      align-items:center;
      gap:var(--sp2);
      margin-bottom:var(--sp8);
      text-decoration:none;
    }
    .mobile-brand__logo{
      width:36px;height:36px;
      border-radius:10px;
      background:var(--primary);
      display:flex;align-items:center;justify-content:center;
      flex-shrink:0;
    }
    .mobile-brand__name{
      font-size:1.2rem;
      font-weight:800;
      color:var(--text);
    }
    .mobile-brand__name em{color:var(--primary);font-style:normal}

    .form-heading{
      font-size:1.75rem;
      font-weight:800;
      letter-spacing:-.03em;
      color:var(--text);
      line-height:1.15;
      margin-bottom:var(--sp2);
    }
    .form-sub{
      font-size:.9rem;
      color:var(--muted);
      margin-bottom:var(--sp8);
      line-height:1.6;
    }

    /* social proof strip */
    .social-proof{
      display:flex;
      align-items:center;
      gap:var(--sp3);
      margin-bottom:var(--sp8);
      padding:var(--sp3) var(--sp4);
      background:var(--surface);
      border:1px solid var(--border);
      border-radius:10px;
    }
    .sp-avatars{
      display:flex;
    }
    .sp-avatar{
      width:28px;height:28px;
      border-radius:50%;
      border:2px solid var(--bg);
      background:var(--primary-lo);
      display:flex;align-items:center;justify-content:center;
      font-size:.65rem;
      font-weight:700;
      color:var(--primary);
      margin-left:-8px;
    }
    .sp-avatar:first-child{margin-left:0}
    .sp-stars{color:var(--accent);font-size:.75rem;letter-spacing:1px}
    .sp-text{font-size:.75rem;color:var(--muted)}
    .sp-text strong{color:var(--text)}

    /* alert */
    .alert{
      display:flex;
      align-items:flex-start;
      gap:var(--sp3);
      padding:var(--sp3) var(--sp4);
      border-radius:10px;
      font-size:.875rem;
      margin-bottom:var(--sp5);
      animation:slide-in .3s ease;
    }
    .alert--error{
      background:var(--danger-lo);
      border:1px solid rgba(192,57,43,.2);
      color:var(--danger);
    }
    @keyframes slide-in{from{opacity:0;transform:translateY(-6px)}to{opacity:1;transform:none}}

    /* fields */
    .fields{display:flex;flex-direction:column;gap:var(--sp5)}
    .field{display:flex;flex-direction:column;gap:var(--sp2)}
    .field label{
      font-size:.8125rem;
      font-weight:600;
      color:var(--muted);
      letter-spacing:.02em;
      text-transform:uppercase;
    }
    .field-input{
      position:relative;
    }
    .field-input-icon{
      position:absolute;
      left:var(--sp4);
      top:50%;
      transform:translateY(-50%);
      color:var(--faint);
      pointer-events:none;
      transition:color var(--transition);
    }
    .control{
      width:100%;
      padding:var(--sp4) var(--sp4) var(--sp4) calc(var(--sp4)*2 + 18px);
      background:var(--surface);
      border:1.5px solid var(--border);
      border-radius:10px;
      font-family:var(--font);
      font-size:.9375rem;
      color:var(--text);
      transition:border-color var(--transition),box-shadow var(--transition);
      -webkit-appearance:none;
    }
    .control::placeholder{color:var(--faint)}
    .control:focus{
      outline:none;
      border-color:var(--primary);
      box-shadow:0 0 0 3px var(--primary-lo);
    }
    .control:focus+.field-focus-bar{width:100%}
    .control:focus~.field-input-icon{color:var(--primary)}
    .pwd-toggle{
      position:absolute;
      right:var(--sp4);
      top:50%;
      transform:translateY(-50%);
      display:flex;
      color:var(--faint);
      padding:var(--sp1);
      border-radius:6px;
      transition:color var(--transition);
    }
    .pwd-toggle:hover{color:var(--text)}

    /* remember + forgot row */
    .row-check{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:var(--sp3);
    }
    .check-label{
      display:flex;
      align-items:center;
      gap:var(--sp2);
      font-size:.8125rem;
      color:var(--muted);
      cursor:pointer;
    }
    .check-label input{accent-color:var(--primary);width:15px;height:15px}
    .forgot{
      font-size:.8125rem;
      color:var(--primary);
      font-weight:500;
    }

    /* CTA */
    .btn-primary{
      width:100%;
      padding:var(--sp4);
      background:var(--primary);
      color:#fff;
      border-radius:10px;
      font-size:1rem;
      font-weight:700;
      letter-spacing:-.01em;
      text-align:center;
      border:none;
      cursor:pointer;
      transition:background var(--transition),transform var(--transition),box-shadow var(--transition);
      box-shadow:0 4px 14px rgba(1,106,112,.35);
      display:flex;
      align-items:center;
      justify-content:center;
      gap:var(--sp2);
    }
    .btn-primary:hover{
      background:var(--primary-h);
      transform:translateY(-1px);
      box-shadow:0 6px 20px rgba(1,106,112,.45);
    }
    .btn-primary:active{transform:translateY(0)}

    /* divider */
    .divider{
      display:flex;
      align-items:center;
      gap:var(--sp3);
      margin:var(--sp6) 0;
      color:var(--faint);
      font-size:.75rem;
    }
    .divider::before,.divider::after{
      content:'';
      flex:1;
      height:1px;
      background:var(--border);
    }

    /* register link */
    .register-link{
      text-align:center;
      font-size:.875rem;
      color:var(--muted);
    }
    .register-link a{
      color:var(--primary);
      font-weight:600;
    }

    /* trust badges */
    .trust-row{
      display:flex;
      align-items:center;
      justify-content:center;
      gap:var(--sp5);
      margin-top:var(--sp8);
      flex-wrap:wrap;
    }
    .trust-item{
      display:flex;
      align-items:center;
      gap:var(--sp1);
      font-size:.72rem;
      color:var(--faint);
      font-weight:500;
    }

    /* ═══════════════════════════════════════════════
       RESPONSIVE
    ═══════════════════════════════════════════════ */
    @media(max-width:900px){
      .auth-shell{grid-template-columns:1fr}
      .hero-panel{display:none}
      .form-panel{padding:var(--sp8) var(--sp5)}
      .mobile-brand{display:flex}
    }
    @media(max-width:480px){
      .form-panel{padding:var(--sp6) var(--sp4)}
      .form-heading{font-size:1.5rem}
    }
  </style>
</head>
<body>

<div class="auth-shell">

  {# ══════ LEFT — HERO PANEL ══════ #}
  <div class="hero-panel" aria-hidden="true">

    <div class="hero-brand">
      <div class="hero-brand__logo">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
        </svg>
      </div>
      <span class="hero-brand__name"><em>Pulse</em>SMM</span>
    </div>

    <div class="hero-body">
      <div class="hero-eyebrow">
        <span class="hero-eyebrow-dot"></span>
        Plataforma de social media marketing
      </div>

      <h1 class="hero-headline">
        Impulsione seu<br>
        crescimento nas<br>
        <span>redes sociais</span>
      </h1>

      <p class="hero-sub">
        Seguidores, curtidas, visualizações e muito mais.
        Entrega rápida, painel simples e suporte 24/7.
      </p>

      <div class="hero-features">
        <div class="hero-feat">
          <div class="hero-feat__icon">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="13 17 18 12 13 7"/>
              <polyline points="6 17 11 12 6 7"/>
            </svg>
          </div>
          Entrega automática em minutos
        </div>
        <div class="hero-feat">
          <div class="hero-feat__icon">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            </svg>
          </div>
          Pagamentos 100% seguros
        </div>
        <div class="hero-feat">
          <div class="hero-feat__icon">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/>
              <polyline points="12 6 12 12 16 14"/>
            </svg>
          </div>
          Suporte ativo 24 horas por dia
        </div>
      </div>
    </div>

    <div class="hero-stats">
      <div class="stat-card">
        <div class="stat-card__num" id="statOrders">0</div>
        <div class="stat-card__label">Pedidos hoje</div>
      </div>
      <div class="stat-card">
        <div class="stat-card__num" id="statUsers">0</div>
        <div class="stat-card__label">Clientes ativos</div>
      </div>
      <div class="stat-card">
        <div class="stat-card__num">99.9%</div>
        <div class="stat-card__label">Uptime</div>
      </div>
    </div>

    <svg class="hero-wave" viewBox="0 0 1440 80" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M0,40 C360,80 1080,0 1440,40 L1440,80 L0,80 Z"/>
    </svg>

  </div>

  {# ══════ RIGHT — FORM PANEL ══════ #}
  <div class="form-panel">

    <button class="theme-btn" id="themeToggle" aria-label="Alternar tema claro/escuro" data-theme-toggle>
      <svg id="themeIcon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="5"/>
        <line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/>
        <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
        <line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/>
        <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
      </svg>
    </button>

    <div class="form-wrap">

      {# Mobile brand #}
      <a href="/" class="mobile-brand">
        <div class="mobile-brand__logo">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
          </svg>
        </div>
        <span class="mobile-brand__name"><em>Pulse</em>SMM</span>
      </a>

      <h1 class="form-heading">Bem-vindo de volta 👋</h1>
      <p class="form-sub">Entre na sua conta para continuar gerenciando seus serviços.</p>

      {# Social proof #}
      <div class="social-proof">
        <div class="sp-avatars">
          <div class="sp-avatar">AN</div>
          <div class="sp-avatar">MR</div>
          <div class="sp-avatar">LK</div>
        </div>
        <div>
          <div class="sp-stars">★★★★★</div>
          <div class="sp-text"><strong>+4.800 clientes</strong> confiam no PulseSMM</div>
        </div>
      </div>

      {# Error #}
      {% if error %}
      <div class="alert alert--error" role="alert">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" flex-shrink="0" style="flex-shrink:0;margin-top:1px">
          <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
        </svg>
        <span>{{ error.messageKey|trans(error.messageData, 'security') }}</span>
      </div>
      {% endif %}

      {# Form #}
      <form method="post" action="{{ path('app_login') }}" novalidate>
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

        <div class="fields">

          <div class="field">
            <label for="inputEmail">E-mail</label>
            <div class="field-input">
              <svg class="field-input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                <polyline points="22,6 12,13 2,6"/>
              </svg>
              <input
                type="email"
                id="inputEmail"
                name="_username"
                value="{{ last_username }}"
                required autofocus
                autocomplete="email"
                class="control"
                placeholder="seu@email.com.br"
              >
            </div>
          </div>

          <div class="field">
            <label for="inputPassword">Senha</label>
            <div class="field-input">
              <svg class="field-input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
              </svg>
              <input
                type="password"
                id="inputPassword"
                name="_password"
                required
                autocomplete="current-password"
                class="control"
                placeholder="••••••••"
                style="padding-right:3rem"
              >
              <button type="button" class="pwd-toggle" id="togglePwd" aria-label="Mostrar senha">
                <svg id="eyeIcon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                  <circle cx="12" cy="12" r="3"/>
                </svg>
              </button>
            </div>
          </div>

          <div class="row-check">
            <label class="check-label">
              <input type="checkbox" name="_remember_me"> Lembrar-me
            </label>
            <a href="#" class="forgot">Esqueceu a senha?</a>
          </div>

        </div>

        <button type="submit" class="btn-primary" style="margin-top:var(--sp6)">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/>
            <polyline points="10 17 15 12 10 7"/>
            <line x1="15" y1="12" x2="3" y2="12"/>
          </svg>
          Entrar na conta
        </button>

      </form>

      <div class="divider">ou</div>

      <div class="register-link">
        Ainda não tem conta?
        <a href="{{ path('app_register') }}">Criar conta grátis →</a>
      </div>

      <div class="trust-row">
        <div class="trust-item">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          SSL seguro
        </div>
        <div class="trust-item">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          Entrega rápida
        </div>
        <div class="trust-item">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
          Garantia 30 dias
        </div>
      </div>

    </div>
  </div>

</div>

<script>
(function(){
  // ── theme ──
  var html = document.documentElement;
  var stored = sessionStorage.getItem('pulse-theme');
  var sys = matchMedia('(prefers-color-scheme:dark)').matches?'dark':'light';
  html.setAttribute('data-theme', stored||sys);

  var moonPath = '<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>';
  var sunPaths = '<circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>';

  function updateThemeIcon(t){
    var icon = document.getElementById('themeIcon');
    if(icon) icon.innerHTML = t==='dark'?moonPath:sunPaths;
  }
  updateThemeIcon(html.getAttribute('data-theme'));

  var btn = document.getElementById('themeToggle');
  if(btn) btn.addEventListener('click',function(){
    var cur = html.getAttribute('data-theme');
    var next = cur==='dark'?'light':'dark';
    html.setAttribute('data-theme',next);
    sessionStorage.setItem('pulse-theme',next);
    updateThemeIcon(next);
  });

  // ── password toggle ──
  var pwdBtn = document.getElementById('togglePwd');
  var pwdInput = document.getElementById('inputPassword');
  var eyeIcon = document.getElementById('eyeIcon');
  var eyeOpenPaths = '<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>';
  var eyeOffPaths = '<path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/>';
  if(pwdBtn){
    pwdBtn.addEventListener('click',function(){
      var show = pwdInput.type==='password';
      pwdInput.type = show?'text':'password';
      eyeIcon.innerHTML = show?eyeOffPaths:eyeOpenPaths;
      pwdBtn.setAttribute('aria-label', show?'Ocultar senha':'Mostrar senha');
    });
  }

  // ── animated counters ──
  function counter(el, target, suffix){
    if(!el) return;
    var start=0, duration=2000, startTime=null;
    function step(ts){
      if(!startTime) startTime=ts;
      var prog = Math.min((ts-startTime)/duration,1);
      var eased = 1-Math.pow(1-prog,3);
      el.textContent = Math.floor(eased*target)+(suffix||'');
      if(prog<1) requestAnimationFrame(step);
    }
    requestAnimationFrame(step);
  }
  window.addEventListener('DOMContentLoaded',function(){
    counter(document.getElementById('statOrders'), 1247, '+');
    counter(document.getElementById('statUsers'),  4832, '+');
  });
})();
</script>

</body>
</html>
{% endblock %}
