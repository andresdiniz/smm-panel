{% extends 'base.html.twig' %}

{% block title %}Novo pedido — PulseSMM{% endblock %}
{% block page_title %}Novo pedido{% endblock %}

{% block content %}
<div class="order-new-layout">

  {# ── INFO LATERAL ── #}
  <div class="order-info" data-reveal>
    <div class="order-info__badge">
      <i data-lucide="shopping-cart" width="16" height="16"></i>
      Pedido
    </div>
    <h1 class="order-info__title">Crie um novo pedido</h1>
    <p class="order-info__desc">Selecione o serviço, informe a URL e a quantidade. O valor é descontado do seu saldo.</p>

    <div class="order-info__tips">
      <div class="order-tip">
        <i data-lucide="zap" width="14" height="14"></i>
        <span>Processamento automático</span>
      </div>
      <div class="order-tip">
        <i data-lucide="shield-check" width="14" height="14"></i>
        <span>Saldo só é debitado após confirmação</span>
      </div>
      <div class="order-tip">
        <i data-lucide="refresh-cw" width="14" height="14"></i>
        <span>Acompanhe em tempo real no painel</span>
      </div>
    </div>
  </div>

  {# ── FORMULÁRIO ── #}
  <div class="card card--padded" data-reveal>
    <form method="post" action="{{ path('app_order_create') }}" class="form-grid" id="orderForm">
      <input type="hidden" name="_token" value="{{ csrf_token('order_create') }}">

      <div class="field">
        <label for="serviceSelect">Serviço <span class="required">*</span></label>
        <select name="service_id" id="serviceSelect" class="control" required>
          <option value="">Selecione um serviço...</option>
          {% for category, services in servicesGrouped %}
            <optgroup label="{{ category }}">
              {% for service in services %}
                <option
                  value="{{ service.id }}"
                  data-min="{{ service.minQty }}"
                  data-max="{{ service.maxQty }}"
                  data-price="{{ service.pricePerThousandCents }}"
                >{{ service.name }}</option>
              {% endfor %}
            </optgroup>
          {% endfor %}
        </select>
      </div>

      {# Detalhes do serviço selecionado #}
      <div class="service-detail-card" id="serviceDetail" style="display:none">
        <div class="service-detail-card__row">
          <span>Mínimo</span><strong id="sdMin">—</strong>
        </div>
        <div class="service-detail-card__row">
          <span>Máximo</span><strong id="sdMax">—</strong>
        </div>
        <div class="service-detail-card__row">
          <span>Preço / 1k</span><strong id="sdPrice">—</strong>
        </div>
      </div>

      <div class="field">
        <label for="targetUrl">URL alvo <span class="required">*</span></label>
        <input type="url" name="target_url" id="targetUrl" class="control"
               placeholder="https://instagram.com/seuperfil" required>
      </div>

      <div class="field">
        <label for="qtyInput">Quantidade <span class="required">*</span></label>
        <input type="number" name="quantity" id="qtyInput" class="control" min="1" required>
        <span class="field-hint" id="qtyHint">Selecione um serviço para ver o intervalo permitido.</span>
      </div>

      {# Preview de preço #}
      <div class="price-preview" id="pricePreview" style="display:none">
        <div class="price-preview__label">Valor estimado</div>
        <div class="price-preview__value" id="priceValue">R$ 0,00</div>
      </div>

      <button type="submit" class="btn btn--primary btn--lg btn--block">
        <i data-lucide="check" width="18" height="18"></i>
        Criar pedido
      </button>
    </form>
  </div>

</div>

<style>
.order-new-layout {
  display: grid;
  grid-template-columns: 1fr 1.4fr;
  gap: var(--sp10);
  max-width: 900px;
  margin: 0 auto;
  align-items: start;
}
.order-info__badge {
  display: inline-flex;
  align-items: center;
  gap: var(--sp2);
  background: var(--primary-hi);
  color: var(--primary-h);
  padding: 5px var(--sp3);
  border-radius: var(--r-full);
  font-size: var(--text-xs);
  font-weight: 700;
  margin-bottom: var(--sp4);
}
.order-info__title {
  font-size: var(--text-xl);
  font-weight: 900;
  letter-spacing: -0.03em;
  line-height: 1.15;
  margin-bottom: var(--sp3);
}
.order-info__desc {
  font-size: var(--text-sm);
  color: var(--muted);
  line-height: 1.6;
  max-width: 30ch;
  margin-bottom: var(--sp6);
}
.order-info__tips { display: flex; flex-direction: column; gap: var(--sp3); }
.order-tip { display: flex; align-items: center; gap: var(--sp3); font-size: var(--text-xs); font-weight: 600; color: var(--muted); }
.order-tip i { color: var(--primary); flex-shrink: 0; }
.service-detail-card {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--sp2);
  background: var(--surface-off);
  border: 1px solid var(--border);
  border-radius: var(--r-lg);
  padding: var(--sp3) var(--sp4);
}
.service-detail-card__row { display: flex; flex-direction: column; gap: 3px; }
.service-detail-card__row span {
  font-size: 0.65rem;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--faint);
  font-weight: 700;
}
.service-detail-card__row strong {
  font-size: var(--text-sm);
  font-weight: 800;
  font-variant-numeric: tabular-nums;
}
.price-preview {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--primary-hi);
  border: 1px solid color-mix(in oklab, var(--primary) 20%, transparent);
  border-radius: var(--r-lg);
  padding: var(--sp4) var(--sp5);
}
.price-preview__label { font-size: var(--text-xs); font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--primary-h); }
.price-preview__value { font-size: var(--text-lg); font-weight: 900; color: var(--primary-h); font-variant-numeric: tabular-nums; }
@media (max-width: 700px) {
  .order-new-layout { grid-template-columns: 1fr; gap: var(--sp6); }
}
</style>

{% block javascripts %}{{ parent() }}
<script>
(function(){
  const sel    = document.getElementById('serviceSelect');
  const qty    = document.getElementById('qtyInput');
  const hint   = document.getElementById('qtyHint');
  const box    = document.getElementById('pricePreview');
  const price  = document.getElementById('priceValue');
  const detail = document.getElementById('serviceDetail');
  const sdMin  = document.getElementById('sdMin');
  const sdMax  = document.getElementById('sdMax');
  const sdPrice= document.getElementById('sdPrice');

  function fmt(n) { return n.toLocaleString('pt-BR'); }

  function update() {
    const opt = sel.options[sel.selectedIndex];
    const min = parseInt(opt.dataset.min || 0);
    const max = parseInt(opt.dataset.max || 0);
    const ppt = parseInt(opt.dataset.price || 0);
    const q   = parseInt(qty.value || 0);

    if (!min) { box.style.display = 'none'; detail.style.display = 'none'; return; }

    qty.min = min; qty.max = max;
    if (!qty.value || parseInt(qty.value) < min) qty.value = min;
    hint.textContent = 'Mín: ' + fmt(min) + ' | Máx: ' + fmt(max);

    sdMin.textContent   = fmt(min);
    sdMax.textContent   = fmt(max);
    sdPrice.textContent = 'R$ ' + (ppt / 100).toLocaleString('pt-BR', {minimumFractionDigits: 2});
    detail.style.display = 'grid';

    const cents = Math.ceil(ppt * q / 1000);
    price.textContent = 'R$ ' + (cents / 100).toLocaleString('pt-BR', {minimumFractionDigits: 2});
    box.style.display = 'flex';
  }

  sel.addEventListener('change', update);
  qty.addEventListener('input', update);
})();
</script>
{% endblock %}
{% endblock %}
