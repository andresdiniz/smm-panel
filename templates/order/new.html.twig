{% extends 'base.html.twig' %}

{% block title %}Novo pedido — PulseSMM{% endblock %}
{% block page_title %}Novo pedido{% endblock %}

{% block content %}
<div class="on-wrap">

  {# ── PAINEL ESQUERDO ── #}
  <aside class="on-aside">
    <div class="on-aside__inner">
      <span class="on-badge">
        <i data-lucide="shopping-cart" width="13" height="13"></i>
        Pedido
      </span>

      <h1 class="on-title">Crie um<br>novo pedido</h1>
      <p class="on-desc">Selecione o serviço, informe a URL e a quantidade. O valor é descontado do seu saldo instantaneamente após a confirmação.</p>

      <ul class="on-tips">
        <li class="on-tip">
          <span class="on-tip__icon"><i data-lucide="zap" width="14" height="14"></i></span>
          <span>Processamento automático</span>
        </li>
        <li class="on-tip">
          <span class="on-tip__icon"><i data-lucide="shield-check" width="14" height="14"></i></span>
          <span>Saldo debitado só após confirmação</span>
        </li>
        <li class="on-tip">
          <span class="on-tip__icon"><i data-lucide="refresh-cw" width="14" height="14"></i></span>
          <span>Acompanhe em tempo real no painel</span>
        </li>
        <li class="on-tip">
          <span class="on-tip__icon"><i data-lucide="lock" width="14" height="14"></i></span>
          <span>Transação protegida com CSRF</span>
        </li>
      </ul>

      <div class="on-balance-chip">
        <i data-lucide="wallet" width="14" height="14"></i>
        <span>Saldo disponível</span>
        <strong id="asideBalance">…</strong>
      </div>
    </div>
  </aside>

  {# ── FORMULÁRIO ── #}
  <div class="on-form-wrap">
    <form method="post" action="{{ path('app_order_create') }}" class="on-form" id="orderForm">
      <input type="hidden" name="_token" value="{{ csrf_token('order_create') }}">

      {# Serviço #}
      <div class="on-field">
        <label class="on-label" for="serviceSelect">
          Serviço
          <span class="on-required">*</span>
        </label>
        <div class="on-select-wrap">
          <select name="service_id" id="serviceSelect" class="on-control on-select" required>
            <option value="">Selecione um serviço...</option>
            {% for category, services in servicesGrouped %}
              <optgroup label="{{ category }}">
                {% for service in services %}
                  <option
                    value="{{ service.id }}"
                    data-min="{{ service.minQty }}"
                    data-max="{{ service.maxQty }}"
                    data-price="{{ service.pricePerThousandCents }}"
                  >{{ service.name }}</option>
                {% endfor %}
              </optgroup>
            {% endfor %}
          </select>
          <i class="on-select-chevron" data-lucide="chevron-down" width="15" height="15"></i>
        </div>
      </div>

      {# Detalhes do serviço #}
      <div class="on-svc-detail" id="serviceDetail">
        <div class="on-svc-detail__row">
          <span>Mínimo</span>
          <strong id="sdMin">—</strong>
        </div>
        <div class="on-svc-detail__divider"></div>
        <div class="on-svc-detail__row">
          <span>Máximo</span>
          <strong id="sdMax">—</strong>
        </div>
        <div class="on-svc-detail__divider"></div>
        <div class="on-svc-detail__row">
          <span>Preço / 1k</span>
          <strong id="sdPrice">—</strong>
        </div>
      </div>

      {# URL #}
      <div class="on-field">
        <label class="on-label" for="targetUrl">
          URL alvo
          <span class="on-required">*</span>
        </label>
        <div class="on-input-wrap">
          <i class="on-input-icon" data-lucide="link" width="15" height="15"></i>
          <input type="url" name="target_url" id="targetUrl" class="on-control on-control--icon"
                 placeholder="https://instagram.com/seuperfil" required>
        </div>
      </div>

      {# Quantidade #}
      <div class="on-field">
        <label class="on-label" for="qtyInput">
          Quantidade
          <span class="on-required">*</span>
        </label>
        <div class="on-input-wrap">
          <i class="on-input-icon" data-lucide="hash" width="15" height="15"></i>
          <input type="number" name="quantity" id="qtyInput" class="on-control on-control--icon" min="1" required>
        </div>
        <span class="on-hint" id="qtyHint">Selecione um serviço para ver o intervalo permitido.</span>
      </div>

      {# Preview de preço #}
      <div class="on-price" id="pricePreview">
        <div class="on-price__left">
          <i data-lucide="tag" width="14" height="14"></i>
          <span>Valor estimado</span>
        </div>
        <strong class="on-price__value" id="priceValue">R$ 0,00</strong>
      </div>

      <button type="submit" class="on-submit">
        <i data-lucide="check-circle" width="18" height="18"></i>
        Criar pedido
      </button>
    </form>
  </div>

</div>

<style>
/* ════════════════════════════════════════
   ORDER / NEW  —  layout & componentes
   ════════════════════════════════════════ */

.on-wrap {
  display: grid;
  grid-template-columns: 300px 1fr;
  gap: 28px;
  max-width: 860px;
  margin: 0 auto;
  align-items: start;
}

/* ── Aside ── */
.on-aside {
  position: sticky;
  top: 80px;
}
.on-aside__inner {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--r-xl);
  padding: 28px 24px;
  display: flex;
  flex-direction: column;
  gap: 0;
}

.on-badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: var(--primary-hi);
  color: var(--primary-h);
  padding: 4px 10px;
  border-radius: var(--r-full);
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  margin-bottom: 16px;
  width: fit-content;
}

.on-title {
  font-size: var(--text-xl);
  font-weight: 900;
  letter-spacing: -0.03em;
  line-height: 1.15;
  margin-bottom: 10px;
  color: var(--text);
}

.on-desc {
  font-size: 0.8rem;
  color: var(--muted);
  line-height: 1.65;
  margin-bottom: 20px;
}

.on-tips {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 10px;
  margin-bottom: 24px;
  padding: 0;
}
.on-tip {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 0.78rem;
  font-weight: 500;
  color: var(--muted);
}
.on-tip__icon {
  width: 26px;
  height: 26px;
  border-radius: var(--r-md);
  background: var(--surface-off);
  border: 1px solid var(--border);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  color: var(--primary-h);
}

.on-balance-chip {
  display: flex;
  align-items: center;
  gap: 8px;
  background: color-mix(in oklab, var(--primary) 8%, var(--surface-off));
  border: 1px solid color-mix(in oklab, var(--primary) 20%, var(--border));
  border-radius: var(--r-lg);
  padding: 10px 14px;
  font-size: 0.78rem;
  font-weight: 600;
  color: var(--primary-h);
}
.on-balance-chip strong {
  margin-left: auto;
  font-size: 0.9rem;
  font-variant-numeric: tabular-nums;
  font-weight: 800;
}

/* ── Form wrap ── */
.on-form-wrap {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--r-xl);
  padding: 28px 24px;
}

.on-form {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

/* ── Field ── */
.on-field { display: flex; flex-direction: column; gap: 6px; }

.on-label {
  font-size: 0.78rem;
  font-weight: 700;
  color: var(--text);
  letter-spacing: 0.01em;
}
.on-required { color: var(--danger, #e05a5a); margin-left: 2px; }

/* Select customizado */
.on-select-wrap {
  position: relative;
}
.on-select-chevron {
  position: absolute;
  right: 12px;
  top: 50%;
  transform: translateY(-50%);
  pointer-events: none;
  color: var(--muted);
}
.on-select {
  appearance: none;
  -webkit-appearance: none;
  padding-right: 36px !important;
}

/* Input com ícone */
.on-input-wrap { position: relative; }
.on-input-icon {
  position: absolute;
  left: 12px;
  top: 50%;
  transform: translateY(-50%);
  color: var(--muted);
  pointer-events: none;
}
.on-control--icon { padding-left: 36px !important; }

/* Control base */
.on-control {
  width: 100%;
  height: 42px;
  padding: 0 13px;
  background: var(--surface-off);
  border: 1px solid var(--border);
  border-radius: var(--r-md);
  font-size: var(--text-sm);
  color: var(--text);
  transition: border-color 160ms ease, box-shadow 160ms ease;
  outline: none;
}
.on-control:focus {
  border-color: var(--primary-h);
  box-shadow: 0 0 0 3px color-mix(in oklab, var(--primary) 18%, transparent);
}
.on-control::placeholder { color: var(--faint); }

.on-hint {
  font-size: 0.72rem;
  color: var(--muted);
  line-height: 1.4;
}

/* ── Service detail card ── */
.on-svc-detail {
  display: none;
  align-items: center;
  gap: 0;
  background: var(--surface-off);
  border: 1px solid var(--border);
  border-radius: var(--r-lg);
  overflow: hidden;
  animation: fadeSlide 180ms ease;
}
.on-svc-detail.is-visible {
  display: flex;
}
.on-svc-detail__row {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 3px;
  padding: 10px 14px;
}
.on-svc-detail__row span {
  font-size: 0.62rem;
  text-transform: uppercase;
  letter-spacing: 0.07em;
  color: var(--faint);
  font-weight: 700;
}
.on-svc-detail__row strong {
  font-size: var(--text-sm);
  font-weight: 800;
  font-variant-numeric: tabular-nums;
  color: var(--text);
}
.on-svc-detail__divider {
  width: 1px;
  height: 36px;
  background: var(--border);
  flex-shrink: 0;
}

/* ── Price preview ── */
.on-price {
  display: none;
  align-items: center;
  justify-content: space-between;
  background: color-mix(in oklab, var(--primary) 8%, var(--surface-off));
  border: 1px solid color-mix(in oklab, var(--primary) 22%, var(--border));
  border-radius: var(--r-lg);
  padding: 12px 16px;
  animation: fadeSlide 180ms ease;
}
.on-price.is-visible { display: flex; }
.on-price__left {
  display: flex;
  align-items: center;
  gap: 7px;
  font-size: 0.75rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--primary-h);
}
.on-price__value {
  font-size: var(--text-lg);
  font-weight: 900;
  font-variant-numeric: tabular-nums;
  color: var(--primary-h);
}

/* ── Submit ── */
.on-submit {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  width: 100%;
  height: 46px;
  background: var(--primary-h);
  color: #fff;
  border: none;
  border-radius: var(--r-lg);
  font-size: var(--text-sm);
  font-weight: 700;
  cursor: pointer;
  transition: background 160ms ease, transform 100ms ease, box-shadow 160ms ease;
  letter-spacing: 0.01em;
}
.on-submit:hover {
  background: var(--primary-darker, color-mix(in oklab, var(--primary-h) 85%, #000));
  box-shadow: 0 4px 14px color-mix(in oklab, var(--primary) 35%, transparent);
}
.on-submit:active { transform: scale(0.98); }

/* ── Animation ── */
@keyframes fadeSlide {
  from { opacity: 0; transform: translateY(-6px); }
  to   { opacity: 1; transform: translateY(0);    }
}

/* ── Responsive ── */
@media (max-width: 768px) {
  .on-wrap {
    grid-template-columns: 1fr;
    gap: 16px;
  }
  .on-aside {
    position: static;
  }
  .on-aside__inner {
    padding: 20px 18px;
  }
  .on-title { font-size: var(--text-lg); }
  .on-tips { display: none; }
}
</style>

{% block javascripts %}{{ parent() }}
<script>
(function(){
  const sel    = document.getElementById('serviceSelect');
  const qty    = document.getElementById('qtyInput');
  const hint   = document.getElementById('qtyHint');
  const box    = document.getElementById('pricePreview');
  const price  = document.getElementById('priceValue');
  const detail = document.getElementById('serviceDetail');
  const sdMin  = document.getElementById('sdMin');
  const sdMax  = document.getElementById('sdMax');
  const sdPrice= document.getElementById('sdPrice');
  const bal    = document.getElementById('asideBalance');

  /* pega saldo do chip do header se existir */
  const headerBal = document.querySelector('.balance-amount, .header-balance, [data-balance]');
  if (bal && headerBal) bal.textContent = headerBal.textContent.trim();

  function fmt(n){ return parseInt(n).toLocaleString('pt-BR'); }

  function update(){
    const opt   = sel.options[sel.selectedIndex];
    const min   = parseInt(opt.dataset.min  || 0);
    const max   = parseInt(opt.dataset.max  || 0);
    const ppt   = parseInt(opt.dataset.price|| 0);
    const q     = parseInt(qty.value        || 0);

    if (!min) {
      detail.classList.remove('is-visible');
      box.classList.remove('is-visible');
      return;
    }

    qty.min = min; qty.max = max;
    if (!qty.value || parseInt(qty.value) < min) qty.value = min;
    hint.textContent = 'Mín: ' + fmt(min) + '  ·  Máx: ' + fmt(max);

    sdMin.textContent   = fmt(min);
    sdMax.textContent   = fmt(max);
    sdPrice.textContent = 'R$ ' + (ppt/100).toLocaleString('pt-BR',{minimumFractionDigits:2});
    detail.classList.add('is-visible');

    const cents = Math.ceil(ppt * (q||min) / 1000);
    price.textContent = 'R$ ' + (cents/100).toLocaleString('pt-BR',{minimumFractionDigits:2});
    box.classList.add('is-visible');
  }

  sel.addEventListener('change', update);
  qty.addEventListener('input',  update);
})();
</script>
{% endblock %}
{% endblock %}
