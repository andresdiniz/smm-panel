{% extends 'base.html.twig' %}

{% block title %}New order{% endblock %}

{% block body %}
<div class="card">
    <h1>Create order</h1>
    <form id="order-form" method="post" action="{{ path('app_order_create') }}">
        <label>Service
            <select name="service_id" id="service_id" required>
                {% for service in services %}
                    <option value="{{ service.id }}"
                            data-price="{{ service.pricePer1000 }}"
                            data-min="{{ service.minQuantity }}"
                            data-max="{{ service.maxQuantity }}">
                        {{ service.category }} — {{ service.name }} (R$ {{ service.pricePer1000 }}/1k)
                    </option>
                {% endfor %}
            </select>
        </label>
        <label>Link<input type="url" name="link" required placeholder="https://instagram.com/username"></label>
        <label>Quantity<input type="number" name="quantity" id="quantity" min="1" required></label>
        <div class="total">Estimated charge: <strong id="charge">R$ 0.00</strong></div>
        <button class="btn" type="submit">Create order</button>
    </form>
</div>
{% endblock %}
