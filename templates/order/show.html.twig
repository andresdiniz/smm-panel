{% extends 'base.html.twig' %}

{% block title %}Pedido #{{ order.id }} — PulseSMM{% endblock %}
{% block page_title %}Pedido #{{ order.id }}{% endblock %}

{% block stylesheets %}{{ parent() }}
<style>
/* ══════════════════════════════════════════
   ORDER SHOW v2 — tokens locais scoped em .ord
   ══════════════════════════════════════════ */
.ord {
  --_bg:        var(--surface,     #181b26);
  --_bg2:       var(--surface-2,   #1f2333);
  --_bg3:       var(--surface-off, #161925);
  --_border:    var(--border,      rgba(255,255,255,.09));
  --_border2:   var(--border-2,    rgba(255,255,255,.05));
  --_text:      var(--text,        #e4e6f0);
  --_text2:     var(--text-2,      #7a7e99);
  --_text3:     var(--text-3,      #4a4e66);
  --_acc:       var(--acc,         #01696f);
  --_acc-soft:  var(--acc-soft,    rgba(1,105,111,.15));
  --_acc-brd:   var(--acc-border,  rgba(1,105,111,.35));
  --_acc-hov:   var(--acc-hover,   #0c4e54);

  max-width: 720px;
  display: flex;
  flex-direction: column;
  gap: 20px;
  padding-bottom: 48px;
}

/* ── Header do pedido ── */
.ord__head {
  background: var(--_bg2);
  border: 1px solid var(--_border);
  border-radius: 14px;
  padding: 22px 24px;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16px;
  flex-wrap: wrap;
  box-shadow: 0 4px 20px rgba(0,0,0,.15);
}
.ord__head-eyebrow {
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: .08em;
  color: var(--_text2);
  margin-bottom: 4px;
}
.ord__head-name {
  font-size: 17px;
  font-weight: 900;
  letter-spacing: -0.02em;
  line-height: 1.3;
  color: var(--_text);
  max-width: 50ch;
  word-break: break-word;
}

/* Badge status */
.ord__badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 5px 14px;
  border-radius: 999px;
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: .07em;
  white-space: nowrap;
  flex-shrink: 0;
}
.ord__badge--pending    { background: rgba(201,138,0,.15);  color: #c98a00; border: 1px solid rgba(201,138,0,.3); }
.ord__badge--processing { background: rgba(58,140,199,.15); color: #3a8cc7; border: 1px solid rgba(58,140,199,.3); }
.ord__badge--completed  { background: rgba(67,122,34,.15);  color: #5fa83a; border: 1px solid rgba(67,122,34,.3); }
.ord__badge--cancelled  { background: rgba(224,82,82,.12);  color: #e05252; border: 1px solid rgba(224,82,82,.25); }
.ord__badge--partial    { background: rgba(218,113,1,.12);  color: #da7101; border: 1px solid rgba(218,113,1,.25); }

/* ── Grid de detalhes ── */
.ord__grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(min(160px, 100%), 1fr));
  gap: 12px;
}
.ord__item {
  background: var(--_bg2);
  border: 1px solid var(--_border);
  border-radius: 10px;
  padding: 14px 16px;
  display: flex;
  flex-direction: column;
  gap: 5px;
  box-shadow: 0 2px 10px rgba(0,0,0,.1);
}
.ord__item--highlight {
  background: var(--_acc-soft);
  border-color: var(--_acc-brd);
}
.ord__item--full { grid-column: 1 / -1; }

.ord__item-label {
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: .08em;
  color: var(--_text2);
  font-weight: 700;
}
.ord__item--highlight .ord__item-label { color: var(--_acc); opacity: .85; }

.ord__item-value {
  font-size: 14px;
  font-weight: 800;
  color: var(--_text);
  font-variant-numeric: tabular-nums;
  word-break: break-word;
}
.ord__item--highlight .ord__item-value { color: var(--_acc); }

.ord__item-link {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 13px;
  font-weight: 600;
  color: var(--_acc);
  text-decoration: none;
  word-break: break-all;
  line-height: 1.4;
}
.ord__item-link:hover { text-decoration: underline; }

/* ── Ações ── */
.ord__actions { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 4px; }

.ord__btn {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  padding: 10px 18px;
  border-radius: 8px;
  font-size: 13px;
  font-weight: 700;
  cursor: pointer;
  text-decoration: none;
  transition: background .18s, border-color .18s, color .18s, box-shadow .18s;
  border: 1.5px solid transparent;
}
.ord__btn--ghost {
  background: var(--_bg2);
  border-color: var(--_border);
  color: var(--_text2);
}
.ord__btn--ghost:hover {
  background: var(--_bg3);
  border-color: rgba(255,255,255,.16);
  color: var(--_text);
}
.ord__btn--primary {
  background: var(--_acc);
  color: #fff;
  box-shadow: 0 3px 12px rgba(1,105,111,.3);
}
.ord__btn--primary:hover {
  background: var(--_acc-hov);
  box-shadow: 0 5px 16px rgba(1,105,111,.4);
}
</style>
{% endblock %}

{% block content %}
<div class="ord" data-reveal>

  {# ── HEADER ── #}
  <div class="ord__head">
    <div>
      <div class="ord__head-eyebrow">Pedido #{{ order.id }}</div>
      <div class="ord__head-name">{{ order.service.name }}</div>
    </div>
    {% set s = order.status %}
    <span class="ord__badge ord__badge--{{ s == 'completed' ? 'completed' : (s == 'cancelled' ? 'cancelled' : (s == 'partial' ? 'partial' : (s == 'processing' ? 'processing' : 'pending'))) }}">
      <span style="width:6px;height:6px;border-radius:50%;background:currentColor;display:inline-block;"></span>
      {{ s|replace({'_': ' '})|upper }}
    </span>
  </div>

  {# ── GRID DE DETALHES ── #}
  <div class="ord__grid">
    <div class="ord__item">
      <span class="ord__item-label">Serviço</span>
      <span class="ord__item-value">{{ order.service.name }}</span>
    </div>
    <div class="ord__item">
      <span class="ord__item-label">Categoria</span>
      <span class="ord__item-value">{{ order.service.category }}</span>
    </div>
    <div class="ord__item">
      <span class="ord__item-label">Quantidade</span>
      <span class="ord__item-value">{{ order.quantity|number_format(0, ',', '.') }}</span>
    </div>
    <div class="ord__item ord__item--highlight">
      <span class="ord__item-label">Valor cobrado</span>
      <span class="ord__item-value">R$ {{ (order.amountCents / 100)|number_format(2, ',', '.') }}</span>
    </div>
    {% if order.startCount is not null %}
    <div class="ord__item">
      <span class="ord__item-label">Início contagem</span>
      <span class="ord__item-value">{{ order.startCount|number_format(0, ',', '.') }}</span>
    </div>
    {% endif %}
    {% if order.remains is not null %}
    <div class="ord__item">
      <span class="ord__item-label">Restante</span>
      <span class="ord__item-value">{{ order.remains|number_format(0, ',', '.') }}</span>
    </div>
    {% endif %}
    <div class="ord__item">
      <span class="ord__item-label">Criado em</span>
      <span class="ord__item-value">{{ order.createdAt|date('d/m/Y H:i') }}</span>
    </div>
    {% if order.updatedAt %}
    <div class="ord__item">
      <span class="ord__item-label">Atualizado</span>
      <span class="ord__item-value">{{ order.updatedAt|date('d/m/Y H:i') }}</span>
    </div>
    {% endif %}
    <div class="ord__item ord__item--full">
      <span class="ord__item-label">URL alvo</span>
      <a href="{{ order.targetUrl }}" target="_blank" rel="noopener" class="ord__item-link">
        {{ order.targetUrl }}
        <i data-lucide="external-link" width="13" height="13" style="flex-shrink:0;"></i>
      </a>
    </div>
  </div>

  {# ── AÇÕES ── #}
  <div class="ord__actions">
    <a href="{{ path('app_dashboard') }}" class="ord__btn ord__btn--ghost">
      <i data-lucide="arrow-left" width="15" height="15"></i>
      Voltar ao painel
    </a>
    <a href="{{ path('app_order_new') }}" class="ord__btn ord__btn--primary">
      <i data-lucide="plus" width="15" height="15"></i>
      Novo pedido
    </a>
  </div>

</div>
{% endblock %}
