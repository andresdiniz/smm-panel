{% extends 'base.html.twig' %}

{% block title %}Pedido #{{ order.id }} — PulseSMM{% endblock %}
{% block page_title %}Pedido #{{ order.id }}{% endblock %}

{% block content %}
<div class="order-show-layout" data-reveal>

  {# ── CABEÇALHO ── #}
  <div class="order-show-head">
    <div>
      <div class="order-show-head__id">Pedido #{{ order.id }}</div>
      <h1 class="order-show-head__name">{{ order.service.name }}</h1>
    </div>
    <span class="badge badge--{{ order.status == 'completed' ? 'completed' : (order.status == 'cancelled' ? 'cancelled' : 'processing') }} badge--lg">
      {{ order.status|replace({'_': ' '})|capitalize }}
    </span>
  </div>

  {# ── DETALHES (grid de cards) ── #}
  <div class="order-details-grid">
    <div class="order-detail-item">
      <span class="order-detail-item__label">Serviço</span>
      <strong class="order-detail-item__value">{{ order.service.name }}</strong>
    </div>
    <div class="order-detail-item">
      <span class="order-detail-item__label">Categoria</span>
      <strong class="order-detail-item__value">{{ order.service.category }}</strong>
    </div>
    <div class="order-detail-item">
      <span class="order-detail-item__label">Quantidade</span>
      <strong class="order-detail-item__value">{{ order.quantity|number_format(0, ',', '.') }}</strong>
    </div>
    <div class="order-detail-item order-detail-item--highlight">
      <span class="order-detail-item__label">Valor cobrado</span>
      <strong class="order-detail-item__value">R$ {{ (order.amountCents / 100)|number_format(2, ',', '.') }}</strong>
    </div>
    {% if order.startCount is not null %}
    <div class="order-detail-item">
      <span class="order-detail-item__label">Início contagem</span>
      <strong class="order-detail-item__value">{{ order.startCount|number_format(0, ',', '.') }}</strong>
    </div>
    {% endif %}
    {% if order.remains is not null %}
    <div class="order-detail-item">
      <span class="order-detail-item__label">Restante</span>
      <strong class="order-detail-item__value">{{ order.remains|number_format(0, ',', '.') }}</strong>
    </div>
    {% endif %}
    <div class="order-detail-item">
      <span class="order-detail-item__label">Criado em</span>
      <strong class="order-detail-item__value">{{ order.createdAt|date('d/m/Y H:i') }}</strong>
    </div>
    {% if order.updatedAt %}
    <div class="order-detail-item">
      <span class="order-detail-item__label">Atualizado</span>
      <strong class="order-detail-item__value">{{ order.updatedAt|date('d/m/Y H:i') }}</strong>
    </div>
    {% endif %}
    <div class="order-detail-item order-detail-item--full">
      <span class="order-detail-item__label">URL alvo</span>
      <a href="{{ order.targetUrl }}" target="_blank" rel="noopener" class="order-detail-item__link">
        {{ order.targetUrl }}
        <i data-lucide="external-link" width="14" height="14"></i>
      </a>
    </div>
  </div>

  {# ── AÇÕES ── #}
  <div class="order-show-actions">
    <a href="{{ path('app_dashboard') }}" class="btn btn--ghost">
      <i data-lucide="arrow-left" width="16" height="16"></i>
      Voltar ao painel
    </a>
    <a href="{{ path('app_order_new') }}" class="btn btn--primary">
      <i data-lucide="plus" width="16" height="16"></i>
      Novo pedido
    </a>
  </div>

</div>

<style>
.order-show-layout { max-width: 760px; margin: 0 auto; display: flex; flex-direction: column; gap: var(--sp6); }
.order-show-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--sp4);
  flex-wrap: wrap;
  padding: var(--sp6);
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--r-xl);
  box-shadow: var(--sh-sm);
}
.order-show-head__id { font-size: var(--text-xs); font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); margin-bottom: var(--sp1); }
.order-show-head__name { font-size: var(--text-lg); font-weight: 900; letter-spacing: -0.02em; }
.badge--lg { padding: 6px var(--sp4); font-size: var(--text-sm); }
.order-details-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(min(180px, 100%), 1fr));
  gap: var(--sp3);
}
.order-detail-item {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--r-lg);
  padding: var(--sp4);
  display: flex;
  flex-direction: column;
  gap: var(--sp1);
  box-shadow: var(--sh-sm);
}
.order-detail-item--highlight {
  background: var(--primary-hi);
  border-color: color-mix(in oklab, var(--primary) 20%, transparent);
}
.order-detail-item--full { grid-column: 1 / -1; }
.order-detail-item__label { font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); font-weight: 700; }
.order-detail-item--highlight .order-detail-item__label { color: var(--primary-h); opacity: 0.8; }
.order-detail-item__value { font-size: var(--text-base); font-weight: 800; color: var(--text); font-variant-numeric: tabular-nums; }
.order-detail-item--highlight .order-detail-item__value { color: var(--primary-h); }
.order-detail-item__link {
  display: flex;
  align-items: center;
  gap: var(--sp2);
  font-size: var(--text-sm);
  font-weight: 600;
  color: var(--primary);
  text-decoration: none;
  word-break: break-all;
}
.order-detail-item__link:hover { text-decoration: underline; }
.order-show-actions { display: flex; gap: var(--sp3); flex-wrap: wrap; }
</style>
{% endblock %}
