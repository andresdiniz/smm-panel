{% extends 'base.html.twig' %}

{% block title %}Pedido #{{ order.id }} — PulseSMM{% endblock %}
{% block page_title %}Pedido #{{ order.id }}{% endblock %}

{% block content %}
<section class="wallet-page">
  <div class="container">
    <div class="panel-card" data-reveal style="max-width:680px;margin:0 auto">
      <div class="panel-card__head">
        <h1 style="font-size:clamp(1.3rem,4vw,1.8rem)">Pedido #{{ order.id }}</h1>
        <span class="badge badge--{{ order.status == 'completed' ? 'completed' : (order.status == 'cancelled' ? 'cancelled' : 'processing') }}">
          {{ order.status|replace({'_': ' '})|capitalize }}
        </span>
      </div>

      <div class="order-details">
        <div class="glass-card">
          <span>Serviço</span>
          <strong>{{ order.service.name }}</strong>
        </div>
        <div class="glass-card">
          <span>Categoria</span>
          <strong>{{ order.service.category }}</strong>
        </div>
        <div class="glass-card">
          <span>Quantidade</span>
          <strong>{{ order.quantity|number_format(0, ',', '.') }}</strong>
        </div>
        <div class="glass-card">
          <span>Valor cobrado</span>
          <strong>R$ {{ (order.amountCents / 100)|number_format(2, ',', '.') }}</strong>
        </div>
        <div class="glass-card" style="grid-column:1/-1">
          <span>URL alvo</span>
          <strong style="word-break:break-all">
            <a href="{{ order.targetUrl }}" target="_blank" rel="noopener">{{ order.targetUrl }}</a>
          </strong>
        </div>
        {% if order.startCount is not null %}
        <div class="glass-card">
          <span>Início contagem</span>
          <strong>{{ order.startCount|number_format(0, ',', '.') }}</strong>
        </div>
        {% endif %}
        {% if order.remains is not null %}
        <div class="glass-card">
          <span>Restante</span>
          <strong>{{ order.remains|number_format(0, ',', '.') }}</strong>
        </div>
        {% endif %}
        <div class="glass-card">
          <span>Criado em</span>
          <strong>{{ order.createdAt|date('d/m/Y H:i') }}</strong>
        </div>
        {% if order.updatedAt %}
        <div class="glass-card">
          <span>Última atualização</span>
          <strong>{{ order.updatedAt|date('d/m/Y H:i') }}</strong>
        </div>
        {% endif %}
      </div>

      <div style="margin-top:var(--space-6);display:flex;gap:var(--space-3);flex-wrap:wrap">
        <a href="{{ path('app_dashboard') }}" class="btn btn--ghost">← Voltar ao painel</a>
        <a href="{{ path('app_order_new') }}" class="btn btn--primary">Novo pedido</a>
      </div>
    </div>
  </div>
</section>
{% endblock %}
