{% extends 'blog/base_blog.html.twig' %}

{% block title %}{% if searchQuery is defined and searchQuery %}Busca: {{ searchQuery }}{% else %}Blog{% endif %}{% endblock %}

{% block body %}
<div class="b-wrap">

    {# ── POST EM DESTAQUE (só na página 1 sem busca) ── #}
    {% if posts|length > 0 and (currentPage is not defined or currentPage == 1) and (searchQuery is not defined or not searchQuery) %}
        {% set featured = posts|first %}
        <div class="b-featured">
            {% if featured.thumbnail %}
                <img src="{{ featured.thumbnail }}" alt="{{ featured.title }}" class="b-featured-img" loading="eager" width="600" height="450">
            {% else %}
                <div class="b-featured-img-placeholder">
                    <svg viewBox="0 0 24 24" width="48"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                </div>
            {% endif %}
            <div class="b-featured-body">
                <span class="b-featured-label">
                    <svg viewBox="0 0 24 24" width="10" stroke="currentColor" fill="none" stroke-width="2.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                    Destaque
                </span>
                {% if featured.category %}
                    <div style="font-size:.72rem;font-weight:700;color:var(--primary);text-transform:uppercase;letter-spacing:.06em;margin-bottom:.5rem;">
                        <a href="{{ path('blog_category', {slug: featured.category.slug}) }}">{{ featured.category.name }}</a>
                    </div>
                {% endif %}
                <h2 class="b-featured-title">
                    <a href="{{ path('blog_show', {slug: featured.slug}) }}">{{ featured.title }}</a>
                </h2>
                {% if featured.excerpt %}
                    <p class="b-featured-excerpt">{{ featured.excerpt|slice(0, 180) }}{% if featured.excerpt|length > 180 %}…{% endif %}</p>
                {% endif %}
                <a href="{{ path('blog_show', {slug: featured.slug}) }}" class="b-read-link">
                    Ler artigo
                    <svg viewBox="0 0 24 24" width="14" stroke="currentColor" fill="none" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                </a>
                <div class="b-featured-meta">
                    <span>{{ featured.publishedAt ? featured.publishedAt|date('d/m/Y') : '' }}</span>
                    <span>{{ featured.views }} view{{ featured.views != 1 ? 's' : '' }}</span>
                </div>
            </div>
        </div>
    {% endif %}

    <div class="b-grid">
        <main>
            <div class="b-page-hdr">
                {% if searchQuery is defined and searchQuery %}
                    <h1>Resultados para "{{ searchQuery }}"</h1>
                    <p>{{ total }} post{{ total != 1 ? 's' : '' }} encontrado{{ total != 1 ? 's' : '' }}</p>
                {% else %}
                    <h1>Últimas Publicações</h1>
                    <p>{{ total }} post{{ total != 1 ? 's' : '' }} publicado{{ total != 1 ? 's' : '' }}</p>
                {% endif %}
            </div>

            {% if posts|length == 0 %}
                <div style="text-align:center;padding:4rem 0;color:var(--text-muted);">
                    <svg viewBox="0 0 24 24" width="48" style="margin:0 auto 1rem;stroke:var(--text-faint);fill:none;stroke-width:1.5;"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                    <p style="font-size:1.1rem;margin-bottom:.5rem;">Nenhum post encontrado</p>
                    <p style="font-size:.875rem;"><a href="{{ path('blog_index') }}">← Voltar ao blog</a></p>
                </div>
            {% else %}
                {# Pula o destaque no grid se não for busca #}
                {% set gridPosts = (searchQuery is not defined or not searchQuery) ? posts|slice(1) : posts %}

                {% if gridPosts|length > 0 %}
                    {% if not (searchQuery is defined and searchQuery) %}
                        <p class="b-section-title">Mais posts</p>
                    {% endif %}
                    <div class="b-posts-grid">
                        {% for post in gridPosts %}
                            <article class="b-card">
                                <a href="{{ path('blog_show', {slug: post.slug}) }}">
                                    {% if post.thumbnail %}
                                        <img src="{{ post.thumbnail }}" alt="{{ post.title }}" class="b-card-img" loading="lazy" width="400" height="225">
                                    {% else %}
                                        <div class="b-card-img-placeholder">
                                            <svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                                        </div>
                                    {% endif %}
                                </a>
                                <div class="b-card-body">
                                    {% if post.category %}
                                        <a href="{{ path('blog_category', {slug: post.category.slug}) }}" class="b-card-cat">{{ post.category.name }}</a>
                                    {% endif %}
                                    <h2 class="b-card-title">
                                        <a href="{{ path('blog_show', {slug: post.slug}) }}">{{ post.title }}</a>
                                    </h2>
                                    {% if post.excerpt %}
                                        <p class="b-card-excerpt">{{ post.excerpt }}</p>
                                    {% endif %}
                                    <div class="b-card-meta">
                                        <span>{{ post.publishedAt ? post.publishedAt|date('d/m/Y') : '—' }}</span>
                                        <span>{{ post.views }} view{{ post.views != 1 ? 's' : '' }}</span>
                                    </div>
                                </div>
                            </article>
                        {% endfor %}
                    </div>
                {% endif %}

                {# PAGINAÇÃO #}
                {% if totalPages is defined and totalPages > 1 %}
                    <nav class="b-pagination" aria-label="Paginação">
                        {% if currentPage > 1 %}
                            <a href="{{ path('blog_index', {page: currentPage - 1}) }}">‹ Anterior</a>
                        {% endif %}
                        {% for p in 1..totalPages %}
                            {% if p == currentPage %}
                                <span class="current">{{ p }}</span>
                            {% elseif p == 1 or p == totalPages or (p >= currentPage - 2 and p <= currentPage + 2) %}
                                <a href="{{ path('blog_index', {page: p}) }}">{{ p }}</a>
                            {% elseif p == currentPage - 3 or p == currentPage + 3 %}
                                <span>…</span>
                            {% endif %}
                        {% endfor %}
                        {% if currentPage < totalPages %}
                            <a href="{{ path('blog_index', {page: currentPage + 1}) }}">Próximo ›</a>
                        {% endif %}
                    </nav>
                {% endif %}
            {% endif %}
        </main>

        {# ── SIDEBAR ── #}
        <aside>
            {# busca #}
            <div class="b-sidebar-widget">
                <h3>Buscar</h3>
                <form action="{{ path('blog_index') }}" method="get" class="b-search-form" role="search">
                    <input type="search" name="q" value="{{ searchQuery ?? '' }}" placeholder="Buscar posts…" aria-label="Buscar">
                    <button type="submit" aria-label="Pesquisar">
                        <svg viewBox="0 0 24 24" width="16" stroke="currentColor" fill="none" stroke-width="2.5"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                    </button>
                </form>
            </div>

            {# categorias #}
            {% if categories is defined and categories|length > 0 %}
                <div class="b-sidebar-widget">
                    <h3>Categorias</h3>
                    {% for cat in categories %}
                        <div class="b-cat-item">
                            <a href="{{ path('blog_category', {slug: cat.slug}) }}">{{ cat.name }}</a>
                            <span class="b-cat-count">{{ cat.postCount ?? cat.blogPosts|length }}</span>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}

            {# recentes #}
            {% if recentPosts is defined and recentPosts|length > 0 %}
                <div class="b-sidebar-widget">
                    <h3>Posts Recentes</h3>
                    {% for rp in recentPosts %}
                        <div class="b-recent-item">
                            {% if rp.thumbnail %}
                                <img src="{{ rp.thumbnail }}" alt="{{ rp.title }}" class="b-recent-thumb" loading="lazy" width="52" height="40">
                            {% else %}
                                <div class="b-recent-thumb-placeholder">
                                    <svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><polyline points="21 15 16 10 5 21"/></svg>
                                </div>
                            {% endif %}
                            <div class="b-recent-info">
                                <div class="b-recent-title"><a href="{{ path('blog_show', {slug: rp.slug}) }}">{{ rp.title|slice(0,60) }}{% if rp.title|length > 60 %}…{% endif %}</a></div>
                                <div class="b-recent-date">{{ rp.publishedAt ? rp.publishedAt|date('d/m/Y') : '' }}</div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </aside>
    </div>
</div>
{% endblock %}
