{% extends 'blog/base_blog.html.twig' %}

{% block title %}Blog{% if searchQuery is defined and searchQuery %} — Busca: {{ searchQuery }}{% endif %}{% endblock %}

{% block body %}
<div class="blog-container">
    <main class="blog-main">
        <div class="page-header">
            {% if searchQuery is defined and searchQuery %}
                <h1>Resultados para "{{ searchQuery }}"</h1>
                <p>{{ total }} post(s) encontrado(s)</p>
            {% else %}
                <h1>Últimas Publicações</h1>
                <p>{{ total }} post(s) publicado(s)</p>
            {% endif %}
        </div>

        {% if posts|length == 0 %}
            <p style="color: var(--color-text-muted); text-align: center; padding: 3rem 0;">Nenhum post encontrado.</p>
        {% else %}
        <div class="post-grid">
            {% for post in posts %}
            <article class="post-card">
                {% if post.thumbnail %}
                    <img src="{{ post.thumbnail }}" alt="{{ post.title }}" class="post-card-img" loading="lazy">
                {% else %}
                    <div class="post-card-img" style="display:flex;align-items:center;justify-content:center;background:#f0eeea;">
                        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#bab9b4" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="m3 9 4-4 4 4 4-4 4 4"/><circle cx="8.5" cy="14.5" r="1.5"/></svg>
                    </div>
                {% endif %}
                <div class="post-card-body">
                    {% if post.category %}
                        <a href="{{ path('blog_category', {slug: post.category.slug}) }}" class="post-card-cat">{{ post.category.name }}</a>
                    {% endif %}
                    <a href="{{ path('blog_show', {slug: post.slug}) }}">
                        <div class="post-card-title">{{ post.title }}</div>
                    </a>
                    {% if post.excerpt %}
                        <p class="post-card-excerpt">{{ post.excerpt }}</p>
                    {% endif %}
                    <div class="post-card-meta">
                        <span>{{ post.publishedAt ? post.publishedAt|date('d/m/Y') : 'Sem data' }}</span>
                        <span>{{ post.views }} view{{ post.views != 1 ? 's' : '' }}</span>
                    </div>
                </div>
            </article>
            {% endfor %}
        </div>

        {% if totalPages > 1 %}
        <nav class="pagination" aria-label="Paginação">
            {% if page > 1 %}<a href="?page={{ page - 1 }}">← Anterior</a>{% endif %}
            {% for i in 1..totalPages %}
                {% if i == page %}
                    <span class="current">{{ i }}</span>
                {% else %}
                    <a href="?page={{ i }}">{{ i }}</a>
                {% endif %}
            {% endfor %}
            {% if page < totalPages %}<a href="?page={{ page + 1 }}">Próxima →</a>{% endif %}
        </nav>
        {% endif %}
        {% endif %}
    </main>

    <aside class="blog-sidebar">
        <div class="sidebar-widget">
            <h3>Buscar</h3>
            <form class="search-form" action="{{ path('blog_search') }}" method="get">
                <input type="search" name="q" placeholder="Buscar posts…" value="{{ searchQuery ?? '' }}">
                <button type="submit">🔍</button>
            </form>
        </div>

        {% if categories|length > 0 %}
        <div class="sidebar-widget">
            <h3>Categorias</h3>
            {% for cat in categories %}
            <div class="sidebar-cat-item">
                <a href="{{ path('blog_category', {slug: cat.slug}) }}">{{ cat.name }}</a>
                <span style="font-size:0.75rem;color:var(--color-text-muted);">{{ cat.posts|length }}</span>
            </div>
            {% endfor %}
        </div>
        {% endif %}

        {% if recent|length > 0 %}
        <div class="sidebar-widget">
            <h3>Posts Recentes</h3>
            {% for p in recent %}
            <div class="sidebar-post-item">
                {% if p.thumbnail %}
                    <img src="{{ p.thumbnail }}" alt="" class="sidebar-post-thumb" loading="lazy">
                {% else %}
                    <div class="sidebar-post-thumb" style="background:var(--color-bg);"></div>
                {% endif %}
                <div>
                    <a href="{{ path('blog_show', {slug: p.slug}) }}" class="sidebar-post-title">{{ p.title }}</a>
                    <div class="sidebar-post-date">{{ p.publishedAt ? p.publishedAt|date('d/m/Y') : '' }}</div>
                </div>
            </div>
            {% endfor %}
        </div>
        {% endif %}
    </aside>
</div>
{% endblock %}
