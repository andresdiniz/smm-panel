{% extends 'blog/base_blog.html.twig' %}

{% block title %}{{ tag.name }} | Blog PulseSMM{% endblock %}
{% block meta_description %}Artigos marcados com {{ tag.name }} no blog PulseSMM.{% endblock %}

{% block body %}
<div class="b-wrap">
    <div class="b-grid">
        <main>
            <header class="b-page-hdr">
                <nav class="b-breadcrumb" aria-label="Breadcrumb">
                    <a href="{{ path('blog_index') }}">Blog</a>
                    <span aria-hidden="true">/</span>
                    <span aria-current="page">{{ tag.name }}</span>
                </nav>
                <h1>Artigos sobre {{ tag.name }}</h1>
                <p>{{ total }} artigo{{ total != 1 ? 's' : '' }} com esta tag</p>
            </header>

            {% if posts|length %}
                <div class="b-posts-grid">
                    {% for post in posts %}
                        <article class="b-card">
                            <a href="{{ path('blog_show', {slug: post.slug}) }}" aria-label="Ler {{ post.title }}">
                                {% if post.thumbnail %}
                                    <img src="{{ post.thumbnail }}" alt="{{ post.title }}" class="b-card-img" loading="lazy" width="400" height="225">
                                {% else %}
                                    <div class="b-card-img-placeholder" aria-hidden="true">
                                        <svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                                    </div>
                                {% endif %}
                            </a>
                            <div class="b-card-body">
                                {% if post.category %}
                                    <a href="{{ path('blog_category', {slug: post.category.slug}) }}" class="b-card-cat">{{ post.category.name }}</a>
                                {% endif %}
                                <h2 class="b-card-title"><a href="{{ path('blog_show', {slug: post.slug}) }}">{{ post.title }}</a></h2>
                                {% if post.excerpt %}<p class="b-card-excerpt">{{ post.excerpt }}</p>{% endif %}
                                <div class="b-card-meta">
                                    <span>{{ post.publishedAt ? post.publishedAt|date('d/m/Y') : '' }}</span>
                                    <span>{{ post.views }} visualizaç{{ post.views != 1 ? 'ões' : 'ão' }}</span>
                                </div>
                            </div>
                        </article>
                    {% endfor %}
                </div>
            {% else %}
                <div class="b-empty-state">
                    <h2>Nenhum artigo com esta tag</h2>
                    <p>Explore outras publicações do blog.</p>
                    <a href="{{ path('blog_index') }}" class="b-read-link">Ver todos os artigos</a>
                </div>
            {% endif %}

            {% if totalPages > 1 %}
                <nav class="b-pagination" aria-label="Paginação">
                    {% if page > 1 %}<a href="{{ path('blog_tag', {slug: tag.slug, page: page - 1}) }}" rel="prev">‹ Anterior</a>{% endif %}
                    {% for number in 1..totalPages %}
                        {% if number == page %}
                            <span class="current" aria-current="page">{{ number }}</span>
                        {% else %}
                            <a href="{{ path('blog_tag', {slug: tag.slug, page: number}) }}">{{ number }}</a>
                        {% endif %}
                    {% endfor %}
                    {% if page < totalPages %}<a href="{{ path('blog_tag', {slug: tag.slug, page: page + 1}) }}" rel="next">Próxima ›</a>{% endif %}
                </nav>
            {% endif %}
        </main>

        <aside aria-label="Navegação do blog">
            <div class="b-sidebar-widget">
                <h2>Buscar</h2>
                <form action="{{ path('blog_search') }}" method="get" class="b-search-form" role="search">
                    <input type="search" name="q" placeholder="Buscar artigos…" aria-label="Buscar artigos">
                    <button type="submit" aria-label="Pesquisar">
                        <svg viewBox="0 0 24 24" width="16" stroke="currentColor" fill="none" stroke-width="2.5"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                    </button>
                </form>
            </div>
            {% if categories|length %}
                <div class="b-sidebar-widget">
                    <h2>Categorias</h2>
                    {% for item in categories %}
                        <div class="b-cat-item"><a href="{{ path('blog_category', {slug: item.slug}) }}">{{ item.name }}</a><span class="b-cat-count">{{ item.postCount }}</span></div>
                    {% endfor %}
                </div>
            {% endif %}
            {% if recent|length %}
                <div class="b-sidebar-widget">
                    <h2>Posts recentes</h2>
                    {% for item in recent %}
                        <article class="b-recent-item">
                            {% if item.thumbnail %}
                                <img src="{{ item.thumbnail }}" alt="" class="b-recent-thumb" loading="lazy" width="52" height="40">
                            {% else %}
                                <div class="b-recent-thumb-placeholder" aria-hidden="true"></div>
                            {% endif %}
                            <div class="b-recent-info">
                                <div class="b-recent-title"><a href="{{ path('blog_show', {slug: item.slug}) }}">{{ item.title }}</a></div>
                                <div class="b-recent-date">{{ item.publishedAt ? item.publishedAt|date('d/m/Y') : '' }}</div>
                            </div>
                        </article>
                    {% endfor %}
                </div>
            {% endif %}
        </aside>
    </div>
</div>
{% endblock %}
