<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Blog{% endblock %} | SMM Panel</title>
    <meta name="description" content="{% block meta_description %}Dicas, tutoriais e novidades sobre SMM e marketing digital.{% endblock %}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300..700&family=Merriweather:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        :root {
            --color-bg: #f7f6f2;
            --color-surface: #ffffff;
            --color-primary: #01696f;
            --color-primary-hover: #0c4e54;
            --color-text: #28251d;
            --color-text-muted: #7a7974;
            --color-border: #d4d1ca;
            --color-divider: #dcd9d5;
            --font-body: 'Inter', sans-serif;
            --font-serif: 'Merriweather', Georgia, serif;
            --radius-sm: 0.375rem;
            --radius-md: 0.5rem;
            --radius-lg: 0.75rem;
            --space-1: 0.25rem; --space-2: 0.5rem; --space-3: 0.75rem;
            --space-4: 1rem;    --space-6: 1.5rem;  --space-8: 2rem;
            --space-10: 2.5rem; --space-12: 3rem;   --space-16: 4rem;
        }
        body { font-family: var(--font-body); font-size: 1rem; color: var(--color-text); background: var(--color-bg); line-height: 1.6; }
        a { color: var(--color-primary); text-decoration: none; }
        a:hover { color: var(--color-primary-hover); text-decoration: underline; }
        img { max-width: 100%; height: auto; display: block; }

        /* HEADER */
        .blog-header { background: var(--color-surface); border-bottom: 1px solid var(--color-border); padding: var(--space-4) var(--space-6); display: flex; align-items: center; justify-content: space-between; position: sticky; top: 0; z-index: 100; }
        .blog-header .logo { font-weight: 700; font-size: 1.25rem; color: var(--color-text); }
        .blog-header .logo span { color: var(--color-primary); }
        .blog-header nav a { margin-left: var(--space-6); color: var(--color-text-muted); font-size: 0.9rem; }
        .blog-header nav a:hover { color: var(--color-primary); text-decoration: none; }

        /* LAYOUT */
        .blog-container { max-width: 1160px; margin: 0 auto; padding: var(--space-10) var(--space-6); display: grid; grid-template-columns: 1fr 280px; gap: var(--space-10); }
        @media (max-width: 768px) { .blog-container { grid-template-columns: 1fr; } .blog-sidebar { order: 2; } }

        /* CARDS */
        .post-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(300px,100%), 1fr)); gap: var(--space-6); }
        .post-card { background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-lg); overflow: hidden; transition: box-shadow 180ms ease; }
        .post-card:hover { box-shadow: 0 4px 20px rgba(0,0,0,0.08); }
        .post-card-img { aspect-ratio: 16/9; width: 100%; object-fit: cover; background: var(--color-bg); }
        .post-card-body { padding: var(--space-4); }
        .post-card-cat { font-size: 0.75rem; font-weight: 600; color: var(--color-primary); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: var(--space-2); display: block; }
        .post-card-title { font-family: var(--font-serif); font-size: 1.1rem; font-weight: 700; line-height: 1.3; margin-bottom: var(--space-2); color: var(--color-text); }
        .post-card-excerpt { font-size: 0.875rem; color: var(--color-text-muted); display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
        .post-card-meta { font-size: 0.75rem; color: var(--color-text-muted); margin-top: var(--space-3); padding-top: var(--space-3); border-top: 1px solid var(--color-divider); display: flex; gap: var(--space-3); }

        /* SIDEBAR */
        .sidebar-widget { background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: var(--space-6); margin-bottom: var(--space-6); }
        .sidebar-widget h3 { font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-text-muted); margin-bottom: var(--space-4); }
        .sidebar-cat-item { display: flex; justify-content: space-between; align-items: center; padding: var(--space-2) 0; border-bottom: 1px solid var(--color-divider); font-size: 0.9rem; }
        .sidebar-cat-item:last-child { border-bottom: none; }
        .sidebar-post-item { display: flex; gap: var(--space-3); padding: var(--space-3) 0; border-bottom: 1px solid var(--color-divider); }
        .sidebar-post-item:last-child { border-bottom: none; }
        .sidebar-post-thumb { width: 56px; height: 42px; object-fit: cover; border-radius: var(--radius-sm); flex-shrink: 0; background: var(--color-bg); }
        .sidebar-post-title { font-size: 0.85rem; line-height: 1.4; font-weight: 500; color: var(--color-text); }
        .sidebar-post-date { font-size: 0.75rem; color: var(--color-text-muted); margin-top: 2px; }

        /* SEARCH */
        .search-form { display: flex; gap: var(--space-2); }
        .search-form input { flex: 1; border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: var(--space-2) var(--space-3); font-size: 0.9rem; outline: none; }
        .search-form input:focus { border-color: var(--color-primary); }
        .search-form button { background: var(--color-primary); color: #fff; border: none; border-radius: var(--radius-md); padding: var(--space-2) var(--space-3); cursor: pointer; font-size: 0.9rem; }

        /* SINGLE POST */
        .post-hero { width: 100%; max-height: 440px; object-fit: cover; border-radius: var(--radius-lg); margin-bottom: var(--space-8); }
        .post-title-main { font-family: var(--font-serif); font-size: clamp(1.75rem, 4vw, 2.5rem); font-weight: 700; line-height: 1.2; margin-bottom: var(--space-4); }
        .post-meta-bar { display: flex; flex-wrap: wrap; gap: var(--space-4); font-size: 0.85rem; color: var(--color-text-muted); margin-bottom: var(--space-8); padding-bottom: var(--space-6); border-bottom: 1px solid var(--color-divider); }
        .post-content { font-family: var(--font-serif); font-size: 1.05rem; line-height: 1.8; max-width: 70ch; }
        .post-content h2, .post-content h3 { font-family: var(--font-body); margin: var(--space-8) 0 var(--space-3); }
        .post-content p { margin-bottom: var(--space-4); }
        .post-content img { border-radius: var(--radius-md); margin: var(--space-4) 0; }
        .post-content ul, .post-content ol { padding-left: var(--space-6); margin-bottom: var(--space-4); }
        .post-content blockquote { border-left: 3px solid var(--color-primary); padding-left: var(--space-4); color: var(--color-text-muted); font-style: italic; margin: var(--space-6) 0; }
        .post-content pre { background: #1e1e2e; color: #cdd6f4; border-radius: var(--radius-md); padding: var(--space-4); overflow-x: auto; font-size: 0.875rem; margin: var(--space-4) 0; }

        /* TAGS */
        .tag-list { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-4); }
        .tag-badge { background: var(--color-bg); border: 1px solid var(--color-border); border-radius: var(--radius-full, 9999px); padding: 2px var(--space-3); font-size: 0.78rem; color: var(--color-text-muted); transition: background 180ms; }
        .tag-badge:hover { background: var(--color-primary); color: #fff; border-color: var(--color-primary); text-decoration: none; }

        /* PAGINATION */
        .pagination { display: flex; gap: var(--space-2); justify-content: center; margin-top: var(--space-10); }
        .pagination a, .pagination span { padding: var(--space-2) var(--space-4); border: 1px solid var(--color-border); border-radius: var(--radius-md); font-size: 0.9rem; color: var(--color-text-muted); }
        .pagination a:hover { background: var(--color-primary); color: #fff; border-color: var(--color-primary); text-decoration: none; }
        .pagination .current { background: var(--color-primary); color: #fff; border-color: var(--color-primary); }

        /* PAGE HEADER */
        .page-header { margin-bottom: var(--space-8); }
        .page-header h1 { font-family: var(--font-serif); font-size: clamp(1.5rem, 3vw, 2rem); margin-bottom: var(--space-2); }
        .page-header p { color: var(--color-text-muted); }

        /* FOOTER */
        .blog-footer { text-align: center; padding: var(--space-8); color: var(--color-text-muted); font-size: 0.85rem; border-top: 1px solid var(--color-divider); margin-top: var(--space-12); }
    </style>
    {% block head %}{% endblock %}
</head>
<body>
<header class="blog-header">
    <a href="{{ path('blog_index') }}" class="logo">SMM<span>Blog</span></a>
    <nav>
        <a href="{{ path('blog_index') }}">Início</a>
        <a href="{{ path('app_login') }}">Painel</a>
    </nav>
</header>

{% block body %}{% endblock %}

<footer class="blog-footer">
    © {{ 'now'|date('Y') }} SMM Panel — Todos os direitos reservados
</footer>
</body>
</html>
