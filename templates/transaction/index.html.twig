{% extends 'base.html.twig' %}

{% block title %}Histórico de Transações{% endblock %}

{% block page_title %}Histórico{% endblock %}

{% block content %}
<div class="page-transactions">

  {# KPIs #}
  <div class="kpi-grid">
    <div class="kpi">
      <div class="kpi__label">Total de transações</div>
      <div class="kpi__value">{{ transactions|length }}</div>
    </div>
    <div class="kpi">
      <div class="kpi__label">Entradas</div>
      <div class="kpi__value">
        {{ transactions|filter(t => t.type.value == 'credit')|length }}
      </div>
    </div>
    <div class="kpi">
      <div class="kpi__label">Saídas</div>
      <div class="kpi__value">
        {{ transactions|filter(t => t.type.value == 'debit')|length }}
      </div>
    </div>
    <div class="kpi kpi--balance">
      <div class="kpi__label">Saldo atual</div>
      <div class="kpi__value">
        {% if wallet %}
          R$ {{ (wallet.balanceCents / 100)|number_format(2, ',', '.') }}
        {% else %}
          R$ 0,00
        {% endif %}
      </div>
    </div>
  </div>

  {# Tabela #}
  <div class="table-card">
    <table class="table">
      <thead>
        <tr>
          <th>Data</th>
          <th>Descrição</th>
          <th>Tipo</th>
          <th>Valor</th>
          <th>Saldo após</th>
        </tr>
      </thead>
      <tbody>
        {% for t in transactions %}
        <tr>
          <td class="td-date">{{ t.createdAt|date('d/m/Y H:i') }}</td>
          <td>{{ t.description }}</td>
          <td>
            {% if t.type.value == 'credit' %}
              <span class="badge badge--success">Entrada</span>
            {% elseif t.type.value == 'debit' %}
              <span class="badge badge--error">Saída</span>
            {% else %}
              <span class="badge badge--neutral">{{ t.type.value }}</span>
            {% endif %}
          </td>
          <td class="td-amount {{ t.type.value == 'credit' ? 'amount--in' : 'amount--out' }}">
            {{ t.type.value == 'credit' ? '+' : '-' }}
            R$ {{ (t.amountCents / 100)|number_format(2, ',', '.') }}
          </td>
          <td class="td-balance">
            R$ {{ (t.balanceAfterCents / 100)|number_format(2, ',', '.') }}
          </td>
        </tr>
        {% else %}
        <tr>
          <td colspan="5" class="empty-state">
            <span>Nenhuma transação encontrada.</span>
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>

</div>

<style>
.page-transactions { padding: var(--space-6) var(--space-4); max-width: var(--content-wide); margin: 0 auto; }

.kpi-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: var(--space-4); margin-bottom: var(--space-6); }
.kpi { background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: var(--space-4); }
.kpi--balance { border-color: var(--color-primary); }
.kpi__label { font-size: var(--text-xs); color: var(--color-text-muted); text-transform: uppercase; letter-spacing: .05em; margin-bottom: var(--space-1); }
.kpi__value { font-size: var(--text-xl); font-weight: 700; color: var(--color-text); }
.kpi--balance .kpi__value { color: var(--color-primary); }

.table-card { background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-lg); overflow: hidden; }
.table { width: 100%; border-collapse: collapse; font-size: var(--text-sm); }
.table thead th { background: var(--color-surface-offset); padding: var(--space-3) var(--space-4); text-align: left; font-weight: 600; color: var(--color-text-muted); font-size: var(--text-xs); text-transform: uppercase; letter-spacing: .05em; border-bottom: 1px solid var(--color-border); }
.table tbody tr { border-bottom: 1px solid var(--color-divider); transition: background var(--transition-interactive); }
.table tbody tr:last-child { border-bottom: none; }
.table tbody tr:hover { background: var(--color-surface-offset); }
.table td { padding: var(--space-3) var(--space-4); vertical-align: middle; color: var(--color-text); }
.td-date { color: var(--color-text-muted); white-space: nowrap; }
.td-amount { font-weight: 600; white-space: nowrap; }
.amount--in { color: var(--color-success); }
.amount--out { color: var(--color-error); }
.td-balance { color: var(--color-text-muted); white-space: nowrap; }

.badge { display: inline-block; padding: 2px var(--space-2); border-radius: var(--radius-full); font-size: var(--text-xs); font-weight: 600; }
.badge--success { background: var(--color-success-highlight); color: var(--color-success); }
.badge--error { background: var(--color-error-highlight); color: var(--color-error); }
.badge--neutral { background: var(--color-surface-offset); color: var(--color-text-muted); }

.empty-state { text-align: center; padding: var(--space-12); color: var(--color-text-muted); }

@media (max-width: 640px) {
  .table thead { display: none; }
  .table tbody tr { display: block; padding: var(--space-3); margin-bottom: var(--space-2); background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-md); }
  .table td { display: flex; justify-content: space-between; padding: var(--space-1) 0; border: none; }
  .table td::before { content: attr(data-label); color: var(--color-text-muted); font-size: var(--text-xs); }
}
</style>
{% endblock %}
