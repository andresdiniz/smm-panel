{% extends 'base.html.twig' %}

{% block title %}Histórico — PulseSMM{% endblock %}
{% block page_title %}Histórico{% endblock %}

{% block content %}
<div class="tx-page">

  {# ── KPIs ── #}
  <div class="kpi-grid" data-reveal>
    <div class="kpi">
      <div class="kpi__icon kpi__icon--teal"><i data-lucide="repeat" width="18" height="18"></i></div>
      <div class="kpi__label">Total</div>
      <div class="kpi__value">{{ transactions|length }}</div>
    </div>
    <div class="kpi">
      <div class="kpi__icon kpi__icon--green"><i data-lucide="arrow-down-left" width="18" height="18"></i></div>
      <div class="kpi__label">Entradas</div>
      <div class="kpi__value">{{ transactions|filter(t => t.type.value == 'credit')|length }}</div>
    </div>
    <div class="kpi">
      <div class="kpi__icon kpi__icon--error"><i data-lucide="arrow-up-right" width="18" height="18"></i></div>
      <div class="kpi__label">Saídas</div>
      <div class="kpi__value">{{ transactions|filter(t => t.type.value == 'debit')|length }}</div>
    </div>
    <div class="kpi">
      <div class="kpi__icon kpi__icon--blue"><i data-lucide="wallet" width="18" height="18"></i></div>
      <div class="kpi__label">Saldo atual</div>
      <div class="kpi__value">
        {% if wallet %}R$ {{ (wallet.balanceCents / 100)|number_format(2, ',', '.') }}{% else %}R$ 0,00{% endif %}
      </div>
    </div>
  </div>

  {# ── TABELA ── #}
  <div class="wtable-wrap" data-reveal>
    <div class="wtable-header">
      <h2 class="wtable-title">Transações</h2>
      <span class="wtable-count">{{ transactions|length }} registro(s)</span>
    </div>
    <div class="wtable-scroll">
      <table class="wtable">
        <thead>
          <tr>
            <th>Data</th>
            <th>Descrição</th>
            <th>Tipo</th>
            <th class="text-right">Valor</th>
            <th class="text-right">Saldo após</th>
          </tr>
        </thead>
        <tbody>
        {% for t in transactions %}
          <tr>
            <td class="wt-date">
              {{ t.createdAt|date('d/m/Y') }}
              <small>{{ t.createdAt|date('H:i') }}</small>
            </td>
            <td>{{ t.description }}</td>
            <td>
              {% if t.type.value == 'credit' %}
                <span class="wbadge wbadge--success">
                  <i data-lucide="arrow-down-left" width="12" height="12"></i> Entrada
                </span>
              {% elseif t.type.value == 'debit' %}
                <span class="wbadge wbadge--error">
                  <i data-lucide="arrow-up-right" width="12" height="12"></i> Saída
                </span>
              {% else %}
                <span class="wbadge wbadge--neutral">{{ t.type.value }}</span>
              {% endif %}
            </td>
            <td class="text-right wt-amount {{ t.type.value == 'credit' ? 'wt-amount--credit' : 'wt-amount--debit' }}">
              {{ t.type.value == 'credit' ? '+' : '-' }}R$ {{ (t.amountCents / 100)|number_format(2, ',', '.') }}
            </td>
            <td class="text-right wt-amount">
              R$ {{ (t.balanceAfterCents / 100)|number_format(2, ',', '.') }}
            </td>
          </tr>
        {% else %}
          <tr>
            <td colspan="5">
              <div class="wtable-empty">
                <i data-lucide="inbox" width="40" height="40"></i>
                <p>Nenhuma transação encontrada.</p>
              </div>
            </td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
    </div>
  </div>

</div>

<style>
.tx-page { display: flex; flex-direction: column; gap: var(--sp6); max-width: 1000px; }
</style>
{% endblock %}
