{% extends 'base.html.twig' %}

{% block title %}Configurações — PulseSMM{% endblock %}
{% block page_title %}Configurações{% endblock %}

{% block content %}
<div class="settings-layout">

  {# ── SENHA ── #}
  <div class="card card--padded settings-section" data-reveal>
    <div class="settings-section__head">
      <div class="settings-section__icon settings-section__icon--primary">
        <i data-lucide="lock" width="18" height="18"></i>
      </div>
      <div>
        <h2 class="settings-section__title">Alterar senha</h2>
        <p class="settings-section__sub">Use uma senha forte com ao menos 8 caracteres.</p>
      </div>
    </div>

    {% if error %}
    <div class="flash flash--error">
      <i data-lucide="x-circle" width="16" height="16"></i>
      <span>{{ error }}</span>
    </div>
    {% endif %}

    <form method="post" class="form-grid" style="margin-top: var(--sp5)">
      <input type="hidden" name="_token" value="{{ csrf_token('settings_password') }}">
      <div class="field">
        <label>Senha atual <span class="required">*</span></label>
        <input type="password" name="current_password" class="control" required autocomplete="current-password">
      </div>
      <div class="field">
        <label>Nova senha <span class="required">*</span></label>
        <input type="password" name="new_password" class="control" required minlength="8" autocomplete="new-password" id="newPwd">
        <span class="field-hint">Mínimo 8 caracteres.</span>
      </div>
      <div class="field">
        <label>Confirmar nova senha <span class="required">*</span></label>
        <input type="password" name="confirm_password" class="control" required autocomplete="new-password" id="confirmPwd">
        <span class="field-error" id="pwdMatchError" style="display:none">As senhas não coincidem.</span>
      </div>
      <button type="submit" class="btn btn--primary">
        <i data-lucide="shield-check" width="16" height="16"></i>
        Alterar senha
      </button>
    </form>
  </div>

  {# ── TEMA ── #}
  <div class="card card--padded settings-section" data-reveal>
    <div class="settings-section__head">
      <div class="settings-section__icon settings-section__icon--gold">
        <i data-lucide="palette" width="18" height="18"></i>
      </div>
      <div>
        <h2 class="settings-section__title">Aparência</h2>
        <p class="settings-section__sub">Escolha o tema da interface.</p>
      </div>
    </div>

    <div class="theme-picker">
      <button class="theme-opt" id="themeLight" onclick="setTheme('light')">
        <i data-lucide="sun" width="20" height="20"></i>
        <span>Claro</span>
      </button>
      <button class="theme-opt" id="themeDark" onclick="setTheme('dark')">
        <i data-lucide="moon" width="20" height="20"></i>
        <span>Escuro</span>
      </button>
      <button class="theme-opt" id="themeSystem" onclick="setTheme('system')">
        <i data-lucide="monitor" width="20" height="20"></i>
        <span>Sistema</span>
      </button>
    </div>
  </div>

  {# ── API KEY ── #}
  <div class="card card--padded settings-section" data-reveal>
    <div class="settings-section__head">
      <div class="settings-section__icon settings-section__icon--blue">
        <i data-lucide="key" width="18" height="18"></i>
      </div>
      <div>
        <h2 class="settings-section__title">API Key</h2>
        <p class="settings-section__sub">Use sua chave para integrar com ferramentas externas.</p>
      </div>
    </div>
    <div class="api-key-row">
      <input type="text" class="control" value="&#x2022;&#x2022;&#x2022;&#x2022;&#x2022;&#x2022;&#x2022;&#x2022;&#x2022;&#x2022;&#x2022;&#x2022;&#x2022;&#x2022;&#x2022;&#x2022;&#x2022;&#x2022;&#x2022;&#x2022;&#x2022;&#x2022;&#x2022;&#x2022;" readonly id="apiKeyInput">
      <button class="btn btn--ghost btn--sm" onclick="toggleKey()" type="button" aria-label="Mostrar/ocultar API key">
        <i data-lucide="eye" width="14" height="14"></i>
      </button>
      <button class="btn btn--ghost btn--sm" onclick="copyKey()" type="button" aria-label="Copiar API key">
        <i data-lucide="copy" width="14" height="14"></i>
      </button>
    </div>
  </div>

</div>

<style>
.settings-layout { display: flex; flex-direction: column; gap: var(--sp4); max-width: 640px; }
.settings-section__head { display: flex; align-items: flex-start; gap: var(--sp4); margin-bottom: var(--sp5); }
.settings-section__icon {
  width: 40px; height: 40px;
  border-radius: var(--r-lg);
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.settings-section__icon--primary { background: var(--primary-hi); color: var(--primary-h); }
.settings-section__icon--gold    { background: color-mix(in oklab, #d19900 12%, var(--surface)); color: #6e4800; }
.settings-section__icon--blue    { background: color-mix(in oklab, var(--blue) 12%, var(--surface)); color: var(--blue); }
.settings-section__title { font-size: var(--text-base); font-weight: 800; letter-spacing: -0.02em; }
.settings-section__sub   { font-size: var(--text-xs); color: var(--muted); margin-top: 2px; }
.theme-picker { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--sp3); margin-top: var(--sp2); }
.theme-opt {
  display: flex; flex-direction: column; align-items: center; gap: var(--sp2);
  padding: var(--sp4) var(--sp3);
  border: 1.5px solid var(--border);
  border-radius: var(--r-lg);
  background: var(--surface-off);
  color: var(--muted);
  font-size: var(--text-xs); font-weight: 700;
  cursor: pointer;
  transition: background var(--t), border-color var(--t), color var(--t);
  min-height: 80px;
}
.theme-opt:hover, .theme-opt.is-active {
  background: var(--primary-hi);
  border-color: var(--primary);
  color: var(--primary-h);
}
.api-key-row { display: flex; gap: var(--sp2); align-items: center; margin-top: var(--sp2); }
.api-key-row .control { font-family: 'Courier New', monospace; font-size: var(--text-sm); flex: 1; }
</style>

{% block javascripts %}{{ parent() }}
<script>
function setTheme(t) {
  if (t === 'system') {
    document.documentElement.removeAttribute('data-theme');
    sessionStorage.removeItem('pulse-theme');
  } else {
    document.documentElement.setAttribute('data-theme', t);
    sessionStorage.setItem('pulse-theme', t);
  }
  document.querySelectorAll('.theme-opt').forEach(b => b.classList.remove('is-active'));
  const map = { light: 'themeLight', dark: 'themeDark', system: 'themeSystem' };
  document.getElementById(map[t])?.classList.add('is-active');
}
(function(){
  const saved = sessionStorage.getItem('pulse-theme') || 'system';
  const map = { light: 'themeLight', dark: 'themeDark', system: 'themeSystem' };
  document.getElementById(map[saved])?.classList.add('is-active');
})();

const np = document.getElementById('newPwd');
const cp = document.getElementById('confirmPwd');
const err = document.getElementById('pwdMatchError');
[np, cp].forEach(el => el?.addEventListener('input', () => {
  if (cp.value && np.value !== cp.value) {
    err.style.display = 'block'; cp.classList.add('is-invalid');
  } else {
    err.style.display = 'none'; cp.classList.remove('is-invalid');
  }
}));

let keyVisible = false;
function toggleKey() {
  keyVisible = !keyVisible;
  document.getElementById('apiKeyInput').value = keyVisible ? 'pk_live_demo_key_aqui' : '\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022';
}
function copyKey() {
  const val = document.getElementById('apiKeyInput').value;
  navigator.clipboard?.writeText(val);
}
</script>
{% endblock %}
{% endblock %}
