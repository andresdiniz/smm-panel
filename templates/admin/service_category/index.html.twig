{% extends 'admin/layout.html.twig' %}

{% block page_title %}Categorias de Serviços{% endblock %}

{% block admin_content %}
<style>
  .sc-wrap { padding: 24px; }
  .sc-topbar {
    display: flex; align-items: center; justify-content: space-between;
    flex-wrap: wrap; gap: 12px; margin-bottom: 20px;
  }
  .sc-title { font-size: 1.05rem; font-weight: 900; color: #f0f3ff; margin: 0; }
  .btn-sm {
    padding: 6px 13px; border-radius: 5px; font-size: .78rem; font-weight: 700;
    border: 1px solid; display: inline-flex; align-items: center; gap: 5px;
    text-decoration: none; cursor: pointer; transition: background .15s;
  }
  .btn-primary { background: rgba(78,204,211,.12); color: #4eccd3; border-color: rgba(78,204,211,.3); }
  .btn-primary:hover { background: rgba(78,204,211,.25); }
  .sc-card {
    background: #0b0e14; border: 1px solid rgba(255,255,255,.06);
    border-radius: 8px; overflow: hidden;
  }
  .sc-table { width: 100%; border-collapse: collapse; font-size: .8rem; }
  .sc-table thead tr { border-bottom: 1px solid rgba(255,255,255,.06); }
  .sc-table th {
    padding: 10px 14px; text-align: left;
    font-size: 9px; font-weight: 700; text-transform: uppercase;
    letter-spacing: .1em; color: #3e4259; white-space: nowrap;
  }
  .sc-table tbody tr {
    border-bottom: 1px solid rgba(255,255,255,.03);
    transition: background .12s;
  }
  .sc-table tbody tr:last-child { border-bottom: none; }
  .sc-table tbody tr:hover { background: rgba(255,255,255,.02); }
  .sc-table td { padding: 10px 14px; vertical-align: middle; color: #9196b0; }
  .td-name { color: #dde1f0; font-weight: 600; }
  .td-mono { font-family: monospace; font-size: .74rem; }
  .badge {
    display: inline-flex; padding: 2px 7px; border-radius: 999px;
    font-size: 9px; font-weight: 700; text-transform: uppercase; letter-spacing: .05em;
  }
  .badge-active   { background: rgba(77,143,37,.14);  color: #5aaa2a; }
  .badge-inactive { background: rgba(120,120,140,.12); color: #7070a0; }
  .count-chip {
    display: inline-flex; align-items: center; justify-content: center;
    min-width: 22px; height: 18px; padding: 0 6px;
    border-radius: 999px; font-size: .68rem; font-weight: 700;
    background: rgba(78,204,211,.08); color: #4eccd3;
  }
  .row-actions { display: flex; gap: 6px; align-items: center; }
  .ra {
    width: 26px; height: 26px; border-radius: 5px; display: flex;
    align-items: center; justify-content: center;
    text-decoration: none; transition: background .12s; border: none; cursor: pointer;
  }
  .ra-edit   { background: rgba(201,138,0,.1);  color: #b07a00; }
  .ra-edit:hover   { background: rgba(201,138,0,.25); }
  .ra-delete { background: rgba(176,48,48,.1);  color: #cc4444; padding: 0; }
  .ra-delete:hover { background: rgba(176,48,48,.25); }
  .sc-empty { text-align: center; padding: 48px 16px; color: #3e4259; font-size: .85rem; }
</style>

<div class="sc-wrap">

  <div class="sc-topbar">
    <h1 class="sc-title">
      Categorias de Serviços
      <span style="font-size:.75rem;font-weight:400;color:#3e4259;margin-left:6px;">
        {{ categories|length }} registro{{ categories|length != 1 ? 's' : '' }}
      </span>
    </h1>
    <a href="{{ path('admin_service_category_new') }}" class="btn-sm btn-primary">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 5v14M5 12h14"/></svg>
      Nova categoria
    </a>
  </div>

  <div class="sc-card">
    {% if categories|length > 0 %}
    <table class="sc-table">
      <thead>
        <tr>
          <th style="width:44px;">#</th>
          <th>Nome</th>
          <th>Slug</th>
          <th>Ordem</th>
          <th>Serviços</th>
          <th>Status</th>
          <th style="width:70px;"></th>
        </tr>
      </thead>
      <tbody>
        {% for cat in categories %}
        <tr>
          <td class="td-mono" style="color:#3e4259;">#{{ cat.id }}</td>

          <td class="td-name">{{ cat.name }}</td>

          <td class="td-mono" style="color:#5a5f78;">{{ cat.slug }}</td>

          <td style="text-align:center;">{{ cat.sortOrder }}</td>

          <td>
            <span class="count-chip">{{ cat.services|length }}</span>
          </td>

          <td>
            <span class="badge {{ cat.isActive ? 'badge-active' : 'badge-inactive' }}">
              {{ cat.isActive ? 'Ativa' : 'Inativa' }}
            </span>
          </td>

          <td>
            <div class="row-actions">
              <a href="{{ path('admin_service_category_edit', {id: cat.id}) }}" class="ra ra-edit" title="Editar">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
              </a>
              <form method="post" action="{{ path('admin_service_category_delete', {id: cat.id}) }}"
                    onsubmit="return confirm('Excluir categoria {{ cat.name|e('js') }}?')" style="margin:0;">
                <input type="hidden" name="_token" value="{{ csrf_token('delete_svc_cat_' ~ cat.id) }}">
                <button type="submit" class="ra ra-delete" title="Excluir"
                  {{ cat.services|length > 0 ? 'disabled title="Possui serviços vinculados"' : '' }}>
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6M14 11v6"/></svg>
                </button>
              </form>
            </div>
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    {% else %}
      <div class="sc-empty">
        Nenhuma categoria cadastrada ainda.
        <br><a href="{{ path('admin_service_category_new') }}" style="color:#4eccd3;text-decoration:none;margin-top:8px;display:inline-block;">Criar primeira categoria</a>
      </div>
    {% endif %}
  </div>

</div>
{% endblock %}
