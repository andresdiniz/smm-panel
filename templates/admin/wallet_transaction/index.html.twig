{% extends 'admin/layout.html.twig' %}

{% block page_title %}Transações de Carteira{% endblock %}

{% block admin_content %}
<div style="padding:24px;display:flex;flex-direction:column;gap:20px">

  <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px">
    <h1 style="font-size:1.1rem;font-weight:800;color:#f0f3ff">Carteiras / Transações</h1>
    <a href="{{ path('admin_dashboard') }}"
       style="display:inline-flex;align-items:center;gap:5px;font-size:.78rem;color:#6b708a;text-decoration:none">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
      Voltar
    </a>
  </div>

  <div style="background:#0b0e14;border:1px solid rgba(255,255,255,.06);border-radius:10px;overflow:hidden">
    {% if pagination.items|length == 0 %}
      <div style="display:flex;flex-direction:column;align-items:center;gap:10px;
                  padding:48px 20px;color:#3e4259;text-align:center">
        <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 12V22H4V12"/><path d="M22 7H2v5h20V7z"/><path d="M12 22V7"/></svg>
        <p style="font-size:.88rem;color:#6b708a">Nenhuma transação encontrada.</p>
      </div>
    {% else %}
      <div style="overflow-x:auto">
        <table style="width:100%;border-collapse:collapse;font-size:.8rem">
          <thead>
            <tr>
              {% for col in ['#ID','Usuário','Saldo Atual','Tipo','Valor','Saldo Após','Descrição','Data'] %}
                <th style="background:#0d1016;color:#3e4259;font-weight:700;font-size:.68rem;
                            letter-spacing:.05em;text-transform:uppercase;padding:9px 13px;
                            text-align:left;border-bottom:1px solid rgba(255,255,255,.06);white-space:nowrap">
                  {{ col }}
                </th>
              {% endfor %}
            </tr>
          </thead>
          <tbody>
            {% for tx in pagination %}
            {% set typeSlug = tx.type.value|lower %}
            {% set isCredit = typeSlug in ['credit','bonus','cashback','refund'] %}
            <tr style="border-bottom:1px solid rgba(255,255,255,.04)">
              <td style="padding:10px 13px"><strong style="color:#dde1f0">#{{ tx.id }}</strong></td>
              <td style="padding:10px 13px">
                <strong style="display:block;font-size:.82rem;color:#dde1f0">{{ tx.wallet.user.name }}</strong>
                <small style="font-size:.7rem;color:#3e4259">{{ tx.wallet.user.email }}</small>
              </td>
              <td style="padding:10px 13px;color:#3e4259;font-size:.76rem">
                R$ {{ (tx.wallet.balanceCents / 100)|number_format(2, ',', '.') }}
              </td>
              <td style="padding:10px 13px">
                {% set tc = {
                  'credit':   'rgba(34,197,94,.12);color:#22c55e;border:1px solid rgba(34,197,94,.25)',
                  'debit':    'rgba(239,68,68,.12);color:#ef4444;border:1px solid rgba(239,68,68,.25)',
                  'refund':   'rgba(139,92,246,.12);color:#8b5cf6;border:1px solid rgba(139,92,246,.25)',
                  'bonus':    'rgba(245,158,11,.12);color:#f59e0b;border:1px solid rgba(245,158,11,.25)',
                  'cashback': 'rgba(1,134,141,.12);color:#4eccd3;border:1px solid rgba(1,134,141,.25)'
                } %}
                <span style="display:inline-flex;padding:3px 9px;border-radius:20px;
                             font-size:.68rem;font-weight:700;
                             background:{{ tc[typeSlug] ?? 'rgba(255,255,255,.06);color:#9196b0;border:1px solid rgba(255,255,255,.1)' }}">
                  {{ tx.type.value|capitalize }}
                </span>
              </td>
              <td style="padding:10px 13px;font-weight:700;
                         color:{{ isCredit ? '#22c55e' : '#ef4444' }}">
                {{ isCredit ? '+' : '−' }} R$ {{ (tx.amountCents / 100)|number_format(2, ',', '.') }}
              </td>
              <td style="padding:10px 13px;color:#3e4259;font-size:.76rem">
                R$ {{ (tx.balanceAfterCents / 100)|number_format(2, ',', '.') }}
              </td>
              <td style="padding:10px 13px;color:#6b708a;font-size:.76rem;max-width:220px">
                {{ tx.description }}
              </td>
              <td style="padding:10px 13px;color:#3e4259;font-size:.76rem;white-space:nowrap">
                {{ tx.createdAt|date('d/m/Y H:i') }}
              </td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>

      {% if pagination.pageCount > 1 %}
      <div style="display:flex;align-items:center;justify-content:flex-end;
                  gap:5px;padding:13px 18px;
                  border-top:1px solid rgba(255,255,255,.06);flex-wrap:wrap">
        {% if pagination.currentPageNumber > 1 %}
          <a href="{{ path('admin_wallet_transaction_index', {page: pagination.currentPageNumber - 1}) }}"
             style="display:inline-flex;align-items:center;justify-content:center;
                    min-width:30px;height:30px;padding:0 7px;border-radius:6px;font-size:.76rem;
                    border:1px solid rgba(255,255,255,.08);color:#6b708a;text-decoration:none">&lsaquo;</a>
        {% endif %}
        {% for page in 1..pagination.pageCount %}
          {% if page == pagination.currentPageNumber %}
            <span style="display:inline-flex;align-items:center;justify-content:center;
                         min-width:30px;height:30px;padding:0 7px;border-radius:6px;font-size:.76rem;
                         background:#01868d;border:1px solid #01868d;color:#fff;font-weight:700">{{ page }}</span>
          {% elseif page == 1 or page == pagination.pageCount
                    or (page >= pagination.currentPageNumber - 2 and page <= pagination.currentPageNumber + 2) %}
            <a href="{{ path('admin_wallet_transaction_index', {page: page}) }}"
               style="display:inline-flex;align-items:center;justify-content:center;
                       min-width:30px;height:30px;padding:0 7px;border-radius:6px;font-size:.76rem;
                       border:1px solid rgba(255,255,255,.08);color:#6b708a;text-decoration:none">{{ page }}</a>
          {% elseif page == pagination.currentPageNumber - 3 or page == pagination.currentPageNumber + 3 %}
            <span style="color:#3e4259;font-size:.76rem">…</span>
          {% endif %}
        {% endfor %}
        {% if pagination.currentPageNumber < pagination.pageCount %}
          <a href="{{ path('admin_wallet_transaction_index', {page: pagination.currentPageNumber + 1}) }}"
             style="display:inline-flex;align-items:center;justify-content:center;
                    min-width:30px;height:30px;padding:0 7px;border-radius:6px;font-size:.76rem;
                    border:1px solid rgba(255,255,255,.08);color:#6b708a;text-decoration:none">&rsaquo;</a>
        {% endif %}
      </div>
      {% endif %}
    {% endif %}
  </div>

</div>
{% endblock %}
