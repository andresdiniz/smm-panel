{% extends 'base.html.twig' %}
{% block page_title %}Suporte — Admin{% endblock %}

{% block content %}
<div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;margin-bottom:20px;">
  <div>
    <h1 style="font-size:1.25rem;font-weight:700;margin:0 0 2px;">Central de Suporte</h1>
    <p style="font-size:.85rem;color:var(--color-text-muted);margin:0;">
      {{ tickets|length }} ticket{{ tickets|length != 1 ? 's' : '' }} aberto{{ tickets|length != 1 ? 's' : '' }}
      {% if unreadCount > 0 %}&nbsp;&mdash;&nbsp;<strong style="color:var(--color-error);">{{ unreadCount }} não lido{{ unreadCount != 1 ? 's' : '' }}</strong>{% endif %}
    </p>
  </div>
</div>

{% if tickets|length == 0 %}
<div style="display:flex;flex-direction:column;align-items:center;text-align:center;padding:64px 16px;color:var(--color-text-muted);">
  <i data-lucide="check-circle" width="48" height="48" style="margin-bottom:16px;color:var(--color-success);" aria-hidden="true"></i>
  <h3 style="font-size:1rem;font-weight:600;color:var(--color-text);margin:0 0 6px;">Tudo em dia!</h3>
  <p style="max-width:34ch;margin:0;font-size:.875rem;">Nenhum ticket aberto no momento.</p>
</div>
{% else %}
<div class="card" style="overflow:hidden;">
  <table style="width:100%;border-collapse:collapse;">
    <thead>
      <tr style="border-bottom:1px solid var(--color-border);background:var(--color-surface-2);">
        <th style="padding:10px 16px;text-align:left;font-size:.7rem;font-weight:600;letter-spacing:.05em;text-transform:uppercase;color:var(--color-text-muted);">#</th>
        <th style="padding:10px 16px;text-align:left;font-size:.7rem;font-weight:600;letter-spacing:.05em;text-transform:uppercase;color:var(--color-text-muted);">Usuário</th>
        <th style="padding:10px 16px;text-align:left;font-size:.7rem;font-weight:600;letter-spacing:.05em;text-transform:uppercase;color:var(--color-text-muted);">Assunto</th>
        <th style="padding:10px 16px;text-align:center;font-size:.7rem;font-weight:600;letter-spacing:.05em;text-transform:uppercase;color:var(--color-text-muted);">Status</th>
        <th style="padding:10px 16px;text-align:center;font-size:.7rem;font-weight:600;letter-spacing:.05em;text-transform:uppercase;color:var(--color-text-muted);">Prior.</th>
        <th style="padding:10px 16px;text-align:center;font-size:.7rem;font-weight:600;letter-spacing:.05em;text-transform:uppercase;color:var(--color-text-muted);">Msgs</th>
        <th style="padding:10px 16px;text-align:left;font-size:.7rem;font-weight:600;letter-spacing:.05em;text-transform:uppercase;color:var(--color-text-muted);">Atualizado</th>
        <th style="padding:10px 16px;"></th>
      </tr>
    </thead>
    <tbody>
    {% for ticket in tickets %}
      {%- set unread = ticket.countUnreadByAdmin() -%}
      <tr style="border-bottom:1px solid var(--color-border);transition:background .15s;" onmouseover="this.style.background='var(--color-surface-offset)'" onmouseout="this.style.background=''">
        <td style="padding:11px 16px;font-size:.8rem;color:var(--color-text-muted);font-variant-numeric:tabular-nums;">#{{ ticket.id }}</td>
        <td style="padding:11px 16px;">
          <div style="font-size:.8rem;font-weight:600;">{{ ticket.user.name|split(' ')|first }}</div>
          <div style="font-size:.7rem;color:var(--color-text-muted);">{{ ticket.user.email }}</div>
        </td>
        <td style="padding:11px 16px;font-size:.875rem;font-weight:500;max-width:240px;">
          {{ ticket.subject|u.truncate(50, '…') }}
          {% if unread > 0 %}
          <span style="display:inline-flex;margin-left:6px;padding:1px 6px;font-size:.58rem;font-weight:700;border-radius:9999px;background:var(--color-error,#a12c7b);color:#fff;vertical-align:middle;">{{ unread }} novo{{ unread != 1 ? 's' : '' }}</span>
          {% endif %}
        </td>
        <td style="padding:11px 16px;text-align:center;">
          <span style="padding:2px 9px;font-size:.68rem;font-weight:600;border-radius:9999px;
            {% if ticket.status.value == 'open' %}background:color-mix(in srgb,var(--color-blue) 12%,transparent);color:var(--color-blue);
            {% elseif ticket.status.value == 'in_progress' %}background:color-mix(in srgb,var(--color-orange) 12%,transparent);color:var(--color-orange);
            {% elseif ticket.status.value == 'waiting_user' %}background:color-mix(in srgb,var(--color-gold) 12%,transparent);color:var(--color-gold);
            {% else %}background:color-mix(in srgb,var(--color-success) 12%,transparent);color:var(--color-success);
            {% endif %}">{{ ticket.status.label() }}</span>
        </td>
        <td style="padding:11px 16px;text-align:center;">
          <span style="padding:2px 9px;font-size:.68rem;font-weight:600;border-radius:9999px;
            {% if ticket.priority.value == 'urgent' %}background:color-mix(in srgb,var(--color-error) 12%,transparent);color:var(--color-error);
            {% elseif ticket.priority.value == 'high' %}background:color-mix(in srgb,var(--color-orange) 12%,transparent);color:var(--color-orange);
            {% elseif ticket.priority.value == 'normal' %}background:color-mix(in srgb,var(--color-blue) 12%,transparent);color:var(--color-blue);
            {% else %}background:color-mix(in srgb,var(--color-text-muted) 12%,transparent);color:var(--color-text-muted);
            {% endif %}">{{ ticket.priority.label() }}</span>
        </td>
        <td style="padding:11px 16px;text-align:center;font-size:.8rem;color:var(--color-text-muted);font-variant-numeric:tabular-nums;">{{ ticket.messages|length }}</td>
        <td style="padding:11px 16px;font-size:.8rem;color:var(--color-text-muted);white-space:nowrap;">
          {{ (ticket.updatedAt ?? ticket.createdAt)|date('d/m/y H:i') }}
        </td>
        <td style="padding:11px 16px;text-align:right;">
          <a href="{{ path('admin_support_show', {id: ticket.id}) }}" style="font-size:.8rem;font-weight:500;color:var(--color-primary);text-decoration:none;">Atender →</a>
        </td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
</div>
{% endif %}
{% endblock %}
