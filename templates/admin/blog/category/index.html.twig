{% extends 'admin/layout.html.twig' %}
{% block page_title %}Categorias do Blog{% endblock %}

{% block admin_content %}
<div style="padding:28px 32px;">
<div style="max-width:860px;">

  {# ── Cabeçalho ── #}
  <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:20px;">
    <h1 style="font-size:1rem;font-weight:700;color:#dde1f0;margin:0;">Categorias do Blog</h1>
    <a href="{{ path('admin_blog_category_new') }}"
       style="display:inline-flex;align-items:center;gap:6px;padding:7px 14px;background:#01696f;color:#fff;border-radius:7px;font-size:.8rem;font-weight:600;text-decoration:none;transition:background .15s;"
       onmouseover="this.style.background='#0c4e54'" onmouseout="this.style.background='#01696f'">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      Nova categoria
    </a>
  </div>

  {# ── Flash ── #}
  {% for label, messages in app.flashes %}
    {% for msg in messages %}
      <div style="margin-bottom:14px;padding:10px 14px;border-radius:8px;font-size:.85rem;font-weight:500;
        background:{% if label=='success' %}rgba(67,122,34,.15){% else %}rgba(161,44,123,.15){% endif %};
        color:{% if label=='success' %}#6daa45{% else %}#d163a7{% endif %};
        border:1px solid {% if label=='success' %}rgba(67,122,34,.25){% else %}rgba(161,44,123,.25){% endif %};">{{ msg }}</div>
    {% endfor %}
  {% endfor %}

  {# ── Tabela ── #}
  {% if categories|length == 0 %}
    <div style="text-align:center;padding:48px 0;color:#3e4259;font-size:.9rem;">
      Nenhuma categoria cadastrada ainda.
    </div>
  {% else %}
  <div style="border:1px solid rgba(255,255,255,.07);border-radius:10px;overflow:hidden;">
    <table style="width:100%;border-collapse:collapse;font-size:.85rem;">
      <thead>
        <tr style="background:#12151c;">
          <th style="padding:10px 16px;text-align:left;color:#6b708a;font-weight:600;font-size:.75rem;text-transform:uppercase;letter-spacing:.04em;">#</th>
          <th style="padding:10px 16px;text-align:left;color:#6b708a;font-weight:600;font-size:.75rem;text-transform:uppercase;letter-spacing:.04em;">Nome</th>
          <th style="padding:10px 16px;text-align:left;color:#6b708a;font-weight:600;font-size:.75rem;text-transform:uppercase;letter-spacing:.04em;">Slug</th>
          <th style="padding:10px 16px;text-align:right;color:#6b708a;font-weight:600;font-size:.75rem;text-transform:uppercase;letter-spacing:.04em;">Ações</th>
        </tr>
      </thead>
      <tbody>
        {% for cat in categories %}
        <tr style="border-top:1px solid rgba(255,255,255,.05);transition:background .12s;" onmouseover="this.style.background='rgba(255,255,255,.02)'" onmouseout="this.style.background='transparent'">
          <td style="padding:11px 16px;color:#3e4259;">{{ cat.id }}</td>
          <td style="padding:11px 16px;color:#dde1f0;font-weight:500;">{{ cat.name }}</td>
          <td style="padding:11px 16px;color:#6b708a;font-family:monospace;font-size:.8rem;">{{ cat.slug }}</td>
          <td style="padding:11px 16px;text-align:right;">
            <div style="display:inline-flex;align-items:center;gap:8px;">
              <a href="{{ path('admin_blog_category_edit', {id: cat.id}) }}"
                 title="Editar"
                 style="display:inline-flex;align-items:center;justify-content:center;width:30px;height:30px;border-radius:6px;background:rgba(78,204,211,.08);color:#4eccd3;border:1px solid rgba(78,204,211,.15);text-decoration:none;transition:all .15s;"
                 onmouseover="this.style.background='rgba(78,204,211,.16)'" onmouseout="this.style.background='rgba(78,204,211,.08)'">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
              </a>
              <form method="POST" action="{{ path('admin_blog_category_delete', {id: cat.id}) }}" onsubmit="return confirm('Remover categoria {{ cat.name|e('js') }}?')" style="display:inline;">
                <input type="hidden" name="_token" value="{{ csrf_token('delete_blog_cat_' ~ cat.id) }}">
                <button type="submit" title="Remover"
                        style="display:inline-flex;align-items:center;justify-content:center;width:30px;height:30px;border-radius:6px;background:rgba(161,44,123,.08);color:#d163a7;border:1px solid rgba(161,44,123,.15);cursor:pointer;transition:all .15s;"
                        onmouseover="this.style.background='rgba(161,44,123,.18)'" onmouseout="this.style.background='rgba(161,44,123,.08)'">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6M14 11v6"/><path d="M9 6V4h6v2"/></svg>
                </button>
              </form>
            </div>
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% endif %}

</div>
</div>
{% endblock %}
