{% extends 'admin/layout.html.twig' %}
{% block page_title %}Posts{% endblock %}

{% block admin_content %}
<div style="padding:28px 32px;">

  <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;margin-bottom:20px;">
    <div>
      <h1 style="font-size:1.25rem;font-weight:700;margin:0 0 2px;">Posts</h1>
      <p style="font-size:.85rem;color:#6b708a;margin:0;">Gerencie os artigos do blog</p>
    </div>
    <a href="{{ path('admin_blog_post_new') }}" style="display:inline-flex;align-items:center;gap:6px;padding:8px 16px;background:#01696f;color:#fff;border-radius:7px;font-size:.8rem;font-weight:600;text-decoration:none;transition:background .15s;" onmouseover="this.style.background='#0c4e54'" onmouseout="this.style.background='#01696f'">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      Novo post
    </a>
  </div>

  {% for label, messages in app.flashes %}
    {% for msg in messages %}
      <div style="margin-bottom:14px;padding:10px 14px;border-radius:8px;font-size:.85rem;font-weight:500;
        background:{% if label=='success' %}rgba(67,122,34,.15){% else %}rgba(161,44,123,.15){% endif %};
        color:{% if label=='success' %}#6daa45{% else %}#d163a7{% endif %};border:1px solid {% if label=='success' %}rgba(67,122,34,.25){% else %}rgba(161,44,123,.25){% endif %};">{{ msg }}</div>
    {% endfor %}
  {% endfor %}

  {% if pagination.items|length == 0 %}
  <div style="display:flex;flex-direction:column;align-items:center;text-align:center;padding:64px 16px;color:#6b708a;">
    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#4eccd3" stroke-width="1.5" style="margin-bottom:14px;"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
    <h3 style="font-size:1rem;font-weight:600;color:#dde1f0;margin:0 0 6px;">Nenhum post ainda</h3>
    <a href="{{ path('admin_blog_post_new') }}" style="font-size:.875rem;color:#4eccd3;text-decoration:none;">Criar o primeiro post &rarr;</a>
  </div>
  {% else %}
  <div style="background:#0b0e14;border:1px solid rgba(255,255,255,.06);border-radius:10px;overflow:hidden;">
    <table style="width:100%;border-collapse:collapse;">
      <thead>
        <tr style="border-bottom:1px solid rgba(255,255,255,.06);background:rgba(255,255,255,.02);">
          <th style="padding:10px 16px;text-align:left;font-size:.7rem;font-weight:600;letter-spacing:.05em;text-transform:uppercase;color:#3e4259;">#</th>
          <th style="padding:10px 16px;text-align:left;font-size:.7rem;font-weight:600;letter-spacing:.05em;text-transform:uppercase;color:#3e4259;">T&iacute;tulo</th>
          <th style="padding:10px 16px;text-align:left;font-size:.7rem;font-weight:600;letter-spacing:.05em;text-transform:uppercase;color:#3e4259;">Categoria</th>
          <th style="padding:10px 16px;text-align:center;font-size:.7rem;font-weight:600;letter-spacing:.05em;text-transform:uppercase;color:#3e4259;">Status</th>
          <th style="padding:10px 16px;text-align:center;font-size:.7rem;font-weight:600;letter-spacing:.05em;text-transform:uppercase;color:#3e4259;">Views</th>
          <th style="padding:10px 16px;text-align:left;font-size:.7rem;font-weight:600;letter-spacing:.05em;text-transform:uppercase;color:#3e4259;">Criado</th>
          <th style="padding:10px 16px;"></th>
        </tr>
      </thead>
      <tbody>
      {% for post in pagination %}
        <tr style="border-bottom:1px solid rgba(255,255,255,.04);transition:background .15s;" onmouseover="this.style.background='rgba(255,255,255,.03)'" onmouseout="this.style.background=''">
          <td style="padding:11px 16px;font-size:.8rem;color:#6b708a;font-variant-numeric:tabular-nums;">#{{ post.id }}</td>
          <td style="padding:11px 16px;max-width:280px;">
            <div style="font-size:.875rem;font-weight:600;color:#dde1f0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">{{ post.title }}</div>
            <div style="font-size:.7rem;color:#6b708a;font-family:monospace;">/{{ post.slug }}</div>
          </td>
          <td style="padding:11px 16px;font-size:.8rem;color:#6b708a;">{{ post.category ? post.category.name : '—' }}</td>
          <td style="padding:11px 16px;text-align:center;">
            {% if post.status.value == 'published' %}
              <span style="padding:2px 9px;font-size:.68rem;font-weight:600;border-radius:9999px;background:rgba(67,122,34,.18);color:#6daa45;">Publicado</span>
            {% else %}
              <span style="padding:2px 9px;font-size:.68rem;font-weight:600;border-radius:9999px;background:rgba(107,112,138,.15);color:#6b708a;">Rascunho</span>
            {% endif %}
          </td>
          <td style="padding:11px 16px;text-align:center;font-size:.8rem;color:#6b708a;font-variant-numeric:tabular-nums;">{{ post.views }}</td>
          <td style="padding:11px 16px;font-size:.8rem;color:#6b708a;white-space:nowrap;">{{ post.createdAt|date('d/m/y') }}</td>
          <td style="padding:11px 16px;text-align:right;display:flex;gap:10px;justify-content:flex-end;align-items:center;">
            <a href="{{ path('admin_blog_post_edit', {id: post.id}) }}" style="font-size:.8rem;font-weight:500;color:#4eccd3;text-decoration:none;">Editar</a>
            <form method="POST" action="{{ path('admin_blog_post_delete', {id: post.id}) }}" onsubmit="return confirm('Remover este post?')" style="margin:0;">
              <input type="hidden" name="_token" value="{{ csrf_token('delete_blog_post_' ~ post.id) }}">
              <button type="submit" style="font-size:.8rem;font-weight:500;color:#6b708a;background:none;border:none;cursor:pointer;padding:0;transition:color .15s;" onmouseover="this.style.color='#d163a7'" onmouseout="this.style.color='#6b708a'">Remover</button>
            </form>
          </td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>

  {% if pagination.pageCount > 1 %}
  <div style="display:flex;justify-content:center;gap:6px;margin-top:16px;">
    {% if pagination.currentPageNumber > 1 %}
      <a href="?page={{ pagination.currentPageNumber - 1 }}" style="padding:5px 12px;font-size:.8rem;border:1px solid rgba(255,255,255,.08);border-radius:6px;color:#6b708a;text-decoration:none;">&lsaquo; Anterior</a>
    {% endif %}
    <span style="padding:5px 12px;font-size:.8rem;border:1px solid rgba(1,134,141,.35);border-radius:6px;color:#4eccd3;">{{ pagination.currentPageNumber }}</span>
    {% if pagination.currentPageNumber < pagination.pageCount %}
      <a href="?page={{ pagination.currentPageNumber + 1 }}" style="padding:5px 12px;font-size:.8rem;border:1px solid rgba(255,255,255,.08);border-radius:6px;color:#6b708a;text-decoration:none;">Pr&oacute;xima &rsaquo;</a>
    {% endif %}
  </div>
  {% endif %}
  {% endif %}

</div>
{% endblock %}
