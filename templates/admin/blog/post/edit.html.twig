{% extends 'admin/layout.html.twig' %}
{% block page_title %}{{ post ? 'Editar Post' : 'Novo Post' }}{% endblock %}

{% block admin_content %}
{# ─── Quill CSS ─── #}
<link href="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.snow.css" rel="stylesheet">
<style>
  /* ── Quill dark theme ── */
  .ql-toolbar.ql-snow{
    background:#12151c;border:1px solid rgba(255,255,255,.08)!important;
    border-bottom:1px solid rgba(255,255,255,.05)!important;
    border-radius:8px 8px 0 0;padding:6px 10px;flex-wrap:wrap;
  }
  .ql-container.ql-snow{
    background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.08)!important;
    border-top:none!important;border-radius:0 0 8px 8px;
    font-size:.9rem;color:#dde1f0;min-height:320px;
  }
  .ql-editor{min-height:320px;color:#dde1f0;line-height:1.75;padding:14px 16px;}
  .ql-editor.ql-blank::before{color:#3e4259;font-style:normal;}
  .ql-snow .ql-stroke{stroke:#6b708a!important;}
  .ql-snow .ql-fill{fill:#6b708a!important;}
  .ql-snow .ql-picker-label{color:#6b708a!important;}
  .ql-snow.ql-toolbar button:hover .ql-stroke,
  .ql-snow .ql-toolbar button:hover .ql-stroke,
  .ql-snow.ql-toolbar button.ql-active .ql-stroke{stroke:#4eccd3!important;}
  .ql-snow.ql-toolbar button:hover .ql-fill,
  .ql-snow .ql-toolbar button:hover .ql-fill,
  .ql-snow.ql-toolbar button.ql-active .ql-fill{fill:#4eccd3!important;}
  .ql-snow.ql-toolbar button:hover,
  .ql-snow .ql-toolbar button:hover,
  .ql-snow.ql-toolbar button.ql-active{background:rgba(78,204,211,.08)!important;border-radius:4px;}
  .ql-snow .ql-picker-options{background:#12151c;border:1px solid rgba(255,255,255,.08)!important;}
  .ql-snow .ql-picker-item{color:#dde1f0!important;}
  .ql-snow .ql-tooltip{
    background:#0b0e14!important;border:1px solid rgba(255,255,255,.08)!important;
    color:#dde1f0!important;border-radius:6px;
  }
  .ql-snow .ql-tooltip input[type=text]{
    background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.12);
    color:#dde1f0;border-radius:5px;
  }
  .ql-snow .ql-tooltip a.ql-action::after{color:#4eccd3!important;}
  .ql-snow .ql-tooltip a.ql-remove::before{color:#d163a7!important;}

  /* ── Tooltip CSS ── */
  [data-ql-tip]{position:relative;}
  [data-ql-tip]::after{
    content: attr(data-ql-tip);
    position:absolute;bottom:calc(100% + 6px);left:50%;transform:translateX(-50%);
    white-space:nowrap;pointer-events:none;
    background:#0b0e14;border:1px solid rgba(255,255,255,.1);
    color:#dde1f0;font-size:.7rem;font-weight:500;font-family:inherit;
    padding:3px 8px;border-radius:5px;
    opacity:0;transition:opacity .15s;
    z-index:9999;
  }
  [data-ql-tip]:hover::after{opacity:1;}
  /* picker tooltips ficam na toolbar */
  .ql-toolbar .ql-picker[data-ql-tip]{position:relative;}

  /* HTML source mode */
  #content-html-source{
    display:none;width:100%;min-height:320px;padding:14px 16px;
    border:1px solid rgba(255,255,255,.08);border-radius:0 0 8px 8px;
    background:rgba(255,255,255,.03);color:#4eccd3;font-family:'Courier New',monospace;
    font-size:.82rem;line-height:1.6;resize:vertical;outline:none;
  }
  #btn-html-toggle{
    display:inline-flex;align-items:center;gap:5px;
    padding:3px 10px;font-size:.72rem;font-weight:600;
    border:1px solid rgba(255,255,255,.1);border-radius:6px;
    background:transparent;color:#6b708a;cursor:pointer;transition:all .15s;
  }
  #btn-html-toggle:hover,#btn-html-toggle.active{
    border-color:rgba(78,204,211,.4);color:#4eccd3;background:rgba(78,204,211,.06);
  }
</style>

<div style="padding:28px 32px;">
<div style="max-width:900px;">

  <div style="margin-bottom:16px;display:flex;align-items:center;justify-content:space-between;">
    <a href="{{ path('admin_blog_post_index') }}" style="font-size:.85rem;color:#6b708a;text-decoration:none;display:inline-flex;align-items:center;gap:4px;">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg> Posts
    </a>
    <h1 style="font-size:1rem;font-weight:700;color:#dde1f0;margin:0;">{{ post ? 'Editar: ' ~ post.title|slice(0,40) : 'Novo post' }}</h1>
  </div>

  {% for label, messages in app.flashes %}
    {% for msg in messages %}
      <div style="margin-bottom:14px;padding:10px 14px;border-radius:8px;font-size:.85rem;font-weight:500;
        background:{% if label=='success' %}rgba(67,122,34,.15){% else %}rgba(161,44,123,.15){% endif %};
        color:{% if label=='success' %}#6daa45{% else %}#d163a7{% endif %};border:1px solid {% if label=='success' %}rgba(67,122,34,.25){% else %}rgba(161,44,123,.25){% endif %};">{{ msg }}</div>
    {% endfor %}
  {% endfor %}

  <form method="POST" id="post-form" style="display:flex;flex-direction:column;gap:16px;">

    {# Título #}
    <div>
      <label style="display:block;font-size:.8rem;font-weight:600;margin-bottom:6px;color:#dde1f0;">Título <span style="color:#d163a7;">*</span></label>
      <input type="text" name="title" value="{{ post ? post.title : '' }}" required maxlength="200"
             style="width:100%;padding:9px 12px;border:1px solid rgba(255,255,255,.08);border-radius:8px;background:rgba(255,255,255,.03);color:#dde1f0;font-size:.9rem;outline:none;transition:border .15s;"
             onfocus="this.style.borderColor='#4eccd3'" onblur="this.style.borderColor='rgba(255,255,255,.08)'">
    </div>

    {# Resumo #}
    <div>
      <label style="display:block;font-size:.8rem;font-weight:600;margin-bottom:6px;color:#dde1f0;">Resumo (excerpt)</label>
      <textarea name="summary" rows="2" maxlength="500"
                style="width:100%;padding:9px 12px;border:1px solid rgba(255,255,255,.08);border-radius:8px;background:rgba(255,255,255,.03);color:#dde1f0;font-size:.875rem;resize:vertical;outline:none;font-family:inherit;transition:border .15s;"
                onfocus="this.style.borderColor='#4eccd3'" onblur="this.style.borderColor='rgba(255,255,255,.08)'">{{ post ? post.excerpt : '' }}</textarea>
    </div>

    {# ─── Editor de Conteúdo ─── #}
    <div>
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:6px;">
        <label style="font-size:.8rem;font-weight:600;color:#dde1f0;">Conteúdo <span style="color:#d163a7;">*</span></label>
        <button type="button" id="btn-html-toggle" title="Alternar entre editor visual e código HTML">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
          HTML
        </button>
      </div>
      <div id="quill-editor"></div>
      <textarea id="content-html-source" spellcheck="false" placeholder="Cole ou edite HTML diretamente aqui..."></textarea>
      <input type="hidden" name="content" id="content-hidden">
    </div>

    {# Categoria + Status #}
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
      <div>
        <label style="display:block;font-size:.8rem;font-weight:600;margin-bottom:6px;color:#dde1f0;">Categoria</label>
        <select name="category" style="width:100%;padding:9px 12px;border:1px solid rgba(255,255,255,.08);border-radius:8px;background:#0b0e14;color:#dde1f0;font-size:.875rem;outline:none;">
          <option value="">— Sem categoria —</option>
          {% for cat in categories %}
            <option value="{{ cat.id }}" {{ post and post.category and post.category.id == cat.id ? 'selected' }}>{{ cat.name }}</option>
          {% endfor %}
        </select>
      </div>
      <div>
        <label style="display:block;font-size:.8rem;font-weight:600;margin-bottom:6px;color:#dde1f0;">Status</label>
        <select name="isPublished" style="width:100%;padding:9px 12px;border:1px solid rgba(255,255,255,.08);border-radius:8px;background:#0b0e14;color:#dde1f0;font-size:.875rem;outline:none;">
          <option value="0" {{ post and not post.isPublished() ? 'selected' }}>Rascunho</option>
          <option value="1" {{ post and post.isPublished() ? 'selected' }}>Publicado</option>
        </select>
      </div>
    </div>

    {# Tags #}
    {% if tags|length > 0 %}
    <div>
      <label style="display:block;font-size:.8rem;font-weight:600;margin-bottom:8px;color:#dde1f0;">Tags</label>
      <div style="display:flex;flex-wrap:wrap;gap:8px;">
        {% for tag in tags %}
          {% set checked = post and post.tags.contains(tag) %}
          <label style="display:inline-flex;align-items:center;gap:5px;padding:4px 10px;border:1px solid rgba(255,255,255,.08);border-radius:9999px;cursor:pointer;font-size:.78rem;color:#6b708a;transition:all .15s;" onmouseover="this.style.borderColor='#4eccd3';this.style.color='#4eccd3'" onmouseout="this.style.borderColor='rgba(255,255,255,.08)';this.style.color='#6b708a'">
            <input type="checkbox" name="tags[]" value="{{ tag.id }}" {% if checked %}checked{% endif %} style="accent-color:#01696f;">
            {{ tag.name }}
          </label>
        {% endfor %}
      </div>
    </div>
    {% endif %}

    {# Thumbnail URL #}
    <div>
      <label style="display:block;font-size:.8rem;font-weight:600;margin-bottom:6px;color:#dde1f0;">Thumbnail (URL)</label>
      <input type="text" name="thumbnail" value="{{ post ? post.thumbnail : '' }}" placeholder="https://..."
             style="width:100%;padding:9px 12px;border:1px solid rgba(255,255,255,.08);border-radius:8px;background:rgba(255,255,255,.03);color:#dde1f0;font-size:.875rem;outline:none;transition:border .15s;"
             onfocus="this.style.borderColor='#4eccd3'" onblur="this.style.borderColor='rgba(255,255,255,.08)'">
    </div>

    {# SEO #}
    <details style="border:1px solid rgba(255,255,255,.06);border-radius:8px;padding:12px 16px;">
      <summary style="font-size:.8rem;font-weight:600;color:#6b708a;cursor:pointer;list-style:none;">SEO (opcional)</summary>
      <div style="display:flex;flex-direction:column;gap:12px;margin-top:12px;">
        <div>
          <label style="display:block;font-size:.78rem;font-weight:600;margin-bottom:5px;color:#dde1f0;">Meta Title</label>
          <input type="text" name="metaTitle" value="{{ post ? post.metaTitle : '' }}" maxlength="200"
                 style="width:100%;padding:8px 12px;border:1px solid rgba(255,255,255,.08);border-radius:8px;background:rgba(255,255,255,.03);color:#dde1f0;font-size:.875rem;outline:none;">
        </div>
        <div>
          <label style="display:block;font-size:.78rem;font-weight:600;margin-bottom:5px;color:#dde1f0;">Meta Description</label>
          <textarea name="metaDescription" rows="2" maxlength="300"
                    style="width:100%;padding:8px 12px;border:1px solid rgba(255,255,255,.08);border-radius:8px;background:rgba(255,255,255,.03);color:#dde1f0;font-size:.875rem;resize:vertical;outline:none;font-family:inherit;">{{ post ? post.metaDescription : '' }}</textarea>
        </div>
      </div>
    </details>

    {# Botões #}
    <div style="display:flex;justify-content:flex-end;gap:10px;padding-top:4px;">
      <a href="{{ path('admin_blog_post_index') }}" style="padding:8px 16px;background:rgba(255,255,255,.05);color:#dde1f0;border:1px solid rgba(255,255,255,.08);border-radius:7px;font-size:.8rem;font-weight:500;text-decoration:none;">Cancelar</a>
      <button type="submit" style="padding:8px 20px;background:#01696f;color:#fff;border:none;border-radius:7px;font-size:.8rem;font-weight:600;cursor:pointer;transition:background .15s;" onmouseover="this.style.background='#0c4e54'" onmouseout="this.style.background='#01696f'">
        {{ post ? 'Salvar alterações' : 'Criar post' }}
      </button>
    </div>

  </form>
</div>
</div>

{# ─── Quill JS ─── #}
<script src="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.js"></script>
<script>
(function () {
  const initialContent = {{ post ? post.content|json_encode|raw : '""' }};

  const quill = new Quill('#quill-editor', {
    theme: 'snow',
    placeholder: 'Escreva o conteúdo do post aqui...',
    modules: {
      toolbar: [
        [{ header: [1, 2, 3, 4, false] }],
        ['bold', 'italic', 'underline', 'strike'],
        [{ color: [] }, { background: [] }],
        [{ list: 'ordered' }, { list: 'bullet' }, { list: 'check' }],
        [{ indent: '-1' }, { indent: '+1' }],
        [{ align: [] }],
        ['blockquote', 'code-block'],
        ['link', 'image', 'video'],
        ['clean']
      ]
    }
  });

  if (initialContent) {
    quill.clipboard.dangerouslyPasteHTML(initialContent);
  }

  // ── Tooltips em português para cada botão da toolbar ──
  const TIPS = {
    'ql-bold':        'Negrito (Ctrl+B)',
    'ql-italic':      'Itálico (Ctrl+I)',
    'ql-underline':   'Sublinhado (Ctrl+U)',
    'ql-strike':      'Tachado',
    'ql-blockquote':  'Citação',
    'ql-code-block':  'Bloco de código',
    'ql-link':        'Inserir link',
    'ql-image':       'Inserir imagem',
    'ql-video':       'Inserir vídeo',
    'ql-clean':       'Remover formatação',
    'ql-color':       'Cor do texto',
    'ql-background':  'Cor de fundo',
    'ql-header':      'Estilo de título',
    'ql-list-ordered':'Lista numerada',
    'ql-list-bullet': 'Lista com marcadores',
    'ql-list-check':  'Lista de tarefas',
    'ql-indent--1':   'Diminuir recuo',
    'ql-indent-+1':   'Aumentar recuo',
    'ql-align':       'Alinhamento',
  };

  // Aguarda o DOM do Quill ser renderizado
  requestAnimationFrame(function applyTips() {
    const toolbar = document.querySelector('.ql-toolbar');
    if (!toolbar) { requestAnimationFrame(applyTips); return; }

    // Botões simples
    toolbar.querySelectorAll('button').forEach(function(btn) {
      // Detecta classe tipo ql-bold, ql-list etc.
      const cls = Array.from(btn.classList).find(c => c.startsWith('ql-'));
      if (!cls) return;
      const val = btn.getAttribute('value'); // ex: 'ordered', 'bullet', '+1'
      const key = val ? cls + '-' + val : cls;
      const tip = TIPS[key] || TIPS[cls];
      if (tip) {
        btn.setAttribute('data-ql-tip', tip);
        btn.setAttribute('aria-label', tip);
      }
    });

    // Pickers (header, color, align, background)
    toolbar.querySelectorAll('.ql-picker').forEach(function(picker) {
      const cls = Array.from(picker.classList).find(c => c.startsWith('ql-') && c !== 'ql-picker' && c !== 'ql-color-picker' && c !== 'ql-icon-picker');
      if (!cls) return;
      const tip = TIPS[cls];
      if (tip) picker.setAttribute('data-ql-tip', tip);
    });
  });

  // ── Toggle HTML / Visual ──
  const btn      = document.getElementById('btn-html-toggle');
  const source   = document.getElementById('content-html-source');
  const editorEl = document.getElementById('quill-editor');
  let htmlMode   = false;

  btn.addEventListener('click', function () {
    htmlMode = !htmlMode;
    if (htmlMode) {
      source.value = quill.getSemanticHTML();
      editorEl.style.display = 'none';
      source.style.display   = 'block';
      btn.classList.add('active');
    } else {
      quill.clipboard.dangerouslyPasteHTML(source.value);
      source.style.display   = 'none';
      editorEl.style.display = 'block';
      btn.classList.remove('active');
    }
  });

  // ── Sincroniza hidden input no submit ──
  document.getElementById('post-form').addEventListener('submit', function () {
    document.getElementById('content-hidden').value = htmlMode
      ? source.value
      : quill.getSemanticHTML();
  });
})();
</script>
{% endblock %}
