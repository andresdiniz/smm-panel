{% extends 'admin/layout.html.twig' %}

{% block page_title %}CRM Dashboard{% endblock %}

{% block admin_content %}
<div style="padding:24px;display:flex;flex-direction:column;gap:24px">

  <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px">
    <h1 style="font-size:1.1rem;font-weight:800;color:#f0f3ff">CRM Dashboard</h1>
  </div>

  {% for type, messages in app.flashes %}
    {% if type == 'crm_campaign' %}
      {% for message in messages %}
        <section style="padding:14px;background:#0b0e14;border:1px solid rgba(255,255,255,.08);border-radius:10px;color:#dde1f0">
          {% if message.preview %}
            <strong>Prévia — {{ message.recipientCount }} destinatário(s) com consentimento explícito</strong>
          {% else %}
            <strong>Campanha: {{ message.sent }} e-mail(s) enviado(s)</strong>
            {% if message.campaignId is defined and message.sent > 0 %}
              <a href="{{ path('app_admin_crm_campaign_show', {campaignId: message.campaignId}) }}" style="margin-left:10px;color:#4eccd3">Ver rastreamento</a>
            {% endif %}
          {% endif %}
          {% if message.errorCount > 0 %}<p>{{ message.errorCount }} envio(s) falharam.</p>{% endif %}
          {% if message.preview %}
            <p>Assunto: {{ message.subject }}</p>
            <p>Destinatários limitados aos 500 usuários selecionados pelo CRM.</p>
          {% endif %}
        </section>
      {% endfor %}
    {% else %}
      {% for message in messages %}
        <div role="status" style="padding:10px 14px;border:1px solid rgba(255,255,255,.1);border-radius:8px;color:#dde1f0">{{ message }}</div>
      {% endfor %}
    {% endif %}
  {% endfor %}

  {% if profileUser is not null %}
  {% set contactUser = profileUser.user %}
  <section style="background:#0b0e14;border:1px solid rgba(255,255,255,.06);border-radius:10px;padding:18px">
    <h2 style="margin:0 0 8px;color:#dde1f0;font-size:1rem">Contato individual</h2>
    <p style="color:#9196b0;font-size:.82rem;margin:0 0 14px">
      {{ contactUser.name }} · {{ contactUser.email }} ·
      {% if contactUser.marketingConsent %}autorizou marketing{% else %}não autorizou marketing{% endif %}
    </p>
    {% if contactUser.marketingConsent and contactUser.active %}
    <form method="post" action="{{ path('app_admin_crm_send_user_email', {id: contactUser.id}) }}" style="display:grid;gap:10px">
      <input type="hidden" name="_token" value="{{ csrf_token('crm_user_email_' ~ contactUser.id) }}">
      <label style="display:grid;gap:5px;color:#9196b0;font-size:.78rem">
        Assunto
        <input name="subject" maxlength="180" required style="padding:10px;background:#161a24;border:1px solid rgba(255,255,255,.1);border-radius:7px;color:#dde1f0">
      </label>
      <label style="display:grid;gap:5px;color:#9196b0;font-size:.78rem">
        Mensagem HTML
        <textarea name="body" maxlength="10000" rows="10" required placeholder="<h2 style=&quot;color:#01696f&quot;>Novidades PulseSMM</h2>&#10;<p style=&quot;font-size:16px&quot;>Escreva sua mensagem aqui.</p>&#10;<p><a href=&quot;https://acheireviews.com.br&quot; style=&quot;color:#01696f&quot;>Acessar a plataforma</a></p>" style="padding:10px;background:#161a24;border:1px solid rgba(255,255,255,.1);border-radius:7px;color:#dde1f0;font-family:monospace"></textarea>
      </label>
      <p style="margin:0;color:#9196b0;font-size:.76rem">Aceita HTML para e-mail. Scripts, formulários e estilos inseguros são removidos; links HTTP/HTTPS são rastreados.</p>
      <button type="submit" style="justify-self:start;padding:9px 14px;border:0;border-radius:7px;background:#01868d;color:#fff;font-weight:700">Enviar e-mail</button>
    </form>
    {% else %}
      <p style="margin:0;color:#f59e0b;font-size:.82rem">O envio de marketing está indisponível sem consentimento explícito.</p>
    {% endif %}
  </section>
  {% endif %}

  {% if profileUser is null %}
  <section style="background:#0b0e14;border:1px solid rgba(255,255,255,.06);border-radius:10px;padding:18px">
    <h2 style="margin:0 0 12px;color:#dde1f0;font-size:1rem">Campanha por e-mail</h2>
    <p style="margin:0 0 14px;color:#9196b0;font-size:.8rem">Somente usuários ativos que autorizaram marketing recebem estas mensagens. Faça uma prévia antes de enviar.</p>
    <form method="post" action="{{ path('app_admin_crm_send_marketing') }}" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:10px">
      <input type="hidden" name="_token" value="{{ csrf_token('crm_send_marketing') }}">
      <label style="display:grid;gap:5px;color:#9196b0;font-size:.78rem">Assunto<input name="subject" maxlength="180" required style="padding:10px;background:#161a24;border:1px solid rgba(255,255,255,.1);border-radius:7px;color:#dde1f0"></label>
      <label style="display:grid;gap:5px;color:#9196b0;font-size:.78rem">Segmento
        <select name="segment" style="padding:10px;background:#161a24;border:1px solid rgba(255,255,255,.1);border-radius:7px;color:#dde1f0">
          <option value="">Todos os segmentos autorizados</option><option value="new">Novos</option><option value="active">Ativos</option><option value="whale">Maior gasto</option>
        </select>
      </label>
      <label style="grid-column:1/-1;display:grid;gap:5px;color:#9196b0;font-size:.78rem">Mensagem HTML<textarea name="body" maxlength="10000" rows="10" required placeholder="<h2 style=&quot;color:#01696f&quot;>Novidades PulseSMM</h2>&#10;<p style=&quot;font-size:16px&quot;>Escreva sua mensagem aqui.</p>&#10;<p><a href=&quot;https://acheireviews.com.br&quot; style=&quot;color:#01696f&quot;>Acessar a plataforma</a></p>" style="padding:10px;background:#161a24;border:1px solid rgba(255,255,255,.1);border-radius:7px;color:#dde1f0;font-family:monospace"></textarea></label>
      <p style="grid-column:1/-1;margin:0;color:#9196b0;font-size:.76rem">Aceita HTML para e-mail. Scripts, formulários e estilos inseguros são removidos; links HTTP/HTTPS são rastreados. Aberturas são estimativas e podem variar conforme o aplicativo de e-mail.</p>
      <label style="grid-column:1/-1;color:#9196b0;font-size:.78rem"><input type="checkbox" name="preview_only" value="1" checked> Gerar prévia sem enviar</label>
      <button type="submit" style="justify-self:start;padding:9px 14px;border:0;border-radius:7px;background:#01868d;color:#fff;font-weight:700">Executar campanha</button>
    </form>
  </section>
  {% if marketingCampaigns is not empty %}
  <section style="background:#0b0e14;border:1px solid rgba(255,255,255,.06);border-radius:10px;padding:18px">
    <h2 style="margin:0 0 12px;color:#dde1f0;font-size:1rem">Campanhas e rastreamento</h2>
    <div style="overflow-x:auto">
      <table style="width:100%;border-collapse:collapse;font-size:.8rem;color:#dde1f0">
        <thead><tr style="color:#9196b0;text-align:left"><th style="padding:8px">Campanha</th><th>Enviados</th><th>Abertos</th><th>Clicaram</th><th>Cliques</th><th></th></tr></thead>
        <tbody>
        {% for campaign in marketingCampaigns %}
          <tr style="border-top:1px solid rgba(255,255,255,.06)">
            <td style="padding:8px">{{ campaign.subject }}<br><small style="color:#9196b0">{{ campaign.sentAt|date('d/m/Y H:i') }}</small></td>
            <td>{{ campaign.recipients }}</td>
            <td>{{ campaign.opened }}</td>
            <td>{{ campaign.clicked }}</td>
            <td>{{ campaign.clicks }}</td>
            <td><a href="{{ path('app_admin_crm_campaign_show', {campaignId: campaign.campaignId}) }}" style="color:#4eccd3">Detalhes</a></td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
    </div>
    <p style="margin:10px 0 0;color:#9196b0;font-size:.74rem">Aberturas são aproximadas: clientes de e-mail podem bloquear ou pré-carregar imagens.</p>
  </section>
  {% endif %}
  {% endif %}

  {% if campaignEmails is not null %}
  <section style="background:#0b0e14;border:1px solid rgba(255,255,255,.06);border-radius:10px;padding:18px">
    <h2 style="margin:0 0 12px;color:#dde1f0;font-size:1rem">Destinatários — rastreamento de campanha</h2>
    <p style="margin:0 0 12px;color:#9196b0;font-size:.8rem">{{ campaignEmails|length }} destinatário(s) · <a href="{{ path('app_admin_crm_dashboard') }}" style="color:#4eccd3">Voltar ao CRM</a></p>
    <div style="overflow-x:auto">
      <table style="width:100%;border-collapse:collapse;font-size:.8rem;color:#dde1f0">
        <thead><tr style="color:#9196b0;text-align:left"><th style="padding:8px">Destinatário</th><th>Envio</th><th>Aberturas</th><th>Cliques</th><th>Links clicados</th></tr></thead>
        <tbody>
        {% for emailLog in campaignEmails %}
          <tr style="border-top:1px solid rgba(255,255,255,.06);vertical-align:top">
            <td style="padding:8px">{{ emailLog.user.name }}<br><small style="color:#9196b0">{{ emailLog.user.email }}</small></td>
            <td>{{ emailLog.status == 'sent' ? 'Enviado' : (emailLog.status == 'failed' ? 'Falhou' : 'Pendente') }}</td>
            <td>{{ emailLog.openCount }}{% if emailLog.openedAt %}<br><small style="color:#9196b0">{{ emailLog.openedAt|date('d/m/Y H:i') }}</small>{% endif %}</td>
            <td>{{ emailLog.clickCount }}</td>
            <td>
              {% for linkId, clickedAt in emailLog.clickedLinks %}
                {% if emailLog.links[linkId] is defined %}
                  <a href="{{ emailLog.links[linkId] }}" target="_blank" rel="noopener noreferrer" style="display:block;max-width:320px;overflow-wrap:anywhere;color:#4eccd3">{{ emailLog.links[linkId] }}</a>
                  <small style="color:#9196b0">{{ clickedAt|date('d/m/Y H:i') }}</small>
                {% endif %}
              {% else %}
                <span style="color:#9196b0">—</span>
              {% endfor %}
            </td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
    </div>
    <p style="margin:10px 0 0;color:#9196b0;font-size:.74rem">As aberturas são estimativas; cliques nos links HTTP/HTTPS são registrados por destinatário.</p>
  </section>
  {% endif %}

  {# ── KPIs ── #}
  {% if stats is defined %}
  <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(170px,1fr));gap:12px">
    {% for label, value in stats %}
    <div style="background:#0b0e14;border:1px solid rgba(255,255,255,.06);border-radius:10px;padding:16px 18px">
      <p style="font-size:.65rem;font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:#3e4259;margin:0 0 6px">{{ label }}</p>
      <p style="font-size:1.4rem;font-weight:800;color:#dde1f0;margin:0;font-variant-numeric:tabular-nums">{{ value }}</p>
    </div>
    {% endfor %}
  </div>
  {% endif %}

  {# ── Receita Mensal ── #}
  {% if monthlyRevenue is defined and monthlyRevenue is not empty %}
  <div style="background:#0b0e14;border:1px solid rgba(255,255,255,.06);border-radius:10px;overflow:hidden">
    <div style="padding:12px 16px;border-bottom:1px solid rgba(255,255,255,.06)">
      <p style="font-size:.68rem;font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:#3e4259;margin:0">Receita Mensal</p>
    </div>
    <div style="overflow-x:auto">
      <table style="width:100%;border-collapse:collapse;font-size:.8rem">
        <thead>
          <tr>
            {% for col in ['Mês','Receita','Pedidos'] %}
            <th style="background:#0d1016;color:#3e4259;font-weight:700;font-size:.65rem;letter-spacing:.05em;text-transform:uppercase;padding:8px 13px;text-align:left;border-bottom:1px solid rgba(255,255,255,.06)">{{ col }}</th>
            {% endfor %}
          </tr>
        </thead>
        <tbody>
          {% for row in monthlyRevenue %}
          <tr style="border-bottom:1px solid rgba(255,255,255,.03)">
            <td style="padding:9px 13px;color:#9196b0">{{ row.month ?? row[0] ?? '-' }}</td>
            <td style="padding:9px 13px;color:#22c55e;font-variant-numeric:tabular-nums">R$ {{ (row.revenue ?? row[1] ?? 0)|number_format(2,',','.') }}</td>
            <td style="padding:9px 13px;color:#dde1f0">{{ row.orders ?? row[2] ?? '-' }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
  {% endif %}

  {# ── UTM Sources ── #}
  {% if utmSources is defined and utmSources is not empty %}
  <div style="background:#0b0e14;border:1px solid rgba(255,255,255,.06);border-radius:10px;overflow:hidden">
    <div style="padding:12px 16px;border-bottom:1px solid rgba(255,255,255,.06)">
      <p style="font-size:.68rem;font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:#3e4259;margin:0">UTM Sources</p>
    </div>
    <div style="overflow-x:auto">
      <table style="width:100%;border-collapse:collapse;font-size:.8rem">
        <thead>
          <tr>
            <th style="background:#0d1016;color:#3e4259;font-weight:700;font-size:.65rem;letter-spacing:.05em;text-transform:uppercase;padding:8px 13px;text-align:left;border-bottom:1px solid rgba(255,255,255,.06)">Source</th>
            {% for src in utmSources %}
            <th style="background:#0d1016;color:#3e4259;font-weight:700;font-size:.65rem;letter-spacing:.05em;text-transform:uppercase;padding:8px 13px;text-align:right;border-bottom:1px solid rgba(255,255,255,.06)">{{ src }}</th>
            {% endfor %}
          </tr>
        </thead>
        <tbody>
          {% if utmMap is defined %}
          {% for rowKey, rowData in utmMap %}
          <tr style="border-bottom:1px solid rgba(255,255,255,.03)">
            <td style="padding:9px 13px;color:#9196b0">{{ rowKey }}</td>
            {% for src in utmSources %}
            <td style="padding:9px 13px;color:#dde1f0;text-align:right;font-variant-numeric:tabular-nums">{{ rowData[src] ?? 0 }}</td>
            {% endfor %}
          </tr>
          {% endfor %}
          {% endif %}
        </tbody>
      </table>
    </div>
  </div>
  {% endif %}

  {# ── Afiliados ── #}
  {% if affiliateRows is defined and affiliateRows is not empty %}
  <div style="background:#0b0e14;border:1px solid rgba(255,255,255,.06);border-radius:10px;overflow:hidden">
    <div style="padding:12px 16px;border-bottom:1px solid rgba(255,255,255,.06)">
      <p style="font-size:.68rem;font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:#3e4259;margin:0">Afiliados</p>
    </div>
    <div style="overflow-x:auto">
      <table style="width:100%;border-collapse:collapse;font-size:.8rem">
        <thead>
          <tr>
            {% for col in ['Afiliado','Indicados','Comissão Total','Pendente'] %}
            <th style="background:#0d1016;color:#3e4259;font-weight:700;font-size:.65rem;letter-spacing:.05em;text-transform:uppercase;padding:8px 13px;text-align:left;border-bottom:1px solid rgba(255,255,255,.06)">{{ col }}</th>
            {% endfor %}
          </tr>
        </thead>
        <tbody>
          {% for row in affiliateRows %}
          <tr style="border-bottom:1px solid rgba(255,255,255,.03)">
            <td style="padding:9px 13px;color:#dde1f0">{{ row.name ?? row.email ?? '-' }}</td>
            <td style="padding:9px 13px;color:#9196b0">{{ row.referrals ?? 0 }}</td>
            <td style="padding:9px 13px;color:#22c55e;font-variant-numeric:tabular-nums">R$ {{ (row.totalCommission ?? 0)|number_format(2,',','.') }}</td>
            <td style="padding:9px 13px;color:#f59e0b;font-variant-numeric:tabular-nums">R$ {{ (row.pendingCommission ?? 0)|number_format(2,',','.') }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
  {% endif %}

  {# ── Usuários CRM ── #}
  {% if crmUsers is defined and crmUsers is not empty %}
  <div style="background:#0b0e14;border:1px solid rgba(255,255,255,.06);border-radius:10px;overflow:hidden">
    <div style="padding:12px 16px;border-bottom:1px solid rgba(255,255,255,.06)">
      <p style="font-size:.68rem;font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:#3e4259;margin:0">Usuários CRM</p>
    </div>
    <div style="overflow-x:auto">
      <table style="width:100%;border-collapse:collapse;font-size:.8rem">
        <thead>
          <tr>
            {% for col in ['#','E-mail','Saldo','Pedidos','Cadastro','Marketing','Contato'] %}
            <th style="background:#0d1016;color:#3e4259;font-weight:700;font-size:.65rem;letter-spacing:.05em;text-transform:uppercase;padding:8px 13px;text-align:left;border-bottom:1px solid rgba(255,255,255,.06)">{{ col }}</th>
            {% endfor %}
          </tr>
        </thead>
        <tbody>
          {% for row in crmUsers %}
          {% set user = row.user %}
          <tr style="border-bottom:1px solid rgba(255,255,255,.03)">
            <td style="padding:9px 13px;color:#3e4259">{{ user.id }}</td>
            <td style="padding:9px 13px;color:#dde1f0">{{ user.email }}</td>
            <td style="padding:9px 13px;color:#22c55e;font-variant-numeric:tabular-nums">R$ {{ ((user.wallet ? user.wallet.balanceCents : 0) / 100)|number_format(2,',','.') }}</td>
            <td style="padding:9px 13px;color:#9196b0">{{ row.orderCount }}</td>
            <td style="padding:9px 13px;color:#3e4259;font-size:.75rem">{{ user.createdAt|date('d/m/Y') }}</td>
            <td style="padding:9px 13px;color:{{ user.marketingConsent ? '#22c55e' : '#f59e0b' }};font-size:.75rem">{{ user.marketingConsent ? 'Autorizado' : 'Sem autorização' }}</td>
            <td style="padding:9px 13px"><a href="{{ path('app_admin_crm_user_profile', {id: user.id}) }}" style="color:#4eccd3;text-decoration:none">Abrir CRM</a></td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
  {% endif %}

</div>
{% endblock %}
