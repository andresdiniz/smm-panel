{% extends 'admin/layout.html.twig' %}

{% block page_title %}CRM Dashboard{% endblock %}

{% block admin_content %}
<div style="padding:24px;display:flex;flex-direction:column;gap:24px">

  <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px">
    <h1 style="font-size:1.1rem;font-weight:800;color:#f0f3ff">CRM Dashboard</h1>
  </div>

  {# ── KPIs ── #}
  {% if stats is defined %}
  <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(170px,1fr));gap:12px">
    {% for label, value in stats %}
    <div style="background:#0b0e14;border:1px solid rgba(255,255,255,.06);border-radius:10px;padding:16px 18px">
      <p style="font-size:.65rem;font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:#3e4259;margin:0 0 6px">{{ label }}</p>
      <p style="font-size:1.4rem;font-weight:800;color:#dde1f0;margin:0;font-variant-numeric:tabular-nums">{{ value }}</p>
    </div>
    {% endfor %}
  </div>
  {% endif %}

  {# ── Receita Mensal ── #}
  {% if monthlyRevenue is defined and monthlyRevenue is not empty %}
  <div style="background:#0b0e14;border:1px solid rgba(255,255,255,.06);border-radius:10px;overflow:hidden">
    <div style="padding:12px 16px;border-bottom:1px solid rgba(255,255,255,.06)">
      <p style="font-size:.68rem;font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:#3e4259;margin:0">Receita Mensal</p>
    </div>
    <div style="overflow-x:auto">
      <table style="width:100%;border-collapse:collapse;font-size:.8rem">
        <thead>
          <tr>
            {% for col in ['Mês','Receita','Pedidos'] %}
            <th style="background:#0d1016;color:#3e4259;font-weight:700;font-size:.65rem;letter-spacing:.05em;text-transform:uppercase;padding:8px 13px;text-align:left;border-bottom:1px solid rgba(255,255,255,.06)">{{ col }}</th>
            {% endfor %}
          </tr>
        </thead>
        <tbody>
          {% for row in monthlyRevenue %}
          <tr style="border-bottom:1px solid rgba(255,255,255,.03)">
            <td style="padding:9px 13px;color:#9196b0">{{ row.month ?? row[0] ?? '-' }}</td>
            <td style="padding:9px 13px;color:#22c55e;font-variant-numeric:tabular-nums">R$ {{ (row.revenue ?? row[1] ?? 0)|number_format(2,',','.') }}</td>
            <td style="padding:9px 13px;color:#dde1f0">{{ row.orders ?? row[2] ?? '-' }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
  {% endif %}

  {# ── UTM Sources ── #}
  {% if utmSources is defined and utmSources is not empty %}
  <div style="background:#0b0e14;border:1px solid rgba(255,255,255,.06);border-radius:10px;overflow:hidden">
    <div style="padding:12px 16px;border-bottom:1px solid rgba(255,255,255,.06)">
      <p style="font-size:.68rem;font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:#3e4259;margin:0">UTM Sources</p>
    </div>
    <div style="overflow-x:auto">
      <table style="width:100%;border-collapse:collapse;font-size:.8rem">
        <thead>
          <tr>
            <th style="background:#0d1016;color:#3e4259;font-weight:700;font-size:.65rem;letter-spacing:.05em;text-transform:uppercase;padding:8px 13px;text-align:left;border-bottom:1px solid rgba(255,255,255,.06)">Source</th>
            {% for src in utmSources %}
            <th style="background:#0d1016;color:#3e4259;font-weight:700;font-size:.65rem;letter-spacing:.05em;text-transform:uppercase;padding:8px 13px;text-align:right;border-bottom:1px solid rgba(255,255,255,.06)">{{ src }}</th>
            {% endfor %}
          </tr>
        </thead>
        <tbody>
          {% if utmMap is defined %}
          {% for rowKey, rowData in utmMap %}
          <tr style="border-bottom:1px solid rgba(255,255,255,.03)">
            <td style="padding:9px 13px;color:#9196b0">{{ rowKey }}</td>
            {% for src in utmSources %}
            <td style="padding:9px 13px;color:#dde1f0;text-align:right;font-variant-numeric:tabular-nums">{{ rowData[src] ?? 0 }}</td>
            {% endfor %}
          </tr>
          {% endfor %}
          {% endif %}
        </tbody>
      </table>
    </div>
  </div>
  {% endif %}

  {# ── Afiliados ── #}
  {% if affiliateRows is defined and affiliateRows is not empty %}
  <div style="background:#0b0e14;border:1px solid rgba(255,255,255,.06);border-radius:10px;overflow:hidden">
    <div style="padding:12px 16px;border-bottom:1px solid rgba(255,255,255,.06)">
      <p style="font-size:.68rem;font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:#3e4259;margin:0">Afiliados</p>
    </div>
    <div style="overflow-x:auto">
      <table style="width:100%;border-collapse:collapse;font-size:.8rem">
        <thead>
          <tr>
            {% for col in ['Afiliado','Indicados','Comissão Total','Pendente'] %}
            <th style="background:#0d1016;color:#3e4259;font-weight:700;font-size:.65rem;letter-spacing:.05em;text-transform:uppercase;padding:8px 13px;text-align:left;border-bottom:1px solid rgba(255,255,255,.06)">{{ col }}</th>
            {% endfor %}
          </tr>
        </thead>
        <tbody>
          {% for row in affiliateRows %}
          <tr style="border-bottom:1px solid rgba(255,255,255,.03)">
            <td style="padding:9px 13px;color:#dde1f0">{{ row.name ?? row.email ?? '-' }}</td>
            <td style="padding:9px 13px;color:#9196b0">{{ row.referrals ?? 0 }}</td>
            <td style="padding:9px 13px;color:#22c55e;font-variant-numeric:tabular-nums">R$ {{ (row.totalCommission ?? 0)|number_format(2,',','.') }}</td>
            <td style="padding:9px 13px;color:#f59e0b;font-variant-numeric:tabular-nums">R$ {{ (row.pendingCommission ?? 0)|number_format(2,',','.') }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
  {% endif %}

  {# ── Usuários CRM ── #}
  {% if crmUsers is defined and crmUsers is not empty %}
  <div style="background:#0b0e14;border:1px solid rgba(255,255,255,.06);border-radius:10px;overflow:hidden">
    <div style="padding:12px 16px;border-bottom:1px solid rgba(255,255,255,.06)">
      <p style="font-size:.68rem;font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:#3e4259;margin:0">Usuários CRM</p>
    </div>
    <div style="overflow-x:auto">
      <table style="width:100%;border-collapse:collapse;font-size:.8rem">
        <thead>
          <tr>
            {% for col in ['#','E-mail','Saldo','Pedidos','Cadastro'] %}
            <th style="background:#0d1016;color:#3e4259;font-weight:700;font-size:.65rem;letter-spacing:.05em;text-transform:uppercase;padding:8px 13px;text-align:left;border-bottom:1px solid rgba(255,255,255,.06)">{{ col }}</th>
            {% endfor %}
          </tr>
        </thead>
        <tbody>
          {% for user in crmUsers %}
          <tr style="border-bottom:1px solid rgba(255,255,255,.03)">
            <td style="padding:9px 13px;color:#3e4259">{{ user.id }}</td>
            <td style="padding:9px 13px;color:#dde1f0">{{ user.email }}</td>
            <td style="padding:9px 13px;color:#22c55e;font-variant-numeric:tabular-nums">R$ {{ (user.balance ?? 0)|number_format(2,',','.') }}</td>
            <td style="padding:9px 13px;color:#9196b0">{{ user.orderCount ?? 0 }}</td>
            <td style="padding:9px 13px;color:#3e4259;font-size:.75rem">{{ user.createdAt is defined ? user.createdAt|date('d/m/Y') : '-' }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
  {% endif %}

</div>
{% endblock %}
