{% extends 'admin/layout.html.twig' %}

{% block page_title %}Editar Serviço #{{ service.id }}{% endblock %}

{% block admin_content %}
<style>
  .svedit-wrap { padding: 24px; max-width: 760px; }
  .svedit-topbar { display: flex; align-items: center; gap: 12px; margin-bottom: 24px; }
  .svedit-back {
    display: inline-flex; align-items: center; justify-content: center;
    width: 28px; height: 28px; border-radius: 6px; text-decoration: none;
    background: rgba(255,255,255,.04); color: #6b708a;
    border: 1px solid rgba(255,255,255,.08);
  }
  .svedit-title { font-size: 1.05rem; font-weight: 900; color: #f0f3ff; margin: 0; }
  .svedit-badge {
    display: inline-flex; padding: 2px 8px; border-radius: 999px;
    font-size: 9px; font-weight: 700; text-transform: uppercase;
    background: rgba(78,204,211,.08); color: #4eccd3; margin-left: 8px;
  }
  .svedit-card { background: #0b0e14; border: 1px solid rgba(255,255,255,.06); border-radius: 8px; padding: 24px; }
  .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .form-group { display: flex; flex-direction: column; gap: 6px; }
  .form-group.full { grid-column: 1 / -1; }
  .form-label { font-size: .72rem; font-weight: 700; text-transform: uppercase; color: #3e4259; }
  .form-control {
    background: #0d1018; border: 1px solid rgba(255,255,255,.08);
    border-radius: 6px; color: #dde1f0; font-size: .82rem;
    padding: 8px 12px; width: 100%;
  }
  textarea.form-control { min-height: 80px; resize: vertical; }
  .form-hint { font-size: .7rem; color: #3e4259; }
  .toggle-row { display: flex; align-items: center; gap: 10px; padding: 10px 0; }
  .toggle-label { font-size: .82rem; color: #9196b0; }
  .toggle-switch { position: relative; width: 36px; height: 20px; display: inline-block; }
  .toggle-switch input { opacity: 0; width: 0; height: 0; }
  .toggle-slider { position: absolute; inset: 0; border-radius: 999px; background: rgba(255,255,255,.1); cursor: pointer; }
  .toggle-slider:before { content: ''; position: absolute; width: 14px; height: 14px; border-radius: 50%; background: #9196b0; left: 3px; top: 3px; transition: .2s; }
  .toggle-switch input:checked + .toggle-slider { background: rgba(90,170,42,.3); }
  .toggle-switch input:checked + .toggle-slider:before { transform: translateX(16px); background: #5aaa2a; }
  .divider { border: none; border-top: 1px solid rgba(255,255,255,.05); margin: 20px 0; }
  .meta-row { display: flex; flex-wrap: wrap; gap: 24px; background: rgba(255,255,255,.02); padding: 12px 14px; border-radius: 6px; }
  .meta-item { display: flex; flex-direction: column; gap: 3px; }
  .meta-key { font-size: .65rem; text-transform: uppercase; color: #3e4259; font-weight: 700; }
  .meta-val { font-size: .78rem; color: #9196b0; font-family: monospace; }
  .currency-box { background: rgba(78,204,211,.05); border: 1px solid rgba(78,204,211,.18); border-radius: 8px; padding: 16px; margin-top: 18px; }
  .currency-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 14px; margin-bottom: 14px; }
  .currency-actions { display: flex; gap: 10px; align-items: end; flex-wrap: wrap; }
  .btn-provider {
    padding: 8px 16px; border-radius: 6px; font-size: .78rem; font-weight: 700;
    background: rgba(90,170,42,.12); color: #7ed957;
    border: 1px solid rgba(90,170,42,.3); cursor: pointer;
  }
  .btn-provider:disabled { opacity: .5; cursor: not-allowed; }
  .provider-status { font-size: .75rem; color: #9196b0; margin-top: 8px; }
  .form-actions { display: flex; gap: 10px; justify-content: flex-end; margin-top: 24px; }
  .btn-save { padding: 8px 20px; border-radius: 6px; font-size: .82rem; font-weight: 700; background: rgba(78,204,211,.15); color: #4eccd3; border: 1px solid rgba(78,204,211,.3); cursor: pointer; }
  .btn-cancel { padding: 8px 16px; border-radius: 6px; font-size: .82rem; font-weight: 700; background: transparent; color: #6b708a; border: 1px solid rgba(255,255,255,.08); text-decoration: none; }
  @media(max-width:600px){ .form-grid { grid-template-columns: 1fr; } }
</style>

<div class="svedit-wrap">
  <div class="svedit-topbar">
    <a href="{{ path('admin_service_index') }}" class="svedit-back">←</a>
    <h1 class="svedit-title">Editar Serviço <span class="svedit-badge">#{{ service.id }}</span></h1>
  </div>

  <div class="svedit-card">
    <form method="post">
      <div class="form-grid">
        <div class="form-group full">
          <label class="form-label">Nome</label>
          <input class="form-control" name="name" value="{{ service.name }}" required>
        </div>

        <div class="form-group">
          <label class="form-label">Categoria</label>
          <input class="form-control" name="category" value="{{ service.category ?? '' }}">
        </div>

        <div class="form-group">
          <label class="form-label">Preço por 1.000 (centavos)</label>
          <input class="form-control" type="number" id="f-price" name="pricePerThousandCents" value="{{ service.pricePerThousandCents }}" min="0" required>
          <span class="form-hint">R$ {{ (service.pricePerThousandCents / 100)|number_format(2, ',', '.') }}</span>
        </div>

        <div class="form-group">
          <label class="form-label">Lucro individual (%)</label>
          <input class="form-control" type="number" step="0.001" id="f-profit" name="profitPercent" value="{{ service.profitPercent ?? providerConfig.default_profit_percent }}">
          <span class="form-hint">Usado para calcular o preço a partir do custo convertido.</span>
        </div>

        <div class="form-group">
          <label class="form-label">Qtd. mínima</label>
          <input class="form-control" type="number" name="minQty" value="{{ service.minQty }}" min="1" required>
        </div>

        <div class="form-group">
          <label class="form-label">Qtd. máxima</label>
          <input class="form-control" type="number" name="maxQty" value="{{ service.maxQty }}" min="1" required>
        </div>

        <div class="form-group full">
          <label class="form-label">Descrição</label>
          <textarea class="form-control" name="description">{{ service.description ?? '' }}</textarea>
        </div>

        <div class="form-group full">
          <div class="toggle-row">
            <label class="toggle-switch">
              <input type="checkbox" name="active" value="1" {{ service.active ? 'checked' }}>
              <span class="toggle-slider"></span>
            </label>
            <span class="toggle-label">Serviço ativo</span>
          </div>
        </div>
      </div>

      <hr class="divider">

      <p class="form-label">Dados do provedor</p>
      <div class="meta-row">
        <div class="meta-item"><span class="meta-key">Provider</span><span class="meta-val">{{ service.providerSlug ?? '—' }}</span></div>
        <div class="meta-item"><span class="meta-key">ID externo</span><span class="meta-val">{{ service.externalServiceId ?? '—' }}</span></div>
        <div class="meta-item"><span class="meta-key">Moeda</span><span class="meta-val">{{ providerConfig.currency }}</span></div>
        <div class="meta-item"><span class="meta-key">Cotação</span><span class="meta-val">{{ providerConfig.exchange_rate|number_format(6, ',', '.') }}</span></div>
      </div>

      {% if service.providerSlug and service.externalServiceId %}
      <div class="currency-box">
        <p class="form-label">Custo e preço pelo provedor</p>
        <div class="currency-grid">
          <div class="meta-item"><span class="meta-key">Rate no provedor</span><span class="meta-val" id="provider-rate">Consultando…</span></div>
          <div class="meta-item"><span class="meta-key">Custo em BRL</span><span class="meta-val" id="provider-cost">—</span></div>
          <div class="meta-item"><span class="meta-key">Preço atual local</span><span class="meta-val">R$ {{ (service.pricePerThousandCents / 100)|number_format(2, ',', '.') }}</span></div>
          <div class="meta-item"><span class="meta-key">Novo preço com lucro</span><span class="meta-val" id="provider-suggested">—</span></div>
        </div>

        <div class="currency-actions">
          <button type="button" class="btn-provider" id="btn-refresh">Consultar preço</button>
          <button type="button" class="btn-provider" id="btn-update" disabled>Atualizar preço pelo provedor</button>
        </div>
        <div class="provider-status" id="provider-status"></div>
      </div>
      {% endif %}

      <div class="form-actions">
        <a href="{{ path('admin_service_index') }}" class="btn-cancel">Cancelar</a>
        <button type="submit" class="btn-save">Salvar alterações</button>
      </div>
    </form>
  </div>
</div>

<script>
(function () {
  const serviceId = {{ service.id }};
  const csrf = '{{ csrf_token('admin_api_sync') }}';
  const priceInput = document.getElementById('f-price');
  const profitInput = document.getElementById('f-profit');
  const rateEl = document.getElementById('provider-rate');
  const costEl = document.getElementById('provider-cost');
  const suggestedEl = document.getElementById('provider-suggested');
  const statusEl = document.getElementById('provider-status');
  const refreshBtn = document.getElementById('btn-refresh');
  const updateBtn = document.getElementById('btn-update');

  if (!rateEl) return;

  let costCents = null;

  const brl = cents => 'R$ ' + (cents / 100).toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

  function recalc() {
    if (costCents === null) return;
    const profit = parseFloat(profitInput.value) || 0;
    const suggested = Math.ceil(costCents * (1 + profit / 100));
    suggestedEl.textContent = brl(suggested);
  }

  function recalcProfitFromPrice() {
    if (costCents === null || costCents <= 0) return;
    const price = parseInt(priceInput.value, 10) || 0;
    const profit = ((price / costCents) - 1) * 100;
    profitInput.value = profit.toFixed(3);
    recalc();
  }

  async function load() {
    refreshBtn.disabled = true;
    statusEl.textContent = 'Consultando provedor…';
    try {
      const res = await fetch(`/admin/api/services/${serviceId}/provider-price`);
      const json = await res.json();
      if (!res.ok || json.error) throw new Error(json.error || res.status);
      const r = json.result;
      costCents = r.cost_brl_cents;
      rateEl.textContent = `${r.provider_rate} ${r.provider_currency}`;
      costEl.textContent = brl(costCents);
      profitInput.value = r.profit_percent.toFixed(3);
      recalc();
      updateBtn.disabled = false;
      statusEl.textContent = 'Preço consultado.';
    } catch (e) {
      statusEl.textContent = 'Erro: ' + e.message;
    } finally {
      refreshBtn.disabled = false;
    }
  }

  async function updatePrice() {
    if (costCents === null) return;
    if (!confirm('Atualizar o preço usando a cotação atual e o lucro individual?')) return;
    updateBtn.disabled = true;
    try {
      const res = await fetch(`/admin/api/services/${serviceId}/sync`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrf },
        body: JSON.stringify({ profit_percent: parseFloat(profitInput.value) || 0 })
      });
      const json = await res.json();
      if (!res.ok || json.error) throw new Error(json.error || res.status);
      priceInput.value = json.result.new_price_cents;
      profitInput.value = json.result.profit_percent.toFixed(3);
      statusEl.textContent = 'Preço atualizado. Clique em Salvar alterações para confirmar os demais dados.';
    } catch (e) {
      statusEl.textContent = 'Erro: ' + e.message;
    } finally {
      updateBtn.disabled = false;
    }
  }

  priceInput.addEventListener('input', recalcProfitFromPrice);
  profitInput.addEventListener('input', recalc);
  refreshBtn.addEventListener('click', load);
  updateBtn.addEventListener('click', updatePrice);
  load();
})();
</script>
{% endblock %}
