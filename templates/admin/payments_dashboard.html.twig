{% extends 'base.html.twig' %}

{% block title %}Pagamentos — Admin{% endblock %}
{% block page_title %}Dashboard de Pagamentos{% endblock %}

{% block stylesheets %}
<style>
/* ══════════════════════════════════════════════
   PAYMENTS DASHBOARD — usa variáveis do tema
══════════════════════════════════════════════ */

.pay-page {
  display: flex;
  flex-direction: column;
  gap: var(--space-5, 20px);
}

/* ── KPI row ─────────────────────────────────── */
.pay-kpi-row {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: var(--space-4, 16px);
}

.pay-kpi {
  background: var(--surface, #1c1b19);
  border: 1px solid var(--border, #393836);
  border-radius: 12px;
  padding: 18px 20px;
  display: flex;
  flex-direction: column;
  gap: 6px;
  position: relative;
  overflow: hidden;
}

.pay-kpi::before {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: inherit;
  opacity: .07;
  pointer-events: none;
}

.pay-kpi--green::before  { background: #22c55e; }
.pay-kpi--amber::before  { background: #f59e0b; }
.pay-kpi--purple::before { background: #8b5cf6; }

.pay-kpi__icon {
  width: 32px;
  height: 32px;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.pay-kpi--green  .pay-kpi__icon { background: rgba(34,197,94,.15);  color: #22c55e; }
.pay-kpi--amber  .pay-kpi__icon { background: rgba(245,158,11,.15); color: #f59e0b; }
.pay-kpi--purple .pay-kpi__icon { background: rgba(139,92,246,.15); color: #8b5cf6; }

.pay-kpi__label {
  font-size: .72rem;
  font-weight: 600;
  letter-spacing: .03em;
  text-transform: uppercase;
  color: var(--text-2, #797876);
  line-height: 1;
}

.pay-kpi__value {
  font-size: 1.55rem;
  font-weight: 700;
  color: var(--text, #cdccca);
  line-height: 1.15;
  letter-spacing: -.02em;
}

.pay-kpi__sub {
  font-size: .72rem;
  color: var(--text-3, #5a5957);
}

/* ── Charts row ──────────────────────────────── */
.pay-charts-row {
  display: grid;
  grid-template-columns: 2fr 1fr;
  gap: var(--space-4, 16px);
}
@media (max-width: 768px) {
  .pay-charts-row { grid-template-columns: 1fr; }
}

.pay-card {
  background: var(--surface, #1c1b19);
  border: 1px solid var(--border, #393836);
  border-radius: 12px;
  padding: 20px 22px;
}

.pay-card__title {
  font-size: .82rem;
  font-weight: 600;
  color: var(--text, #cdccca);
  margin-bottom: 14px;
  display: flex;
  align-items: center;
  gap: 7px;
}

.pay-card__title i { color: var(--primary, #4f98a3); }

/* ── Tabs ────────────────────────────────────── */
.pay-tabs {
  display: flex;
  gap: 6px;
  flex-wrap: wrap;
  padding-bottom: 16px;
  border-bottom: 1px solid var(--border, #393836);
  margin-bottom: 20px;
}

.pay-tab {
  padding: 7px 16px;
  border-radius: 8px;
  border: 1px solid var(--border, #393836);
  background: transparent;
  color: var(--text-2, #797876);
  font-size: .8rem;
  font-weight: 500;
  cursor: pointer;
  transition: all .18s;
  display: flex;
  align-items: center;
  gap: 6px;
}

.pay-tab:hover { border-color: var(--primary, #4f98a3); color: var(--text, #cdccca); }

.pay-tab.is-active {
  background: var(--primary, #4f98a3);
  border-color: var(--primary, #4f98a3);
  color: #fff;
}

.pay-tab-content { display: none; }
.pay-tab-content.is-active { display: block; }

/* ── Table ───────────────────────────────────── */
.pay-table-wrap { overflow-x: auto; }

.pay-table {
  width: 100%;
  border-collapse: collapse;
  font-size: .82rem;
}

.pay-table th {
  background: var(--surface-2, #201f1d);
  color: var(--text-2, #797876);
  font-weight: 600;
  font-size: .72rem;
  letter-spacing: .04em;
  text-transform: uppercase;
  padding: 10px 14px;
  text-align: left;
  border-bottom: 1px solid var(--border, #393836);
  white-space: nowrap;
}

.pay-table td {
  padding: 11px 14px;
  color: var(--text, #cdccca);
  border-bottom: 1px solid var(--border, #393836);
  vertical-align: middle;
}

.pay-table tbody tr:last-child td { border-bottom: none; }

.pay-table tbody tr:hover td {
  background: color-mix(in srgb, var(--primary, #4f98a3) 4%, transparent);
}

/* ── Badges ──────────────────────────────────── */
.badge {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: 3px 9px;
  border-radius: 20px;
  font-size: .7rem;
  font-weight: 600;
  white-space: nowrap;
}

.badge--pending  { background: rgba(245,158,11,.12); color: #f59e0b; border: 1px solid rgba(245,158,11,.25); }
.badge--approved { background: rgba(34,197,94,.12);  color: #22c55e; border: 1px solid rgba(34,197,94,.25); }
.badge--failed   { background: rgba(239,68,68,.12);  color: #ef4444; border: 1px solid rgba(239,68,68,.25); }
.badge--refunded { background: rgba(139,92,246,.12); color: #8b5cf6; border: 1px solid rgba(139,92,246,.25); }

/* ── Actions ─────────────────────────────────── */
.pay-btn {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 5px 12px;
  border-radius: 7px;
  font-size: .78rem;
  font-weight: 600;
  cursor: pointer;
  border: none;
  text-decoration: none;
  transition: opacity .15s, transform .1s;
  white-space: nowrap;
}

.pay-btn:active { transform: scale(.97); }
.pay-btn--approve { background: rgba(34,197,94,.15);  color: #22c55e; border: 1px solid rgba(34,197,94,.3); }
.pay-btn--cancel  { background: rgba(239,68,68,.15);  color: #ef4444; border: 1px solid rgba(239,68,68,.3); }
.pay-btn--approve:hover { background: #22c55e; color: #fff; }
.pay-btn--cancel:hover  { background: #ef4444; color: #fff; }

/* ── Form ────────────────────────────────────── */
.pay-form {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 14px;
}

.pay-field { display: flex; flex-direction: column; gap: 5px; }

.pay-field label {
  font-size: .72rem;
  font-weight: 600;
  letter-spacing: .03em;
  text-transform: uppercase;
  color: var(--text-2, #797876);
}

.pay-field input,
.pay-field select,
.pay-field textarea {
  background: var(--surface-2, #201f1d);
  border: 1px solid var(--border, #393836);
  color: var(--text, #cdccca);
  padding: 8px 12px;
  border-radius: 8px;
  font-size: .85rem;
  width: 100%;
  transition: border-color .18s;
}

.pay-field input:focus,
.pay-field select:focus,
.pay-field textarea:focus {
  outline: none;
  border-color: var(--primary, #4f98a3);
}

.pay-field textarea { resize: vertical; min-height: 68px; }

.pay-form-footer { margin-top: 18px; }

.pay-btn-submit {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 9px 22px;
  border-radius: 8px;
  font-size: .85rem;
  font-weight: 600;
  cursor: pointer;
  border: none;
  transition: opacity .15s, transform .1s;
}

.pay-btn-submit:active { transform: scale(.97); }
.pay-btn-submit--primary { background: var(--primary, #4f98a3); color: #fff; }
.pay-btn-submit--danger  { background: #ef4444; color: #fff; }

/* ── Checkbox row ────────────────────────────── */
.pay-checkbox-row {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: 6px;
  font-size: .83rem;
  color: var(--text, #cdccca);
  cursor: pointer;
}

.pay-checkbox-row input[type=checkbox] { width: 14px; height: 14px; accent-color: var(--primary, #4f98a3); }

/* ── Empty state ─────────────────────────────── */
.pay-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;
  padding: 40px 20px;
  color: var(--text-3, #5a5957);
  text-align: center;
}

.pay-empty i { color: var(--text-3, #5a5957); }
.pay-empty p { font-size: .9rem; color: var(--text-2, #797876); }

/* ── Warning banner ──────────────────────────── */
.pay-warning {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  background: rgba(245,158,11,.08);
  border: 1px solid rgba(245,158,11,.2);
  border-radius: 8px;
  padding: 10px 14px;
  font-size: .82rem;
  color: #f59e0b;
  margin-bottom: 16px;
}

/* ── User cell ───────────────────────────────── */
.user-cell strong {
  display: block;
  font-size: .83rem;
  color: var(--text, #cdccca);
}
.user-cell small {
  font-size: .72rem;
  color: var(--text-3, #5a5957);
}

/* ── Value highlight ─────────────────────────── */
.val-green { font-weight: 700; color: #22c55e; }
.val-muted  { color: var(--text-3, #5a5957); font-size: .78rem; }

/* ── Back link ───────────────────────────────── */
.pay-back {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  font-size: .8rem;
  color: var(--text-2, #797876);
  text-decoration: none;
  margin-bottom: 4px;
  transition: color .15s;
}
.pay-back:hover { color: var(--text, #cdccca); }
</style>
{% endblock %}

{% block content %}
<div class="pay-page">

  <a href="{{ path('admin_dashboard') }}" class="pay-back">
    <i data-lucide="arrow-left" width="14" height="14"></i> Voltar ao Admin
  </a>

  {# ── Flash messages ─── #}
  {% for type, messages in app.flashes %}
    {% for msg in messages %}
      <div class="flash flash--{{ type }}">
        <i data-lucide="{% if type == 'success' %}check-circle{% elseif type == 'error' %}x-circle{% else %}alert-triangle{% endif %}" width="15" height="15"></i>
        <span>{{ msg }}</span>
        <button class="flash__close" onclick="this.closest('.flash').remove()" aria-label="Fechar">&times;</button>
      </div>
    {% endfor %}
  {% endfor %}

  {# ══ KPI CARDS ══════════════════════════════════ #}
  <div class="pay-kpi-row">

    <div class="pay-kpi pay-kpi--green">
      <div class="pay-kpi__icon"><i data-lucide="trending-up" width="16" height="16"></i></div>
      <span class="pay-kpi__label">Total Recebido</span>
      <span class="pay-kpi__value">R$ {{ (totalApproved / 100)|number_format(2, ',', '.') }}</span>
    </div>

    <div class="pay-kpi pay-kpi--amber">
      <div class="pay-kpi__icon"><i data-lucide="clock" width="16" height="16"></i></div>
      <span class="pay-kpi__label">Pendente</span>
      <span class="pay-kpi__value">R$ {{ (totalPending / 100)|number_format(2, ',', '.') }}</span>
      <span class="pay-kpi__sub">{{ countPending }} pagamento{{ countPending != 1 ? 's' : '' }}</span>
    </div>

    <div class="pay-kpi pay-kpi--purple">
      <div class="pay-kpi__icon"><i data-lucide="rotate-ccw" width="16" height="16"></i></div>
      <span class="pay-kpi__label">Total Estornado</span>
      <span class="pay-kpi__value">R$ {{ (totalRefunded / 100)|number_format(2, ',', '.') }}</span>
    </div>

  </div>

  {# ══ CHARTS ══════════════════════════════════════ #}
  <div class="pay-charts-row">

    <div class="pay-card">
      <div class="pay-card__title">
        <i data-lucide="bar-chart-2" width="15" height="15"></i>
        Receita Aprovada — Últimos 6 Meses
      </div>
      <canvas id="chartMonthly" height="110"></canvas>
    </div>

    <div class="pay-card">
      <div class="pay-card__title">
        <i data-lucide="pie-chart" width="15" height="15"></i>
        Distribuição por Status
      </div>
      <canvas id="chartStatus" height="200"></canvas>
    </div>

  </div>

  {# ══ TABS SECTION ════════════════════════════════ #}
  <div class="pay-card">

    <div class="pay-tabs">
      <button class="pay-tab is-active" onclick="payTab('tab-pending', this)">
        <i data-lucide="clock" width="13" height="13"></i>
        Pendentes
        {% if countPending > 0 %}
          <span class="badge badge--pending">{{ countPending }}</span>
        {% endif %}
      </button>
      <button class="pay-tab" onclick="payTab('tab-manual', this)">
        <i data-lucide="plus-circle" width="13" height="13"></i>
        Pagamento Manual
      </button>
      <button class="pay-tab" onclick="payTab('tab-refund', this)">
        <i data-lucide="rotate-ccw" width="13" height="13"></i>
        Aplicar Estorno
      </button>
    </div>

    {# ── TAB 1: Pendentes ─────────────────────── #}
    <div id="tab-pending" class="pay-tab-content is-active">
      {% if pendingPayments is empty %}
        <div class="pay-empty">
          <i data-lucide="check-circle" width="40" height="40"></i>
          <p>Nenhum pagamento pendente no momento.</p>
        </div>
      {% else %}
        <div class="pay-table-wrap">
          <table class="pay-table">
            <thead>
              <tr>
                <th>ID</th>
                <th>Usuário</th>
                <th>Valor</th>
                <th>Método</th>
                <th>ID Externo</th>
                <th>Taxa</th>
                <th>Criado em</th>
                <th>Ações</th>
              </tr>
            </thead>
            <tbody>
              {% for p in pendingPayments %}
              <tr>
                <td><strong>#{{ p.id }}</strong></td>
                <td class="user-cell">
                  <strong>{{ p.user.name }}</strong>
                  <small>{{ p.user.email }}</small>
                </td>
                <td class="val-green">R$ {{ (p.amountCents / 100)|number_format(2, ',', '.') }}</td>
                <td>
                  <span class="badge badge--pending">{{ p.method }}</span>
                </td>
                <td class="val-muted">{{ p.externalId ?? '—' }}</td>
                <td>{{ p.feeCents > 0 ? 'R$ ' ~ (p.feeCents / 100)|number_format(2, ',', '.') : '—' }}</td>
                <td class="val-muted">{{ p.createdAt|date('d/m/Y H:i') }}</td>
                <td style="white-space:nowrap">
                  <a href="{{ path('admin_payment_approve', {id: p.id}) }}"
                     onclick="return confirm('Aprovar pagamento #{{ p.id }} para {{ p.user.name }}?')"
                     class="pay-btn pay-btn--approve">
                    <i data-lucide="check" width="12" height="12"></i> Aprovar
                  </a>
                  <a href="{{ path('admin_payment_cancel', {id: p.id}) }}"
                     onclick="return confirm('Cancelar pagamento #{{ p.id }}?')"
                     class="pay-btn pay-btn--cancel" style="margin-left:6px">
                    <i data-lucide="x" width="12" height="12"></i> Cancelar
                  </a>
                </td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      {% endif %}
    </div>

    {# ── TAB 2: Manual ───────────────────────── #}
    <div id="tab-manual" class="pay-tab-content">
      <form method="POST" action="{{ path('admin_payments_dashboard_create_manual') }}">
        <div class="pay-form">
          <div class="pay-field">
            <label for="f_user">Usuário *</label>
            <select id="f_user" name="user_id" required>
              <option value="">— Selecione —</option>
              {% for u in users %}
                <option value="{{ u.id }}">{{ u.name }} ({{ u.email }})</option>
              {% endfor %}
            </select>
          </div>
          <div class="pay-field">
            <label for="f_amount">Valor (R$) *</label>
            <input id="f_amount" type="number" name="amount" step="0.01" min="0.01" placeholder="Ex: 50.00" required>
          </div>
          <div class="pay-field">
            <label for="f_method">Método</label>
            <select id="f_method" name="method">
              <option value="pix">Pix</option>
              <option value="credit_card">Cartão de Crédito</option>
              <option value="debit_card">Cartão de Débito</option>
            </select>
          </div>
          <div class="pay-field">
            <label for="f_note">Observação</label>
            <input id="f_note" type="text" name="note" placeholder="Ex: comprovante enviado pelo cliente">
          </div>
        </div>
        <label class="pay-checkbox-row" style="margin-top:14px">
          <input type="checkbox" name="auto_approve" value="1">
          Aprovar imediatamente e creditar saldo
        </label>
        <div class="pay-form-footer">
          <button type="submit" class="pay-btn-submit pay-btn-submit--primary">
            <i data-lucide="plus-circle" width="14" height="14"></i>
            Criar Pagamento Manual
          </button>
        </div>
      </form>
    </div>

    {# ── TAB 3: Estorno ──────────────────────── #}
    <div id="tab-refund" class="pay-tab-content">
      <div class="pay-warning">
        <i data-lucide="alert-triangle" width="15" height="15" style="flex-shrink:0;margin-top:1px"></i>
        O estorno débita diretamente o saldo da carteira do usuário. Use apenas quando solicitado via suporte.
      </div>
      <form method="POST" action="{{ path('admin_payments_dashboard_refund_wallet') }}">
        <div class="pay-form">
          <div class="pay-field">
            <label for="r_user">Usuário *</label>
            <select id="r_user" name="user_id" required>
              <option value="">— Selecione —</option>
              {% for u in users %}
                <option value="{{ u.id }}">{{ u.name }} ({{ u.email }})</option>
              {% endfor %}
            </select>
          </div>
          <div class="pay-field">
            <label for="r_amount">Valor a estornar (R$) *</label>
            <input id="r_amount" type="number" name="amount" step="0.01" min="0.01" placeholder="Ex: 25.00" required>
          </div>
          <div class="pay-field">
            <label for="r_reason">Motivo / Ticket</label>
            <input id="r_reason" type="text" name="reason" placeholder="Ex: Ticket #123 — reembolso solicitado">
          </div>
        </div>
        <div class="pay-form-footer">
          <button type="submit"
            onclick="return confirm('Confirma o estorno? O valor sera debitado do saldo do usuario.')"
            class="pay-btn-submit pay-btn-submit--danger">
            <i data-lucide="rotate-ccw" width="14" height="14"></i>
            Aplicar Estorno
          </button>
        </div>
      </form>
    </div>

  </div>{# /pay-card #}
</div>{# /pay-page #}
{% endblock %}

{% block javascripts %}
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function () {

  /* ── Detecta tema atual ─────────────────── */
  function isDark() {
    return document.documentElement.getAttribute('data-theme') === 'dark';
  }

  var gridColor  = 'rgba(255,255,255,.06)';
  var tickColor  = '#797876';
  var tooltipBg  = '#1c1b19';
  var tooltipTxt = '#cdccca';

  /* ── Bar chart ──────────────────────────── */
  var ctxBar = document.getElementById('chartMonthly').getContext('2d');
  new Chart(ctxBar, {
    type: 'bar',
    data: {
      labels: {{ chartMonths|raw }},
      datasets: [{
        label: 'Receita Aprovada (R$)',
        data: {{ chartApproved|raw }},
        backgroundColor: 'rgba(79,152,163,.65)',
        borderColor: 'var(--primary, #4f98a3)',
        borderWidth: 2,
        borderRadius: 6,
        borderSkipped: false
      }]
    },
    options: {
      responsive: true,
      plugins: {
        legend: { labels: { color: tickColor, font: { size: 11 } } },
        tooltip: {
          backgroundColor: tooltipBg,
          titleColor: tooltipTxt,
          bodyColor: tickColor,
          borderColor: 'rgba(255,255,255,.08)',
          borderWidth: 1,
          padding: 10
        }
      },
      scales: {
        x: {
          ticks: { color: tickColor, font: { size: 11 } },
          grid: { color: gridColor }
        },
        y: {
          ticks: { color: tickColor, font: { size: 11 } },
          grid: { color: gridColor }
        }
      }
    }
  });

  /* ── Doughnut chart ─────────────────────── */
  var ctxDnt = document.getElementById('chartStatus').getContext('2d');
  new Chart(ctxDnt, {
    type: 'doughnut',
    data: {
      labels: {{ statusLabels|raw }},
      datasets: [{
        data: {{ statusValues|raw }},
        backgroundColor: {{ statusChartColors|raw }},
        borderWidth: 2,
        borderColor: 'var(--surface, #1c1b19)',
        hoverBorderColor: '#fff'
      }]
    },
    options: {
      responsive: true,
      cutout: '68%',
      plugins: {
        legend: {
          position: 'bottom',
          labels: { color: tickColor, font: { size: 11 }, padding: 16, usePointStyle: true }
        },
        tooltip: {
          backgroundColor: tooltipBg,
          titleColor: tooltipTxt,
          bodyColor: tickColor,
          borderColor: 'rgba(255,255,255,.08)',
          borderWidth: 1,
          padding: 10
        }
      }
    }
  });

  /* ── Tabs ───────────────────────────────── */
  window.payTab = function (id, btn) {
    document.querySelectorAll('.pay-tab-content').forEach(function (el) { el.classList.remove('is-active'); });
    document.querySelectorAll('.pay-tab').forEach(function (el) { el.classList.remove('is-active'); });
    document.getElementById(id).classList.add('is-active');
    btn.classList.add('is-active');
  };

  /* Re-render Lucide icons inside this block */
  if (window.lucide) lucide.createIcons();
});
</script>
{% endblock %}
