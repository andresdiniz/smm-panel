{#
  Renderizado via TextField::setTemplatePath() no EasyAdmin 4.10.
  Acessa o Order via ea.entity.instance e chama getOrderLogs().
#}
{% set logs = ea.entity.instance.orderLogs %}

<div class="mt-3">

  {# ── Cabeçalho ─────────────────────────────────────── #}
  <div class="d-flex align-items-center gap-2 mb-2 border-bottom pb-2">
    <i class="fa fa-rotate text-muted"></i>
    <strong>Logs do Provider</strong>
    <span class="badge bg-secondary">{{ logs|length }}</span>
    <small class="text-muted ms-auto">mais recente primeiro</small>
  </div>

  {% if logs is empty %}
    <div class="text-center text-muted py-4 border rounded">
      <i class="fas fa-inbox fa-2x mb-2 d-block"></i>
      Nenhum log registrado para este pedido.
    </div>

  {% else %}
    <div class="table-responsive border rounded">
      <table class="table table-sm table-hover align-middle mb-0">
        <thead class="table-dark">
          <tr>
            <th style="width:150px">Data/Hora</th>
            <th style="width:75px">Ação</th>
            <th style="width:62px">HTTP</th>
            <th style="width:70px">ms</th>
            <th style="width:30px"></th>
            <th>Erro / Contexto</th>
          </tr>
        </thead>
        <tbody>

          {% for log in logs %}
            {% set hasErr = log.errorMessage is not null %}

            <tr class="{% if hasErr %}table-danger{% endif %}"
                style="cursor:pointer"
                data-bs-toggle="collapse"
                data-bs-target="#ea-log-{{ log.id }}"
                aria-expanded="false">

              <td class="text-nowrap small ps-2">{{ log.createdAt|date('d/m/Y H:i:s') }}</td>

              <td>
                {% set ac = {'add':'primary','status':'info','sync':'secondary','other':'secondary'} %}
                <span class="badge bg-{{ ac[log.action] ?? 'secondary' }}">{{ log.action }}</span>
              </td>

              <td>
                {% if log.httpStatus %}
                  {% set hc = log.httpStatus >= 400 ? 'danger' : (log.httpStatus >= 300 ? 'warning' : 'success') %}
                  <span class="badge bg-{{ hc }}{% if hc == 'warning' %} text-dark{% endif %}">{{ log.httpStatus }}</span>
                {% else %}
                  <span class="text-muted">&mdash;</span>
                {% endif %}
              </td>

              <td class="small">
                {% if log.elapsedMs %}
                  {% set mc = log.elapsedMs > 5000 ? 'text-danger fw-bold' : (log.elapsedMs > 2000 ? 'text-warning' : 'text-success') %}
                  <span class="{{ mc }}">{{ log.elapsedMs }}</span>
                {% else %}&mdash;{% endif %}
              </td>

              <td class="text-center">
                {% if hasErr %}
                  <span class="text-danger" title="{{ log.errorMessage }}">&#10060;</span>
                {% else %}
                  <span class="text-success">&#10004;</span>
                {% endif %}
              </td>

              <td class="small text-truncate" style="max-width:300px">
                {% if hasErr %}
                  <span class="text-danger">{{ log.errorMessage|slice(0,120) }}</span>
                {% elseif log.context %}
                  <span class="text-muted">
                    {% if log.context.external_status is defined %}status: {{ log.context.external_status }}{% endif %}
                    {% if log.context.remains is defined %} | remains: {{ log.context.remains }}{% endif %}
                  </span>
                {% else %}
                  <span class="text-success">OK</span>
                {% endif %}
              </td>
            </tr>

            {# Painel expandido com JSON #}
            <tr>
              <td colspan="6" class="p-0 border-0">
                <div class="collapse" id="ea-log-{{ log.id }}">
                  <div class="p-3 text-light" style="background:#1a1d23">
                    <div class="row g-3">

                      {% if log.errorMessage %}
                        <div class="col-12">
                          <div class="small fw-bold text-danger mb-1"><i class="fa fa-circle-exclamation me-1"></i>Erro</div>
                          <pre class="text-danger mb-0 small">{{ log.errorMessage }}</pre>
                        </div>
                      {% endif %}

                      {% if log.responseBody %}
                        <div class="col-md-6">
                          <div class="small fw-bold text-info mb-1"><i class="fa fa-arrow-down me-1"></i>Response Body</div>
                          <pre class="small mb-0 text-light" style="max-height:220px;overflow:auto">{{ log.responseBody|json_encode(constant('JSON_PRETTY_PRINT') b-or constant('JSON_UNESCAPED_UNICODE')) }}</pre>
                        </div>
                      {% endif %}

                      {% if log.context %}
                        <div class="col-md-6">
                          <div class="small fw-bold text-warning mb-1"><i class="fa fa-paperclip me-1"></i>Contexto</div>
                          <pre class="small mb-0 text-light" style="max-height:220px;overflow:auto">{{ log.context|json_encode(constant('JSON_PRETTY_PRINT') b-or constant('JSON_UNESCAPED_UNICODE')) }}</pre>
                        </div>
                      {% endif %}

                      <div class="col-12 border-top pt-2 mt-1 text-secondary small">
                        retry: {{ log.retryCount }}
                        &nbsp;|&nbsp; provider: <code class="text-light">{{ log.provider }}</code>
                        &nbsp;|&nbsp; log #{{ log.id }}
                      </div>

                    </div>
                  </div>
                </div>
              </td>
            </tr>

          {% endfor %}

        </tbody>
      </table>
    </div>
  {% endif %}

</div>
