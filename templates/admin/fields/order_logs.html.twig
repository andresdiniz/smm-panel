{#
  TemplateField para logs do provider dentro do detalhe de Order no EasyAdmin.
  Os logs s\u00e3o injetados pelo AdminOrderLogsSubscriber via request attribute.
#}
{% set logs = app.request.attributes.get('orderLogs') ?? [] %}

<div class="mt-2">
  <div class="d-flex align-items-center gap-2 mb-2">
    <h5 class="mb-0"><i class="fa fa-rotate me-2 text-muted"></i>Logs do Provider</h5>
    <span class="badge bg-secondary">{{ logs|length }}</span>
    <small class="text-muted ms-auto">mais recente primeiro</small>
  </div>

  {% if logs is empty %}
    <div class="text-center text-muted py-4 border rounded bg-light">
      <i class="fas fa-inbox fa-2x mb-2"></i>
      <p class="mb-0">Nenhum log registrado para este pedido.</p>
    </div>
  {% else %}
    <div class="table-responsive border rounded">
      <table class="table table-sm table-hover align-middle mb-0">
        <thead class="table-dark">
          <tr>
            <th style="width:145px">Data/Hora</th>
            <th style="width:75px">A\u00e7\u00e3o</th>
            <th style="width:60px">HTTP</th>
            <th style="width:65px">ms</th>
            <th style="width:32px"></th>
            <th>Erro / Contexto</th>
          </tr>
        </thead>
        <tbody>
          {% for log in logs %}
            {% set hasErr = log.errorMessage is not null %}
            <tr class="{% if hasErr %}table-danger{% endif %}" style="cursor:pointer"
                data-bs-toggle="collapse"
                data-bs-target="#ea-log-{{ log.id }}"
                aria-expanded="false">

              <td class="text-nowrap small ps-2">{{ log.createdAt|date('d/m/Y H:i:s') }}</td>

              <td>
                {% set ac = {'add':'primary','status':'info','sync':'secondary'} %}
                <span class="badge bg-{{ ac[log.action] ?? 'secondary' }}">{{ log.action }}</span>
              </td>

              <td>
                {% if log.httpStatus %}
                  {% if log.httpStatus >= 400 %}
                    <span class="badge bg-danger">{{ log.httpStatus }}</span>
                  {% elseif log.httpStatus >= 300 %}
                    <span class="badge bg-warning text-dark">{{ log.httpStatus }}</span>
                  {% else %}
                    <span class="badge bg-success">{{ log.httpStatus }}</span>
                  {% endif %}
                {% else %}
                  <span class="text-muted">&mdash;</span>
                {% endif %}
              </td>

              <td class="small">
                {% if log.elapsedMs %}
                  {% if log.elapsedMs > 5000 %}
                    <span class="text-danger fw-bold">{{ log.elapsedMs }}</span>
                  {% elseif log.elapsedMs > 2000 %}
                    <span class="text-warning">{{ log.elapsedMs }}</span>
                  {% else %}
                    <span class="text-success">{{ log.elapsedMs }}</span>
                  {% endif %}
                {% else %}&mdash;{% endif %}
              </td>

              <td class="text-center">
                {% if hasErr %}
                  <span title="{{ log.errorMessage }}" class="text-danger">&#10060;</span>
                {% else %}
                  <span class="text-success">&#10004;</span>
                {% endif %}
              </td>

              <td class="small text-truncate" style="max-width:320px">
                {% if hasErr %}
                  <span class="text-danger">{{ log.errorMessage|slice(0,120) }}</span>
                {% elseif log.context %}
                  <span class="text-muted">
                    status: {{ log.context.external_status ?? '' }}
                    &nbsp;|&nbsp; remains: {{ log.context.remains ?? '' }}
                  </span>
                {% else %}
                  <span class="text-success">OK</span>
                {% endif %}
              </td>
            </tr>

            {# Painel expandido #}
            <tr>
              <td colspan="6" class="p-0 border-0">
                <div class="collapse" id="ea-log-{{ log.id }}">
                  <div class="p-3 text-light" style="background:#1a1d23">
                    <div class="row g-3">

                      {% if log.errorMessage %}
                        <div class="col-12">
                          <div class="small fw-bold text-danger mb-1">
                            <i class="fa fa-circle-exclamation me-1"></i>Erro
                          </div>
                          <pre class="text-danger mb-0 small">{{ log.errorMessage }}</pre>
                        </div>
                      {% endif %}

                      {% if log.responseBody %}
                        <div class="col-md-6">
                          <div class="small fw-bold text-info mb-1">
                            <i class="fa fa-arrow-down me-1"></i>Response Body
                          </div>
                          <pre class="small mb-0 text-light" style="max-height:220px;overflow:auto">{{ log.responseBody|json_encode(constant('JSON_PRETTY_PRINT') b-or constant('JSON_UNESCAPED_UNICODE')) }}</pre>
                        </div>
                      {% endif %}

                      {% if log.context %}
                        <div class="col-md-6">
                          <div class="small fw-bold text-warning mb-1">
                            <i class="fa fa-paperclip me-1"></i>Contexto
                          </div>
                          <pre class="small mb-0 text-light" style="max-height:220px;overflow:auto">{{ log.context|json_encode(constant('JSON_PRETTY_PRINT') b-or constant('JSON_UNESCAPED_UNICODE')) }}</pre>
                        </div>
                      {% endif %}

                      <div class="col-12 border-top pt-2 mt-1 text-secondary small">
                        retry: {{ log.retryCount }}
                        &nbsp;|&nbsp; provider: <code class="text-light">{{ log.provider }}</code>
                        &nbsp;|&nbsp; log #{{ log.id }}
                      </div>

                    </div>
                  </div>
                </div>
              </td>
            </tr>

          {% endfor %}
        </tbody>
      </table>
    </div>
  {% endif %}
</div>

{# Bootstrap JS j\u00e1 carregado pelo EasyAdmin (via importmap/assets) #}
