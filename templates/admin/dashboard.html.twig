{% extends '@EasyAdmin/page/content.html.twig' %}
{% block page_title %}Dashboard{% endblock %}
{% block head_javascript %}{{ parent() }}{% endblock %}
{% block content_title %}{% endblock %}

{% block main %}
<style>
.content-header { display:none !important; }
.content-wrapper { padding: 0 !important; }
.content-body { padding-left: 20px !important; }

/* ═══ Reset & Base ═══════════════════════════════════════════ */
.dash *,
.dash *::before,
.dash *::after { box-sizing: border-box; }

.dash {
  padding: 28px 32px 72px 24px;
  background: #0d1016;
  min-height: 100vh;
  color: #dde1f0;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
  --r: 12px;
  --card: #141921;
  --card-border: rgba(255,255,255,.07);
  --card-head: #111720;
  --muted: #5c617a;
  --accent-teal: #01868d;
  --accent-blue: #1e72a0;
  --accent-green: #4d8f25;
  --accent-gold: #c98a00;
  --accent-red: #b03030;
  --text-bright: #f0f3ff;
  --text-dim: #9196b0;
}

/* ═══ Header ════════════════════════════════════════════════ */
.dh {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28px;
  gap: 16px;
  flex-wrap: wrap;
}
.dh__left h1 {
  font-size: 1.25rem;
  font-weight: 900;
  letter-spacing: -.04em;
  color: var(--text-bright);
  margin: 0 0 3px;
}
.dh__date {
  font-size: .7rem;
  color: var(--muted);
  font-weight: 500;
  letter-spacing: .04em;
  text-transform: uppercase;
}
.dh__actions { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
.dh__btn {
  display: inline-flex; align-items: center; gap: 6px;
  padding: 7px 14px;
  border-radius: 8px;
  font-size: .75rem;
  font-weight: 700;
  text-decoration: none;
  transition: all .18s;
  white-space: nowrap;
  border: 1px solid transparent;
}
.dh__btn--ghost {
  background: rgba(255,255,255,.05);
  color: var(--text-dim);
  border-color: var(--card-border);
}
.dh__btn--ghost:hover { background: rgba(255,255,255,.1); color: var(--text-bright); }
.dh__btn--teal {
  background: var(--accent-teal);
  color: #fff;
}
.dh__btn--teal:hover { filter: brightness(1.15); }

/* ═══ KPI Grid ══════════════════════════════════════════════ */
.kpi-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12px;
  margin-bottom: 20px;
}
@media(max-width:1100px) { .kpi-grid { grid-template-columns: repeat(2,1fr); } }
@media(max-width:540px)  { .kpi-grid { grid-template-columns: 1fr; } }

.kpi {
  background: var(--card);
  border: 1px solid var(--card-border);
  border-radius: var(--r);
  padding: 18px 20px 16px;
  display: flex;
  flex-direction: column;
  gap: 10px;
  position: relative;
  overflow: hidden;
  transition: transform .18s, box-shadow .18s;
  cursor: default;
}
.kpi:hover { transform: translateY(-2px); box-shadow: 0 10px 32px rgba(0,0,0,.35); }

/* top accent bar */
.kpi::before {
  content: '';
  position: absolute;
  inset: 0 0 auto 0;
  height: 2px;
  border-radius: var(--r) var(--r) 0 0;
}
.kpi--teal::before  { background: var(--accent-teal); }
.kpi--blue::before  { background: var(--accent-blue); }
.kpi--green::before { background: var(--accent-green); }
.kpi--gold::before  { background: var(--accent-gold); }

.kpi__row { display: flex; align-items: center; justify-content: space-between; gap: 8px; }

.kpi__label {
  font-size: 9.5px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: .1em;
  color: var(--muted);
}
.kpi__ico {
  width: 32px; height: 32px;
  border-radius: 9px;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.kpi__ico svg { width: 15px; height: 15px; display: block; }
.kpi__ico--teal  { background: rgba(1,134,141,.16);  color: #4eccd3; }
.kpi__ico--blue  { background: rgba(30,114,160,.16); color: #5ba8d4; }
.kpi__ico--green { background: rgba(77,143,37,.16);  color: #82c84e; }
.kpi__ico--gold  { background: rgba(201,138,0,.16);  color: #e8b430; }

.kpi__value {
  font-size: 2.1rem;
  font-weight: 900;
  font-variant-numeric: tabular-nums;
  letter-spacing: -.045em;
  line-height: 1;
  color: var(--text-bright);
}
.kpi__value--green { color: #82c84e; }
.kpi__value--gold  { color: #e8b430; }

.kpi__footer { display: flex; align-items: center; justify-content: space-between; gap: 6px; }
.kpi__delta {
  font-size: .6875rem;
  color: var(--muted);
  display: flex;
  align-items: center;
  gap: 4px;
}
.kpi__delta--up   { color: #82c84e; }
.kpi__delta--down { color: #e06060; }

/* ═══ Section label ═════════════════════════════════════════ */
.d-sect {
  display: flex; align-items: center; gap: 10px;
  font-size: 9.5px; font-weight: 700;
  text-transform: uppercase; letter-spacing: .1em;
  color: var(--muted);
  margin: 24px 0 12px;
}
.d-sect::after { content:''; flex:1; height:1px; background: var(--card-border); }

/* ═══ Financial cards ════════════════════════════════════════ */
.fin-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10px;
}
@media(max-width:800px) { .fin-grid { grid-template-columns: repeat(2,1fr); } }
@media(max-width:500px) { .fin-grid { grid-template-columns: 1fr; } }

.fin {
  background: var(--card);
  border: 1px solid var(--card-border);
  border-radius: var(--r);
  padding: 16px 18px;
  display: flex;
  flex-direction: column;
  gap: 10px;
  transition: box-shadow .18s;
}
.fin:hover { box-shadow: 0 6px 22px rgba(0,0,0,.28); }

.fin__top { display: flex; align-items: center; gap: 12px; }
.fin__ico {
  width: 38px; height: 38px;
  border-radius: 10px;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.fin__ico svg { width: 16px; height: 16px; display: block; }
.fin__ico--green { background: rgba(77,143,37,.16);  color: #82c84e; }
.fin__ico--red   { background: rgba(176,48,48,.15);  color: #e06060; }
.fin__ico--gold  { background: rgba(201,138,0,.16);  color: #e8b430; }

.fin__body { display: flex; flex-direction: column; gap: 3px; }
.fin__label { font-size: 9.5px; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; color: var(--muted); }
.fin__value {
  font-size: 1.3rem; font-weight: 900;
  font-variant-numeric: tabular-nums;
  letter-spacing: -.03em;
  line-height: 1.1;
  color: var(--text-bright);
}
.fin__value--green { color: #82c84e; }
.fin__value--red   { color: #e06060; }
.fin__value--gold  { color: #e8b430; }

/* progress track */
.fin__bar-track {
  height: 3px;
  background: rgba(255,255,255,.07);
  border-radius: 99px;
  overflow: hidden;
}
.fin__bar-fill {
  height: 100%;
  border-radius: 99px;
  transition: width .6s ease;
}
.fin__bar-fill--green { background: #82c84e; }
.fin__bar-fill--red   { background: #e06060; }
.fin__bar-fill--gold  { background: #e8b430; }

/* ═══ Status breakdown bar ═══════════════════════════════════ */
.status-bar-card {
  background: var(--card);
  border: 1px solid var(--card-border);
  border-radius: var(--r);
  padding: 18px 20px;
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.status-bar-title {
  font-size: .875rem;
  font-weight: 800;
  color: var(--text-bright);
  letter-spacing: -.02em;
}
.status-seg-wrap {
  display: flex;
  height: 8px;
  border-radius: 99px;
  overflow: hidden;
  gap: 2px;
}
.status-seg {
  border-radius: 99px;
  transition: flex .6s ease;
  min-width: 0;
}
.status-seg--completed  { background: #82c84e; }
.status-seg--processing { background: #5ba8d4; }
.status-seg--pending    { background: #e8b430; }
.status-seg--partial    { background: #e07840; }
.status-seg--cancelled  { background: #e06060; }
.status-seg--refunded   { background: var(--muted); }

.status-legend {
  display: flex;
  flex-wrap: wrap;
  gap: 10px 18px;
}
.status-leg-item {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: .75rem;
  color: var(--text-dim);
}
.status-leg-dot {
  width: 8px; height: 8px;
  border-radius: 50%;
  flex-shrink: 0;
}

/* ═══ Providers ══════════════════════════════════════════════ */
.prov-grid { display: flex; flex-wrap: wrap; gap: 8px; }
.prov {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  background: var(--card);
  border: 1px solid var(--card-border);
  border-radius: 999px;
  padding: 7px 16px 7px 11px;
  transition: border-color .18s, box-shadow .18s;
}
.prov:hover { border-color: rgba(255,255,255,.18); box-shadow: 0 4px 14px rgba(0,0,0,.25); }
.prov__status {
  width: 8px; height: 8px;
  border-radius: 50%;
  flex-shrink: 0;
}
.prov__status--on  { background: #82c84e; box-shadow: 0 0 0 2.5px rgba(130,200,78,.2); }
.prov__status--off { background: var(--muted); }
.prov__name { font-size: .75rem; font-weight: 800; color: var(--text-bright); letter-spacing: -.01em; }
.prov__badge {
  font-size: .625rem;
  font-weight: 700;
  padding: 2px 7px;
  border-radius: 999px;
  letter-spacing: .04em;
  text-transform: uppercase;
}
.prov__badge--smm     { background: rgba(1,134,141,.18);  color: #4eccd3; }
.prov__badge--gateway { background: rgba(201,138,0,.18);  color: #e8b430; }

/* ═══ Bottom grid ════════════════════════════════════════════ */
.bottom-grid {
  display: grid;
  grid-template-columns: 6fr 4fr;
  gap: 12px;
  align-items: start;
}
@media(max-width:960px) { .bottom-grid { grid-template-columns: 1fr; } }

.tbl-card {
  background: var(--card);
  border: 1px solid var(--card-border);
  border-radius: var(--r);
  overflow: hidden;
  display: flex;
  flex-direction: column;
}
.tbl-card__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 13px 18px;
  border-bottom: 1px solid var(--card-border);
  background: var(--card-head);
  flex-shrink: 0;
}
.tbl-card__title { font-size: .875rem; font-weight: 800; color: var(--text-bright); letter-spacing: -.02em; }
.tbl-card__link {
  font-size: .6875rem;
  font-weight: 700;
  color: #4eccd3;
  text-decoration: none;
  transition: color .15s;
  white-space: nowrap;
}
.tbl-card__link:hover { color: #a0edf0; }

.tbl-wrap { overflow-x: auto; }
.tbl { width: 100%; border-collapse: collapse; table-layout: auto; }
.tbl th {
  text-align: left;
  font-size: 9px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: .1em;
  color: var(--muted);
  padding: 8px 14px;
  border-bottom: 1px solid var(--card-border);
  background: var(--card-head);
  white-space: nowrap;
}
.tbl td {
  padding: 10px 14px;
  border-bottom: 1px solid rgba(255,255,255,.035);
  vertical-align: middle;
  font-size: .8125rem;
  color: var(--dde1f0);
}
.tbl tbody tr { transition: background .1s; }
.tbl tbody tr:hover { background: rgba(255,255,255,.035); }
.tbl tbody tr:last-child td { border-bottom: none; }

/* Avatar circle */
.av {
  width: 28px; height: 28px;
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: .625rem;
  font-weight: 800;
  letter-spacing: -.01em;
  text-transform: uppercase;
  flex-shrink: 0;
  user-select: none;
}
.av-cell { display: flex; align-items: center; gap: 9px; }
.av-name  { font-weight: 700; color: #ccd0e8; font-size: .8125rem; white-space: nowrap; }

{% set avColors = [
  ['rgba(1,134,141,.25)','#4eccd3'],
  ['rgba(30,114,160,.25)','#5ba8d4'],
  ['rgba(77,143,37,.25)','#82c84e'],
  ['rgba(201,138,0,.25)','#e8b430'],
  ['rgba(176,48,48,.25)','#e06060'],
  ['rgba(110,70,200,.25)','#a07ee0'],
] %}

.col-id    { white-space: nowrap; color: var(--muted) !important; font-variant-numeric: tabular-nums; font-size: .75rem !important; width: 40px; }
.col-srv   { color: var(--text-dim) !important; min-width: 140px; word-break: break-word; white-space: normal; }
.col-val   { white-space: nowrap; font-variant-numeric: tabular-nums; font-size: .75rem !important; color: var(--text-dim) !important; width: 84px; text-align: right; }
.col-st    { white-space: nowrap; width: 120px; }
.col-mail  { color: var(--text-dim) !important; min-width: 130px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 0; }
.col-bal   { white-space: nowrap; font-variant-numeric: tabular-nums; font-size: .75rem !important; color: var(--text-dim) !important; width: 90px; text-align: right; }
.col-dt    { white-space: nowrap; color: var(--muted) !important; font-size: .75rem !important; width: 68px; }

/* Badge status */
.bst {
  display: inline-flex; align-items: center; gap: 5px;
  padding: 3px 9px;
  border-radius: 999px;
  font-size: 10px; font-weight: 700;
  text-transform: uppercase; letter-spacing: .05em;
  white-space: nowrap;
}
.bst::before { content:''; width:5px; height:5px; border-radius:50%; background:currentColor; flex-shrink:0; }
.bst--completed  { background: rgba(77,143,37,.16);  color: #82c84e; }
.bst--processing { background: rgba(30,114,160,.16); color: #5ba8d4; }
.bst--in_progress{ background: rgba(30,114,160,.12); color: #5ba8d4; }
.bst--cancelled  { background: rgba(176,48,48,.15);  color: #e06060; }
.bst--pending    { background: rgba(201,138,0,.15);  color: #e8b430; }
.bst--partial    { background: rgba(220,120,64,.15); color: #e07840; }
.bst--refunded   { background: rgba(255,255,255,.07);color: var(--muted); }

.d-empty { color: var(--muted); font-size: .8125rem; text-align: center; padding: 32px 16px; }

/* ═══ Order ID link ═════════════════════════════════════════ */
a.ord-link {
  color: var(--muted);
  text-decoration: none;
  font-size: .75rem;
  font-variant-numeric: tabular-nums;
  transition: color .15s;
}
a.ord-link:hover { color: #4eccd3; }
</style>

{# ── Macros ─────────────────────────────────────────── #}
{% macro ico(d) %}<svg style="width:15px;height:15px;display:block;flex-shrink:0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">{{ d|raw }}</svg>{% endmacro %}
{% import _self as i %}

{% set _m = {'01':'janeiro','02':'fevereiro','03':'março','04':'abril','05':'maio','06':'junho','07':'julho','08':'agosto','09':'setembro','10':'outubro','11':'novembro','12':'dezembro'} %}
{% set _hoje = 'now'|date('d') ~ ' de ' ~ _m['now'|date('m')] ~ ' de ' ~ 'now'|date('Y') %}

{# paleta de avatares #}
{% set avPalette = [
  ['rgba(1,134,141,.22)','#4eccd3'],
  ['rgba(30,114,160,.22)','#5ba8d4'],
  ['rgba(77,143,37,.22)','#82c84e'],
  ['rgba(201,138,0,.22)','#e8b430'],
  ['rgba(176,48,48,.22)','#e06060'],
  ['rgba(110,70,200,.22)','#a07ee0'],
  ['rgba(200,80,160,.22)','#e07ec8'],
  ['rgba(0,130,100,.22)','#3ec89e'],
] %}

{# totais por status #}
{% set st_total = ordersTotal > 0 ? ordersTotal : 1 %}
{% set st_completed  = statusCounts.completed  ?? 0 %}
{% set st_processing = (statusCounts.processing ?? 0) + (statusCounts.in_progress ?? 0) %}
{% set st_pending    = statusCounts.pending    ?? 0 %}
{% set st_partial    = statusCounts.partial    ?? 0 %}
{% set st_cancelled  = statusCounts.cancelled  ?? 0 %}
{% set st_refunded   = statusCounts.refunded   ?? 0 %}

<div class="dash">

  {# ── Header ──────────────────────────────────────────── #}
  <div class="dh">
    <div class="dh__left">
      <h1>Dashboard</h1>
      <div class="dh__date">{{ _hoje }}</div>
    </div>
    <div class="dh__actions">
      <a class="dh__btn dh__btn--ghost"
         href="{{ ea_url().setController('App\\Controller\\Admin\\OrderCrudController').generateUrl() }}">
        {{ i.ico('<path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/>') }}
        Pedidos
      </a>
      <a class="dh__btn dh__btn--ghost"
         href="{{ ea_url().setController('App\\Controller\\Admin\\UserCrudController').generateUrl() }}">
        {{ i.ico('<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/>') }}
        Usuários
      </a>
      <a class="dh__btn dh__btn--ghost"
         href="{{ ea_url().setController('App\\Controller\\Admin\\ServiceCrudController').generateUrl() }}">
        {{ i.ico('<rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/>') }}
        Serviços
      </a>
    </div>
  </div>

  {# ── KPIs ─────────────────────────────────────────────── #}
  <div class="kpi-grid">

    <div class="kpi kpi--teal">
      <div class="kpi__row">
        <span class="kpi__label">Usuários</span>
        <span class="kpi__ico kpi__ico--teal">{{ i.ico('<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/>') }}</span>
      </div>
      <div class="kpi__value">{{ usersCount }}</div>
      <div class="kpi__footer">
        <span class="kpi__delta{% if newUsersToday > 0 %} kpi__delta--up{% endif %}">
          {% if newUsersToday > 0 %}▲{% endif %} +{{ newUsersToday }} hoje
        </span>
      </div>
    </div>

    <div class="kpi kpi--blue">
      <div class="kpi__row">
        <span class="kpi__label">Pedidos (30d)</span>
        <span class="kpi__ico kpi__ico--blue">{{ i.ico('<path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/>') }}</span>
      </div>
      <div class="kpi__value">{{ ordersTotal }}</div>
      <div class="kpi__footer">
        <span class="kpi__delta{% if ordersToday > 0 %} kpi__delta--up{% endif %}">
          {% if ordersToday > 0 %}▲{% endif %} {{ ordersToday }} hoje
        </span>
      </div>
    </div>

    <div class="kpi kpi--green">
      <div class="kpi__row">
        <span class="kpi__label">Receita (30d)</span>
        <span class="kpi__ico kpi__ico--green">{{ i.ico('<line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/>') }}</span>
      </div>
      <div class="kpi__value kpi__value--green">R$&nbsp;{{ (revenueCents/100)|number_format(2,',','.') }}</div>
      <div class="kpi__footer">
        <span class="kpi__delta">R$&nbsp;{{ (revenueToday/100)|number_format(2,',','.') }} hoje</span>
      </div>
    </div>

    <div class="kpi kpi--gold">
      <div class="kpi__row">
        <span class="kpi__label">Lucro líquido</span>
        <span class="kpi__ico kpi__ico--gold">{{ i.ico('<polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/>') }}</span>
      </div>
      <div class="kpi__value kpi__value--gold">R$&nbsp;{{ (netProfitCents/100)|number_format(2,',','.') }}</div>
      <div class="kpi__footer">
        <span class="kpi__delta">Após taxas e custos</span>
      </div>
    </div>

  </div>

  {# ── Financeiro ───────────────────────────────────────── #}
  <div class="d-sect">Análise financeira — últimos 30 dias</div>

  {% set maxFin = max(revenueCents, expensesCents, feesCents, 1) %}

  <div class="fin-grid">
    <div class="fin">
      <div class="fin__top">
        <span class="fin__ico fin__ico--green">{{ i.ico('<line x1="12" y1="19" x2="12" y2="5"/><polyline points="5 12 12 5 19 12"/>') }}</span>
        <div class="fin__body">
          <div class="fin__label">Entradas (depósitos)</div>
          <div class="fin__value fin__value--green">R$&nbsp;{{ (revenueCents/100)|number_format(2,',','.') }}</div>
        </div>
      </div>
      <div class="fin__bar-track"><div class="fin__bar-fill fin__bar-fill--green" style="width:{{ (revenueCents/maxFin*100)|round }}%"></div></div>
    </div>

    <div class="fin">
      <div class="fin__top">
        <span class="fin__ico fin__ico--red">{{ i.ico('<line x1="12" y1="5" x2="12" y2="19"/><polyline points="19 12 12 19 5 12"/>') }}</span>
        <div class="fin__body">
          <div class="fin__label">Saídas (custo providers)</div>
          <div class="fin__value fin__value--red">R$&nbsp;{{ (expensesCents/100)|number_format(2,',','.') }}</div>
        </div>
      </div>
      <div class="fin__bar-track"><div class="fin__bar-fill fin__bar-fill--red" style="width:{{ (expensesCents/maxFin*100)|round }}%"></div></div>
    </div>

    <div class="fin">
      <div class="fin__top">
        <span class="fin__ico fin__ico--gold">{{ i.ico('<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>') }}</span>
        <div class="fin__body">
          <div class="fin__label">Taxas (gateways)</div>
          <div class="fin__value fin__value--gold">R$&nbsp;{{ (feesCents/100)|number_format(2,',','.') }}</div>
        </div>
      </div>
      <div class="fin__bar-track"><div class="fin__bar-fill fin__bar-fill--gold" style="width:{{ (feesCents/maxFin*100)|round }}%"></div></div>
    </div>
  </div>

  {# ── Status breakdown ─────────────────────────────────── #}
  <div class="d-sect">Distribuição de pedidos por status</div>
  <div class="status-bar-card">
    <div class="status-seg-wrap">
      {% if st_completed  > 0 %}<div class="status-seg status-seg--completed"  style="flex:{{ st_completed }}"></div>{% endif %}
      {% if st_processing > 0 %}<div class="status-seg status-seg--processing" style="flex:{{ st_processing }}"></div>{% endif %}
      {% if st_pending    > 0 %}<div class="status-seg status-seg--pending"    style="flex:{{ st_pending }}"></div>{% endif %}
      {% if st_partial    > 0 %}<div class="status-seg status-seg--partial"    style="flex:{{ st_partial }}"></div>{% endif %}
      {% if st_cancelled  > 0 %}<div class="status-seg status-seg--cancelled"  style="flex:{{ st_cancelled }}"></div>{% endif %}
      {% if st_refunded   > 0 %}<div class="status-seg status-seg--refunded"   style="flex:{{ st_refunded }}"></div>{% endif %}
      {% if ordersTotal == 0  %}<div class="status-seg" style="flex:1;background:rgba(255,255,255,.07)"></div>{% endif %}
    </div>
    <div class="status-legend">
      {% set legend = [
        ['completed','#82c84e','Concluído',st_completed],
        ['processing','#5ba8d4','Em andamento',st_processing],
        ['pending','#e8b430','Pendente',st_pending],
        ['partial','#e07840','Parcial',st_partial],
        ['cancelled','#e06060','Cancelado',st_cancelled],
        ['refunded','#8b90a8','Reembolsado',st_refunded],
      ] %}
      {% for leg in legend %}
        {% if leg[3] > 0 %}
        <div class="status-leg-item">
          <span class="status-leg-dot" style="background:{{ leg[1] }}"></span>
          {{ leg[2] }} <strong style="color:#dde1f0;margin-left:3px">{{ leg[3] }}</strong>
        </div>
        {% endif %}
      {% endfor %}
      {% if ordersTotal == 0 %}
        <span style="color:var(--muted);font-size:.75rem">Nenhum pedido ainda</span>
      {% endif %}
    </div>
  </div>

  {# ── Providers ────────────────────────────────────────── #}
  <div class="d-sect">Providers &amp; Gateways</div>
  <div class="prov-grid">
    {% for cred in credentials %}
    <div class="prov">
      <span class="prov__status prov__status--{{ cred.active ? 'on' : 'off' }}"></span>
      <span class="prov__name">{{ cred.slug|upper }}</span>
      <span class="prov__badge prov__badge--{{ cred.type == 'payment_gateway' ? 'gateway' : 'smm' }}">
        {{ cred.type == 'payment_gateway' ? 'Gateway' : 'SMM' }}
      </span>
    </div>
    {% else %}
    <p class="d-empty">Nenhuma credencial cadastrada.</p>
    {% endfor %}
  </div>

  {# ── Tabelas ──────────────────────────────────────────── #}
  <div class="d-sect" style="margin-top:28px">Atividade recente</div>
  <div class="bottom-grid">

    {# Pedidos recentes #}
    <div class="tbl-card">
      <div class="tbl-card__head">
        <span class="tbl-card__title">Pedidos recentes</span>
        <a class="tbl-card__link" href="{{ ea_url().setController('App\\Controller\\Admin\\OrderCrudController').generateUrl() }}">Ver todos →</a>
      </div>
      {% if recentOrders|length > 0 %}
      <div class="tbl-wrap">
        <table class="tbl">
          <thead><tr>
            <th>#</th>
            <th>Usuário</th>
            <th>Serviço</th>
            <th style="text-align:right">Valor</th>
            <th>Status</th>
          </tr></thead>
          <tbody>
            {% for o in recentOrders %}
            {% set st = o.status %}
            {% set av = avPalette[loop.index0 % avPalette|length] %}
            <tr>
              <td class="col-id">
                <a class="ord-link" href="{{ ea_url().setController('App\\Controller\\Admin\\OrderCrudController').setAction('show').setEntityId(o.id).generateUrl() }}">#{{ o.id }}</a>
              </td>
              <td>
                <div class="av-cell">
                  <div class="av" style="background:{{ av[0] }};color:{{ av[1] }}">{{ o.user.name|slice(0,2) }}</div>
                  <span class="av-name">{{ o.user.name }}</span>
                </div>
              </td>
              <td class="col-srv" title="{{ o.service.name }}">{{ o.service.name }}</td>
              <td class="col-val">R$&nbsp;{{ (o.amountCents/100)|number_format(2,',','.') }}</td>
              <td class="col-st">
                {% set bclass = {
                  'completed':'completed','processing':'processing',
                  'in_progress':'in_progress','cancelled':'cancelled',
                  'pending':'pending','partial':'partial','refunded':'refunded'
                } %}
                <span class="bst bst--{{ bclass[st] ?? 'refunded' }}">{{ st|replace({'_':' '})|capitalize }}</span>
              </td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      {% else %}
        <p class="d-empty">Nenhum pedido ainda.</p>
      {% endif %}
    </div>

    {# Usuários recentes #}
    <div class="tbl-card">
      <div class="tbl-card__head">
        <span class="tbl-card__title">Usuários recentes</span>
        <a class="tbl-card__link" href="{{ ea_url().setController('App\\Controller\\Admin\\UserCrudController').generateUrl() }}">Ver todos →</a>
      </div>
      {% if recentUsers|length > 0 %}
      <div class="tbl-wrap">
        <table class="tbl">
          <thead><tr>
            <th>Nome</th>
            <th>E-mail</th>
            <th style="text-align:right">Saldo</th>
            <th>Desde</th>
          </tr></thead>
          <tbody>
            {% for u in recentUsers %}
            {% set av = avPalette[loop.index0 % avPalette|length] %}
            <tr>
              <td>
                <div class="av-cell">
                  <div class="av" style="background:{{ av[0] }};color:{{ av[1] }}">{{ u.name|slice(0,2) }}</div>
                  <span class="av-name">{{ u.name }}</span>
                </div>
              </td>
              <td class="col-mail" title="{{ u.email }}">{{ u.email }}</td>
              <td class="col-bal">R$&nbsp;{{ u.wallet ? (u.wallet.balanceCents/100)|number_format(2,',','.') : '0,00' }}</td>
              <td class="col-dt">{{ u.createdAt|date('d/m/Y') }}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      {% else %}
        <p class="d-empty">Nenhum usuário ainda.</p>
      {% endif %}
    </div>

  </div>
</div>
{% endblock %}
