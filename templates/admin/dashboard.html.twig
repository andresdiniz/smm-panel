{% extends '@EasyAdmin/page/content.html.twig' %}

{% block page_title %}Dashboard Administrativo{% endblock %}

{% block head_stylesheets %}
  {{ parent() }}
  <link rel="stylesheet" href="{{ asset('css/admin.css') }}">
{% endblock %}

{% block main %}

{# ── KPIs principais ── #}
<div class="adm-grid">

  <div class="adm-kpi">
    <div class="adm-kpi__icon adm-kpi__icon--teal">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
        <circle cx="9" cy="7" r="4"/>
        <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
        <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
      </svg>
    </div>
    <div class="adm-kpi__label">Usuários totais</div>
    <div class="adm-kpi__value">{{ usersCount }}</div>
    <div class="adm-kpi__delta">+{{ newUsersToday }} hoje</div>
  </div>

  <div class="adm-kpi">
    <div class="adm-kpi__icon adm-kpi__icon--blue">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/>
        <line x1="3" y1="6" x2="21" y2="6"/>
        <path d="M16 10a4 4 0 01-8 0"/>
      </svg>
    </div>
    <div class="adm-kpi__label">Pedidos (30d)</div>
    <div class="adm-kpi__value">{{ ordersTotal }}</div>
    <div class="adm-kpi__delta">{{ ordersToday }} hoje</div>
  </div>

  <div class="adm-kpi">
    <div class="adm-kpi__icon adm-kpi__icon--green">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="12" y1="1" x2="12" y2="23"/>
        <path d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/>
      </svg>
    </div>
    <div class="adm-kpi__label">Receita (30d)</div>
    <div class="adm-kpi__value adm-kpi__value--green">
      R$&nbsp;{{ (revenueCents / 100)|number_format(2, ',', '.') }}
    </div>
    <div class="adm-kpi__delta">R$&nbsp;{{ (revenueToday / 100)|number_format(2, ',', '.') }} hoje</div>
  </div>

  <div class="adm-kpi">
    <div class="adm-kpi__icon adm-kpi__icon--gold">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/>
        <polyline points="16 7 22 7 22 13"/>
      </svg>
    </div>
    <div class="adm-kpi__label">Lucro líquido (30d)</div>
    <div class="adm-kpi__value adm-kpi__value--gold">
      R$&nbsp;{{ (netProfitCents / 100)|number_format(2, ',', '.') }}
    </div>
    <div class="adm-kpi__delta">Após taxas e custos</div>
  </div>

</div>

{# ── Análise financeira ── #}
<div class="adm-section-label">Análise financeira — últimos 30 dias</div>
<div class="fin-grid">

  <div class="fin-card">
    <div class="fin-card__icon fin-card__icon--green">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/>
        <polyline points="17 6 23 6 23 12"/>
      </svg>
    </div>
    <div class="fin-card__label">Entradas (depósitos)</div>
    <div class="fin-card__value fin-card__value--green">
      R$&nbsp;{{ (revenueCents / 100)|number_format(2, ',', '.') }}
    </div>
  </div>

  <div class="fin-card">
    <div class="fin-card__icon fin-card__icon--red">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="23 18 13.5 8.5 8.5 13.5 1 6"/>
        <polyline points="17 18 23 18 23 12"/>
      </svg>
    </div>
    <div class="fin-card__label">Saídas (custo providers)</div>
    <div class="fin-card__value fin-card__value--red">
      R$&nbsp;{{ (expensesCents / 100)|number_format(2, ',', '.') }}
    </div>
  </div>

  <div class="fin-card">
    <div class="fin-card__icon fin-card__icon--gold">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
      </svg>
    </div>
    <div class="fin-card__label">Taxas (gateways)</div>
    <div class="fin-card__value fin-card__value--gold">
      R$&nbsp;{{ (feesCents / 100)|number_format(2, ',', '.') }}
    </div>
  </div>

</div>

{# ── Providers / Gateways ── #}
<div class="adm-section-label">Providers &amp; Gateways</div>
<div class="provider-grid">
  {% for cred in credentials %}
  <div class="provider-card">
    <div class="provider-dot provider-dot--{{ cred.active ? 'on' : 'off' }}"></div>
    <div class="provider-info">
      <strong>{{ cred.slug|upper }}</strong>
      <span>{{ cred.type == 'payment_gateway' ? 'Gateway' : 'SMM' }} &mdash; {{ cred.active ? 'Ativo' : 'Inativo' }}</span>
    </div>
  </div>
  {% else %}
  <p class="adm-empty">Nenhuma credencial cadastrada.</p>
  {% endfor %}
</div>

{# ── Pedidos + Usuários recentes ── #}
<div class="adm-row">

  <div class="adm-card">
    <div class="adm-card__head">
      <h3>Pedidos recentes</h3>
      <a href="{{ ea_url().setController('App\\Controller\\Admin\\OrderCrudController').generateUrl() }}">Ver todos →</a>
    </div>
    {% if recentOrders|length > 0 %}
    <div class="adm-table-wrap">
      <table class="adm-table">
        <thead>
          <tr>
            <th>#</th>
            <th>Usuário</th>
            <th>Serviço</th>
            <th>Valor</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          {% for order in recentOrders %}
          <tr>
            <td class="cell-id">{{ order.id }}</td>
            <td class="cell-name">{{ order.user.name }}</td>
            <td class="cell-muted cell-truncate">{{ order.service.name }}</td>
            <td class="cell-mono">R$&nbsp;{{ (order.amountCents / 100)|number_format(2, ',', '.') }}</td>
            <td>
              <span class="adm-badge adm-badge--{{ order.status == 'completed' ? 'green' : (order.status == 'cancelled' ? 'red' : (order.status == 'pending' ? 'grey' : 'blue')) }}">
                {{ order.status|replace({'_': ' '})|capitalize }}
              </span>
            </td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% else %}
    <p class="adm-empty">Nenhum pedido ainda.</p>
    {% endif %}
  </div>

  <div class="adm-card">
    <div class="adm-card__head">
      <h3>Usuários recentes</h3>
      <a href="{{ ea_url().setController('App\\Controller\\Admin\\UserCrudController').generateUrl() }}">Ver todos →</a>
    </div>
    {% if recentUsers|length > 0 %}
    <div class="adm-table-wrap">
      <table class="adm-table">
        <thead>
          <tr>
            <th>Nome</th>
            <th>E-mail</th>
            <th>Saldo</th>
            <th>Desde</th>
          </tr>
        </thead>
        <tbody>
          {% for user in recentUsers %}
          <tr>
            <td class="cell-name">{{ user.name }}</td>
            <td class="cell-muted">{{ user.email }}</td>
            <td class="cell-mono">R$&nbsp;{{ user.wallet ? (user.wallet.balanceCents / 100)|number_format(2, ',', '.') : '0,00' }}</td>
            <td class="cell-muted cell-mono">{{ user.createdAt|date('d/m/Y') }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% else %}
    <p class="adm-empty">Nenhum usuário ainda.</p>
    {% endif %}
  </div>

</div>

{% endblock %}
