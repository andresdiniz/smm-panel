{% extends '@EasyAdmin/page/content.html.twig' %}
{% block page_title %}Dashboard{% endblock %}

{% block head_stylesheets %}
  {{ parent() }}
  <link rel="preconnect" href="https://api.fontshare.com">
  <link href="https://api.fontshare.com/v2/css?f[]=satoshi@400,500,600,700,800,900&display=swap" rel="stylesheet">
{% endblock %}

{% block head_javascript %}{{ parent() }}{% endblock %}

{% block content_title %}{% endblock %}

{% block main %}
<style>
/* ═══════════════════════════════════════════════════════════
   PulseSMM Admin — Design Premium (override EasyAdmin)
   ═══════════════════════════════════════════════════════════ */

:root {
  --f:    'Satoshi', -apple-system, BlinkMacSystemFont, sans-serif;
  --bg:   #f0efec;
  --s0:   #fafaf8;
  --s1:   #ffffff;
  --off:  #e8e7e4;
  --b1:   rgba(0,0,0,.09);
  --b2:   rgba(0,0,0,.05);
  --t1:   #0c0c0b;
  --t2:   #6b6a67;
  --t3:   #acacaa;
  --acc:  #00696f;
  --acc2: #004d52;
  --grn:  #24601a; --grn-bg: #d8f0d0;
  --red:  #8a2065; --red-bg: #f5dced;
  --gld:  #875d00; --gld-bg: #f5e9cc;
  --blu:  #1a4e80; --blu-bg: #d4e5f5;
  --sb:   #111112;
  --sb-b: rgba(255,255,255,.06);
  --r1: 5px; --r2: 8px; --r3: 12px; --rp: 999px;
  --sh0: 0 1px 2px rgba(0,0,0,.04);
  --sh1: 0 1px 3px rgba(0,0,0,.07), 0 2px 8px rgba(0,0,0,.04);
  --sh2: 0 4px 16px rgba(0,0,0,.1), 0 1px 4px rgba(0,0,0,.05);
  --tr: 130ms cubic-bezier(.16,1,.3,1);
}

/* ── FONT GLOBAL ── */
body, .content-wrapper, .sidebar, .main-header,
.content-panel, h1,h2,h3,h4,h5,h6,p,a,td,th,label,input,button,select,textarea {
  font-family: var(--f) !important;
}

/* ── BG ── */
body { background: var(--bg) !important; color: var(--t1) !important; -webkit-font-smoothing: antialiased !important; }
.content-wrapper, .ea-content-width-full { background: var(--bg) !important; }
.content-panel { background: transparent !important; border: none !important; box-shadow: none !important; padding: 0 22px 22px !important; }

/* ── SUMIR o header padrão EA ── */
.content-header, .page-header { display: none !important; }

/* ── TOPBAR ── */
.main-header {
  height: 48px !important;
  background: rgba(250,250,248,.94) !important;
  backdrop-filter: blur(18px) !important;
  -webkit-backdrop-filter: blur(18px) !important;
  border-bottom: 1px solid var(--b1) !important;
  box-shadow: none !important;
  position: sticky !important; top: 0 !important; z-index: 200 !important;
}
.main-header .user-name, .main-header .user-details, .main-header a {
  font-size: .8125rem !important; color: var(--t2) !important;
}

/* ── SIDEBAR ── */
.sidebar {
  width: 200px !important;
  background: var(--sb) !important;
  border-right: none !important;
}
.sidebar-brand, .sidebar .sidebar-brand {
  height: 48px !important;
  padding: 0 14px !important;
  border-bottom: 1px solid var(--sb-b) !important;
  display: flex !important; align-items: center !important;
}
.sidebar-brand a, .sidebar .sidebar-brand a {
  font-size: .9rem !important; font-weight: 900 !important;
  letter-spacing: -.05em !important; color: #fff !important;
  text-decoration: none !important;
}
.sidebar .sidebar-menu { padding: 6px 7px !important; }
.sidebar .sidebar-menu li.sidebar-separator {
  font-size: 9px !important; font-weight: 700 !important;
  text-transform: uppercase !important; letter-spacing: .1em !important;
  color: rgba(255,255,255,.2) !important;
  padding: 14px 6px 3px !important; list-style: none !important;
}
.sidebar .sidebar-menu .menu-item { list-style: none !important; }
.sidebar .sidebar-menu .menu-item > a {
  display: flex !important; align-items: center !important; gap: 7px !important;
  padding: 5px 7px !important; border-radius: var(--r1) !important;
  color: rgba(255,255,255,.42) !important;
  font-size: .8125rem !important; font-weight: 500 !important;
  text-decoration: none !important;
  transition: background var(--tr), color var(--tr) !important;
  margin: 1px 0 !important;
}
.sidebar .sidebar-menu .menu-item > a:hover {
  background: rgba(255,255,255,.06) !important;
  color: rgba(255,255,255,.88) !important;
}
.sidebar .sidebar-menu .menu-item.active > a {
  background: rgba(255,255,255,.11) !important;
  color: #fff !important; font-weight: 600 !important;
}

/* ── DATAGRID (outras páginas EA) ── */
.datagrid { background: var(--s1); border: 1px solid var(--b1); border-radius: var(--r3); box-shadow: var(--sh1); overflow: hidden; }
.datagrid thead th { background: var(--s0) !important; font-size: 9.5px !important; font-weight: 700 !important; text-transform: uppercase !important; letter-spacing: .08em !important; color: var(--t2) !important; padding: 7px 14px !important; border-bottom: 1px solid var(--b1) !important; }
.datagrid tbody td { padding: 8px 14px !important; font-size: .8125rem !important; color: var(--t1) !important; border-bottom: 1px solid var(--b2) !important; }
.datagrid tbody tr:hover { background: var(--s0) !important; }
.datagrid tbody tr:last-child td { border-bottom: none !important; }

/* ── BTNS ── */
.btn { font-weight: 600 !important; border-radius: var(--rp) !important; font-size: .8125rem !important; transition: all var(--tr) !important; }
.btn-primary, .action-new .btn { background: var(--acc) !important; border-color: var(--acc) !important; color: #fff !important; }
.btn-primary:hover, .action-new .btn:hover { background: var(--acc2) !important; border-color: var(--acc2) !important; }

/* ── BADGE (EA) ── */
.badge { font-weight: 700 !important; font-size: .6875rem !important; border-radius: var(--rp) !important; padding: 2px 8px !important; }

/* ── SCROLLBAR ── */
::-webkit-scrollbar { width: 5px; height: 5px; }
::-webkit-scrollbar-thumb { background: var(--b1); border-radius: 99px; }


/* ═══════════════════════════════════════════
   DASHBOARD COMPONENTS
   ═══════════════════════════════════════════ */

.dash {
  padding: 20px 0 0;
}

/* PAGE HEADER */
.d-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 20px;
}
.d-header__title {
  font-size: 1.0625rem;
  font-weight: 800;
  letter-spacing: -.035em;
  color: var(--t1);
  margin: 0;
}
.d-header__date {
  font-size: .75rem;
  color: var(--t3);
  margin-top: 2px;
}

/* ── KPI GRID ── */
.kpi-grid {
  display: grid;
  grid-template-columns: repeat(4,1fr);
  gap: 10px;
  margin-bottom: 22px;
}
@media(max-width:1100px){.kpi-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:560px){.kpi-grid{grid-template-columns:1fr}}

.kpi {
  background: var(--s1);
  border: 1px solid var(--b1);
  border-radius: var(--r3);
  padding: 16px 18px 14px;
  box-shadow: var(--sh1);
  display: flex;
  flex-direction: column;
  gap: 6px;
  position: relative;
  overflow: hidden;
  transition: box-shadow var(--tr), transform var(--tr);
  cursor: default;
}
.kpi:hover { box-shadow: var(--sh2); transform: translateY(-1px); }

/* accent top strip */
.kpi::after {
  content: '';
  position: absolute;
  inset: 0 0 auto 0;
  height: 3px;
  border-radius: var(--r3) var(--r3) 0 0;
}
.kpi--teal::after  { background: var(--acc); }
.kpi--blue::after  { background: var(--blu); }
.kpi--green::after { background: var(--grn); }
.kpi--gold::after  { background: var(--gld); }

.kpi__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.kpi__label {
  font-size: 10px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: .08em;
  color: var(--t2);
}
.kpi__ico {
  width: 24px; height: 24px;
  border-radius: var(--r1);
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.kpi__ico svg { width: 12px; height: 12px; display: block; }
.kpi__ico--teal  { background: rgba(0,105,111,.1);  color: var(--acc); }
.kpi__ico--blue  { background: rgba(26,78,128,.1);  color: var(--blu); }
.kpi__ico--green { background: rgba(36,96,26,.1);   color: var(--grn); }
.kpi__ico--gold  { background: rgba(135,93,0,.1);   color: var(--gld); }

.kpi__value {
  font-size: 1.75rem;
  font-weight: 900;
  font-variant-numeric: tabular-nums;
  letter-spacing: -.045em;
  line-height: 1;
  color: var(--t1);
}
.kpi__value--green { color: var(--grn); }
.kpi__value--gold  { color: var(--gld); }

.kpi__delta {
  font-size: .6875rem;
  color: var(--t3);
}

/* ── SECTION DIVIDER ── */
.d-sect {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 9.5px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: .09em;
  color: var(--t3);
  margin-bottom: 10px;
}
.d-sect::after { content: ''; flex: 1; height: 1px; background: var(--b1); }

/* ── FIN CARDS ── */
.fin-grid {
  display: grid;
  grid-template-columns: repeat(3,1fr);
  gap: 10px;
  margin-bottom: 22px;
}
@media(max-width:820px){.fin-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:520px){.fin-grid{grid-template-columns:1fr}}

.fin {
  background: var(--s1);
  border: 1px solid var(--b1);
  border-radius: var(--r2);
  padding: 14px 16px;
  box-shadow: var(--sh0);
  display: flex;
  align-items: center;
  gap: 12px;
  transition: box-shadow var(--tr);
}
.fin:hover { box-shadow: var(--sh1); }
.fin__stripe {
  width: 4px;
  border-radius: 99px;
  align-self: stretch;
  flex-shrink: 0;
}
.fin__stripe--green { background: var(--grn); }
.fin__stripe--red   { background: var(--red); }
.fin__stripe--gold  { background: var(--gld); }
.fin__body { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
.fin__label {
  font-size: 9.5px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: .08em;
  color: var(--t2);
  white-space: nowrap;
}
.fin__value {
  font-size: 1.25rem;
  font-weight: 900;
  font-variant-numeric: tabular-nums;
  letter-spacing: -.03em;
  line-height: 1.1;
}
.fin__value--green { color: var(--grn); }
.fin__value--red   { color: var(--red); }
.fin__value--gold  { color: var(--gld); }

/* ── PROVIDERS ── */
.prov-grid { display: flex; flex-wrap: wrap; gap: 7px; margin-bottom: 22px; }
.prov {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  background: var(--s1);
  border: 1px solid var(--b1);
  border-radius: var(--rp);
  padding: 5px 12px 5px 9px;
  box-shadow: var(--sh0);
  transition: box-shadow var(--tr);
}
.prov:hover { box-shadow: var(--sh1); }
.prov__dot {
  width: 6px; height: 6px;
  border-radius: 50%;
  flex-shrink: 0;
}
.prov__dot--on  { background: var(--grn); box-shadow: 0 0 0 2.5px var(--grn-bg); }
.prov__dot--off { background: var(--t3); }
.prov__name { font-size: .75rem; font-weight: 800; letter-spacing: -.02em; color: var(--t1); }
.prov__type { font-size: .6875rem; color: var(--t3); }

/* ── TABLE CARDS ── */
.tbl-pair {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
  margin-bottom: 16px;
}
@media(max-width:920px){.tbl-pair{grid-template-columns:1fr}}

.tbl-card {
  background: var(--s1);
  border: 1px solid var(--b1);
  border-radius: var(--r3);
  overflow: hidden;
  box-shadow: var(--sh1);
  display: flex;
  flex-direction: column;
}
.tbl-card__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10px 16px;
  border-bottom: 1px solid var(--b1);
  background: var(--s0);
  flex-shrink: 0;
}
.tbl-card__title {
  font-size: .8125rem;
  font-weight: 800;
  letter-spacing: -.025em;
  color: var(--t1);
}
.tbl-card__link {
  font-size: .6875rem;
  font-weight: 700;
  color: var(--acc);
  text-decoration: none;
  white-space: nowrap;
  transition: color var(--tr);
}
.tbl-card__link:hover { color: var(--acc2); }

.tbl-wrap { overflow-x: auto; flex: 1; }
.tbl {
  width: 100%;
  border-collapse: collapse;
}
.tbl th {
  text-align: left;
  font-size: 9.5px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: .08em;
  color: var(--t2);
  padding: 7px 16px;
  border-bottom: 1px solid var(--b1);
  background: var(--s0);
  white-space: nowrap;
}
.tbl td {
  padding: 7px 16px;
  border-bottom: 1px solid var(--b2);
  vertical-align: middle;
  font-size: .8125rem;
  color: var(--t1);
}
.tbl tbody tr { transition: background 100ms; }
.tbl tbody tr:hover { background: var(--s0); }
.tbl tbody tr:last-child td { border-bottom: none; }

.c-id    { color: var(--t3); font-size: .6875rem; width: 22px; padding-right: 4px !important; }
.c-bold  { font-weight: 700; letter-spacing: -.02em; }
.c-muted { color: var(--t2); font-size: .75rem; }
.c-mono  { font-variant-numeric: tabular-nums; font-weight: 600; white-space: nowrap; }
.c-clip  { max-width: 115px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

/* ── BADGES ── */
.badge-s {
  display: inline-flex;
  align-items: center;
  padding: 2px 7px;
  border-radius: var(--rp);
  font-size: .6875rem;
  font-weight: 700;
  letter-spacing: .02em;
  text-transform: capitalize;
  white-space: nowrap;
}
.badge-s--green { background: var(--grn-bg); color: var(--grn); }
.badge-s--blue  { background: var(--blu-bg); color: var(--blu); }
.badge-s--grey  { background: var(--off);    color: var(--t2); border: 1px solid var(--b1); }
.badge-s--red   { background: var(--red-bg); color: var(--red); }
.badge-s--gold  { background: var(--gld-bg); color: var(--gld); }

.d-empty { color: var(--t3); font-size: .8125rem; text-align: center; padding: 28px 16px; }
</style>

{# Macro icon — sempre 12×12 #}
{% macro ico(d) %}<svg style="width:12px;height:12px;display:block;flex-shrink:0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">{{ d|raw }}</svg>{% endmacro %}
{% import _self as i %}

<div class="dash">

  {# PAGE HEADER #}
  <div class="d-header">
    <div>
      <h1 class="d-header__title">Dashboard</h1>
      <div class="d-header__date">{{ 'now'|date('d \\d\\e F \\d\\e Y') }}</div>
    </div>
  </div>

  {# KPIs #}
  <div class="kpi-grid">

    <div class="kpi kpi--teal">
      <div class="kpi__top">
        <span class="kpi__label">Usuários</span>
        <span class="kpi__ico kpi__ico--teal">{{ i.ico('<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/>') }}</span>
      </div>
      <div class="kpi__value">{{ usersCount }}</div>
      <div class="kpi__delta">+{{ newUsersToday }} hoje</div>
    </div>

    <div class="kpi kpi--blue">
      <div class="kpi__top">
        <span class="kpi__label">Pedidos (30d)</span>
        <span class="kpi__ico kpi__ico--blue">{{ i.ico('<path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/>') }}</span>
      </div>
      <div class="kpi__value">{{ ordersTotal }}</div>
      <div class="kpi__delta">{{ ordersToday }} hoje</div>
    </div>

    <div class="kpi kpi--green">
      <div class="kpi__top">
        <span class="kpi__label">Receita (30d)</span>
        <span class="kpi__ico kpi__ico--green">{{ i.ico('<line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/>') }}</span>
      </div>
      <div class="kpi__value kpi__value--green">R$&nbsp;{{ (revenueCents/100)|number_format(2,',','.') }}</div>
      <div class="kpi__delta">R$&nbsp;{{ (revenueToday/100)|number_format(2,',','.') }} hoje</div>
    </div>

    <div class="kpi kpi--gold">
      <div class="kpi__top">
        <span class="kpi__label">Lucro líquido</span>
        <span class="kpi__ico kpi__ico--gold">{{ i.ico('<polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/>') }}</span>
      </div>
      <div class="kpi__value kpi__value--gold">R$&nbsp;{{ (netProfitCents/100)|number_format(2,',','.') }}</div>
      <div class="kpi__delta">Após taxas e custos</div>
    </div>

  </div>

  {# ANÁLISE FINANCEIRA #}
  <div class="d-sect">Análise financeira — últimos 30 dias</div>
  <div class="fin-grid">

    <div class="fin">
      <div class="fin__stripe fin__stripe--green"></div>
      <div class="fin__body">
        <div class="fin__label">Entradas (depósitos)</div>
        <div class="fin__value fin__value--green">R$&nbsp;{{ (revenueCents/100)|number_format(2,',','.') }}</div>
      </div>
    </div>

    <div class="fin">
      <div class="fin__stripe fin__stripe--red"></div>
      <div class="fin__body">
        <div class="fin__label">Saídas (custo providers)</div>
        <div class="fin__value fin__value--red">R$&nbsp;{{ (expensesCents/100)|number_format(2,',','.') }}</div>
      </div>
    </div>

    <div class="fin">
      <div class="fin__stripe fin__stripe--gold"></div>
      <div class="fin__body">
        <div class="fin__label">Taxas (gateways)</div>
        <div class="fin__value fin__value--gold">R$&nbsp;{{ (feesCents/100)|number_format(2,',','.') }}</div>
      </div>
    </div>

  </div>

  {# PROVIDERS #}
  <div class="d-sect">Providers &amp; Gateways</div>
  <div class="prov-grid">
    {% for cred in credentials %}
    <div class="prov">
      <span class="prov__dot prov__dot--{{ cred.active ? 'on' : 'off' }}"></span>
      <span class="prov__name">{{ cred.slug|upper }}</span>
      <span class="prov__type">{{ cred.type == 'payment_gateway' ? 'Gateway' : 'SMM' }}</span>
    </div>
    {% else %}
    <p class="d-empty">Nenhuma credencial.</p>
    {% endfor %}
  </div>

  {# TABLES #}
  <div class="tbl-pair">

    <div class="tbl-card">
      <div class="tbl-card__head">
        <span class="tbl-card__title">Pedidos recentes</span>
        <a class="tbl-card__link" href="{{ ea_url().setController('App\\Controller\\Admin\\OrderCrudController').generateUrl() }}">Ver todos →</a>
      </div>
      {% if recentOrders|length > 0 %}
      <div class="tbl-wrap">
        <table class="tbl">
          <thead><tr><th>#</th><th>Usuário</th><th>Serviço</th><th>Valor</th><th>Status</th></tr></thead>
          <tbody>
            {% for o in recentOrders %}
            <tr>
              <td class="c-id">{{ o.id }}</td>
              <td class="c-bold">{{ o.user.name }}</td>
              <td class="c-muted c-clip">{{ o.service.name }}</td>
              <td class="c-mono">R$&nbsp;{{ (o.amountCents/100)|number_format(2,',','.') }}</td>
              <td>
                {% set st = o.status %}
                <span class="badge-s badge-s--{{ st=='completed'?'green':(st=='cancelled'?'red':(st=='processing'?'blue':'grey')) }}">
                  {{ st|replace({'_':' '})|capitalize }}
                </span>
              </td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      {% else %}<p class="d-empty">Nenhum pedido ainda.</p>{% endif %}
    </div>

    <div class="tbl-card">
      <div class="tbl-card__head">
        <span class="tbl-card__title">Usuários recentes</span>
        <a class="tbl-card__link" href="{{ ea_url().setController('App\\Controller\\Admin\\UserCrudController').generateUrl() }}">Ver todos →</a>
      </div>
      {% if recentUsers|length > 0 %}
      <div class="tbl-wrap">
        <table class="tbl">
          <thead><tr><th>Nome</th><th>E-mail</th><th>Saldo</th><th>Desde</th></tr></thead>
          <tbody>
            {% for u in recentUsers %}
            <tr>
              <td class="c-bold">{{ u.name }}</td>
              <td class="c-muted">{{ u.email }}</td>
              <td class="c-mono">R$&nbsp;{{ u.wallet ? (u.wallet.balanceCents/100)|number_format(2,',','.') : '0,00' }}</td>
              <td class="c-muted c-mono">{{ u.createdAt|date('d/m/Y') }}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      {% else %}<p class="d-empty">Nenhum usuário ainda.</p>{% endif %}
    </div>

  </div>

</div>
{% endblock %}
