{% extends '@EasyAdmin/page/content.html.twig' %}
{% block page_title %}Dashboard{% endblock %}
{% block head_javascript %}{{ parent() }}{% endblock %}
{% block content_title %}{% endblock %}

{% block main %}
<style>
/* ══ ADMIN DASHBOARD v2 ══ */

.dash { padding: 20px 0 48px; }

/* ─ Header ─ */
.d-hd { display:flex; align-items:baseline; justify-content:space-between; margin-bottom:22px; }
.d-hd__title { font-size:1.0625rem; font-weight:900; letter-spacing:-.03em; color:var(--t1); margin:0; }
.d-hd__date  { font-size:.75rem; color:var(--t3); margin-top:3px; }

/* ─ KPI grid ─ */
.kpi-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:10px; margin-bottom:20px; }
@media(max-width:1100px){ .kpi-grid{ grid-template-columns:repeat(2,1fr) } }
@media(max-width:560px) { .kpi-grid{ grid-template-columns:1fr } }

.kpi {
  background:var(--s1); border:1px solid var(--b1); border-radius:var(--r3);
  padding:16px 18px 14px; box-shadow:var(--sh1);
  display:flex; flex-direction:column; gap:6px;
  position:relative; overflow:hidden;
  transition:box-shadow var(--tr),transform var(--tr);
  cursor:default;
}
.kpi:hover { box-shadow:var(--sh2); transform:translateY(-1px); }
.kpi::after {
  content:''; position:absolute; inset:0 0 auto 0;
  height:3px; border-radius:var(--r3) var(--r3) 0 0;
}
.kpi--teal::after  { background:var(--acc); }
.kpi--blue::after  { background:var(--blu); }
.kpi--green::after { background:var(--grn); }
.kpi--gold::after  { background:var(--gld); }

.kpi__top   { display:flex; align-items:center; justify-content:space-between; }
.kpi__label { font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:.08em; color:var(--t2); }
.kpi__ico   { width:26px; height:26px; border-radius:var(--r1); display:flex; align-items:center; justify-content:center; flex-shrink:0; }
.kpi__ico svg { width:13px; height:13px; display:block; }
.kpi__ico--teal  { background:rgba(0,105,111,.12); color:var(--acc); }
.kpi__ico--blue  { background:rgba(26,78,128,.12);  color:var(--blu); }
.kpi__ico--green { background:rgba(36,96,26,.12);   color:var(--grn); }
.kpi__ico--gold  { background:rgba(135,93,0,.12);   color:var(--gld); }

.kpi__value { font-size:1.75rem; font-weight:900; font-variant-numeric:tabular-nums; letter-spacing:-.04em; line-height:1; color:var(--t1); }
.kpi__value--green { color:var(--grn); }
.kpi__value--gold  { color:var(--gld); }
.kpi__delta { font-size:.6875rem; color:var(--t3); }

/* ─ Section label ─ */
.d-sect { display:flex; align-items:center; gap:8px; font-size:9.5px; font-weight:700; text-transform:uppercase; letter-spacing:.09em; color:var(--t3); margin-bottom:10px; }
.d-sect::after { content:''; flex:1; height:1px; background:var(--b1); }

/* ─ Financeiro ─ */
.fin-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:10px; margin-bottom:20px; }
@media(max-width:820px){ .fin-grid{ grid-template-columns:repeat(2,1fr) } }
@media(max-width:520px){ .fin-grid{ grid-template-columns:1fr } }

.fin {
  background:var(--s1); border:1px solid var(--b1); border-radius:var(--r2);
  padding:14px 16px; box-shadow:var(--sh0);
  display:flex; align-items:center; gap:12px;
  transition:box-shadow var(--tr);
}
.fin:hover { box-shadow:var(--sh1); }
.fin__ico { width:32px; height:32px; border-radius:var(--r1); display:flex; align-items:center; justify-content:center; flex-shrink:0; }
.fin__ico svg { width:14px; height:14px; display:block; }
.fin__ico--green { background:rgba(36,96,26,.12);   color:var(--grn); }
.fin__ico--red   { background:rgba(161,44,123,.1);  color:var(--red); }
.fin__ico--gold  { background:rgba(135,93,0,.12);   color:var(--gld); }
.fin__body  { display:flex; flex-direction:column; gap:3px; min-width:0; }
.fin__label { font-size:9.5px; font-weight:700; text-transform:uppercase; letter-spacing:.08em; color:var(--t2); white-space:nowrap; }
.fin__value { font-size:1.1875rem; font-weight:900; font-variant-numeric:tabular-nums; letter-spacing:-.025em; line-height:1.15; }
.fin__value--green { color:var(--grn); }
.fin__value--red   { color:var(--red); }
.fin__value--gold  { color:var(--gld); }

/* ─ Providers ─ */
.prov-grid { display:flex; flex-wrap:wrap; gap:7px; margin-bottom:20px; }
.prov {
  display:inline-flex; align-items:center; gap:7px;
  background:var(--s1); border:1px solid var(--b1);
  border-radius:var(--rp); padding:5px 12px 5px 9px;
  box-shadow:var(--sh0); transition:box-shadow var(--tr);
}
.prov:hover { box-shadow:var(--sh1); }
.prov__dot { width:7px; height:7px; border-radius:50%; flex-shrink:0; }
.prov__dot--on  { background:var(--grn); box-shadow:0 0 0 2.5px rgba(67,122,34,.2); }
.prov__dot--off { background:var(--t3); }
.prov__name { font-size:.75rem; font-weight:800; letter-spacing:-.01em; color:var(--t1); }
.prov__type { font-size:.6875rem; font-weight:500; color:var(--t3); }

/* ─ Table pair ─ */
.tbl-pair { display:grid; grid-template-columns:1fr 1fr; gap:12px; }
@media(max-width:960px){ .tbl-pair{ grid-template-columns:1fr } }

.tbl-card {
  background:var(--s1); border:1px solid var(--b1);
  border-radius:var(--r3); overflow:hidden;
  box-shadow:var(--sh1); display:flex; flex-direction:column;
}
.tbl-card__head {
  display:flex; align-items:center; justify-content:space-between;
  padding:10px 16px; border-bottom:1px solid var(--b1);
  background:var(--s0); flex-shrink:0;
}
.tbl-card__title { font-size:.8125rem; font-weight:800; letter-spacing:-.02em; color:var(--t1); }
.tbl-card__link  { font-size:.6875rem; font-weight:700; color:var(--acc); text-decoration:none; white-space:nowrap; transition:color var(--tr); }
.tbl-card__link:hover { color:var(--acc2); }

.tbl-wrap { overflow-x:auto; flex:1; }
.tbl { width:100%; border-collapse:collapse; table-layout:fixed; }
.tbl th {
  text-align:left; font-size:9.5px; font-weight:700;
  text-transform:uppercase; letter-spacing:.08em;
  color:var(--t2); padding:7px 12px;
  border-bottom:1px solid var(--b1);
  background:var(--s0); white-space:nowrap;
}
.tbl td {
  padding:7px 12px; border-bottom:1px solid var(--b2);
  vertical-align:middle; font-size:.8125rem; color:var(--t1);
  overflow:hidden; text-overflow:ellipsis; white-space:nowrap;
}
.tbl tbody tr { transition:background 100ms; }
.tbl tbody tr:hover { background:var(--s0); }
.tbl tbody tr:last-child td { border-bottom:none; }

/* Larguras — tabela pedidos */
.tbl--orders col.c-id   { width:44px; }
.tbl--orders col.c-usr  { width:22%; }
.tbl--orders col.c-srv  { width:auto; }
.tbl--orders col.c-val  { width:80px; }
.tbl--orders col.c-st   { width:90px; }

/* Larguras — tabela usuários */
.tbl--users col.c-nome  { width:26%; }
.tbl--users col.c-mail  { width:auto; }
.tbl--users col.c-bal   { width:90px; }
.tbl--users col.c-dt    { width:72px; }

.c-id   { color:var(--t3) !important; font-variant-numeric:tabular-nums; font-size:.75rem !important; }
.c-bold { font-weight:700; }
.c-muted{ color:var(--t2) !important; }
.c-mono { font-variant-numeric:tabular-nums; font-size:.75rem !important; }

/* Badge status inline */
.bst {
  display:inline-flex; align-items:center; gap:4px;
  padding:2px 8px; border-radius:999px;
  font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:.05em;
  white-space:nowrap;
}
.bst::before { content:''; width:5px; height:5px; border-radius:50%; background:currentColor; flex-shrink:0; }
.bst--green { background:rgba(67,122,34,.12);  color:var(--grn); }
.bst--blue  { background:rgba(26,78,128,.12);  color:var(--blu); }
.bst--red   { background:rgba(161,44,123,.1);  color:var(--red); }
.bst--grey  { background:rgba(255,255,255,.06);color:var(--t2); }
.bst--gold  { background:rgba(135,93,0,.12);   color:var(--gld); }

.d-empty { color:var(--t3); font-size:.8125rem; text-align:center; padding:28px 16px; }
</style>

{# Macro SVG icon 13×13 #}
{% macro ico(d) %}<svg style="width:13px;height:13px;display:block;flex-shrink:0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">{{ d|raw }}</svg>{% endmacro %}
{% import _self as i %}

{# Mapa de meses pt-BR #}
{% set meses = {
  '01':'janeiro','02':'fevereiro','03':'março','04':'abril',
  '05':'maio','06':'junho','07':'julho','08':'agosto',
  '09':'setembro','10':'outubro','11':'novembro','12':'dezembro'
} %}
{% set hoje = 'now'|date('d') ~ ' de ' ~ meses['now'|date('m')] ~ ' de ' ~ 'now'|date('Y') %}

<div class="dash">

  {# HEADER #}
  <div class="d-hd">
    <div>
      <h1 class="d-hd__title">Dashboard</h1>
      <div class="d-hd__date">{{ hoje }}</div>
    </div>
  </div>

  {# KPIs #}
  <div class="kpi-grid">
    <div class="kpi kpi--teal">
      <div class="kpi__top">
        <span class="kpi__label">Usuários</span>
        <span class="kpi__ico kpi__ico--teal">{{ i.ico('<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/>') }}</span>
      </div>
      <div class="kpi__value">{{ usersCount }}</div>
      <div class="kpi__delta">+{{ newUsersToday }} hoje</div>
    </div>

    <div class="kpi kpi--blue">
      <div class="kpi__top">
        <span class="kpi__label">Pedidos (30d)</span>
        <span class="kpi__ico kpi__ico--blue">{{ i.ico('<path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/>') }}</span>
      </div>
      <div class="kpi__value">{{ ordersTotal }}</div>
      <div class="kpi__delta">{{ ordersToday }} hoje</div>
    </div>

    <div class="kpi kpi--green">
      <div class="kpi__top">
        <span class="kpi__label">Receita (30d)</span>
        <span class="kpi__ico kpi__ico--green">{{ i.ico('<line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/>') }}</span>
      </div>
      <div class="kpi__value kpi__value--green">R$ {{ (revenueCents/100)|number_format(2,',','.') }}</div>
      <div class="kpi__delta">R$ {{ (revenueToday/100)|number_format(2,',','.') }} hoje</div>
    </div>

    <div class="kpi kpi--gold">
      <div class="kpi__top">
        <span class="kpi__label">Lucro líquido</span>
        <span class="kpi__ico kpi__ico--gold">{{ i.ico('<polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/>') }}</span>
      </div>
      <div class="kpi__value kpi__value--gold">R$ {{ (netProfitCents/100)|number_format(2,',','.') }}</div>
      <div class="kpi__delta">Após taxas e custos</div>
    </div>
  </div>

  {# FINANCEIRO #}
  <div class="d-sect">Análise financeira — últimos 30 dias</div>
  <div class="fin-grid">
    <div class="fin">
      <span class="fin__ico fin__ico--green">{{ i.ico('<line x1="12" y1="19" x2="12" y2="5"/><polyline points="5 12 12 5 19 12"/>') }}</span>
      <div class="fin__body">
        <div class="fin__label">Entradas (depósitos)</div>
        <div class="fin__value fin__value--green">R$ {{ (revenueCents/100)|number_format(2,',','.') }}</div>
      </div>
    </div>
    <div class="fin">
      <span class="fin__ico fin__ico--red">{{ i.ico('<line x1="12" y1="5" x2="12" y2="19"/><polyline points="19 12 12 19 5 12"/>') }}</span>
      <div class="fin__body">
        <div class="fin__label">Saídas (custo providers)</div>
        <div class="fin__value fin__value--red">R$ {{ (expensesCents/100)|number_format(2,',','.') }}</div>
      </div>
    </div>
    <div class="fin">
      <span class="fin__ico fin__ico--gold">{{ i.ico('<circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>') }}</span>
      <div class="fin__body">
        <div class="fin__label">Taxas (gateways)</div>
        <div class="fin__value fin__value--gold">R$ {{ (feesCents/100)|number_format(2,',','.') }}</div>
      </div>
    </div>
  </div>

  {# PROVIDERS #}
  <div class="d-sect">Providers &amp; Gateways</div>
  <div class="prov-grid">
    {% for cred in credentials %}
    <div class="prov">
      <span class="prov__dot prov__dot--{{ cred.active ? 'on' : 'off' }}"></span>
      <span class="prov__name">{{ cred.slug|upper }}</span>
      <span class="prov__type">{{ cred.type == 'payment_gateway' ? 'Gateway' : 'SMM' }}</span>
    </div>
    {% else %}
    <p class="d-empty">Nenhuma credencial.</p>
    {% endfor %}
  </div>

  {# TABLES #}
  <div class="tbl-pair">

    {# Pedidos recentes #}
    <div class="tbl-card">
      <div class="tbl-card__head">
        <span class="tbl-card__title">Pedidos recentes</span>
        <a class="tbl-card__link" href="{{ ea_url().setController('App\\Controller\\Admin\\OrderCrudController').generateUrl() }}">Ver todos →</a>
      </div>
      {% if recentOrders|length > 0 %}
      <div class="tbl-wrap">
        <table class="tbl tbl--orders">
          <colgroup>
            <col class="c-id"><col class="c-usr"><col class="c-srv"><col class="c-val"><col class="c-st">
          </colgroup>
          <thead><tr><th>#</th><th>Usuário</th><th>Serviço</th><th>Valor</th><th>Status</th></tr></thead>
          <tbody>
            {% for o in recentOrders %}
            {% set st = o.status %}
            <tr>
              <td class="c-id">{{ o.id }}</td>
              <td class="c-bold">{{ o.user.name }}</td>
              <td class="c-muted" title="{{ o.service.name }}">{{ o.service.name }}</td>
              <td class="c-mono">R$ {{ (o.amountCents/100)|number_format(2,',','.') }}</td>
              <td>
                <span class="bst bst--{{ st=='completed'?'green':(st=='cancelled'?'red':(st=='processing'?'blue':(st=='partial'?'gold':'grey'))) }}">
                  {{ st|replace({'_':' '})|capitalize }}
                </span>
              </td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      {% else %}<p class="d-empty">Nenhum pedido ainda.</p>{% endif %}
    </div>

    {# Usuários recentes #}
    <div class="tbl-card">
      <div class="tbl-card__head">
        <span class="tbl-card__title">Usuários recentes</span>
        <a class="tbl-card__link" href="{{ ea_url().setController('App\\Controller\\Admin\\UserCrudController').generateUrl() }}">Ver todos →</a>
      </div>
      {% if recentUsers|length > 0 %}
      <div class="tbl-wrap">
        <table class="tbl tbl--users">
          <colgroup>
            <col class="c-nome"><col class="c-mail"><col class="c-bal"><col class="c-dt">
          </colgroup>
          <thead><tr><th>Nome</th><th>E-mail</th><th>Saldo</th><th>Desde</th></tr></thead>
          <tbody>
            {% for u in recentUsers %}
            <tr>
              <td class="c-bold">{{ u.name }}</td>
              <td class="c-muted" title="{{ u.email }}">{{ u.email }}</td>
              <td class="c-mono">R$ {{ u.wallet ? (u.wallet.balanceCents/100)|number_format(2,',','.') : '0,00' }}</td>
              <td class="c-muted c-mono">{{ u.createdAt|date('d/m/Y') }}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      {% else %}<p class="d-empty">Nenhum usuário ainda.</p>{% endif %}
    </div>

  </div>
</div>
{% endblock %}
