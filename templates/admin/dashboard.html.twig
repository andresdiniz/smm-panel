{% extends '@EasyAdmin/page/content.html.twig' %}

{% block page_title %}Dashboard Administrativo{% endblock %}

{% block main %}
<style>
:root{--primary:#01696f;--primary-h:#0c4e54;--primary-hi:#cedcd8;--success:#437a22;--error:#a12c7b;--error-hi:#e0ced7;--gold:#d19900;--text:#28251d;--muted:#7a7974;--faint:#bab9b4;--surface:#f9f8f5;--surface-off:#f3f0ec;--border:#d4d1ca;--sh-sm:0 1px 2px oklch(.2 .01 80/.06);--sh-md:0 4px 12px oklch(.2 .01 80/.08);--r-lg:.75rem;--r-xl:1rem;--sp2:.5rem;--sp3:.75rem;--sp4:1rem;--sp5:1.25rem;--sp6:1.5rem;--sp8:2rem;--text-xs:clamp(.75rem,.7rem + .25vw,.875rem);--text-sm:clamp(.875rem,.8rem + .35vw,1rem);--text-base:clamp(1rem,.95rem + .25vw,1.125rem);--text-lg:clamp(1.125rem,1rem + .75vw,1.5rem);--text-xl:clamp(1.5rem,1.2rem + 1.25vw,2.25rem)}

.adm-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(200px,100%),1fr));gap:var(--sp4);margin-bottom:var(--sp8)}
.adm-kpi{background:var(--surface);border:1px solid var(--border);border-radius:var(--r-xl);padding:var(--sp5);box-shadow:var(--sh-sm);display:flex;flex-direction:column;gap:var(--sp2)}
.adm-kpi__icon{width:40px;height:40px;border-radius:var(--r-lg);display:flex;align-items:center;justify-content:center;font-size:1.3rem}
.adm-kpi__label{font-size:var(--text-xs);color:var(--muted);text-transform:uppercase;letter-spacing:.05em}
.adm-kpi__value{font-size:var(--text-xl);font-weight:900;line-height:1;font-variant-numeric:tabular-nums}
.adm-kpi__delta{font-size:var(--text-xs);color:var(--muted);margin-top:2px}

.adm-row{display:grid;grid-template-columns:1fr 1fr;gap:var(--sp6);margin-bottom:var(--sp8)}
@media(max-width:900px){.adm-row{grid-template-columns:1fr}}

.adm-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--r-xl);padding:var(--sp6);box-shadow:var(--sh-sm)}
.adm-card h3{font-size:var(--text-base);font-weight:800;margin-bottom:var(--sp4);display:flex;align-items:center;justify-content:space-between}
.adm-card h3 a{font-size:var(--text-xs);font-weight:600;color:var(--primary);text-decoration:none}

.adm-table{width:100%;border-collapse:collapse;font-size:var(--text-sm)}
.adm-table th{text-align:left;font-size:var(--text-xs);font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:var(--muted);padding:var(--sp2) var(--sp3);border-bottom:1px solid var(--border)}
.adm-table td{padding:var(--sp2) var(--sp3);border-bottom:1px solid oklch(from var(--text) l c h/.05);vertical-align:middle}
.adm-table tr:last-child td{border-bottom:none}
.adm-table tbody tr:hover{background:var(--surface-off)}

.badge{display:inline-flex;align-items:center;padding:2px 8px;border-radius:9999px;font-size:var(--text-xs);font-weight:700}
.badge--green{background:#d4dfcc;color:var(--success)}
.badge--blue{background:#c6d8e4;color:#006494}
.badge--grey{background:var(--surface-off);color:var(--muted)}
.badge--red{background:var(--error-hi);color:var(--error)}
.badge--gold{background:#e9e0c6;color:#8a5b00}

.provider-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:var(--sp3);margin-bottom:var(--sp8)}
.provider-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--r-xl);padding:var(--sp4);box-shadow:var(--sh-sm);display:flex;align-items:center;gap:var(--sp3)}
.provider-dot{width:10px;height:10px;border-radius:50%;flex-shrink:0}
.provider-dot--on{background:#437a22}
.provider-dot--off{background:#d4d1ca}
.provider-info strong{display:block;font-size:var(--text-sm);font-weight:700}
.provider-info span{font-size:var(--text-xs);color:var(--muted)}

.fin-row{display:grid;grid-template-columns:repeat(3,1fr);gap:var(--sp4);margin-bottom:var(--sp8)}
@media(max-width:700px){.fin-row{grid-template-columns:1fr}}
.fin-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--r-xl);padding:var(--sp5);box-shadow:var(--sh-sm);text-align:center}
.fin-card__label{font-size:var(--text-xs);color:var(--muted);text-transform:uppercase;letter-spacing:.05em}
.fin-card__value{font-size:var(--text-xl);font-weight:900;font-variant-numeric:tabular-nums;margin-top:6px}
.fin-card__value--green{color:var(--success)}
.fin-card__value--red{color:var(--error)}
.fin-card__value--gold{color:var(--gold)}
</style>

{# ── KPIs principais ────────────────────────────────────────────── #}
<div class="adm-grid">
  <div class="adm-kpi">
    <div class="adm-kpi__icon" style="background:#cedcd8;color:#0c4e54">👥</div>
    <div class="adm-kpi__label">Usuários</div>
    <div class="adm-kpi__value">{{ usersCount }}</div>
    <div class="adm-kpi__delta">+{{ newUsersToday }} hoje</div>
  </div>
  <div class="adm-kpi">
    <div class="adm-kpi__icon" style="background:#c6d8e4;color:#006494">🛒</div>
    <div class="adm-kpi__label">Pedidos (30d)</div>
    <div class="adm-kpi__value">{{ ordersTotal }}</div>
    <div class="adm-kpi__delta">{{ ordersToday }} hoje</div>
  </div>
  <div class="adm-kpi">
    <div class="adm-kpi__icon" style="background:#d4dfcc;color:#437a22">💰</div>
    <div class="adm-kpi__label">Receita (30d)</div>
    <div class="adm-kpi__value" style="color:var(--success)">R$ {{ (revenueCents / 100)|number_format(2,',','.') }}</div>
    <div class="adm-kpi__delta">R$ {{ (revenueToday / 100)|number_format(2,',','.') }} hoje</div>
  </div>
  <div class="adm-kpi">
    <div class="adm-kpi__icon" style="background:#e9e0c6;color:#8a5b00">📊</div>
    <div class="adm-kpi__label">Lucro líquido (30d)</div>
    <div class="adm-kpi__value" style="color:var(--gold)">R$ {{ (netProfitCents / 100)|number_format(2,',','.') }}</div>
    <div class="adm-kpi__delta">Após taxas e custos</div>
  </div>
</div>

{# ── Financeiro detalhado ───────────────────────────────────────── #}
<h3 style="font-size:var(--text-base);font-weight:800;margin-bottom:var(--sp4);color:var(--muted);text-transform:uppercase;letter-spacing:.06em;font-size:var(--text-xs)">Análise financeira — últimos 30 dias</h3>
<div class="fin-row">
  <div class="fin-card">
    <div class="fin-card__label">Entradas (depósitos)</div>
    <div class="fin-card__value fin-card__value--green">R$ {{ (revenueCents / 100)|number_format(2,',','.') }}</div>
  </div>
  <div class="fin-card">
    <div class="fin-card__label">Saídas (custo providers)</div>
    <div class="fin-card__value fin-card__value--red">R$ {{ (expensesCents / 100)|number_format(2,',','.') }}</div>
  </div>
  <div class="fin-card">
    <div class="fin-card__label">Taxas (gateways)</div>
    <div class="fin-card__value fin-card__value--gold">R$ {{ (feesCents / 100)|number_format(2,',','.') }}</div>
  </div>
</div>

{# ── Status dos providers ───────────────────────────────────────── #}
<h3 style="font-size:var(--text-xs);font-weight:800;margin-bottom:var(--sp4);color:var(--muted);text-transform:uppercase;letter-spacing:.06em">Providers / Gateways</h3>
<div class="provider-grid">
  {% for cred in credentials %}
  <div class="provider-card">
    <div class="provider-dot provider-dot--{{ cred.active ? 'on' : 'off' }}"></div>
    <div class="provider-info">
      <strong>{{ cred.slug|upper }}</strong>
      <span>{{ cred.type == 'payment_gateway' ? 'Gateway' : 'SMM' }} &mdash; {{ cred.active ? 'Ativo' : 'Inativo' }}</span>
    </div>
  </div>
  {% else %}
  <p style="color:var(--muted);font-size:var(--text-sm)">Nenhuma credencial cadastrada.</p>
  {% endfor %}
</div>

{# ── Pedidos + Usuários recentes ─────────────────────────────────── #}
<div class="adm-row">

  <div class="adm-card">
    <h3>
      Pedidos recentes
      <a href="{{ ea_url().setController('App\\Controller\\Admin\\OrderCrudController').generateUrl() }}">Ver todos →</a>
    </h3>
    {% if recentOrders|length > 0 %}
    <table class="adm-table">
      <thead><tr><th>#</th><th>Usuário</th><th>Serviço</th><th>Valor</th><th>Status</th></tr></thead>
      <tbody>
        {% for order in recentOrders %}
        <tr>
          <td style="color:var(--muted);font-size:var(--text-xs)">{{ order.id }}</td>
          <td style="font-size:var(--text-sm)">{{ order.user.name }}</td>
          <td style="font-size:var(--text-xs);color:var(--muted);max-width:120px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">
            {{ order.service.name|length > 30 ? order.service.name|slice(0,30)~'…' : order.service.name }}
          </td>
          <td style="font-variant-numeric:tabular-nums;font-size:var(--text-sm);white-space:nowrap">
            R$ {{ (order.amountCents/100)|number_format(2,',','.')}}
          </td>
          <td>
            <span class="badge badge--{{ order.status == 'completed' ? 'green' : (order.status == 'cancelled' ? 'red' : (order.status == 'pending' ? 'grey' : 'blue')) }}">
              {{ order.status|replace({'_':' '})|capitalize }}
            </span>
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    {% else %}
      <p style="color:var(--muted);font-size:var(--text-sm);text-align:center;padding:var(--sp8)">Nenhum pedido ainda.</p>
    {% endif %}
  </div>

  <div class="adm-card">
    <h3>
      Usuários recentes
      <a href="{{ ea_url().setController('App\\Controller\\Admin\\UserCrudController').generateUrl() }}">Ver todos →</a>
    </h3>
    {% if recentUsers|length > 0 %}
    <table class="adm-table">
      <thead><tr><th>Nome</th><th>E-mail</th><th>Saldo</th><th>Desde</th></tr></thead>
      <tbody>
        {% for user in recentUsers %}
        <tr>
          <td style="font-weight:600;font-size:var(--text-sm)">{{ user.name }}</td>
          <td style="font-size:var(--text-xs);color:var(--muted)">{{ user.email }}</td>
          <td style="font-variant-numeric:tabular-nums;font-size:var(--text-sm);white-space:nowrap">
            R$ {{ user.wallet ? (user.wallet.balanceCents/100)|number_format(2,',','.') : '0,00' }}
          </td>
          <td style="font-size:var(--text-xs);color:var(--muted);white-space:nowrap">{{ user.createdAt|date('d/m/Y') }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    {% else %}
      <p style="color:var(--muted);font-size:var(--text-sm);text-align:center;padding:var(--sp8)">Nenhum usuário ainda.</p>
    {% endif %}
  </div>

</div>
{% endblock %}
