{% extends '@EasyAdmin/page/content.html.twig' %}
{% block page_title %}Dashboard{% endblock %}
{% block head_javascript %}{{ parent() }}{% endblock %}
{% block content_title %}{% endblock %}

{% block main %}
<style>
/*
  ADMIN DASHBOARD v3
  Cores hardcoded — não depende dos tokens do EasyAdmin nem do painel.
  Paleta dark-mode em camadas:
    --bg   : #0f1117  (fundo página)
    --s0   : #161b27  (header de tabelas, hover)
    --s1   : #1c2233  (cards, tbl-card)
    --s2   : #212840  (card hover / destaque)
    --bd   : rgba(255,255,255,.08)
    --bd2  : rgba(255,255,255,.04)
    --t1   : #e2e6f0  (texto principal)
    --t2   : #8b90a8  (texto secundário)
    --t3   : #505570  (texto apagado / labels)
*/

/* reset de espaço que o EasyAdmin injeta */
.content-header { display:none !important; }
.content-wrapper { padding: 0 !important; }

.dash {
  padding: 24px 28px 60px;
  max-width: 1480px;
  background: #0f1117;
  min-height: 100vh;
  color: #e2e6f0;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
}

/* ── Header ── */
.d-hd { display:flex; align-items:baseline; justify-content:space-between; margin-bottom:28px; }
.d-hd__title { font-size:1.125rem; font-weight:900; letter-spacing:-.03em; color:#e2e6f0; margin:0; }
.d-hd__date  { font-size:.75rem; color:#505570; margin-top:4px; }

/* ── KPI grid ── */
.kpi-grid {
  display: grid;
  grid-template-columns: repeat(4,1fr);
  gap: 12px;
  margin-bottom: 28px;
}
@media(max-width:1100px){ .kpi-grid{ grid-template-columns:repeat(2,1fr) } }
@media(max-width:560px) { .kpi-grid{ grid-template-columns:1fr } }

.kpi {
  background: #1c2233;
  border: 1px solid rgba(255,255,255,.08);
  border-radius: 12px;
  padding: 20px 20px 16px;
  box-shadow: 0 4px 20px rgba(0,0,0,.25);
  display: flex;
  flex-direction: column;
  gap: 8px;
  position: relative;
  overflow: hidden;
  transition: box-shadow .18s, transform .18s;
  cursor: default;
}
.kpi:hover { box-shadow: 0 8px 30px rgba(0,0,0,.35); transform: translateY(-2px); }
.kpi::after {
  content: '';
  position: absolute; inset: 0 0 auto 0;
  height: 3px;
  border-radius: 12px 12px 0 0;
}
.kpi--teal::after  { background: #01696f; }
.kpi--blue::after  { background: #1e6fa0; }
.kpi--green::after { background: #437a22; }
.kpi--gold::after  { background: #c98a00; }

.kpi__top { display:flex; align-items:center; justify-content:space-between; }
.kpi__label {
  font-size: 10px; font-weight: 700;
  text-transform: uppercase; letter-spacing: .08em;
  color: #8b90a8;
}
.kpi__ico {
  width: 30px; height: 30px;
  border-radius: 8px;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.kpi__ico svg { width: 14px; height: 14px; display: block; }
.kpi__ico--teal  { background: rgba(1,105,111,.18);  color: #4fb8be; }
.kpi__ico--blue  { background: rgba(30,111,160,.18); color: #5ba8d4; }
.kpi__ico--green { background: rgba(67,122,34,.18);  color: #7abf4a; }
.kpi__ico--gold  { background: rgba(201,138,0,.18);  color: #e8af34; }

.kpi__value {
  font-size: 2rem;
  font-weight: 900;
  font-variant-numeric: tabular-nums;
  letter-spacing: -.04em;
  line-height: 1;
  color: #f0f2fa;
}
.kpi__value--green { color: #7abf4a; }
.kpi__value--gold  { color: #e8af34; }
.kpi__delta { font-size: .6875rem; color: #505570; }

/* ── Seção label ── */
.d-sect {
  display: flex; align-items: center; gap: 10px;
  font-size: 10px; font-weight: 700;
  text-transform: uppercase; letter-spacing: .09em;
  color: #505570;
  margin-bottom: 12px;
}
.d-sect::after { content:''; flex:1; height:1px; background:rgba(255,255,255,.07); }

/* ── Fin cards ── */
.fin-grid {
  display: grid;
  grid-template-columns: repeat(3,1fr);
  gap: 12px;
  margin-bottom: 28px;
}
@media(max-width:820px){ .fin-grid{ grid-template-columns:repeat(2,1fr) } }
@media(max-width:520px){ .fin-grid{ grid-template-columns:1fr } }

.fin {
  background: #1c2233;
  border: 1px solid rgba(255,255,255,.08);
  border-radius: 10px;
  padding: 16px 18px;
  box-shadow: 0 2px 12px rgba(0,0,0,.2);
  display: flex;
  align-items: center;
  gap: 14px;
  transition: box-shadow .18s;
}
.fin:hover { box-shadow: 0 6px 20px rgba(0,0,0,.3); }
.fin__ico {
  width: 36px; height: 36px;
  border-radius: 10px;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.fin__ico svg { width: 16px; height: 16px; display: block; }
.fin__ico--green { background: rgba(67,122,34,.18);  color: #7abf4a; }
.fin__ico--red   { background: rgba(200,70,70,.15);  color: #e06060; }
.fin__ico--gold  { background: rgba(201,138,0,.18);  color: #e8af34; }
.fin__body { display:flex; flex-direction:column; gap:4px; min-width:0; }
.fin__label {
  font-size: 9.5px; font-weight: 700;
  text-transform: uppercase; letter-spacing: .08em;
  color: #8b90a8;
}
.fin__value {
  font-size: 1.25rem; font-weight: 900;
  font-variant-numeric: tabular-nums;
  letter-spacing: -.025em;
  line-height: 1.15;
  color: #f0f2fa;
}
.fin__value--green { color: #7abf4a; }
.fin__value--red   { color: #e06060; }
.fin__value--gold  { color: #e8af34; }

/* ── Providers ── */
.prov-grid { display:flex; flex-wrap:wrap; gap:8px; margin-bottom:28px; }
.prov {
  display: inline-flex; align-items: center; gap: 8px;
  background: #1c2233;
  border: 1px solid rgba(255,255,255,.08);
  border-radius: 999px;
  padding: 6px 14px 6px 10px;
  box-shadow: 0 2px 8px rgba(0,0,0,.15);
  transition: box-shadow .18s, border-color .18s;
}
.prov:hover { box-shadow: 0 4px 14px rgba(0,0,0,.25); border-color: rgba(255,255,255,.15); }
.prov__dot { width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0; }
.prov__dot--on  { background: #7abf4a; box-shadow: 0 0 0 2.5px rgba(122,191,74,.2); }
.prov__dot--off { background: #505570; }
.prov__name { font-size: .75rem; font-weight: 800; letter-spacing: -.01em; color: #e2e6f0; }
.prov__type { font-size: .6875rem; font-weight: 500; color: #505570; }

/* ── Table pair (60/40) ── */
.tbl-pair {
  display: grid;
  grid-template-columns: 6fr 4fr;
  gap: 14px;
}
@media(max-width:1000px){ .tbl-pair{ grid-template-columns:1fr } }

.tbl-card {
  background: #1c2233;
  border: 1px solid rgba(255,255,255,.08);
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 4px 20px rgba(0,0,0,.22);
  display: flex;
  flex-direction: column;
}
.tbl-card__head {
  display: flex; align-items: center; justify-content: space-between;
  padding: 13px 18px;
  border-bottom: 1px solid rgba(255,255,255,.07);
  background: #161b27;
  flex-shrink: 0;
}
.tbl-card__title { font-size: .875rem; font-weight: 800; letter-spacing: -.025em; color: #e2e6f0; }
.tbl-card__link {
  font-size: .6875rem; font-weight: 700;
  color: #4fb8be;
  text-decoration: none;
  white-space: nowrap;
  transition: color .15s;
}
.tbl-card__link:hover { color: #8bdde1; }

.tbl-wrap { overflow-x: auto; flex: 1; }
.tbl { width:100%; border-collapse:collapse; table-layout:fixed; }
.tbl th {
  text-align: left;
  font-size: 9.5px; font-weight: 700;
  text-transform: uppercase; letter-spacing: .08em;
  color: #505570;
  padding: 8px 14px;
  border-bottom: 1px solid rgba(255,255,255,.07);
  background: #161b27;
  white-space: nowrap;
}
.tbl td {
  padding: 8px 14px;
  border-bottom: 1px solid rgba(255,255,255,.04);
  vertical-align: middle;
  font-size: .8125rem;
  color: #e2e6f0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.tbl tbody tr { transition: background .1s; }
.tbl tbody tr:hover { background: rgba(255,255,255,.03); }
.tbl tbody tr:last-child td { border-bottom: none; }

/* Colgroup — pedidos */
.tbl--orders col.co-id  { width: 40px; }
.tbl--orders col.co-usr { width: 100px; }
.tbl--orders col.co-srv { width: auto; }
.tbl--orders col.co-val { width: 76px; }
.tbl--orders col.co-st  { width: 94px; }

/* Colgroup — usuários */
.tbl--users col.cu-nome { width: 28%; }
.tbl--users col.cu-mail { width: auto; }
.tbl--users col.cu-bal  { width: 88px; }
.tbl--users col.cu-dt   { width: 60px; }

.c-id   { color: #505570 !important; font-variant-numeric:tabular-nums; font-size:.75rem !important; }
.c-bold { font-weight: 700; color: #c8ccdc !important; }
.c-muted{ color: #8b90a8 !important; }
.c-mono { font-variant-numeric:tabular-nums; font-size:.75rem !important; color:#a0a4bc !important; }

/* Badge status */
.bst {
  display: inline-flex; align-items: center; gap: 5px;
  padding: 3px 9px;
  border-radius: 999px;
  font-size: 10px; font-weight: 700;
  text-transform: uppercase; letter-spacing: .05em;
  white-space: nowrap;
}
.bst::before { content:''; width:5px; height:5px; border-radius:50%; background:currentColor; flex-shrink:0; }
.bst--green { background:rgba(67,122,34,.18);  color:#7abf4a; }
.bst--blue  { background:rgba(30,111,160,.18); color:#5ba8d4; }
.bst--red   { background:rgba(200,70,70,.15);  color:#e06060; }
.bst--grey  { background:rgba(255,255,255,.07);color:#8b90a8; }
.bst--gold  { background:rgba(201,138,0,.18);  color:#e8af34; }

.d-empty { color:#505570; font-size:.8125rem; text-align:center; padding:32px 16px; }
</style>

{# Macro SVG #}
{% macro ico(d) %}<svg style="width:14px;height:14px;display:block;flex-shrink:0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">{{ d|raw }}</svg>{% endmacro %}
{% import _self as i %}

{# Data em pt-BR sem depender de locale PHP #}
{% set _m = {'01':'janeiro','02':'fevereiro','03':'março','04':'abril','05':'maio','06':'junho','07':'julho','08':'agosto','09':'setembro','10':'outubro','11':'novembro','12':'dezembro'} %}
{% set _hoje = 'now'|date('d') ~ ' de ' ~ _m['now'|date('m')] ~ ' de ' ~ 'now'|date('Y') %}

<div class="dash">

  {# HEADER #}
  <div class="d-hd">
    <div>
      <h1 class="d-hd__title">Dashboard</h1>
      <div class="d-hd__date">{{ _hoje }}</div>
    </div>
  </div>

  {# KPIs #}
  <div class="kpi-grid">
    <div class="kpi kpi--teal">
      <div class="kpi__top">
        <span class="kpi__label">Usuários</span>
        <span class="kpi__ico kpi__ico--teal">{{ i.ico('<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/>') }}</span>
      </div>
      <div class="kpi__value">{{ usersCount }}</div>
      <div class="kpi__delta">+{{ newUsersToday }} hoje</div>
    </div>

    <div class="kpi kpi--blue">
      <div class="kpi__top">
        <span class="kpi__label">Pedidos (30d)</span>
        <span class="kpi__ico kpi__ico--blue">{{ i.ico('<path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/>') }}</span>
      </div>
      <div class="kpi__value">{{ ordersTotal }}</div>
      <div class="kpi__delta">{{ ordersToday }} hoje</div>
    </div>

    <div class="kpi kpi--green">
      <div class="kpi__top">
        <span class="kpi__label">Receita (30d)</span>
        <span class="kpi__ico kpi__ico--green">{{ i.ico('<line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/>') }}</span>
      </div>
      <div class="kpi__value kpi__value--green">R$ {{ (revenueCents/100)|number_format(2,',','.') }}</div>
      <div class="kpi__delta">R$ {{ (revenueToday/100)|number_format(2,',','.') }} hoje</div>
    </div>

    <div class="kpi kpi--gold">
      <div class="kpi__top">
        <span class="kpi__label">Lucro líquido</span>
        <span class="kpi__ico kpi__ico--gold">{{ i.ico('<polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/>') }}</span>
      </div>
      <div class="kpi__value kpi__value--gold">R$ {{ (netProfitCents/100)|number_format(2,',','.') }}</div>
      <div class="kpi__delta">Após taxas e custos</div>
    </div>
  </div>

  {# FINANCEIRO #}
  <div class="d-sect">Análise financeira — últimos 30 dias</div>
  <div class="fin-grid">
    <div class="fin">
      <span class="fin__ico fin__ico--green">{{ i.ico('<line x1="12" y1="19" x2="12" y2="5"/><polyline points="5 12 12 5 19 12"/>') }}</span>
      <div class="fin__body">
        <div class="fin__label">Entradas (depósitos)</div>
        <div class="fin__value fin__value--green">R$ {{ (revenueCents/100)|number_format(2,',','.') }}</div>
      </div>
    </div>
    <div class="fin">
      <span class="fin__ico fin__ico--red">{{ i.ico('<line x1="12" y1="5" x2="12" y2="19"/><polyline points="19 12 12 19 5 12"/>') }}</span>
      <div class="fin__body">
        <div class="fin__label">Saídas (custo providers)</div>
        <div class="fin__value fin__value--red">R$ {{ (expensesCents/100)|number_format(2,',','.') }}</div>
      </div>
    </div>
    <div class="fin">
      <span class="fin__ico fin__ico--gold">{{ i.ico('<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>') }}</span>
      <div class="fin__body">
        <div class="fin__label">Taxas (gateways)</div>
        <div class="fin__value fin__value--gold">R$ {{ (feesCents/100)|number_format(2,',','.') }}</div>
      </div>
    </div>
  </div>

  {# PROVIDERS #}
  <div class="d-sect">Providers &amp; Gateways</div>
  <div class="prov-grid">
    {% for cred in credentials %}
    <div class="prov">
      <span class="prov__dot prov__dot--{{ cred.active ? 'on' : 'off' }}"></span>
      <span class="prov__name">{{ cred.slug|upper }}</span>
      <span class="prov__type">{{ cred.type == 'payment_gateway' ? 'Gateway' : 'SMM' }}</span>
    </div>
    {% else %}
    <p class="d-empty">Nenhuma credencial.</p>
    {% endfor %}
  </div>

  {# TABELAS 60/40 #}
  <div class="tbl-pair">

    <div class="tbl-card">
      <div class="tbl-card__head">
        <span class="tbl-card__title">Pedidos recentes</span>
        <a class="tbl-card__link" href="{{ ea_url().setController('App\\Controller\\Admin\\OrderCrudController').generateUrl() }}">Ver todos →</a>
      </div>
      {% if recentOrders|length > 0 %}
      <div class="tbl-wrap">
        <table class="tbl tbl--orders">
          <colgroup><col class="co-id"><col class="co-usr"><col class="co-srv"><col class="co-val"><col class="co-st"></colgroup>
          <thead><tr><th>#</th><th>Usuário</th><th>Serviço</th><th>Valor</th><th>Status</th></tr></thead>
          <tbody>
            {% for o in recentOrders %}
            {% set st = o.status %}
            <tr>
              <td class="c-id">{{ o.id }}</td>
              <td class="c-bold">{{ o.user.name }}</td>
              <td class="c-muted" title="{{ o.service.name }}">{{ o.service.name }}</td>
              <td class="c-mono">R$ {{ (o.amountCents/100)|number_format(2,',','.') }}</td>
              <td><span class="bst bst--{{ st=='completed'?'green':(st=='cancelled'?'red':(st=='processing'?'blue':(st=='partial'?'gold':'grey'))) }}">{{ st|replace({'_':' '})|capitalize }}</span></td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      {% else %}<p class="d-empty">Nenhum pedido ainda.</p>{% endif %}
    </div>

    <div class="tbl-card">
      <div class="tbl-card__head">
        <span class="tbl-card__title">Usuários recentes</span>
        <a class="tbl-card__link" href="{{ ea_url().setController('App\\Controller\\Admin\\UserCrudController').generateUrl() }}">Ver todos →</a>
      </div>
      {% if recentUsers|length > 0 %}
      <div class="tbl-wrap">
        <table class="tbl tbl--users">
          <colgroup><col class="cu-nome"><col class="cu-mail"><col class="cu-bal"><col class="cu-dt"></colgroup>
          <thead><tr><th>Nome</th><th>E-mail</th><th>Saldo</th><th>Desde</th></tr></thead>
          <tbody>
            {% for u in recentUsers %}
            <tr>
              <td class="c-bold">{{ u.name }}</td>
              <td class="c-muted" title="{{ u.email }}">{{ u.email }}</td>
              <td class="c-mono">R$ {{ u.wallet ? (u.wallet.balanceCents/100)|number_format(2,',','.') : '0,00' }}</td>
              <td class="c-muted c-mono">{{ u.createdAt|date('d/m/Y') }}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      {% else %}<p class="d-empty">Nenhum usuário ainda.</p>{% endif %}
    </div>

  </div>
</div>
{% endblock %}
