<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Pedido #{{ order.id }} — Admin</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <style>
    body { background: #f4f6fb; }
    .navbar-admin { background: #1a1d23; }
    .navbar-admin .navbar-brand { color: #fff; font-weight: 700; letter-spacing: .5px; }
    .navbar-admin .nav-link { color: #adb5bd; }
    .navbar-admin .nav-link:hover { color: #fff; }
    pre { white-space: pre-wrap; word-break: break-all; }
    .log-expand { background: #181c25 !important; }
    tr[data-bs-toggle] { user-select: none; }
  </style>
</head>
<body>

{# ── Navbar admin própria — sem dependência do EasyAdmin context ── #}
<nav class="navbar navbar-expand-lg navbar-admin px-3 py-2 mb-4 shadow-sm">
  <a class="navbar-brand" href="{{ path('admin') }}">
    <i class="fa fa-gauge-high me-2"></i>SMM Panel Admin
  </a>
  <div class="collapse navbar-collapse">
    <ul class="navbar-nav me-auto">
      <li class="nav-item">
        <a class="nav-link" href="{{ path('admin') }}?crudController=App%5CController%5CAdmin%5COrderCrudController&crudAction=index">
          <i class="fa fa-cart-shopping me-1"></i>Pedidos
        </a>
      </li>
      <li class="nav-item">
        <a class="nav-link" href="{{ path('admin_order_logs_errors') }}">
          <i class="fa fa-triangle-exclamation me-1"></i>Erros 24h
        </a>
      </li>
    </ul>
    <span class="navbar-text text-secondary small">
      <i class="fa fa-user me-1"></i>{{ app.user ? app.user.email : 'Admin' }}
    </span>
  </div>
</nav>

<div class="container-fluid px-4 pb-5">

  {# ── Cabeçalho ─────────────────────────────────────────────────────── #}
  <div class="d-flex align-items-center gap-3 mb-4 flex-wrap">
    <a href="{{ path('admin') }}?crudController=App%5CController%5CAdmin%5COrderCrudController&crudAction=index"
       class="btn btn-sm btn-outline-secondary">
      <i class="fa fa-arrow-left me-1"></i>Voltar aos pedidos
    </a>
    <h1 class="h4 mb-0">Pedido <strong>#{{ order.id }}</strong></h1>
    {% set statusColors = {
      'pending':     'warning',
      'processing':  'info',
      'in_progress': 'primary',
      'completed':   'success',
      'partial':     'secondary',
      'cancelled':   'danger',
      'refunded':    'dark'
    } %}
    <span class="badge bg-{{ statusColors[order.status] ?? 'secondary' }} fs-6">
      {{ order.status|upper }}
    </span>
  </div>

  <div class="row g-3">

    {# ── Card: Dados do pedido ─────────────────────────────────────────── #}
    <div class="col-lg-5">
      <div class="card shadow-sm h-100">
        <div class="card-header fw-semibold"><i class="fa fa-clipboard-list me-2"></i>Dados do Pedido</div>
        <div class="card-body p-0">
          <table class="table table-sm table-borderless mb-0">
            <tbody>
              <tr><th class="ps-3 text-muted" style="width:130px">ID</th><td>{{ order.id }}</td></tr>
              <tr><th class="ps-3 text-muted">Usuário</th><td>{{ order.user.email }}</td></tr>
              <tr><th class="ps-3 text-muted">Serviço</th><td>{{ order.service.name }}</td></tr>
              <tr><th class="ps-3 text-muted">Provider</th><td><code>{{ order.service.providerSlug ?? '-' }}</code></td></tr>
              <tr><th class="ps-3 text-muted">ID Externo</th><td><code>{{ order.externalOrderId ?? '-' }}</code></td></tr>
              <tr><th class="ps-3 text-muted">Quantidade</th><td>{{ order.quantity }}</td></tr>
              <tr><th class="ps-3 text-muted">Valor</th><td><strong>R$ {{ (order.amountCents / 100)|number_format(2, ',', '.') }}</strong></td></tr>
              <tr><th class="ps-3 text-muted">Start Count</th><td>{{ order.startCount ?? '-' }}</td></tr>
              <tr><th class="ps-3 text-muted">Restante</th><td>{{ order.remains ?? '-' }}</td></tr>
              <tr>
                <th class="ps-3 text-muted">URL Alvo</th>
                <td class="text-break pe-3">
                  <a href="{{ order.targetUrl }}" target="_blank" rel="noopener">
                    {{ order.targetUrl|length > 60 ? order.targetUrl[:60] ~ '…' : order.targetUrl }}
                  </a>
                </td>
              </tr>
              <tr><th class="ps-3 text-muted">Criado em</th><td>{{ order.createdAt|date('d/m/Y H:i:s') }}</td></tr>
              <tr><th class="ps-3 text-muted">Atualizado</th><td>{{ order.updatedAt|date('d/m/Y H:i:s') }}</td></tr>
            </tbody>
          </table>
        </div>
        <div class="card-footer text-end">
          <a href="{{ path('admin') }}?crudController=App%5CController%5CAdmin%5COrderCrudController&crudAction=detail&entityId={{ order.id }}"
             class="btn btn-sm btn-outline-primary">
            <i class="fa fa-external-link-alt me-1"></i>Abrir no EasyAdmin
          </a>
        </div>
      </div>
    </div>

    {# ── Card: Timeline de logs ──────────────────────────────────────── #}
    <div class="col-lg-7">
      <div class="card shadow-sm">
        <div class="card-header d-flex justify-content-between align-items-center fw-semibold">
          <span><i class="fa fa-rotate me-2"></i>Logs do Provider
            <span class="badge bg-secondary ms-1">{{ logs|length }}</span>
          </span>
          <small class="text-muted">mais recente primeiro</small>
        </div>
        <div class="card-body p-0">

          {% if logs is empty %}
            <div class="p-5 text-center text-muted">
              <i class="fas fa-inbox fa-2x mb-2"></i>
              <p class="mb-0">Nenhum log registrado para este pedido.</p>
            </div>
          {% else %}
            <div class="table-responsive">
              <table class="table table-sm table-hover mb-0 align-middle">
                <thead class="table-dark">
                  <tr>
                    <th style="width:140px">Data/Hora</th>
                    <th style="width:75px">Ação</th>
                    <th style="width:58px">HTTP</th>
                    <th style="width:58px">ms</th>
                    <th style="width:30px"></th>
                    <th>Erro / Contexto</th>
                  </tr>
                </thead>
                <tbody>
                  {% for log in logs %}
                    {% set hasErr = log.errorMessage is not null %}
                    <tr class="{% if hasErr %}table-danger{% endif %}" style="cursor:pointer"
                        data-bs-toggle="collapse" data-bs-target="#log-{{ log.id }}">
                      <td class="text-nowrap small ps-2">{{ log.createdAt|date('d/m H:i:s') }}</td>
                      <td>
                        {% set actionColor = {'add':'primary','status':'info','sync':'secondary'} %}
                        <span class="badge bg-{{ actionColor[log.action] ?? 'secondary' }}">{{ log.action }}</span>
                      </td>
                      <td>
                        {% if log.httpStatus %}
                          <span class="badge {% if log.httpStatus >= 400 %}bg-danger{% elseif log.httpStatus >= 300 %}bg-warning text-dark{% else %}bg-success{% endif %}">
                            {{ log.httpStatus }}
                          </span>
                        {% else %}
                          <span class="text-muted">—</span>
                        {% endif %}
                      </td>
                      <td class="small">
                        {% if log.elapsedMs %}
                          <span class="{% if log.elapsedMs > 5000 %}text-danger fw-bold{% elseif log.elapsedMs > 2000 %}text-warning{% else %}text-success{% endif %}">
                            {{ log.elapsedMs }}
                          </span>
                        {% else %}—{% endif %}
                      </td>
                      <td class="text-center">
                        {% if hasErr %}<span title="{{ log.errorMessage }}">❌</span>{% else %}<span class="text-success">✔</span>{% endif %}
                      </td>
                      <td class="small text-truncate" style="max-width:280px">
                        {% if hasErr %}
                          <span class="text-danger">{{ log.errorMessage|slice(0, 100) }}</span>
                        {% elseif log.context %}
                          <span class="text-muted">status: {{ log.context.external_status ?? '' }} | remains: {{ log.context.remains ?? '' }}</span>
                        {% else %}
                          <span class="text-success">OK</span>
                        {% endif %}
                      </td>
                    </tr>
                    {# Painel expandido com JSON completo #}
                    <tr class="collapse log-expand" id="log-{{ log.id }}">
                      <td colspan="6" class="p-0">
                        <div class="p-3 text-light" style="background:#181c25">
                          <div class="row g-2">
                            {% if log.errorMessage %}
                            <div class="col-12">
                              <strong class="text-danger small"><i class="fa fa-circle-exclamation me-1"></i>Erro:</strong>
                              <pre class="text-danger mb-0 small mt-1">{{ log.errorMessage }}</pre>
                            </div>
                            {% endif %}
                            {% if log.responseBody %}
                            <div class="col-md-6">
                              <strong class="text-info small"><i class="fa fa-arrow-down me-1"></i>Response Body:</strong>
                              <pre class="small mb-0 mt-1 text-light" style="max-height:200px;overflow:auto">{{ log.responseBody|json_encode(constant('JSON_PRETTY_PRINT') b-or constant('JSON_UNESCAPED_UNICODE')) }}</pre>
                            </div>
                            {% endif %}
                            {% if log.context %}
                            <div class="col-md-6">
                              <strong class="text-warning small"><i class="fa fa-paperclip me-1"></i>Contexto:</strong>
                              <pre class="small mb-0 mt-1 text-light" style="max-height:200px;overflow:auto">{{ log.context|json_encode(constant('JSON_PRETTY_PRINT') b-or constant('JSON_UNESCAPED_UNICODE')) }}</pre>
                            </div>
                            {% endif %}
                            <div class="col-12 text-secondary small border-top pt-2 mt-1">
                              retry: {{ log.retryCount }} &nbsp;|&nbsp; provider: {{ log.provider }} &nbsp;|&nbsp; log #{{ log.id }}
                            </div>
                          </div>
                        </div>
                      </td>
                    </tr>
                  {% endfor %}
                </tbody>
              </table>
            </div>
          {% endif %}

        </div>
      </div>
    </div>

  </div>{# /row #}
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
