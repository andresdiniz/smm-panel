{% extends 'admin/layout.html.twig' %}

{% block page_title %}Usuário #{{ user.id }}{% endblock %}

{% block admin_content %}
<style>
  .us-wrap { padding: clamp(16px, 2.4vw, 32px); max-width: 1080px; margin:0 auto; }
  .us-topbar { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 14px; margin-bottom: 24px; padding:18px 20px; border:1px solid rgba(255,255,255,.08); border-radius:14px; background:linear-gradient(130deg,rgba(17,23,34,.98),rgba(10,13,20,.96)); }
  .us-back {
    display: inline-flex; align-items: center; gap: 5px;
    font-size: .78rem; color: #a7aec1; text-decoration: none;
    padding: 8px 11px; border: 1px solid rgba(255,255,255,.1);
    border-radius: 8px; transition: background .12s;
  }
  .us-back:hover { background: rgba(255,255,255,.04); color: #dde1f0; }
  .us-title { font-size: clamp(1.1rem, 2vw, 1.4rem); font-weight: 850; color: #f0f3ff; margin: 0; letter-spacing:-.02em; }
  .us-actions { display: flex; gap: 8px; flex-wrap:wrap; }
  .btn {
    padding: 8px 13px; border-radius: 8px; font-size: .78rem; font-weight: 700;
    border: 1px solid; display: inline-flex; align-items: center; gap: 5px;
    text-decoration: none; cursor: pointer; transition: background .15s;
  }
  .btn-edit   { background: rgba(201,138,0,.1); color: #b07a00; border-color: rgba(201,138,0,.3); }
  .btn-edit:hover { background: rgba(201,138,0,.25); }
  .btn-toggle-on  { background: rgba(120,120,140,.1); color: #7070a0; border-color: rgba(120,120,140,.2); }
  .btn-toggle-on:hover { background: rgba(120,120,140,.2); }
  .btn-toggle-off { background: rgba(77,143,37,.1); color: #5aaa2a; border-color: rgba(77,143,37,.25); }
  .btn-toggle-off:hover { background: rgba(77,143,37,.2); }
  .btn-danger { background: rgba(176,48,48,.1); color: #cc4444; border-color: rgba(176,48,48,.25); }
  .btn-danger:hover { background: rgba(176,48,48,.25); }
  .us-card {
    background: linear-gradient(145deg, rgba(15,19,29,.98), rgba(9,12,18,.98));
    border: 1px solid rgba(255,255,255,.08);
    border-radius: 13px; overflow: hidden; margin-bottom: 16px; box-shadow:0 12px 34px rgba(0,0,0,.16);
  }
  .us-card-title {
    padding: 13px 17px; border-bottom: 1px solid rgba(255,255,255,.06);
    font-size: .7rem; font-weight: 750; text-transform: uppercase;
    letter-spacing: .1em; color: #8c96ad; background:rgba(255,255,255,.015);
  }
  .us-dl { display: grid; grid-template-columns: minmax(130px, .35fr) minmax(0, 1fr); gap: 0; }
  .us-dt, .us-dd {
    padding: 12px 17px; font-size: .84rem;
    border-bottom: 1px solid rgba(255,255,255,.03);
  }
  .us-dt { color: #8992aa; font-weight: 650; }
  .us-dd { color: #b7bfd1; overflow-wrap:anywhere; }
  .us-dl > :nth-last-child(-n+2) { border-bottom: none; }
  .role-badge {
    display: inline-flex; padding: 2px 7px; border-radius: 999px;
    font-size: 9px; font-weight: 700; text-transform: uppercase;
    letter-spacing: .05em; margin-right: 3px;
  }
  .role-admin { background: rgba(176,48,48,.18); color: #cc4444; }
  .role-user  { background: rgba(30,114,160,.14); color: #3a8fc4; }
  .active-yes { background: rgba(77,143,37,.14); color: #5aaa2a; }
  .active-no  { background: rgba(120,120,140,.12); color: #7070a0; }
  .us-wrap :focus-visible { outline:2px solid #4eccd3; outline-offset:3px; }
  @media(max-width:680px){
    .us-topbar { align-items:flex-start; }
    .us-actions { width:100%; }
    .us-dl { grid-template-columns: minmax(95px,.38fr) minmax(0,1fr); }
    .us-dt, .us-dd { padding:10px 12px; }
  }
  @media(max-width:420px){ .us-dl { grid-template-columns:1fr; } .us-dt { padding-bottom:2px; border-bottom:0; } .us-dd { padding-top:2px; } }
</style>

<div class="us-wrap">
  <div class="us-topbar">
    <div style="display:flex;align-items:center;gap:12px;">
      <a href="{{ path('admin_user_index') }}" class="us-back">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 12H5M12 5l-7 7 7 7"/></svg>
        Usuários
      </a>
      <h1 class="us-title">{{ user.name }}</h1>
    </div>
    <div class="us-actions">
      <a href="{{ path('admin_user_edit', {id: user.id}) }}" class="btn btn-edit">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
        Editar
      </a>
      <form method="post" action="{{ path('admin_user_toggle', {id: user.id}) }}" style="margin:0;">
        <input type="hidden" name="_token" value="{{ csrf_token('toggle_user_' ~ user.id) }}">
        <button type="submit" class="btn {{ user.active ? 'btn-toggle-on' : 'btn-toggle-off' }}">
          {{ user.active ? 'Desativar' : 'Ativar' }}
        </button>
      </form>
      <form method="post" action="{{ path('admin_user_delete', {id: user.id}) }}"
            onsubmit="return confirm('Excluir {{ user.name|e('js') }}? Esta ação não pode ser desfeita.')" style="margin:0;">
        <input type="hidden" name="_token" value="{{ csrf_token('delete_user_' ~ user.id) }}">
        <button type="submit" class="btn btn-danger">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/></svg>
          Excluir
        </button>
      </form>
    </div>
  </div>

  <div class="us-card">
    <div class="us-card-title">Informações</div>
    <div class="us-dl">
      <span class="us-dt">ID</span>
      <span class="us-dd" style="font-family:monospace;">#{{ user.id }}</span>
      <span class="us-dt">Nome</span>
      <span class="us-dd" style="color:#dde1f0;font-weight:600;">{{ user.name }}</span>
      <span class="us-dt">E-mail</span>
      <span class="us-dd" style="font-family:monospace;">{{ user.email }}</span>
      <span class="us-dt">Status</span>
      <span class="us-dd">
        <span class="role-badge {{ user.active ? 'active-yes' : 'active-no' }}">
          {{ user.active ? 'Ativo' : 'Inativo' }}
        </span>
      </span>
      <span class="us-dt">Funções</span>
      <span class="us-dd">
        {% for role in user.roles %}
          {% if role != 'ROLE_USER' %}
            <span class="role-badge {{ role == 'ROLE_ADMIN' ? 'role-admin' : 'role-user' }}">
              {{ role|replace({'ROLE_': ''}) }}
            </span>
          {% endif %}
        {% endfor %}
        {% if user.roles|filter(r => r != 'ROLE_USER')|length == 0 %}
          <span class="role-badge role-user">USER</span>
        {% endif %}
      </span>
      <span class="us-dt">Cadastro</span>
      <span class="us-dd">{{ user.createdAt|date('d/m/Y H:i') }}</span>
    </div>
  </div>

  {% if user.wallet %}
  <div class="us-card">
    <div class="us-card-title">Carteira</div>
    <div class="us-dl">
      <span class="us-dt">Saldo</span>
      <span class="us-dd" style="font-weight:700;{{ user.wallet.balanceCents > 0 ? 'color:#5aaa2a;' : 'color:#3e4259;' }}">
        R$&nbsp;{{ (user.wallet.balanceCents / 100)|number_format(2, ',', '.') }}
      </span>
    </div>
  </div>
  {% endif %}

  {% if user.affiliateCode %}
  <div class="us-card">
    <div class="us-card-title">Afiliado</div>
    <div class="us-dl">
      <span class="us-dt">Código</span>
      <span class="us-dd">
        <span style="font-family:monospace;font-size:.8rem;background:rgba(201,138,0,.1);color:#b07a00;padding:2px 7px;border-radius:4px;">{{ user.affiliateCode }}</span>
      </span>
      {% if user.affiliateCommissionRate is not null %}
      <span class="us-dt">Comissão</span>
      <span class="us-dd">{{ (user.affiliateCommissionRate * 100)|number_format(1) }}%</span>
      {% endif %}
      {% if user.referredBy %}
      <span class="us-dt">Indicado por</span>
      <span class="us-dd">
        <a href="{{ path('admin_user_show', {id: user.referredBy.id}) }}" style="color:#4eccd3;text-decoration:none;">
          {{ user.referredBy.name }}
        </a>
      </span>
      {% endif %}
    </div>
  </div>
  {% endif %}
</div>
{% endblock %}
