{% extends 'admin/layout.html.twig' %}

{% block page_title %}Usuários{% endblock %}

{% block admin_content %}
<style>
  .ub-wrap { padding: 24px; }
  .ub-topbar {
    display: flex; align-items: center; justify-content: space-between;
    flex-wrap: wrap; gap: 12px; margin-bottom: 20px;
  }
  .ub-title { font-size: 1.05rem; font-weight: 900; color: #f0f3ff; margin: 0; }
  .ub-actions { display: flex; gap: 8px; align-items: center; }
  .ub-search-form { display: flex; gap: 6px; }
  .ub-search-input {
    background: #0b0e14; border: 1px solid rgba(255,255,255,.08);
    border-radius: 6px; color: #dde1f0; font-size: .8rem;
    padding: 6px 12px; width: 220px; outline: none;
    transition: border-color .15s;
  }
  .ub-search-input:focus { border-color: rgba(78,204,211,.4); }
  .ub-search-input::placeholder { color: #3e4259; }
  .btn-sm {
    padding: 6px 13px; border-radius: 5px; font-size: .78rem; font-weight: 700;
    border: 1px solid; display: inline-flex; align-items: center; gap: 5px;
    text-decoration: none; cursor: pointer; transition: background .15s;
  }
  .btn-primary { background: rgba(78,204,211,.12); color: #4eccd3; border-color: rgba(78,204,211,.3); }
  .btn-primary:hover { background: rgba(78,204,211,.25); }
  .btn-ghost   { background: transparent; color: #6b708a; border-color: rgba(255,255,255,.08); }
  .btn-ghost:hover { background: rgba(255,255,255,.04); color: #dde1f0; }
  .ub-card {
    background: #0b0e14; border: 1px solid rgba(255,255,255,.06);
    border-radius: 8px; overflow: hidden;
  }
  .ub-table { width: 100%; border-collapse: collapse; font-size: .8rem; }
  .ub-table thead tr { border-bottom: 1px solid rgba(255,255,255,.06); }
  .ub-table th {
    padding: 10px 14px; text-align: left;
    font-size: 9px; font-weight: 700; text-transform: uppercase;
    letter-spacing: .1em; color: #3e4259; white-space: nowrap;
  }
  .ub-table tbody tr {
    border-bottom: 1px solid rgba(255,255,255,.03);
    transition: background .12s;
  }
  .ub-table tbody tr:last-child { border-bottom: none; }
  .ub-table tbody tr:hover { background: rgba(255,255,255,.02); }
  .ub-table td { padding: 10px 14px; vertical-align: middle; color: #9196b0; }
  .ub-table td.td-name { color: #dde1f0; font-weight: 600; }
  .ub-table td.td-mono { font-family: monospace; font-size: .74rem; }
  .role-badge {
    display: inline-flex; padding: 2px 7px; border-radius: 999px;
    font-size: 9px; font-weight: 700; text-transform: uppercase;
    letter-spacing: .05em; margin-right: 3px;
  }
  .role-admin  { background: rgba(176,48,48,.18); color: #cc4444; }
  .role-user   { background: rgba(30,114,160,.14); color: #3a8fc4; }
  .active-yes  { background: rgba(77,143,37,.14); color: #5aaa2a; }
  .active-no   { background: rgba(120,120,140,.12); color: #7070a0; }
  .wallet-val { font-weight: 700; }
  .wallet-pos { color: #5aaa2a; }
  .wallet-zero { color: #3e4259; }
  .aff-code { font-family: monospace; font-size: .72rem;
    background: rgba(201,138,0,.1); color: #b07a00;
    padding: 2px 6px; border-radius: 4px; }
  .row-actions { display: flex; gap: 6px; align-items: center; }
  .ra {
    width: 26px; height: 26px; border-radius: 5px; display: flex;
    align-items: center; justify-content: center;
    text-decoration: none; transition: background .12s;
  }
  .ra-show   { background: rgba(78,204,211,.1);  color: #4eccd3; }
  .ra-show:hover   { background: rgba(78,204,211,.25); }
  .ra-edit   { background: rgba(201,138,0,.1);  color: #b07a00; }
  .ra-edit:hover   { background: rgba(201,138,0,.25); }
  .ra-delete { background: rgba(176,48,48,.1);  color: #cc4444; border: none; padding: 0; cursor: pointer; }
  .ra-delete:hover { background: rgba(176,48,48,.25); }
  .pag-wrap {
    display: flex; align-items: center; justify-content: space-between;
    flex-wrap: wrap; gap: 10px;
    padding: 14px 16px; border-top: 1px solid rgba(255,255,255,.04);
    font-size: .75rem; color: #6b708a;
  }
  .pag-links { display: flex; gap: 4px; }
  .pag-links a, .pag-links span {
    display: inline-flex; align-items: center; justify-content: center;
    min-width: 28px; height: 28px; padding: 0 6px;
    border-radius: 5px; border: 1px solid rgba(255,255,255,.06);
    text-decoration: none; font-size: .75rem; transition: background .12s;
  }
  .pag-links a { color: #9196b0; }
  .pag-links a:hover { background: rgba(255,255,255,.05); color: #dde1f0; }
  .pag-links span.current { background: rgba(78,204,211,.15); color: #4eccd3; border-color: rgba(78,204,211,.3); font-weight: 700; }
  .pag-links span.disabled { color: #3e4259; cursor: default; }
  .ub-empty { text-align: center; padding: 48px 16px; color: #3e4259; font-size: .85rem; }
  @media(max-width:900px){ .ub-table .col-hide { display: none; } }
</style>

<div class="ub-wrap">

  <div class="ub-topbar">
    <h1 class="ub-title">
      Usuários
      <span style="font-size:.75rem;font-weight:400;color:#3e4259;margin-left:6px;">
        {{ pagination.totalItemCount }} registro{{ pagination.totalItemCount != 1 ? 's' : '' }}
      </span>
    </h1>
    <div class="ub-actions">
      <form class="ub-search-form" method="get" action="">
        <input class="ub-search-input" type="search" name="q"
               value="{{ search }}" placeholder="Buscar nome ou e-mail…">
        <button type="submit" class="btn-sm btn-primary">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
          Buscar
        </button>
        {% if search %}
          <a href="{{ path('admin_user_index') }}" class="btn-sm btn-ghost">Limpar</a>
        {% endif %}
      </form>
      <a href="{{ path('admin_user_new') }}" class="btn-sm btn-primary">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 5v14M5 12h14"/></svg>
        Novo usuário
      </a>
    </div>
  </div>

  <div class="ub-card">
    {% if pagination.items|length > 0 %}
    <table class="ub-table">
      <thead>
        <tr>
          <th style="width:44px;">#</th>
          <th>Nome</th>
          <th>E-mail</th>
          <th class="col-hide">Funções</th>
          <th class="col-hide">Saldo</th>
          <th class="col-hide">Afiliado</th>
          <th>Status</th>
          <th class="col-hide">Cadastro</th>
          <th style="width:90px;"></th>
        </tr>
      </thead>
      <tbody>
        {% for user in pagination.items %}
        <tr>
          <td class="td-mono" style="color:#3e4259;">#{{ user.id }}</td>

          <td class="td-name">
            {{ user.name }}
            {% if user.referredBy %}
              <div style="font-size:.68rem;color:#5a5f78;margin-top:2px;">
                via <span style="color:#b07a00;">{{ user.referredBy.name }}</span>
              </div>
            {% endif %}
          </td>

          <td class="td-mono">{{ user.email }}</td>

          <td class="col-hide">
            {% for role in user.roles %}
              {% if role != 'ROLE_USER' %}
                <span class="role-badge {{ role == 'ROLE_ADMIN' ? 'role-admin' : 'role-user' }}">
                  {{ role|replace({'ROLE_': ''}) }}
                </span>
              {% endif %}
            {% endfor %}
            {% if user.roles|filter(r => r != 'ROLE_USER')|length == 0 %}
              <span class="role-badge role-user">USER</span>
            {% endif %}
          </td>

          <td class="col-hide">
            {% if user.wallet %}
              <span class="wallet-val {{ user.wallet.balanceCents > 0 ? 'wallet-pos' : 'wallet-zero' }}">
                R$&nbsp;{{ (user.wallet.balanceCents / 100)|number_format(2, ',', '.') }}
              </span>
            {% else %}
              <span style="color:#3e4259;">—</span>
            {% endif %}
          </td>

          <td class="col-hide">
            {% if user.affiliateCode %}
              <span class="aff-code">{{ user.affiliateCode }}</span>
              {% if user.affiliateCommissionRate is not null %}
                <div style="font-size:.68rem;color:#5a5f78;margin-top:2px;">
                  {{ (user.affiliateCommissionRate * 100)|number_format(1) }}%
                </div>
              {% endif %}
            {% else %}
              <span style="color:#3e4259;">—</span>
            {% endif %}
          </td>

          <td>
            <span class="role-badge {{ user.active ? 'active-yes' : 'active-no' }}">
              {{ user.active ? 'Ativo' : 'Inativo' }}
            </span>
          </td>

          <td class="col-hide" style="white-space:nowrap;">
            {{ user.createdAt|date('d/m/Y') }}
          </td>

          <td>
            <div class="row-actions">
              <a href="{{ path('admin_user_show', {id: user.id}) }}" class="ra ra-show" title="Ver">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
              </a>
              <a href="{{ path('admin_user_edit', {id: user.id}) }}" class="ra ra-edit" title="Editar">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
              </a>
              {# DELETE: must be POST + CSRF — cannot use a plain <a> #}
              <form method="post" action="{{ path('admin_user_delete', {id: user.id}) }}"
                    onsubmit="return confirm('Excluir {{ user.name|e('js') }}?')" style="margin:0;">
                <input type="hidden" name="_token" value="{{ csrf_token('delete_user_' ~ user.id) }}">
                <button type="submit" class="ra ra-delete" title="Excluir">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6M14 11v6"/></svg>
                </button>
              </form>
            </div>
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>

    {# paginação #}
    {% set curPage    = pagination.currentPageNumber %}
    {% set perPage    = pagination.itemNumberPerPage %}
    {% set total      = pagination.totalItemCount %}
    {% set totalPages = (total / perPage)|round(0, 'ceil') %}
    {% set showingEnd = curPage * perPage > total ? total : curPage * perPage %}
    {% set pStart     = curPage - 2 > 1 ? curPage - 2 : 1 %}
    {% set pEnd       = curPage + 2 < totalPages ? curPage + 2 : totalPages %}

    <div class="pag-wrap">
      <span>
        Mostrando {{ ((curPage - 1) * perPage) + 1 }}
        –
        {{ showingEnd }}
        de {{ total }}
      </span>
      <div class="pag-links">
        {% if curPage > 1 %}
          <a href="?page={{ curPage - 1 }}{% if search %}&q={{ search|url_encode }}{% endif %}">&lsaquo;</a>
        {% else %}
          <span class="disabled">&lsaquo;</span>
        {% endif %}

        {% if pStart > 1 %}
          <a href="?page=1{% if search %}&q={{ search|url_encode }}{% endif %}">1</a>
          {% if pStart > 2 %}<span style="border:none;min-width:auto;padding:0 4px;color:#3e4259;">…</span>{% endif %}
        {% endif %}

        {% for p in pStart..pEnd %}
          {% if p == curPage %}
            <span class="current">{{ p }}</span>
          {% else %}
            <a href="?page={{ p }}{% if search %}&q={{ search|url_encode }}{% endif %}">{{ p }}</a>
          {% endif %}
        {% endfor %}

        {% if pEnd < totalPages %}
          {% if pEnd < totalPages - 1 %}<span style="border:none;min-width:auto;padding:0 4px;color:#3e4259;">…</span>{% endif %}
          <a href="?page={{ totalPages }}{% if search %}&q={{ search|url_encode }}{% endif %}">{{ totalPages }}</a>
        {% endif %}

        {% if curPage < totalPages %}
          <a href="?page={{ curPage + 1 }}{% if search %}&q={{ search|url_encode }}{% endif %}">&rsaquo;</a>
        {% else %}
          <span class="disabled">&rsaquo;</span>
        {% endif %}
      </div>
    </div>

    {% else %}
      <div class="ub-empty">
        {% if search %}
          Nenhum usuário encontrado para <strong style="color:#9196b0;">"{{ search }}"</strong>.
          <br><a href="{{ path('admin_user_index') }}" style="color:#4eccd3;text-decoration:none;margin-top:8px;display:inline-block;">Ver todos os usuários</a>
        {% else %}
          Nenhum usuário cadastrado ainda.
        {% endif %}
      </div>
    {% endif %}
  </div>

</div>
{% endblock %}
