{% extends 'admin/layout.html.twig' %}

{% block page_title %}Importar Serviços{% endblock %}

{% block admin_content %}
<div style="padding:24px">

    {# Flashes #}
    {% for msg in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fa fa-check-circle me-1"></i> {{ msg }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}
    {% for msg in app.flashes('error') %}
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fa fa-circle-xmark me-1"></i> {{ msg }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}

    {# Step 1 — Selecionar Provedor #}
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-white d-flex align-items-center gap-2 py-3">
            <span class="badge bg-primary rounded-pill">1</span>
            <strong>Selecionar Provedor</strong>
        </div>
        <div class="card-body">
            {% if providers is empty %}
                <div class="alert alert-warning mb-0">
                    <i class="fa fa-triangle-exclamation me-2"></i>
                    Nenhum provedor SMM cadastrado.
                    <a href="{{ path('admin_provider_credential_new') }}" class="alert-link ms-1">Cadastrar provedor</a>
                </div>
            {% else %}
                <div class="row g-3">
                    {% for provider in providers %}
                        <div class="col-sm-6 col-md-4 col-lg-3">
                            <button type="button"
                                class="btn btn-outline-secondary w-100 text-start provider-btn d-flex align-items-center gap-2 p-3"
                                data-slug="{{ provider.slug }}"
                                data-name="{{ provider.slug }}">
                                <i class="fa fa-server fa-fw text-muted"></i>
                                <div>
                                    <div class="fw-semibold text-uppercase">{{ provider.slug }}</div>
                                    <small class="text-muted">{{ provider.baseUrl|slice(0,40) }}{% if provider.baseUrl|length > 40 %}…{% endif %}</small>
                                </div>
                            </button>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </div>

    {# Step 2 — Configurações #}
    <div class="card shadow-sm mb-4 d-none" id="card-step2">
        <div class="card-header bg-white d-flex align-items-center gap-2 py-3">
            <span class="badge bg-primary rounded-pill">2</span>
            <strong>Configurações</strong>
            <span class="ms-2 badge bg-secondary" id="selected-provider-name"></span>
        </div>
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Categoria padrão <span class="text-muted fw-normal">(opcional)</span></label>
                    <select class="form-select" id="default-category">
                        <option value="">— Usar categoria do provedor —</option>
                        {% for cat in categories %}
                            <option value="{{ cat.id }}">{{ cat.name }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Markup padrão (%)</label>
                    <div class="input-group">
                        <input type="number" id="default-markup" class="form-control" value="30" min="0" max="9999">
                        <span class="input-group-text">%</span>
                    </div>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Modo</label>
                    <select class="form-select" id="import-mode">
                        <option value="batch">Lote</option>
                        <option value="individual">Individual</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="button" class="btn btn-primary w-100" id="btn-fetch">
                        <i class="fa fa-search me-1"></i> Buscar
                    </button>
                </div>
            </div>
        </div>
    </div>

    {# Loader #}
    <div class="text-center py-5 d-none" id="loader">
        <div class="spinner-border text-primary" style="width:3rem;height:3rem;"></div>
        <p class="mt-3 text-muted">Consultando API do provedor…</p>
    </div>

    {# Erro fetch #}
    <div class="alert alert-danger d-none" id="fetch-error">
        <strong><i class="fa fa-circle-xmark me-1"></i> Erro:</strong>
        <span id="fetch-error-msg"></span>
        <pre id="fetch-error-detail" class="mt-2 mb-0 small" style="white-space:pre-wrap"></pre>
    </div>

    {# Step 3 — Serviços disponíveis #}
    <div class="card shadow-sm d-none" id="card-step3">
        <div class="card-header bg-white d-flex align-items-center gap-3 py-3 flex-wrap">
            <span class="badge bg-primary rounded-pill">3</span>
            <strong>Serviços Disponíveis</strong>
            <span class="badge bg-secondary" id="count-badge">0</span>
            <div class="ms-auto d-flex gap-2 flex-wrap">
                <input type="text" class="form-control form-control-sm" id="search-services" placeholder="Filtrar…" style="width:220px">
                <select class="form-select form-select-sm" id="filter-status" style="width:150px">
                    <option value="all">Todos</option>
                    <option value="new">Novos</option>
                    <option value="existing">Já importados</option>
                </select>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive" style="max-height:55vh;overflow-y:auto">
                <table class="table table-hover table-sm align-middle mb-0">
                    <thead class="table-light sticky-top">
                        <tr>
                            <th style="width:36px"><input type="checkbox" id="check-all" class="form-check-input"></th>
                            <th>ID</th>
                            <th>Nome</th>
                            <th>Categoria</th>
                            <th>Preço Provedor</th>
                            <th>Preço Venda</th>
                            <th style="width:85px">Mín.</th>
                            <th>Máx.</th>
                            <th class="text-center">★</th>
                        </tr>
                    </thead>
                    <tbody id="services-tbody"></tbody>
                </table>
            </div>
        </div>
        <div class="card-footer bg-white d-flex align-items-center justify-content-between flex-wrap gap-2">
            <span class="text-muted small"><span id="selected-count">0</span> selecionados de <span id="total-count">0</span></span>
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-outline-secondary btn-sm" id="btn-select-new">
                    <i class="fa fa-check-double me-1"></i> Selecionar novos
                </button>
                <button type="button" class="btn btn-outline-secondary btn-sm" id="btn-deselect-all">
                    <i class="fa fa-xmark me-1"></i> Desmarcar
                </button>
                <button type="button" class="btn btn-success" id="btn-save">
                    <i class="fa fa-cloud-arrow-down me-1"></i> Importar Selecionados
                </button>
            </div>
        </div>
    </div>

    {# Toast #}
    <div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index:1090">
        <div id="import-toast" class="toast align-items-center border-0" role="alert">
            <div class="d-flex">
                <div class="toast-body fw-semibold" id="toast-message"></div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
            </div>
        </div>
    </div>

</div>{# /padding #}

<script>
(function () {
    'use strict';

    const FETCH_URL = {{ path('admin_service_import_fetch')|json_encode|raw }};
    const SAVE_URL  = {{ path('admin_service_import_save')|json_encode|raw }};

    let allServices = [], existingIds = [], currentSlug = '', currentMode = 'batch';

    document.querySelectorAll('.provider-btn').forEach(btn => {
        btn.addEventListener('click', () => {
            document.querySelectorAll('.provider-btn').forEach(b => {
                b.classList.remove('btn-primary'); b.classList.add('btn-outline-secondary');
            });
            btn.classList.remove('btn-outline-secondary'); btn.classList.add('btn-primary');
            currentSlug = btn.dataset.slug;
            document.getElementById('selected-provider-name').textContent = btn.dataset.name;
            document.getElementById('card-step2').classList.remove('d-none');
            document.getElementById('card-step3').classList.add('d-none');
            document.getElementById('fetch-error').classList.add('d-none');
        });
    });

    document.getElementById('btn-fetch').addEventListener('click', async () => {
        if (!currentSlug) { alert('Selecione um provedor.'); return; }
        currentMode = document.getElementById('import-mode').value;
        document.getElementById('loader').classList.remove('d-none');
        document.getElementById('card-step3').classList.add('d-none');
        document.getElementById('fetch-error').classList.add('d-none');
        try {
            const fd = new FormData();
            fd.append('provider_slug', currentSlug);
            const res = await fetch(FETCH_URL, { method: 'POST', body: fd });
            const ct  = res.headers.get('content-type') || '';
            if (!ct.includes('application/json')) {
                const txt = await res.text();
                throw new Error(`HTTP ${res.status} — servidor retornou HTML. Sessão expirada?\n${txt.slice(0,300)}`);
            }
            const json = await res.json();
            if (!res.ok || json.error) throw new Error(json.error || `HTTP ${res.status}`);
            allServices  = json.services   || [];
            existingIds  = json.existingIds || [];
            if (!allServices.length) throw new Error('Provedor retornou 0 serviços. Verifique URL base e chave de API.');
            renderTable(allServices);
        } catch (err) {
            const [first, ...rest] = err.message.split('\n');
            document.getElementById('fetch-error-msg').textContent    = first;
            document.getElementById('fetch-error-detail').textContent = rest.join('\n');
            document.getElementById('fetch-error').classList.remove('d-none');
        } finally {
            document.getElementById('loader').classList.add('d-none');
        }
    });

    function renderTable(services) {
        const markup = parseInt(document.getElementById('default-markup').value) || 30;
        const tbody  = document.getElementById('services-tbody');
        tbody.innerHTML = '';
        services.forEach(svc => {
            const isExisting = existingIds.includes(String(svc.external_id));
            const sellPrice  = (svc.provider_price * (1 + markup / 100)).toFixed(4);
            const tr = document.createElement('tr');
            tr.dataset.id = svc.external_id; tr.dataset.existing = isExisting ? '1' : '0';
            tr.innerHTML = `
                <td><input type="checkbox" class="form-check-input row-check" ${isExisting?'':'checked'}></td>
                <td><code style="font-size:.75rem">${esc(String(svc.external_id))}</code></td>
                <td style="max-width:280px" class="fw-medium">${esc(svc.name)}</td>
                <td><span class="badge bg-light text-dark border">${esc(svc.category||'—')}</span></td>
                <td class="text-muted" style="font-size:.8rem">R$ ${Number(svc.provider_price).toFixed(4)}</td>
                <td class="text-success fw-semibold">R$ ${sellPrice}</td>
                <td><input type="number" class="form-control form-control-sm min-input" value="${svc.min_qty}" min="1" style="width:72px"></td>
                <td class="text-muted" style="font-size:.8rem">${Number(svc.max_qty).toLocaleString('pt-BR')}</td>
                <td class="text-center">${isExisting?'<span class="badge bg-warning text-dark">atualiza</span>':'<span class="badge bg-success">novo</span>'}</td>`;
            tbody.appendChild(tr);
        });
        document.getElementById('card-step3').classList.remove('d-none');
        document.getElementById('count-badge').textContent = services.length;
        document.getElementById('total-count').textContent = services.length;
        updateCounts();
        document.getElementById('card-step3').scrollIntoView({ behavior:'smooth', block:'start' });
    }

    document.getElementById('search-services').addEventListener('input', applyFilters);
    document.getElementById('filter-status').addEventListener('change', applyFilters);
    function applyFilters() {
        const q = document.getElementById('search-services').value.toLowerCase();
        const s = document.getElementById('filter-status').value;
        document.querySelectorAll('#services-tbody tr').forEach(tr => {
            const ex = tr.dataset.existing === '1';
            tr.style.display = (!q||tr.textContent.toLowerCase().includes(q)) &&
                (s==='all'||(s==='new'&&!ex)||(s==='existing'&&ex)) ? '' : 'none';
        });
        updateCounts();
    }

    document.getElementById('check-all').addEventListener('change', e => {
        document.querySelectorAll('#services-tbody tr').forEach(tr => {
            if (tr.style.display!=='none') tr.querySelector('.row-check').checked = e.target.checked;
        }); updateCounts();
    });
    document.addEventListener('change', e => { if (e.target.classList.contains('row-check')) updateCounts(); });
    document.getElementById('btn-select-new').addEventListener('click', () => {
        document.querySelectorAll('#services-tbody tr').forEach(tr => {
            if (tr.dataset.existing!=='1') tr.querySelector('.row-check').checked = true;
        }); updateCounts();
    });
    document.getElementById('btn-deselect-all').addEventListener('click', () => {
        document.querySelectorAll('.row-check').forEach(cb => cb.checked = false); updateCounts();
    });
    function updateCounts() {
        document.getElementById('selected-count').textContent = document.querySelectorAll('.row-check:checked').length;
    }

    document.getElementById('btn-save').addEventListener('click', async () => {
        const markup  = parseInt(document.getElementById('default-markup').value) || 30;
        const catId   = document.getElementById('default-category').value || null;
        const checked = document.querySelectorAll('.row-check:checked');
        if (!checked.length) { alert('Selecione pelo menos um serviço.'); return; }
        const selected = [];
        checked.forEach(cb => {
            const tr  = cb.closest('tr');
            const svc = allServices.find(s => String(s.external_id) === String(tr.dataset.id));
            if (!svc) return;
            selected.push({ external_id: svc.external_id, name: svc.name,
                provider_price: svc.provider_price, min_qty: svc.min_qty, max_qty: svc.max_qty,
                category_name: svc.category, category_id: catId ? parseInt(catId) : null,
                markup_percent: markup,
                custom_min_qty: parseInt(tr.querySelector('.min-input')?.value)||null });
        });
        const btn = document.getElementById('btn-save');
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Salvando…';
        try {
            const res  = await fetch(SAVE_URL, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    provider_slug: currentSlug, mode: currentMode,
                    category_id: catId ? parseInt(catId) : null,
                    default_markup_percent: markup, services: selected
                })
            });
            const json = await res.json();
            if (json.error) throw new Error(json.error);
            showToast(`✅ ${json.saved} novos, ${json.updated} atualizados.`, 'success');
        } catch (err) {
            showToast('Erro: ' + err.message, 'danger');
        } finally {
            btn.disabled = false;
            btn.innerHTML = '<i class="fa fa-cloud-arrow-down me-1"></i> Importar Selecionados';
        }
    });

    function esc(s) {
        return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
    }
    function showToast(msg, type = 'success') {
        const el = document.getElementById('import-toast');
        el.className = `toast align-items-center text-bg-${type} border-0`;
        document.getElementById('toast-message').textContent = msg;
        bootstrap.Toast.getOrCreateInstance(el, { delay: 7000 }).show();
    }
}());
</script>
{% endblock %}
