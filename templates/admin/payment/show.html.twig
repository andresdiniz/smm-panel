{% extends 'admin/layout.html.twig' %}

{% block page_title %}Pagamento #{{ payment.id }}{% endblock %}

{% block admin_content %}
<div style="padding:24px;display:flex;flex-direction:column;gap:20px;max-width:700px">

  <div style="display:flex;align-items:center;gap:10px">
    <a href="{{ path('admin_payment_index') }}"
       style="display:inline-flex;align-items:center;gap:5px;font-size:.78rem;color:#6b708a;text-decoration:none">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
      Pagamentos
    </a>
    <span style="color:#3e4259;font-size:.78rem">/</span>
    <span style="font-size:.78rem;color:#9196b0">#{{ payment.id }}</span>
  </div>

  {% for type, messages in app.flashes %}
    {% for msg in messages %}
      <div style="padding:10px 14px;border-radius:8px;font-size:.82rem;
           background:{{ type == 'success' ? 'rgba(34,197,94,.1)' : 'rgba(239,68,68,.1)' }};
           color:{{ type == 'success' ? '#22c55e' : '#ef4444' }};
           border:1px solid {{ type == 'success' ? 'rgba(34,197,94,.25)' : 'rgba(239,68,68,.25)' }};">
        {{ msg }}
      </div>
    {% endfor %}
  {% endfor %}

  <div style="background:#0b0e14;border:1px solid rgba(255,255,255,.06);border-radius:10px;padding:22px 24px">
    <p style="font-size:.7rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;
              color:#3e4259;margin-bottom:16px">Informações do Pagamento</p>
    <dl style="display:grid;grid-template-columns:140px 1fr;gap:10px 16px">
      {% macro row(label, value) %}
        <dt style="font-size:.68rem;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:#3e4259;padding-top:2px">{{ label }}</dt>
        <dd style="font-size:.85rem;color:#dde1f0;word-break:break-all">{{ value|raw }}</dd>
      {% endmacro %}
      {{ _self.row('ID', '<strong>#' ~ payment.id ~ '</strong>') }}
      {{ _self.row('Usuário', payment.user.name ~ ' <span style="color:#3e4259">&lt;' ~ payment.user.email ~ '&gt;</span>') }}
      {{ _self.row('Tipo', payment.type|capitalize) }}
      <dt style="font-size:.68rem;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:#3e4259;padding-top:2px">Status</dt>
      <dd>
        {% set sc = {
          'pending':   'rgba(245,158,11,.12);color:#f59e0b;border:1px solid rgba(245,158,11,.25)',
          'approved':  'rgba(34,197,94,.12);color:#22c55e;border:1px solid rgba(34,197,94,.25)',
          'failed':    'rgba(239,68,68,.12);color:#ef4444;border:1px solid rgba(239,68,68,.25)',
          'cancelled': 'rgba(107,114,128,.12);color:#9ca3af;border:1px solid rgba(107,114,128,.25)',
          'refunded':  'rgba(139,92,246,.12);color:#8b5cf6;border:1px solid rgba(139,92,246,.25)'
        } %}
        <span style="display:inline-flex;padding:3px 9px;border-radius:20px;font-size:.68rem;font-weight:700;
                     background:{{ sc[payment.status] ?? 'rgba(255,255,255,.06);color:#9196b0;border:1px solid rgba(255,255,255,.1)' }}">
          {{ payment.status|capitalize }}
        </span>
      </dd>
      {{ _self.row('Método', payment.method|replace({'_': ' '})|capitalize) }}
      <dt style="font-size:.68rem;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:#3e4259;padding-top:2px">Valor</dt>
      <dd style="font-size:.9rem;font-weight:800;color:#22c55e">R$ {{ (payment.amountCents / 100)|number_format(2, ',', '.') }}</dd>
      {{ _self.row('Taxa', payment.feeCents > 0 ? 'R$ ' ~ (payment.feeCents / 100)|number_format(2, ',', '.') : '—') }}
      {{ _self.row('ID Externo', payment.externalId ?? '—') }}
      {{ _self.row('Criado em', payment.createdAt|date('d/m/Y H:i:s')) }}
      {{ _self.row('Pago em', payment.paidAt ? payment.paidAt|date('d/m/Y H:i:s') : '—') }}
    </dl>
  </div>

  {% if payment.pixCode is defined and payment.pixCode %}
  <div style="background:#0b0e14;border:1px solid rgba(255,255,255,.06);border-radius:10px;padding:22px 24px">
    <p style="font-size:.7rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:#3e4259;margin-bottom:14px">Dados Pix</p>
    <p style="font-size:.7rem;color:#3e4259;margin-bottom:6px;text-transform:uppercase;letter-spacing:.06em">Código Pix</p>
    <div style="background:#161a24;border:1px solid rgba(255,255,255,.06);border-radius:7px;
                padding:10px 13px;font-size:.75rem;color:#9196b0;word-break:break-all;font-family:monospace">
      {{ payment.pixCode }}
    </div>
    {% if payment.qrCodeBase64 is defined and payment.qrCodeBase64 %}
      <img src="data:image/png;base64,{{ payment.qrCodeBase64 }}"
           alt="QR Code Pix #{{ payment.id }}"
           style="max-width:180px;margin-top:12px;border-radius:7px;border:1px solid rgba(255,255,255,.06)">
    {% endif %}
  </div>
  {% endif %}

  {% if payment.gatewayResponse is defined and payment.gatewayResponse %}
  <div style="background:#0b0e14;border:1px solid rgba(255,255,255,.06);border-radius:10px;padding:22px 24px">
    <p style="font-size:.7rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:#3e4259;margin-bottom:14px">Resposta do Gateway</p>
    <pre style="background:#161a24;border:1px solid rgba(255,255,255,.06);border-radius:7px;
                padding:12px;font-size:.72rem;color:#9196b0;max-height:260px;overflow:auto;white-space:pre-wrap">{{ payment.gatewayResponse }}</pre>
  </div>
  {% endif %}

</div>
{% endblock %}
