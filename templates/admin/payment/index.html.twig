{% extends 'admin/layout.html.twig' %}

{% block page_title %}Histórico de Pagamentos{% endblock %}

{% block admin_content %}
<div style="padding: 24px; display: flex; flex-direction: column; gap: 20px;">

  <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px">
    <h1 style="font-size:1.1rem;font-weight:800;color:#f0f3ff">Histórico de Pagamentos</h1>
    <a href="{{ path('admin_dashboard') }}"
       style="display:inline-flex;align-items:center;gap:5px;font-size:.78rem;color:#6b708a;text-decoration:none">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
      Voltar
    </a>
  </div>

  {% for type, messages in app.flashes %}
    {% for msg in messages %}
      <div style="padding:10px 14px;border-radius:8px;font-size:.82rem;
           background:{{ type == 'success' ? 'rgba(34,197,94,.1)' : 'rgba(239,68,68,.1)' }};
           color:{{ type == 'success' ? '#22c55e' : '#ef4444' }};
           border:1px solid {{ type == 'success' ? 'rgba(34,197,94,.25)' : 'rgba(239,68,68,.25)' }};">
        {{ msg }}
      </div>
    {% endfor %}
  {% endfor %}

  {# TOOLBAR #}
  <form method="GET" action=""
        style="display:flex;flex-wrap:wrap;align-items:center;gap:10px;
               background:#0b0e14;border:1px solid rgba(255,255,255,.06);
               border-radius:10px;padding:14px 18px">

    <div style="display:flex;gap:5px;flex-wrap:wrap">
      <a href="{{ path('admin_payment_index') }}"
         style="padding:6px 13px;border-radius:7px;font-size:.75rem;font-weight:600;
                text-decoration:none;border:1px solid;
                {{ status is null
                   ? 'background:rgba(1,134,141,.15);border-color:#01868d;color:#4eccd3'
                   : 'border-color:rgba(255,255,255,.1);color:#6b708a' }}">
        Todos
      </a>
      {% for s in statuses %}
        <a href="{{ path('admin_payment_index', {status: s}) }}"
           style="padding:6px 13px;border-radius:7px;font-size:.75rem;font-weight:600;
                  text-decoration:none;border:1px solid;
                  {{ status == s
                     ? 'background:rgba(1,134,141,.15);border-color:#01868d;color:#4eccd3'
                     : 'border-color:rgba(255,255,255,.1);color:#6b708a' }}">
          {{ s|capitalize }}
        </a>
      {% endfor %}
    </div>

    <div style="flex:1 1 200px;display:flex;align-items:center;gap:7px;
                background:#161a24;border:1px solid rgba(255,255,255,.08);
                border-radius:7px;padding:6px 11px">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#6b708a" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      <input type="text" name="q" value="{{ search }}"
             placeholder="Buscar por e-mail, nome ou ID externo…"
             style="border:none;background:transparent;color:#dde1f0;font-size:.8rem;width:100%;outline:none">
      {% if status %}<input type="hidden" name="status" value="{{ status }}">{% endif %}
    </div>

    <button type="submit"
            style="padding:7px 16px;border-radius:7px;background:#01868d;color:#fff;
                   border:none;font-size:.8rem;font-weight:600;cursor:pointer">
      Buscar
    </button>
  </form>

  {# TABLE #}
  <div style="background:#0b0e14;border:1px solid rgba(255,255,255,.06);border-radius:10px;overflow:hidden">
    {% if pagination.items|length == 0 %}
      <div style="display:flex;flex-direction:column;align-items:center;gap:10px;
                  padding:48px 20px;color:#3e4259;text-align:center">
        <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="1" y="4" width="22" height="16" rx="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
        <p style="font-size:.88rem;color:#6b708a">Nenhum pagamento encontrado.</p>
      </div>
    {% else %}
      <div style="overflow-x:auto">
        <table style="width:100%;border-collapse:collapse;font-size:.8rem">
          <thead>
            <tr>
              {% for col in ['#ID','Usuário','Valor','Taxa','Método','Status','ID Externo','Criado em','Pago em',''] %}
                <th style="background:#0d1016;color:#3e4259;font-weight:700;font-size:.68rem;
                            letter-spacing:.05em;text-transform:uppercase;padding:9px 13px;
                            text-align:left;border-bottom:1px solid rgba(255,255,255,.06);white-space:nowrap">
                  {{ col }}
                </th>
              {% endfor %}
            </tr>
          </thead>
          <tbody>
            {% for payment in pagination %}
            <tr style="border-bottom:1px solid rgba(255,255,255,.04)">
              <td style="padding:10px 13px;color:#9196b0"><strong style="color:#dde1f0">#{{ payment.id }}</strong></td>
              <td style="padding:10px 13px">
                <strong style="display:block;font-size:.82rem;color:#dde1f0">{{ payment.user.name }}</strong>
                <small style="font-size:.7rem;color:#3e4259">{{ payment.user.email }}</small>
              </td>
              <td style="padding:10px 13px;color:#22c55e;font-weight:700">
                R$ {{ (payment.amountCents / 100)|number_format(2, ',', '.') }}
              </td>
              <td style="padding:10px 13px;color:#3e4259;font-size:.76rem">
                {{ payment.feeCents > 0 ? 'R$ ' ~ (payment.feeCents / 100)|number_format(2, ',', '.') : '—' }}
              </td>
              <td style="padding:10px 13px;color:#9196b0">
                {{ payment.method|replace({'_': ' '})|capitalize }}
              </td>
              <td style="padding:10px 13px">
                {% set sc = {
                  'pending':   'rgba(245,158,11,.12);color:#f59e0b;border:1px solid rgba(245,158,11,.25)',
                  'approved':  'rgba(34,197,94,.12);color:#22c55e;border:1px solid rgba(34,197,94,.25)',
                  'failed':    'rgba(239,68,68,.12);color:#ef4444;border:1px solid rgba(239,68,68,.25)',
                  'cancelled': 'rgba(107,114,128,.12);color:#9ca3af;border:1px solid rgba(107,114,128,.25)',
                  'refunded':  'rgba(139,92,246,.12);color:#8b5cf6;border:1px solid rgba(139,92,246,.25)'
                } %}
                <span style="display:inline-flex;padding:3px 9px;border-radius:20px;
                             font-size:.68rem;font-weight:700;
                             background:{{ sc[payment.status] ?? 'rgba(255,255,255,.06);color:#9196b0;border:1px solid rgba(255,255,255,.1)' }}">
                  {{ payment.status|capitalize }}
                </span>
              </td>
              <td style="padding:10px 13px;color:#3e4259;font-size:.76rem">{{ payment.externalId ?? '—' }}</td>
              <td style="padding:10px 13px;color:#3e4259;font-size:.76rem">{{ payment.createdAt|date('d/m/Y H:i') }}</td>
              <td style="padding:10px 13px;color:#3e4259;font-size:.76rem">
                {{ payment.paidAt ? payment.paidAt|date('d/m/Y H:i') : '—' }}
              </td>
              <td style="padding:10px 13px">
                <a href="{{ path('admin_payment_show', {id: payment.id}) }}"
                   style="display:inline-flex;align-items:center;gap:4px;
                          padding:4px 10px;border-radius:6px;font-size:.74rem;font-weight:600;
                          border:1px solid rgba(255,255,255,.08);color:#6b708a;text-decoration:none;
                          transition:all .15s">
                  <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                  Ver
                </a>
              </td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>

      {% if pagination.pageCount > 1 %}
      <div style="display:flex;align-items:center;justify-content:flex-end;
                  gap:5px;padding:13px 18px;
                  border-top:1px solid rgba(255,255,255,.06);flex-wrap:wrap">
        {% if pagination.currentPageNumber > 1 %}
          <a href="{{ path('admin_payment_index', {page: pagination.currentPageNumber - 1, status: status, q: search}) }}"
             style="display:inline-flex;align-items:center;justify-content:center;
                    min-width:30px;height:30px;padding:0 7px;border-radius:6px;font-size:.76rem;
                    border:1px solid rgba(255,255,255,.08);color:#6b708a;text-decoration:none">
            &lsaquo;
          </a>
        {% endif %}
        {% for page in 1..pagination.pageCount %}
          {% if page == pagination.currentPageNumber %}
            <span style="display:inline-flex;align-items:center;justify-content:center;
                         min-width:30px;height:30px;padding:0 7px;border-radius:6px;font-size:.76rem;
                         background:#01868d;border:1px solid #01868d;color:#fff;font-weight:700">{{ page }}</span>
          {% elseif page == 1 or page == pagination.pageCount
                    or (page >= pagination.currentPageNumber - 2 and page <= pagination.currentPageNumber + 2) %}
            <a href="{{ path('admin_payment_index', {page: page, status: status, q: search}) }}"
               style="display:inline-flex;align-items:center;justify-content:center;
                       min-width:30px;height:30px;padding:0 7px;border-radius:6px;font-size:.76rem;
                       border:1px solid rgba(255,255,255,.08);color:#6b708a;text-decoration:none">{{ page }}</a>
          {% elseif page == pagination.currentPageNumber - 3 or page == pagination.currentPageNumber + 3 %}
            <span style="color:#3e4259;font-size:.76rem">…</span>
          {% endif %}
        {% endfor %}
        {% if pagination.currentPageNumber < pagination.pageCount %}
          <a href="{{ path('admin_payment_index', {page: pagination.currentPageNumber + 1, status: status, q: search}) }}"
             style="display:inline-flex;align-items:center;justify-content:center;
                    min-width:30px;height:30px;padding:0 7px;border-radius:6px;font-size:.76rem;
                    border:1px solid rgba(255,255,255,.08);color:#6b708a;text-decoration:none">
            &rsaquo;
          </a>
        {% endif %}
      </div>
      {% endif %}
    {% endif %}
  </div>

</div>
{% endblock %}
