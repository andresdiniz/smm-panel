{% extends 'admin/layout.html.twig' %}

{% block page_title %}Chaves de API{% endblock %}

{% block admin_content %}
<div style="padding:24px;display:flex;flex-direction:column;gap:20px">

  <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px">
    <h1 style="font-size:1.1rem;font-weight:800;color:#f0f3ff">Provedores / Chaves de API</h1>
    <a href="{{ path('admin_provider_credential_new') }}"
       style="display:inline-flex;align-items:center;gap:6px;padding:8px 16px;
              background:#01868d;color:#fff;border-radius:8px;font-size:.8rem;
              font-weight:600;text-decoration:none;transition:background .15s">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      Novo Provedor
    </a>
  </div>

  {% for type, messages in app.flashes %}
    {% for msg in messages %}
      <div style="padding:10px 14px;border-radius:8px;font-size:.82rem;
           background:{{ type == 'success' ? 'rgba(34,197,94,.1)' : 'rgba(239,68,68,.1)' }};
           color:{{ type == 'success' ? '#22c55e' : '#ef4444' }};
           border:1px solid {{ type == 'success' ? 'rgba(34,197,94,.25)' : 'rgba(239,68,68,.25)' }};">
        {{ msg }}
      </div>
    {% endfor %}
  {% endfor %}

  <div style="background:#0b0e14;border:1px solid rgba(255,255,255,.06);border-radius:10px;overflow:hidden">
    {% if credentials is empty %}
      <div style="display:flex;flex-direction:column;align-items:center;gap:10px;
                  padding:48px 20px;text-align:center">
        <svg width="38" height="38" viewBox="0 0 24 24" fill="none" stroke="#3e4259" stroke-width="1.5">
          <rect x="2" y="7" width="20" height="14" rx="2"/>
          <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>
        </svg>
        <p style="font-size:.88rem;color:#6b708a">Nenhum provedor cadastrado.</p>
        <a href="{{ path('admin_provider_credential_new') }}"
           style="display:inline-flex;align-items:center;gap:5px;padding:7px 16px;
                  background:#01868d;color:#fff;border-radius:7px;
                  font-size:.8rem;font-weight:600;text-decoration:none">
          Cadastrar primeiro provedor
        </a>
      </div>
    {% else %}
      <div style="overflow-x:auto">
        <table style="width:100%;border-collapse:collapse;font-size:.8rem">
          <thead>
            <tr>
              {% for col in ['#','Nome','URL da API','Chave de API','Status','Ações'] %}
                <th style="background:#0d1016;color:#3e4259;font-weight:700;font-size:.68rem;
                            letter-spacing:.05em;text-transform:uppercase;padding:9px 13px;
                            text-align:left;border-bottom:1px solid rgba(255,255,255,.06);white-space:nowrap">
                  {{ col }}
                </th>
              {% endfor %}
            </tr>
          </thead>
          <tbody>
            {% for cred in credentials %}
            <tr style="border-bottom:1px solid rgba(255,255,255,.04)">
              <td style="padding:10px 13px;color:#3e4259">{{ cred.id }}</td>
              <td style="padding:10px 13px">
                <strong style="color:#dde1f0">{{ cred.name }}</strong>
              </td>
              <td style="padding:10px 13px;color:#6b708a;font-size:.76rem;max-width:220px;word-break:break-all">
                {{ cred.apiUrl }}
              </td>
              <td style="padding:10px 13px">
                <span style="font-size:.75rem;color:#3e4259;font-family:monospace">
                  {{ cred.apiKey|slice(0,6) }}••••••••
                </span>
              </td>
              <td style="padding:10px 13px">
                {% if cred.isActive %}
                  <span style="display:inline-flex;padding:3px 9px;border-radius:20px;font-size:.68rem;
                               font-weight:700;background:rgba(34,197,94,.12);color:#22c55e;
                               border:1px solid rgba(34,197,94,.25)">Ativo</span>
                {% else %}
                  <span style="display:inline-flex;padding:3px 9px;border-radius:20px;font-size:.68rem;
                               font-weight:700;background:rgba(107,114,128,.12);color:#9ca3af;
                               border:1px solid rgba(107,114,128,.25)">Inativo</span>
                {% endif %}
              </td>
              <td style="padding:10px 13px;white-space:nowrap">
                <a href="{{ path('admin_provider_credential_edit', {id: cred.id}) }}"
                   style="display:inline-flex;align-items:center;gap:4px;padding:4px 10px;
                          border-radius:6px;font-size:.74rem;font-weight:600;
                          border:1px solid rgba(255,255,255,.08);color:#6b708a;
                          text-decoration:none;transition:all .15s">
                  <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                  Editar
                </a>
                <form method="POST" action="{{ path('admin_provider_credential_delete', {id: cred.id}) }}"
                      style="display:inline;margin-left:6px"
                      onsubmit="return confirm('Remover o provedor {{ cred.name }}?')">
                  <input type="hidden" name="_token" value="{{ csrf_token('delete_prov_' ~ cred.id) }}">
                  <button type="submit"
                          style="display:inline-flex;align-items:center;gap:4px;padding:4px 10px;
                                 border-radius:6px;font-size:.74rem;font-weight:600;
                                 border:1px solid rgba(239,68,68,.25);color:#ef4444;
                                 background:rgba(239,68,68,.08);cursor:pointer;transition:all .15s">
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4h6v2"/></svg>
                    Remover
                  </button>
                </form>
              </td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    {% endif %}
  </div>

</div>
{% endblock %}
