{% extends '@EasyAdmin/crud/index.html.twig' %}

{% block page_title %}Pedidos{% endblock %}

{# ── only override the table itself, keep EasyAdmin shell ── #}
{% block main %}
<style>
/* full-width container */
.content-wrapper > .container,
.content-wrapper > .container-fluid,
.content-wrapper > .container-xxl { max-width: 100% !important; }

/* tighter top padding */
.content-panel { padding-top: 0 !important; }

/* search bar full width */
.datagrid-search form { max-width: 360px; }

/* table fills available width */
.table-responsive { overflow-x: auto; }
.datagrid table  { width: 100%; table-layout: fixed; }

/* column sizing */
.datagrid table th:nth-child(1) { width: 60px; }   /* # */
.datagrid table th:nth-child(2) { width: 18%; }    /* usuário */
.datagrid table th:nth-child(3) { width: auto; }   /* serviço */
.datagrid table th:nth-child(4) { width: 120px; }  /* status */
.datagrid table th:nth-child(5) { width: 90px; }   /* valor */
.datagrid table th:nth-child(6) { width: 60px; }   /* qtd */
.datagrid table th:nth-child(7) { width: 100px; }  /* id ext */
.datagrid table th:nth-child(8) { width: 105px; }  /* data */
.datagrid table th:nth-child(9) { width: 150px; }  /* ações */

/* truncate long text cells */
.datagrid table td { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; vertical-align: middle; }

/* status badges */
.order-badge {
  display: inline-flex; align-items: center; gap: 5px;
  padding: 3px 9px; border-radius: 999px;
  font-size: 10px; font-weight: 700;
  text-transform: uppercase; letter-spacing: .04em; white-space: nowrap;
  line-height: 1.5;
}
.order-badge::before { content:''; width:5px; height:5px; border-radius:50%; background:currentColor; flex-shrink:0; }
.ob-completed  { background: rgba(77,143,37,.15);  color: #5aaa2a; }
.ob-processing { background: rgba(30,114,160,.15); color: #3a8fc4; }
.ob-in_progress{ background: rgba(30,114,160,.12); color: #3a8fc4; }
.ob-cancelled  { background: rgba(176,48,48,.14);  color: #cc3a3a; }
.ob-pending    { background: rgba(201,138,0,.14);  color: #c08400; }
.ob-partial    { background: rgba(220,120,64,.14); color: #c06020; }
.ob-refunded   { background: rgba(100,100,120,.12); color: #707090; }

/* actions: keep EasyAdmin's but make them a bit tighter */
.datagrid-row-actions { white-space: nowrap; }
</style>

{% set stMap = {
  'pending':     ['ob-pending',    'Pendente'],
  'processing':  ['ob-processing', 'Processando'],
  'in_progress': ['ob-in_progress','Em andamento'],
  'completed':   ['ob-completed',  'Concluído'],
  'partial':     ['ob-partial',    'Parcial'],
  'cancelled':   ['ob-cancelled',  'Cancelado'],
  'refunded':    ['ob-refunded',   'Reembolsado'],
} %}

{% set searchQuery = app.request.query.get('query', '') %}
{% set totalCount  = paginator.numResults %}

{# count visible page statuses for the chips #}
{% set statusGroups = {
  'completed':   ['#5aaa2a','ob-completed',   'Concluídos'],
  'processing':  ['#3a8fc4','ob-processing',  'Processando'],
  'in_progress': ['#3a8fc4','ob-in_progress', 'Em andamento'],
  'pending':     ['#c08400','ob-pending',     'Pendentes'],
  'cancelled':   ['#cc3a3a','ob-cancelled',   'Cancelados'],
  'partial':     ['#c06020','ob-partial',     'Parciais'],
  'refunded':    ['#707090','ob-refunded',    'Reembolsados'],
} %}
{% set counted = {} %}
{% for entityDto in entities %}
  {% set o = entityDto.getInstance() %}
  {% set s = o.status %}
  {% set counted = counted|merge({(s): (counted[s] ?? 0) + 1}) %}
{% endfor %}

{# ── page header (EasyAdmin-native style) ── #}
<div class="content-header d-flex align-items-center justify-content-between gap-3 flex-wrap mb-3">
  <div class="d-flex align-items-center gap-2 flex-wrap">
    <h1 class="h4 mb-0">Pedidos</h1>
    <span class="badge bg-secondary">{{ totalCount }}</span>
    {% for statusKey, info in statusGroups %}
      {% if counted[statusKey] is defined and counted[statusKey] > 0 %}
        <span class="order-badge {{ info[1] }}">{{ counted[statusKey] }} {{ info[2] }}</span>
      {% endif %}
    {% endfor %}
  </div>
  <form method="get" action="" class="d-flex">
    {% for key, val in app.request.query.all %}
      {% if key != 'query' and key != 'page' %}
        <input type="hidden" name="{{ key }}" value="{{ val }}">
      {% endif %}
    {% endfor %}
    <div class="input-group input-group-sm">
      <input type="search" name="query" class="form-control" placeholder="Buscar pedidos…" value="{{ searchQuery }}" autocomplete="off" style="min-width:220px">
      <button class="btn btn-secondary" type="submit">&#128269;</button>
    </div>
  </form>
</div>

{# ── table ── #}
<div class="table-responsive">
  <table class="table table-sm table-hover align-middle datagrid">
    <thead>
      <tr>
        <th>#</th>
        <th>Usuário</th>
        <th>Serviço</th>
        <th>Status</th>
        <th class="text-end">Valor</th>
        <th class="text-end">Qtd</th>
        <th>ID Ext.</th>
        <th>Criado em</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
    {% if entities|length > 0 %}
      {% for entityDto in entities %}
      {% set order = entityDto.getInstance() %}
      {% set stInfo = stMap[order.status] ?? ['ob-refunded', order.status] %}
      <tr>
        <td><small class="text-muted fw-bold">#{{ order.id }}</small></td>
        <td>
          <div>
            <span class="fw-semibold">{{ order.user.name }}</span><br>
            <small class="text-muted">{{ order.user.email }}</small>
          </div>
        </td>
        <td>
          <span title="{{ order.service.name }}">{{ order.service.name }}</span>
        </td>
        <td>
          <span class="order-badge {{ stInfo[0] }}">{{ stInfo[1] }}</span>
        </td>
        <td class="text-end fw-bold">
          R$&nbsp;{{ (order.amountCents / 100)|number_format(2, ',', '.') }}
        </td>
        <td class="text-end">{{ order.quantity }}</td>
        <td>
          {% if order.externalOrderId %}
            <code class="text-muted" style="font-size:.7rem">{{ order.externalOrderId }}</code>
          {% else %}
            <span class="text-muted">—</span>
          {% endif %}
        </td>
        <td>
          <small class="text-muted">
            {{ order.createdAt|date('d/m/Y') }}<br>
            {{ order.createdAt|date('H:i') }}
          </small>
        </td>
        <td class="datagrid-row-actions">
          <a class="btn btn-sm btn-outline-secondary"
             href="{{ ea_url().setController('App\\Controller\\Admin\\OrderCrudController').setAction('show').setEntityId(order.id).generateUrl() }}">
            Show
          </a>
          <a class="btn btn-sm btn-outline-warning"
             href="{{ ea_url().setController('App\\Controller\\Admin\\OrderCrudController').setAction('edit').setEntityId(order.id).generateUrl() }}">
            Edit
          </a>
          <a class="btn btn-sm btn-outline-danger"
             href="{{ ea_url().setController('App\\Controller\\Admin\\OrderCrudController').setAction('delete').setEntityId(order.id).generateUrl() }}"
             onclick="return confirm('Excluir pedido #{{ order.id }}?')">
            Del
          </a>
        </td>
      </tr>
      {% endfor %}
    {% else %}
      <tr><td colspan="9" class="text-center text-muted py-5">Nenhum pedido encontrado.</td></tr>
    {% endif %}
    </tbody>
  </table>
</div>

<div class="d-flex align-items-center justify-content-between mt-3 flex-wrap gap-2">
  <small class="text-muted">{{ totalCount }} resultado{{ totalCount != 1 ? 's' : '' }}</small>
  {{ include('@EasyAdmin/crud/paginator.html.twig') }}
</div>

{% endblock %}
