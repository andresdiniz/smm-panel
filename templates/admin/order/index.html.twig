{% extends 'admin/layout.html.twig' %}

{% block page_title %}Pedidos{% endblock %}

{% block admin_content %}
<style>
  /* table */
  .ord-wrap { padding: 24px; }
  .ord-tbl-wrap { overflow-x: auto; }
  .ord-tbl { width: 100%; border-collapse: collapse; table-layout: fixed; }
  .ord-tbl col.c-id   { width: 58px; }
  .ord-tbl col.c-user { width: 20%; }
  .ord-tbl col.c-svc  { width: auto; }
  .ord-tbl col.c-st   { width: 118px; }
  .ord-tbl col.c-val  { width: 88px; }
  .ord-tbl col.c-qty  { width: 54px; }
  .ord-tbl col.c-ext  { width: 100px; }
  .ord-tbl col.c-date { width: 100px; }
  .ord-tbl col.c-acts { width: 145px; }

  .ord-tbl thead th {
    font-size: 10px; font-weight: 700; text-transform: uppercase;
    letter-spacing: .07em; padding: 8px 10px;
    border-bottom: 2px solid rgba(255,255,255,.08); white-space: nowrap;
    color: #6b708a;
  }
  .ord-tbl tbody td {
    padding: 10px; border-bottom: 1px solid rgba(255,255,255,.04);
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    vertical-align: middle; font-size: .8125rem; color: #dde1f0;
  }
  .ord-tbl tbody tr:last-child td { border-bottom: none; }
  .ord-tbl tbody tr:hover { background: rgba(255,255,255,.03); }
  .tc-val, .tc-qty { text-align: right; }
  .u-name  { font-weight: 600; display: block; }
  .u-email { font-size: .6875rem; opacity: .5; }

  /* status badge */
  .st {
    display: inline-flex; align-items: center; gap: 4px;
    padding: 3px 8px; border-radius: 999px;
    font-size: 10px; font-weight: 700; text-transform: uppercase;
    letter-spacing: .04em; white-space: nowrap; line-height: 1.6;
  }
  .st::before { content:''; width:5px; height:5px; border-radius:50%; background:currentColor; flex-shrink:0; }
  .st-completed              { background:rgba(77,143,37,.15);  color:#5aaa2a; }
  .st-processing,.st-in_progress { background:rgba(30,114,160,.15); color:#3a8fc4; }
  .st-cancelled              { background:rgba(176,48,48,.14);  color:#cc4444; }
  .st-pending                { background:rgba(201,138,0,.14);  color:#b07a00; }
  .st-partial                { background:rgba(220,120,64,.14); color:#c06020; }
  .st-refunded               { background:rgba(120,120,140,.12);color:#7070a0; }

  .ext-id { font-family: monospace; font-size: .7rem; opacity: .55; }
  .row-acts { display:flex; gap:4px; }
  .row-acts .btn {
    padding: 3px 8px; font-size: .6875rem; border-radius: 4px;
    cursor: pointer; text-decoration: none; display: inline-flex; align-items: center;
  }
  .btn-info    { background: rgba(30,114,160,.15); color:#3a8fc4; border:1px solid rgba(30,114,160,.3); }
  .btn-warning { background: rgba(201,138,0,.12);  color:#b07a00; border:1px solid rgba(201,138,0,.3); }
  .btn-danger  { background: rgba(176,48,48,.12);  color:#cc4444; border:1px solid rgba(176,48,48,.3); }
  .btn-info:hover    { background: rgba(30,114,160,.28); }
  .btn-warning:hover { background: rgba(201,138,0,.25); }
  .btn-danger:hover  { background: rgba(176,48,48,.25); }

  /* header chips */
  .pg-chip {
    display:inline-flex; align-items:center; gap:4px;
    padding:2px 8px; border-radius:999px;
    font-size:10px; font-weight:700; text-transform:uppercase;
    letter-spacing:.04em; border:1px solid;
  }
  .pg-chip.tot  { border-color:rgba(255,255,255,.15); color:rgba(255,255,255,.4); }
  .pg-chip.can  { border-color:rgba(176,48,48,.4);    color:#cc4444; background:rgba(176,48,48,.08); }
  .pg-chip.comp { border-color:rgba(77,143,37,.4);    color:#5aaa2a; background:rgba(77,143,37,.08); }
  .pg-chip.proc { border-color:rgba(30,114,160,.4);   color:#3a8fc4; background:rgba(30,114,160,.08); }
  .pg-chip.pend { border-color:rgba(201,138,0,.4);    color:#b07a00; background:rgba(201,138,0,.08); }
  .pg-chip.part { border-color:rgba(220,120,64,.4);   color:#c06020; background:rgba(220,120,64,.08); }
  .pg-chip.refu { border-color:rgba(120,120,140,.3);  color:#7070a0; background:rgba(120,120,140,.06); }

  /* pagination */
  .ord-pager { display:flex; gap:4px; align-items:center; }
  .ord-pager a, .ord-pager span {
    padding: 4px 10px; border-radius:4px; font-size:.75rem; font-weight:600;
    border: 1px solid rgba(255,255,255,.1); color:#6b708a; text-decoration:none;
  }
  .ord-pager a:hover { background:rgba(255,255,255,.05); color:#dde1f0; }
  .ord-pager span.current { background:rgba(1,134,141,.2); border-color:rgba(1,134,141,.4); color:#4eccd3; }

  /* filter bar */
  .ord-filters { display:flex; gap:6px; flex-wrap:wrap; align-items:center; }
  .ord-filters a {
    padding: 4px 10px; border-radius:999px; font-size:.72rem; font-weight:700;
    text-transform:uppercase; letter-spacing:.04em;
    border:1px solid rgba(255,255,255,.1); color:#6b708a; text-decoration:none;
  }
  .ord-filters a:hover { background:rgba(255,255,255,.05); color:#dde1f0; }
  .ord-filters a.active { background:rgba(1,134,141,.15); border-color:rgba(1,134,141,.4); color:#4eccd3; }

  /* form inputs */
  .ord-search input {
    background: rgba(255,255,255,.05); border: 1px solid rgba(255,255,255,.1);
    color: #dde1f0; border-radius: 4px; padding: 4px 10px; font-size:.78rem;
  }
  .ord-search input:focus { outline: none; border-color: rgba(1,134,141,.5); }
  .ord-search button {
    background: rgba(1,134,141,.2); border: 1px solid rgba(1,134,141,.4);
    color: #4eccd3; border-radius: 4px; padding: 4px 10px; cursor:pointer;
  }
  .ord-search button:hover { background: rgba(1,134,141,.35); }
</style>

{% set stMap = {
  'pending':     ['st-pending',    'Pendente'],
  'processing':  ['st-processing', 'Processando'],
  'in_progress': ['st-in_progress','Em andamento'],
  'completed':   ['st-completed',  'Concluído'],
  'partial':     ['st-partial',    'Parcial'],
  'cancelled':   ['st-cancelled',  'Cancelado'],
  'refunded':    ['st-refunded',   'Reembolsado'],
} %}
{% set chipMap = {
  'completed':'comp','processing':'proc','in_progress':'proc',
  'pending':'pend','cancelled':'can','partial':'part','refunded':'refu'
} %}
{% set statusLabels = {
  'completed':'Concluídos','processing':'Processando','in_progress':'Em andamento',
  'pending':'Pendentes','cancelled':'Cancelados','partial':'Parciais','refunded':'Reembolsados'
} %}
{% set totalCount = pagination.totalItemCount %}

<div class="ord-wrap">

  {# header #}
  <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;margin-bottom:16px;">
    <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
      <h4 style="margin:0;font-size:1rem;font-weight:800;color:#f0f3ff;">Pedidos</h4>
      <span class="pg-chip tot">{{ totalCount }} total</span>
    </div>
    <form method="get" action="" class="ord-search" style="display:flex;gap:4px;">
      {% for key, val in app.request.query.all %}
        {% if key != 'search' and key != 'page' %}
          <input type="hidden" name="{{ key }}" value="{{ val }}">
        {% endif %}
      {% endfor %}
      <input type="search" name="search" placeholder="Buscar pedidos…" value="{{ search }}" autocomplete="off" style="width:220px">
      <button type="submit">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
      </button>
    </form>
  </div>

  {# status filter tabs #}
  <div class="ord-filters" style="margin-bottom:14px;">
    <a href="{{ path('admin_order_index', {search: search}) }}" class="{{ status is null ? 'active' }}">Todos</a>
    {% for st in statuses %}
      <a href="{{ path('admin_order_index', {status: st, search: search}) }}"
         class="{{ status == st ? 'active' }}">
        {{ statusLabels[st] ?? st }}
      </a>
    {% endfor %}
  </div>

  {# table #}
  <div class="ord-tbl-wrap">
    <table class="ord-tbl">
      <colgroup>
        <col class="c-id"><col class="c-user"><col class="c-svc">
        <col class="c-st"><col class="c-val"><col class="c-qty">
        <col class="c-ext"><col class="c-date"><col class="c-acts">
      </colgroup>
      <thead>
        <tr>
          <th>#</th><th>Usuário</th><th>Serviço</th>
          <th>Status</th><th class="tc-val">Valor</th><th class="tc-qty">Qtd</th>
          <th>ID Ext.</th><th>Criado em</th><th></th>
        </tr>
      </thead>
      <tbody>
      {% if pagination.items|length > 0 %}
        {% for order in pagination.items %}
        {% set stInfo = stMap[order.status] ?? ['st-refunded', order.status] %}
        <tr>
          <td><span style="font-size:.75rem;font-weight:700;color:#6b708a;">#{{ order.id }}</span></td>
          <td>
            <span class="u-name">{{ order.user.name }}</span>
            <span class="u-email">{{ order.user.email }}</span>
          </td>
          <td title="{{ order.service.name }}">{{ order.service.name }}</td>
          <td><span class="st {{ stInfo[0] }}">{{ stInfo[1] }}</span></td>
          <td class="tc-val" style="font-weight:700">R$&nbsp;{{ (order.amountCents/100)|number_format(2,',','.') }}</td>
          <td class="tc-qty">{{ order.quantity }}</td>
          <td>
            {% if order.externalOrderId %}<span class="ext-id">{{ order.externalOrderId }}</span>
            {% else %}<span style="opacity:.35;">&#8212;</span>{% endif %}
          </td>
          <td style="font-size:.75rem">
            {{ order.createdAt|date('d/m/Y') }}<br>
            <span style="opacity:.45;font-size:.7rem;">{{ order.createdAt|date('H:i') }}</span>
          </td>
          <td>
            <div class="row-acts">
              <a class="btn btn-info"
                 href="{{ path('admin_order_show', {id: order.id}) }}">
                Ver
              </a>
              <a class="btn btn-warning"
                 href="{{ path('admin_order_edit', {id: order.id}) }}">
                Editar
              </a>
              <a class="btn btn-danger"
                 href="{{ path('admin_order_delete', {id: order.id}) }}"
                 onclick="return confirm('Excluir pedido #{{ order.id }}?')">
                Del
              </a>
            </div>
          </td>
        </tr>
        {% endfor %}
      {% else %}
        <tr><td colspan="9" style="text-align:center;padding:40px;opacity:.4;">Nenhum pedido encontrado.</td></tr>
      {% endif %}
      </tbody>
    </table>
  </div>

  {# pagination #}
  <div style="display:flex;justify-content:space-between;align-items:center;margin-top:14px;flex-wrap:wrap;gap:8px;">
    <small style="color:#6b708a;font-size:.75rem;">{{ totalCount }} resultado{{ totalCount != 1 ? 's' : '' }}</small>
    <div class="ord-pager">
      {% if pagination.currentPageNumber > 1 %}
        <a href="{{ path('admin_order_index', app.request.query.all|merge({page: pagination.currentPageNumber - 1})) }}">&laquo;</a>
      {% endif %}
      {% for p in range(
          max(1, pagination.currentPageNumber - 2),
          min(pagination.pageCount, pagination.currentPageNumber + 2)
        ) %}
        {% if p == pagination.currentPageNumber %}
          <span class="current">{{ p }}</span>
        {% else %}
          <a href="{{ path('admin_order_index', app.request.query.all|merge({page: p})) }}">{{ p }}</a>
        {% endif %}
      {% endfor %}
      {% if pagination.currentPageNumber < pagination.pageCount %}
        <a href="{{ path('admin_order_index', app.request.query.all|merge({page: pagination.currentPageNumber + 1})) }}">&raquo;</a>
      {% endif %}
    </div>
  </div>

</div>
{% endblock %}
