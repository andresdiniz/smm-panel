ASAAS_WEBHOOK_TOKEN=
ASAAS_SANDBOX=0

# SMM provider (standard SMM API v2)
SMM_PROVIDER_URL=https://provider.example.com/api/v2
SMM_PROVIDER_KEY=

# Public SMM API authentication
SMM_API_TOKEN=
